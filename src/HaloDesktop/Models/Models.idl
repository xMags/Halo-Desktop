namespace HaloDesktop
{
    enum MediaKind
    {
        Movie = 0,
        Series = 1,
    };

    enum StreamStatus
    {
        Instant = 0,
        Caching = 1,
        Uncached = 2,
        OnDisk = 3,
        Unknown = 4,
    };

    [default_interface]
    runtimeclass MediaSummary
    {
        MediaSummary();
        String Id { get; };
        String Type { get; };
        String Title { get; };
        String Meta { get; };
        String Poster { get; };
        String Background { get; };
        String Description { get; };
        String Rating { get; };
        String ReleaseInfo { get; };
        Int64 AddedAt { get; };
        Int64 UpdatedAt { get; };
        MediaKind Kind { get; };
        String KindLabel { get; };
        // The title's logo art, when its addon sent one.
        String Logo { get; };
        // `behaviorHints.defaultVideoId`: the video a film plays as when that
        // differs from its id. Empty when the addon named none.
        String DefaultVideoId { get; };
    };

    [default_interface]
    runtimeclass MediaDetail
    {
        MediaDetail();
        String Id { get; };
        String Type { get; };
        String Poster { get; };
        String Background { get; };
        String Title { get; };
        String Kicker { get; };
        String MetaLine { get; };
        String Synopsis { get; };
        Windows.Foundation.Collections.IVectorView<String> Facts { get; };
        Windows.Foundation.Collections.IVectorView<String> Availability { get; };
        Windows.Foundation.Collections.IVectorView<Int32> Seasons { get; };
    };

    [default_interface]
    runtimeclass Episode
    {
        Episode();
        String Tag { get; };
        String VideoId { get; };
        Int32 Season { get; };
        Int32 Number { get; };
        String Thumbnail { get; };
        Boolean Watched { get; };
        String Title { get; };
        String Blurb { get; };
        String Runtime { get; };
        String Aired { get; };
        Double Progress { get; };
        Boolean Downloaded { get; };
    };

    [default_interface]
    runtimeclass StreamSource
    {
        StreamSource();
        String Key { get; };
        String Quality { get; };
        String Range { get; };
        String File { get; };
        String Codec { get; };
        String Audio { get; };
        String Languages { get; };
        StreamStatus Status { get; };
        String Size { get; };
        String Detail { get; };
        UInt64 SizeBytes { get; };
        Int32 Rank { get; };
        Windows.Foundation.Collections.IVectorView<String> SubtitleLanguages { get; };
    };

    [default_interface]
    runtimeclass SourceGroup
    {
        SourceGroup();
        String AddonId { get; };
        String Name { get; };
        String Note { get; };
        Int32 Count { get; };
        Boolean Answered { get; };
        Windows.Foundation.Collections.IVectorView<StreamSource> Sources { get; };
    };


    [default_interface]
    runtimeclass Addon
    {
        Addon();
        String Id { get; };
        String TransportUrl { get; };
        String Initials { get; };
        String Name { get; };
        String Version { get; };
        String Scope { get; };
        String Provides { get; };
        Boolean CanEdit { get; };
        Boolean IsGlobal { get; };
        Boolean Enabled;
    };

    runtimeclass ContinueItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        ContinueItem();
        String Name { get; };
        String Type { get; };
        String MetaId { get; };
        String VideoId { get; };
        String ItemId { get; };
        String Poster { get; };
        // The landscape image a continue card draws. Starts as the poster, because
        // that is all watch state remembers, and becomes the episode still or the
        // backdrop once the item's meta has been resolved.
        String Art { get; };
        String Sub { get; };
        String Tag { get; };
        String TimeLeft { get; };
        Double Progress { get; };
        // The episode's own title. Empty until the item's meta has been resolved,
        // because watch state remembers only the show, and empty for a film.
        String EpisodeTitle { get; };
    };

    // A card in the home carousel. Each one carries its own library state: the
    // strip shows several titles at once, so a single shared busy or error flag
    // would report one card's save on all of them.
    runtimeclass FeaturedItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        FeaturedItem();
        MediaSummary Media { get; };
        String Title { get; };
        String Rating { get; };
        String Meta { get; };
        String Synopsis { get; };
        String Background { get; };
        String ActionLabel { get; };
        // The logo drawn in place of the title, empty when there is none.
        String Logo { get; };
        // Hidden when the title has no positive rating, and the separator only
        // when both the rating and the release line are there.
        Microsoft.UI.Xaml.Visibility RatingVisibility { get; };
        Microsoft.UI.Xaml.Visibility MetaVisibility { get; };
        Microsoft.UI.Xaml.Visibility FactsSeparatorVisibility { get; };
        Microsoft.UI.Xaml.Visibility SynopsisVisibility { get; };
        Double TitleSize { get; };
        String LibraryLabel { get; };
        Boolean InLibrary { get; };
        Boolean LibraryBusy { get; };
        Boolean LibraryEnabled { get; };
        Microsoft.UI.Xaml.Visibility InLibraryVisibility { get; };
        Microsoft.UI.Xaml.Visibility NotInLibraryVisibility { get; };
        String LibraryErrorText { get; };
        Microsoft.UI.Xaml.Visibility LibraryErrorVisibility { get; };
    };

    [default_interface]
    runtimeclass Shelf
    {
        Shelf();
        String Title { get; };
        String SourceLabel { get; };
        Windows.Foundation.Collections.IVectorView<MediaSummary> Items { get; };
        // A catalog shelf whose answer has not arrived: it draws its title
        // over skeleton cards.
        Boolean IsLoading { get; };
    };

    [default_interface]
    runtimeclass DetailNavParams
    {
        DetailNavParams();
        String Type { get; };
        String MetaId { get; };
        String Title { get; };
        String Poster { get; };
    };

    [default_interface]
    runtimeclass SourcesNavParams
    {
        SourcesNavParams();
        String Type { get; };
        String MetaId { get; };
        String VideoId { get; };
        String ItemId { get; };
        String Title { get; };
        String ShowName { get; };
        String EpisodeLabel { get; };
        String Poster { get; };
    };

    [default_interface]
    runtimeclass PlaybackRequest
    {
        PlaybackRequest();
        String Url { get; };
        Boolean IsLocalFile { get; };
        String DownloadId { get; };
        String SubtitleLang { get; };
        String MediaType { get; };
        String VideoId { get; };
        String ItemId { get; };
        String MetaId { get; };
        String Title { get; };
        String ShowName { get; };
        String EpisodeLabel { get; };
        String Poster { get; };
        String AddonId { get; };
        String BingeGroup { get; };
        String Filename { get; };
        UInt64 VideoSize { get; };
        String VideoHash { get; };
        // False for a link pasted into Search: nothing about it is kept in
        // watch history, and Discord is not told its name.
        Boolean RecordsHistory { get; };
    };
}
