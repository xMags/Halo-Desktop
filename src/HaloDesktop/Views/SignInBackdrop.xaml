<?xml version="1.0" encoding="utf-8"?>
<!--
  Behind the sign-in card, from the reference's `auth.css`: three real backdrops
  crossfading on a 27s loop (offsets 0, 9 and 18s; in by 6%, held to 33%, out by
  40%, growing from 1.04 to 1.1), dimmed and blurred, then the shade and the two
  glows. Blur is the title page's technique: each backdrop is decoded tiny and
  stretched, which leaves the soft colour a wide blur does without a blur pass.
  Drawn only; it takes no input and says nothing to assistive technology.
-->
<UserControl
  x:Class="HaloDesktop.SignInBackdrop"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  AutomationProperties.AccessibilityView="Raw"
  IsHitTestVisible="False"
  IsTabStop="False"
  Loaded="OnLoaded"
  SizeChanged="OnSizeChanged"
  Unloaded="OnUnloaded">

  <UserControl.Resources>
    <Storyboard x:Key="CrossfadeStoryboard">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Backdrop1" Storyboard.TargetProperty="Opacity" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <LinearDoubleKeyFrame KeyTime="0:0:1.62" Value="1" />
        <LinearDoubleKeyFrame KeyTime="0:0:8.91" Value="1" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="0" />
        <LinearDoubleKeyFrame KeyTime="0:0:27" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Backdrop1Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.04" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="1.1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Backdrop1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.04" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="1.1" />
      </DoubleAnimationUsingKeyFrames>

      <DoubleAnimationUsingKeyFrames BeginTime="0:0:9" Storyboard.TargetName="Backdrop2" Storyboard.TargetProperty="Opacity" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <LinearDoubleKeyFrame KeyTime="0:0:1.62" Value="1" />
        <LinearDoubleKeyFrame KeyTime="0:0:8.91" Value="1" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="0" />
        <LinearDoubleKeyFrame KeyTime="0:0:27" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames BeginTime="0:0:9" Storyboard.TargetName="Backdrop2Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.04" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="1.1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames BeginTime="0:0:9" Storyboard.TargetName="Backdrop2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.04" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="1.1" />
      </DoubleAnimationUsingKeyFrames>

      <DoubleAnimationUsingKeyFrames BeginTime="0:0:18" Storyboard.TargetName="Backdrop3" Storyboard.TargetProperty="Opacity" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <LinearDoubleKeyFrame KeyTime="0:0:1.62" Value="1" />
        <LinearDoubleKeyFrame KeyTime="0:0:8.91" Value="1" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="0" />
        <LinearDoubleKeyFrame KeyTime="0:0:27" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames BeginTime="0:0:18" Storyboard.TargetName="Backdrop3Scale" Storyboard.TargetProperty="ScaleX" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.04" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="1.1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames BeginTime="0:0:18" Storyboard.TargetName="Backdrop3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:27" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.04" />
        <LinearDoubleKeyFrame KeyTime="0:0:10.8" Value="1.1" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>

  <Grid Background="{StaticResource HaloSignInGroundBrush}">
    <!-- `inset: -60px`, so the grown backdrop never shows an edge. With motion
         off only the first backdrop shows, still, as the reference does. -->
    <Grid Margin="-60">
      <Image x:Name="Backdrop1" Opacity="1" RenderTransformOrigin="0.5,0.5" Stretch="UniformToFill">
        <Image.RenderTransform>
          <ScaleTransform x:Name="Backdrop1Scale" />
        </Image.RenderTransform>
      </Image>
      <Image x:Name="Backdrop2" Opacity="0" RenderTransformOrigin="0.5,0.5" Stretch="UniformToFill">
        <Image.RenderTransform>
          <ScaleTransform x:Name="Backdrop2Scale" />
        </Image.RenderTransform>
      </Image>
      <Image x:Name="Backdrop3" Opacity="0" RenderTransformOrigin="0.5,0.5" Stretch="UniformToFill">
        <Image.RenderTransform>
          <ScaleTransform x:Name="Backdrop3Scale" />
        </Image.RenderTransform>
      </Image>
    </Grid>
    <Rectangle Fill="{StaticResource HaloSignInBackdropDimBrush}" />
    <Rectangle Fill="{StaticResource HaloSignInShadeRadialBrush}" />
    <Rectangle Fill="{StaticResource HaloSignInShadeLinearBrush}" />
    <Canvas>
      <Ellipse
        Canvas.Left="-300"
        Canvas.Top="-340"
        Width="840"
        Height="580"
        Fill="{StaticResource HaloSignInGlowABrush}" />
      <!-- At 48% and 38% of the screen, placed as the screen resizes. -->
      <Ellipse
        x:Name="GlowC"
        Width="760"
        Height="420"
        Fill="{StaticResource HaloSignInGlowCBrush}" />
    </Canvas>
  </Grid>
</UserControl>
