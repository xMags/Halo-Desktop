namespace HaloDesktop
{
    runtimeclass HomeViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String HeroTitle { get; };
        String HeroSynopsis { get; };
        String HeroRating { get; };
        String HeroMeta { get; };
        Object ContinueItems { get; };
        Object Shelves { get; };
        Int32 FilterIndex { get; };
        void SetFilter(Int32 index);
        void OpenDetail();
        void OpenPlayer();
        void OpenSearch(String query);
    }

    [default_interface]
    runtimeclass HomePage : Microsoft.UI.Xaml.Controls.Page
    {
        HomePage();
        HomeViewModel ViewModel { get; };
    }
}
