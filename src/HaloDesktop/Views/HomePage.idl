namespace HaloDesktop
{
    runtimeclass HomeViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Object FeaturedItems { get; };
        Int32 FeaturedCount { get; };
        Int32 FeaturedIndex;
        Microsoft.UI.Xaml.Visibility FeaturedVisibility { get; };
        Microsoft.UI.Xaml.Visibility RefreshErrorVisibility { get; };
        String ContinueCountLabel { get; };
        Object ContinueItems { get; };
        Object Shelves { get; };
        Int32 FilterIndex { get; };
        Microsoft.UI.Xaml.Visibility ContentVisibility { get; };
        Microsoft.UI.Xaml.Visibility LoadingVisibility { get; };
        Microsoft.UI.Xaml.Visibility ErrorVisibility { get; };
        Microsoft.UI.Xaml.Visibility EmptyVisibility { get; };
        void SetFilter(Int32 index);
        void Retry();
        void EnsureLoaded();
        void OpenDetail(Object item);
        void OpenFeaturedDetail(Object item);
        void OpenFeaturedSources(Object item);
        void ToggleFeaturedLibrary(Object item);
        void PauseFeatured();
        void ResumeFeatured();
        void Deactivate();
        void OpenContinue(Object item);
        void OpenSearch(String query);
        void OpenCatalog(Object shelf);
        void OpenContinueCatalog();
        Double HeroHeight { get; };
        Double HeroTitleSize { get; };
        Microsoft.UI.Xaml.Thickness ContentPadding { get; };
    }

    [default_interface]
    runtimeclass HomePage : Microsoft.UI.Xaml.Controls.Page
    {
        HomePage();
        HomeViewModel ViewModel { get; };
    }
}
