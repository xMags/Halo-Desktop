<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <local:SectionHeader Title="Settings" Crumb="ACCOUNT &amp; PLAYBACK" />
    <Grid Grid.Row="1" Margin="24,4,24,32" ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <Button Style="{StaticResource HaloRailButtonStyle}" Click="OnAddonsRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Addons" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Catalogs, streams, subtitles" /></StackPanel></Button>
        <Button Style="{StaticResource HaloRailButtonStyle}" Click="OnPlaybackRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Playback" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Decoding, autoplay, resume" /></StackPanel></Button>
        <Button Style="{StaticResource HaloRailButtonStyle}" Click="OnSubtitlesRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Subtitles" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Size, font, appearance" /></StackPanel></Button>
        <Button Style="{StaticResource HaloRailButtonStyle}" Click="OnAccountRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Server &amp; account" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Sync, identity, version" /></StackPanel></Button>
        <Border Margin="0,18,0,0" Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="7"><StackPanel Orientation="Horizontal" Spacing="8"><Image Width="20" Height="20" Source="ms-appx:///Assets/halo-mark.png" /><TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="Halo Desktop" /></StackPanel><TextBlock Style="{StaticResource HaloMonoData}" Text="v0.1.0 · WinUI 3" /><TextBlock Style="{StaticResource HaloMonoData}" Text="mpv 0.40 · WinAppSDK 2.4" /><Button Padding="0,4" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource HaloAccentBrush}" Content="Check for updates" ToolTipService.ToolTip="Update checks are not available in this prototype" /></StackPanel>
        </Border>
      </StackPanel>

      <ScrollViewer x:Name="SettingsScroller" Grid.Column="1" VerticalScrollBarVisibility="Hidden">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Padding="0,0,8,48" Spacing="36">
          <StackPanel x:Name="AddonsSection" Spacing="14">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Addons" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Catalogs, streams and subtitles come from these. Order sets priority." /></StackPanel>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="AddonUrlBox" Height="32" PlaceholderText="https://addon.example.com/manifest.json" /><Button Grid.Column="1" Height="32" Padding="18,0" Click="OnAddAddonClick" Content="Add" FontSize="13" Style="{StaticResource HaloAccentButtonStyle}" /></Grid>
            <InfoBar x:Name="AddonNotice" IsOpen="True" Severity="Informational" Title="Addon" Message="{x:Bind ViewModel.AddonNoticeText, Mode=OneWay}" Visibility="{x:Bind ViewModel.AddonNoticeVisibility, Mode=OneWay}" />
            <!-- One card with hairline dividers between rows, as in the design. -->
            <Border Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <ItemsControl x:Name="AddonList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:AddonRowViewModel">
                    <Border Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1">
                      <Grid ColumnSpacing="13"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource HaloText4Brush}" Glyph="&#xE76F;" ToolTipService.ToolTip="Reordering is not available in this prototype" /><Border Grid.Column="1" Width="34" Height="34" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="11" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Initials}" /></Border><StackPanel Grid.Column="2" Spacing="3"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind Version}" /><Border Padding="7,2" VerticalAlignment="Center" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3" Visibility="{x:Bind GlobalVisibility}"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" Foreground="{ThemeResource HaloText3Brush}" Text="GLOBAL" /></Border><Border Padding="7,2" VerticalAlignment="Center" Background="{ThemeResource HaloAccentTintBrush}" CornerRadius="3" Visibility="{x:Bind YoursVisibility}"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" Foreground="{ThemeResource HaloAccentBrush}" Text="YOURS" /></Border></StackPanel><TextBlock Foreground="{ThemeResource HaloText3Brush}" FontSize="12" Text="{x:Bind Provides}" /></StackPanel><ToggleSwitch Grid.Column="3" VerticalAlignment="Center" IsOn="{x:Bind Enabled}" Style="{StaticResource HaloToggleSwitchStyle}" Tag="{x:Bind Name}" Toggled="OnAddonToggled" /><Button Grid.Column="4" Width="28" Height="28" MinWidth="0" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Remove addon" Click="OnDeleteAddonClick" CornerRadius="4" Tag="{x:Bind Name}" ToolTipService.ToolTip="Remove addon"><FontIcon FontSize="12" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE74D;" /></Button></Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PlaybackSection" Spacing="10">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Playback" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Applied to every stream mpv opens. Changes take effect on the next file." /></StackPanel>
            <Border Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <local:SettingRow Label="Default audio language" Hint="Picked when the file offers a match"><local:SettingRow.SettingContent><ComboBox Width="148" Height="30" SelectedIndex="0" FontSize="13"><ComboBoxItem Content="English" /><ComboBoxItem Content="Japanese" /><ComboBoxItem Content="Original" /></ComboBox></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Default subtitles" Hint="Falls back to the addon results"><local:SettingRow.SettingContent><ComboBox Width="148" Height="30" SelectedIndex="0" FontSize="13"><ComboBoxItem Content="English" /><ComboBoxItem Content="Off" /><ComboBoxItem Content="Auto" /></ComboBox></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Autoplay next episode" Hint="8 second countdown, cancellable"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.AutoplayNext, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Resume where I left off" Hint="Ignored under 30 seconds watched"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.ResumePlayback, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Hardware decoding" Hint="mpv hwdec=d3d11va-copy"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.HardwareDecoding, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /></local:SettingRow.SettingContent></local:SettingRow>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="SubtitlesSection" Spacing="12">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Subtitles" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Appearance applies live during playback." /></StackPanel>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
              <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Text="Size" />
                    <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="50" Maximum="200" Value="{x:Bind ViewModel.SubtitleSize, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" FontSize="11" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.SubtitleSizeLabel, Mode=OneWay}" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="92,-4,44,0"><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="9.5" Foreground="{ThemeResource HaloText4Brush}" Text="50" /><TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" FontSize="9.5" Foreground="{ThemeResource HaloText4Brush}" Text="100" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="9.5" Foreground="{ThemeResource HaloText4Brush}" Text="200" /></Grid>
                  <Grid Margin="0,16,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Text="Font" />
                    <Border Grid.Column="1" Style="{StaticResource HaloSegmentedTrayStyle}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SubtitleFont" IsChecked="True" Click="OnSystemFontClick" Content="System" FontSize="12.5" Padding="14,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleFont" Click="OnSerifFontClick" Content="Serif" FontSize="12.5" Padding="14,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleFont" Click="OnMonoFontClick" Content="Mono" FontSize="12.5" Padding="14,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid Margin="0,10,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Text="Outline" />
                    <Border Grid.Column="1" Style="{StaticResource HaloSegmentedTrayStyle}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SubtitleOutline" Click="OnNoOutlineClick" Content="None" FontSize="12.5" Padding="14,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleOutline" IsChecked="True" Click="OnThinOutlineClick" Content="Thin" FontSize="12.5" Padding="14,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleOutline" Click="OnHeavyOutlineClick" Content="Heavy" FontSize="12.5" Padding="14,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{ThemeResource HaloPhTint2Brush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <Grid><local:PlaceholderArt /><TextBlock Margin="12" VerticalAlignment="Top" Style="{StaticResource HaloMonoKicker}" Text="PREVIEW" /><TextBlock x:Name="ThinPreviewOutline" Margin="2,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="Black" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ThinOutlineVisibility, Mode=OneWay}" /><TextBlock x:Name="HeavyPreviewOutline" Margin="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="Black" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HeavyOutlineVisibility, Mode=OneWay}" /><TextBlock x:Name="SubtitlePreviewText" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" /></Grid>
              </Border>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="AccountSection" Spacing="12">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Server &amp; account" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Library, watch progress and addon order sync through this server." /></StackPanel>
            <Border Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <Grid ColumnSpacing="13"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{ThemeResource HaloAccentBrush}" CornerRadius="20"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource HaloOnAccentBrush}" Text="DB" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UserName, Mode=OneWay}" /><TextBlock Style="{StaticResource HaloMonoData}" Text="ADMIN · LOCAL ACCOUNT" /></StackPanel><Border Grid.Column="2" Padding="11,5" VerticalAlignment="Center" Background="{ThemeResource HaloSuccessTintBrush}" CornerRadius="14"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource HaloSuccessBrush}" /><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9.5" Foreground="{ThemeResource HaloSuccessBrush}" Text="CONNECTED · 12 MS" /></StackPanel></Border></Grid>
            </Border>
            <Border Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1"><TextBlock FontSize="13.5" Text="Server" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.ServerUrl, Mode=OneWay}" /></Grid>
                <Grid Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1"><TextBlock FontSize="13.5" Text="Signed in as" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.SignedInLine, Mode=OneWay}" /></Grid>
                <Grid Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1"><TextBlock FontSize="13.5" Text="Status" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloSuccessBrush}" Text="CONNECTED · 12 MS" /></Grid>
                <Grid Padding="14,13"><TextBlock FontSize="13.5" Text="Version" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloText2Brush}" Text="v0.1.0 · WinAppSDK 2.4" /></Grid>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Height="32" Padding="16,0" Click="OnSwitchServerClick" Content="Switch server" FontSize="13" /><Button Height="32" Padding="16,0" Background="Transparent" BorderBrush="{ThemeResource HaloCriticalBrush}" Click="OnSignOutClick" Content="Sign out" FontSize="13" Foreground="{ThemeResource HaloCriticalBrush}" /></StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
