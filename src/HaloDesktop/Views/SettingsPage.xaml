                    <TextBlock Style="{StaticResource SubtitlePreviewOutlineStyle}" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" Visibility="{x:Bind ViewModel.PreviewOutlineVisibility, Mode=OneWay}"><TextBlock.RenderTransform><TranslateTransform Y="{x:Bind ViewModel.PreviewOutlineOffset, Mode=OneWay}" /></TextBlock.RenderTransform></TextBlock>
                    <TextBlock Style="{StaticResource SubtitlePreviewOutlineStyle}" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" Visibility="{x:Bind ViewModel.PreviewOutlineVisibility, Mode=OneWay}"><TextBlock.RenderTransform><TranslateTransform X="{x:Bind ViewModel.PreviewOutlineOffset, Mode=OneWay}" Y="{x:Bind ViewModel.PreviewOutlineOffset, Mode=OneWay}" /></TextBlock.RenderTransform></TextBlock>
                    <TextBlock x:Name="SubtitlePreviewText" Style="{StaticResource SubtitlePreviewLayerStyle}" Foreground="{StaticResource HaloSubtitleGlyphBrush}" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" />
