            </Border>
            <Border Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1"><TextBlock FontSize="13.5" Text="Server" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.ServerUrl, Mode=OneWay}" /></Grid>
                <Grid Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1"><TextBlock FontSize="13.5" Text="Signed in as" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.SignedInLine, Mode=OneWay}" /></Grid>
                <Grid Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1"><TextBlock FontSize="13.5" Text="Status" /><Grid HorizontalAlignment="Right"><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ViewModel.ServerStatusLine, Mode=OneWay}" Visibility="{x:Bind ViewModel.ServerCheckingVisibility, Mode=OneWay}" /><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloSuccessBrush}" Text="{x:Bind ViewModel.ServerStatusLine, Mode=OneWay}" Visibility="{x:Bind ViewModel.ServerConnectedVisibility, Mode=OneWay}" /><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloCriticalBrush}" Text="{x:Bind ViewModel.ServerStatusLine, Mode=OneWay}" Visibility="{x:Bind ViewModel.ServerUnavailableVisibility, Mode=OneWay}" /></Grid></Grid>
                <Grid Padding="14,13"><TextBlock FontSize="13.5" Text="Version" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="11.5" Foreground="{ThemeResource HaloText2Brush}" Text="v0.1.0 · WinAppSDK 2.4" /></Grid>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Height="32" Padding="16,0" Background="Transparent" BorderBrush="{ThemeResource HaloCriticalBrush}" Click="OnSignOutClick" Content="Sign out" FontSize="13" Foreground="{ThemeResource HaloCriticalBrush}" /></StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
