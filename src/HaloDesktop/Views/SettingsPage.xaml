<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <local:SectionHeader Title="Settings" Crumb="ACCOUNT &amp; PLAYBACK" />
    <Grid Grid.Row="1" Margin="24,4,24,32" ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <Button HorizontalContentAlignment="Left" Click="OnAddonsRailClick"><StackPanel><TextBlock FontWeight="SemiBold" Text="Addons" /><TextBlock Style="{StaticResource HaloCaption12}" Text="Catalogs, streams, subtitles" /></StackPanel></Button>
        <Button HorizontalContentAlignment="Left" Click="OnPlaybackRailClick"><StackPanel><TextBlock FontWeight="SemiBold" Text="Playback" /><TextBlock Style="{StaticResource HaloCaption12}" Text="Decoding, autoplay, resume" /></StackPanel></Button>
        <Button HorizontalContentAlignment="Left" Click="OnSubtitlesRailClick"><StackPanel><TextBlock FontWeight="SemiBold" Text="Subtitles" /><TextBlock Style="{StaticResource HaloCaption12}" Text="Size, font, appearance" /></StackPanel></Button>
        <Button HorizontalContentAlignment="Left" Click="OnAccountRailClick"><StackPanel><TextBlock FontWeight="SemiBold" Text="Server &amp; account" /><TextBlock Style="{StaticResource HaloCaption12}" Text="Sync, identity, version" /></StackPanel></Button>
        <Border Margin="0,20,0,0" Padding="12" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="7"><StackPanel Orientation="Horizontal" Spacing="8"><Image Width="20" Height="20" Source="ms-appx:///Assets/halo-mark.png" /><TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="Halo Desktop" /></StackPanel><TextBlock Style="{StaticResource HaloMonoData}" Text="v0.1.0 · WinUI 3" /><TextBlock Style="{StaticResource HaloMonoData}" Text="WinAppSDK 2.4 · mpv 0.40" /><Button Padding="0,4" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource HaloAccentBrush}" Content="Check for updates" ToolTipService.ToolTip="Update checks are not available in this prototype" /></StackPanel>
        </Border>
      </StackPanel>

      <ScrollViewer x:Name="SettingsScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Padding="0,0,8,48" Spacing="36">
          <StackPanel x:Name="AddonsSection" Spacing="14">
            <StackPanel><TextBlock Style="{StaticResource HaloPageTitle}" Text="Addons" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Catalogs, streams and subtitles come from these. Order sets priority." /></StackPanel>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="AddonUrlBox" PlaceholderText="https://addon.example.com/manifest.json" /><Button Grid.Column="1" Click="OnAddAddonClick" Content="Add" Style="{StaticResource HaloAccentButtonStyle}" /></Grid>
            <InfoBar x:Name="AddonNotice" IsOpen="True" Severity="Informational" Title="Addon" Message="{x:Bind ViewModel.AddonNoticeText, Mode=OneWay}" Visibility="{x:Bind ViewModel.AddonNoticeVisibility, Mode=OneWay}" />
            <ItemsControl x:Name="AddonList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AddonRowViewModel">
                  <Border Margin="0,0,0,6" Padding="10" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{ThemeResource HaloText4Brush}" Text="&#xE700;" /><Border Grid.Column="1" Width="34" Height="34" Background="{ThemeResource HaloAccentTintBrush}" CornerRadius="5"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoBoldFont}" Foreground="{ThemeResource HaloAccentBrush}" Text="{x:Bind Initials}" /></Border><StackPanel Grid.Column="2" Spacing="3"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind Version}" /><Border Padding="5,2" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3" Visibility="{x:Bind GlobalVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Text="GLOBAL" /></Border><Border Padding="5,2" Background="{ThemeResource HaloAccentTintBrush}" CornerRadius="3" Visibility="{x:Bind YoursVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloAccentBrush}" Text="YOURS" /></Border></StackPanel><TextBlock Foreground="{ThemeResource HaloText3Brush}" FontSize="12" Text="{x:Bind Provides}" /></StackPanel><ToggleSwitch Grid.Column="3" VerticalAlignment="Center" IsOn="{x:Bind Enabled}" Tag="{x:Bind Name}" Toggled="OnAddonToggled" /><Button Grid.Column="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="OnDeleteAddonClick" Content="&#xE74D;" Tag="{x:Bind Name}" /></Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel x:Name="PlaybackSection" Spacing="10">
            <StackPanel><TextBlock Style="{StaticResource HaloPageTitle}" Text="Playback" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Applied to every stream mpv opens. Changes take effect on the next file." /></StackPanel>
            <Border Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <local:SettingRow Label="Default audio language" Hint="Picked when the file offers a match"><local:SettingRow.SettingContent><ComboBox Width="148" SelectedIndex="0"><ComboBoxItem Content="English" /><ComboBoxItem Content="Japanese" /><ComboBoxItem Content="Original" /></ComboBox></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Default subtitles" Hint="Falls back to the addon results"><local:SettingRow.SettingContent><ComboBox Width="148" SelectedIndex="0"><ComboBoxItem Content="English" /><ComboBoxItem Content="Off" /><ComboBoxItem Content="Auto" /></ComboBox></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Autoplay next episode" Hint="8 second countdown, cancellable"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.AutoplayNext, Mode=TwoWay}" /></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Resume where I left off" Hint="Ignored under 30 seconds watched"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.ResumePlayback, Mode=TwoWay}" /></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Hardware decoding" Hint="mpv hwdec=d3d11va-copy"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.HardwareDecoding, Mode=TwoWay}" /></local:SettingRow.SettingContent></local:SettingRow>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="SubtitlesSection" Spacing="12">
            <StackPanel><TextBlock Style="{StaticResource HaloPageTitle}" Text="Subtitles" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Appearance applies live during playback." /></StackPanel>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
              <Border Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="14"><Grid><TextBlock Text="Size" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.SubtitleSizeLabel, Mode=OneWay}" /></Grid><Slider Minimum="50" Maximum="200" Value="{x:Bind ViewModel.SubtitleSize, Mode=TwoWay}" /><Grid><TextBlock Style="{StaticResource HaloMonoData}" Text="50" /><TextBlock HorizontalAlignment="Center" Style="{StaticResource HaloMonoData}" Text="100" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="200" /></Grid><TextBlock Text="Font" /><StackPanel Orientation="Horizontal" Spacing="6"><RadioButton GroupName="SubtitleFont" IsChecked="True" Click="OnSystemFontClick" Content="System" /><RadioButton GroupName="SubtitleFont" Click="OnSerifFontClick" Content="Serif" /><RadioButton GroupName="SubtitleFont" Click="OnMonoFontClick" Content="Mono" /></StackPanel><TextBlock Text="Outline" /><StackPanel Orientation="Horizontal" Spacing="6"><RadioButton GroupName="SubtitleOutline" Click="OnNoOutlineClick" Content="None" /><RadioButton GroupName="SubtitleOutline" IsChecked="True" Click="OnThinOutlineClick" Content="Thin" /><RadioButton GroupName="SubtitleOutline" Click="OnHeavyOutlineClick" Content="Heavy" /></StackPanel></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{ThemeResource HaloPhTint2Brush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <Grid><local:PlaceholderArt /><TextBlock Margin="12" VerticalAlignment="Top" Style="{StaticResource HaloMonoKicker}" Text="PREVIEW" /><TextBlock x:Name="ThinPreviewOutline" Margin="2,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="Black" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ThinOutlineVisibility, Mode=OneWay}" /><TextBlock x:Name="HeavyPreviewOutline" Margin="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="Black" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HeavyOutlineVisibility, Mode=OneWay}" /><TextBlock x:Name="SubtitlePreviewText" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" /></Grid>
              </Border>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="AccountSection" Spacing="12">
            <StackPanel><TextBlock Style="{StaticResource HaloPageTitle}" Text="Server &amp; account" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Library, watch progress and addon order sync through this server." /></StackPanel>
            <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="{ThemeResource HaloAccentBrush}" CornerRadius="20"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource HaloOnAccentBrush}" Text="DB" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.UserName, Mode=OneWay}" /><TextBlock Style="{StaticResource HaloMonoData}" Text="ADMIN · LOCAL ACCOUNT" /></StackPanel><Border Grid.Column="2" Padding="8,4" VerticalAlignment="Center" Background="{ThemeResource HaloSuccessTintBrush}" CornerRadius="4"><TextBlock Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloSuccessBrush}" Text="● CONNECTED · 12 MS" /></Border></Grid>
            </Border>
            <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="10"><Grid><TextBlock Text="Server" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.ServerUrl, Mode=OneWay}" /></Grid><Grid><TextBlock Text="Signed in as" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.SignedInLine, Mode=OneWay}" /></Grid><Grid><TextBlock Text="Status" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloSuccessBrush}" Text="CONNECTED · 12 MS" /></Grid><Grid><TextBlock Text="Version" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="v0.1.0 · WinAppSDK 2.4" /></Grid></StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="OnSwitchServerClick" Content="Switch server" /><Button BorderBrush="{ThemeResource HaloCriticalBrush}" Click="OnSignOutClick" Foreground="{ThemeResource HaloCriticalBrush}" Content="Sign out" /></StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
