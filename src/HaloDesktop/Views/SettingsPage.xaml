          </StackPanel>

          <StackPanel x:Name="AccountSection" Spacing="12">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Server &amp; account" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Library, watch progress and addon order sync through this server." /></StackPanel>
            <Border Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <Grid ColumnSpacing="13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20"><Image Source="ms-appx:///Assets/user-avatar.png" Stretch="UniformToFill" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" /><TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.AccountRoleLine, Mode=OneWay}" /></StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                  <Border Padding="11,5" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="14" Visibility="{x:Bind ViewModel.ServerCheckingVisibility, Mode=OneWay}"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ViewModel.ServerStatusLine, Mode=OneWay}" /></Border>
