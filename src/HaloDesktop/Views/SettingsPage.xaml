<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:HaloDesktop"
  Loaded="OnLoaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:SectionHeader Title="Settings" Crumb="ACCOUNT &amp; PLAYBACK" />
    <Border
      Grid.Row="1"
      Width="520"
      Margin="24"
      Padding="20"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Background="{ThemeResource HaloCardBrush}"
      BorderBrush="{ThemeResource HaloCardStrokeBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <StackPanel Spacing="12">
        <TextBlock Text="SERVER &amp; ACCOUNT" Style="{StaticResource HaloMonoKicker}" />
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.UserName, Mode=OneWay}" />
        <TextBlock Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.ServerUrl, Mode=OneWay}" />
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
          <Button Click="OnSwitchServerClick" Content="Switch server" />
          <Button
            BorderBrush="{ThemeResource HaloCriticalBrush}"
            Click="OnSignOutClick"
            Foreground="{ThemeResource HaloCriticalBrush}"
            Content="Sign out" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>
