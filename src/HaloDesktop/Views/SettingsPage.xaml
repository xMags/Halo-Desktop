<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  NavigationCacheMode="Required">
  <!-- Capped and centred so the form does not strand itself against the left edge
       of a maximised window; the header travels with it. -->
  <Page.Resources>
    <!--
      The subtitle preview draws the same caption several times in one layout slot: a
      shadow copy, eight border copies ringing the glyphs, and the caption itself on
      top. Only the offsets differ, so the shared text properties live here.
    -->
    <Style x:Key="SubtitlePreviewLayerStyle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="SubtitlePreviewOutlineStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitlePreviewLayerStyle}">
      <Setter Property="Foreground" Value="{StaticResource HaloSubtitleOutlineBrush}" />
    </Style>
  </Page.Resources>
  <Grid x:Name="PageRoot" MaxWidth="1000" HorizontalAlignment="Center">
    <!--
      The form is capped so line length stays readable, but the cap, the rail and the
      spacing all grow with the window rather than holding one narrow column on a large
      screen. Widths are effective pixels, so they track display scaling too.
    -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="SettingsRegular" />
        <VisualState x:Name="SettingsWide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1500" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageRoot.MaxWidth" Value="1240" />
            <Setter Target="RailColumn.Width" Value="240" />
            <Setter Target="SettingsBody.ColumnSpacing" Value="36" />
            <Setter Target="SettingsForm.MaxWidth" Value="840" />
            <Setter Target="SettingsForm.Spacing" Value="44" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="SettingsExpansive">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1900" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageRoot.MaxWidth" Value="1460" />
            <Setter Target="RailColumn.Width" Value="260" />
            <Setter Target="SettingsBody.ColumnSpacing" Value="44" />
            <Setter Target="SettingsForm.MaxWidth" Value="1000" />
            <Setter Target="SettingsForm.Spacing" Value="52" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <!--
        Which rail entry is lit follows the scroll position, so the states only carry
        the lit treatment: leaving a state reverts its setters, which is what keeps
        exactly one entry marked without the page having to clear the previous one.
      -->
      <VisualStateGroup x:Name="RailSelection">
        <VisualState x:Name="RailAppearance">
          <VisualState.Setters>
            <Setter Target="AppearanceRail.Background" Value="{ThemeResource HaloNavSelBrush}" />
            <Setter Target="AppearanceRail.Foreground" Value="{ThemeResource HaloAccentBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="RailAddons">
          <VisualState.Setters>
            <Setter Target="AddonsRail.Background" Value="{ThemeResource HaloNavSelBrush}" />
            <Setter Target="AddonsRail.Foreground" Value="{ThemeResource HaloAccentBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="RailPlayback">
          <VisualState.Setters>
            <Setter Target="PlaybackRail.Background" Value="{ThemeResource HaloNavSelBrush}" />
            <Setter Target="PlaybackRail.Foreground" Value="{ThemeResource HaloAccentBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="RailSubtitles">
          <VisualState.Setters>
            <Setter Target="SubtitlesRail.Background" Value="{ThemeResource HaloNavSelBrush}" />
            <Setter Target="SubtitlesRail.Foreground" Value="{ThemeResource HaloAccentBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="RailAccount">
          <VisualState.Setters>
            <Setter Target="AccountRail.Background" Value="{ThemeResource HaloNavSelBrush}" />
            <Setter Target="AccountRail.Foreground" Value="{ThemeResource HaloAccentBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <local:SectionHeader Title="Settings" />
    <Grid x:Name="SettingsBody" Grid.Row="1" Margin="24,4,24,32" ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <Button x:Name="AppearanceRail" Style="{StaticResource HaloRailButtonStyle}" Click="OnAppearanceRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Appearance" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Theme" /></StackPanel></Button>
        <Button x:Name="AddonsRail" Style="{StaticResource HaloRailButtonStyle}" Click="OnAddonsRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Addons" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Catalogs, streams, subtitles" /></StackPanel></Button>
        <Button x:Name="PlaybackRail" Style="{StaticResource HaloRailButtonStyle}" Click="OnPlaybackRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Playback" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Decoding, autoplay, resume" /></StackPanel></Button>
        <Button x:Name="SubtitlesRail" Style="{StaticResource HaloRailButtonStyle}" Click="OnSubtitlesRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Subtitles" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Size, font, appearance" /></StackPanel></Button>
        <Button x:Name="AccountRail" Style="{StaticResource HaloRailButtonStyle}" Click="OnAccountRailClick"><StackPanel Spacing="2"><TextBlock FontSize="13.5" Text="Server &amp; account" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="Sync, identity, version" /></StackPanel></Button>
        <Border Margin="0,18,0,0" Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="8"><Image Width="20" Height="20" Source="ms-appx:///Assets/halo-mark.png" /><TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="Halo Desktop" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloMonoData}" Text="v0.1.0 · WinUI 3" /><TextBlock Style="{StaticResource HaloMonoData}" Text="mpv 0.40 · WinAppSDK 2.4" /></StackPanel>
            <Button Padding="0,4" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="OnCheckForUpdatesClick" Foreground="{ThemeResource HaloAccentBrush}" Content="Check for updates" ToolTipService.ToolTip="Opens the releases page on GitHub" />
            <!-- The card pads by 14, so the hairline pulls back out to sit edge to edge. -->
            <Rectangle Height="1" Margin="-14,0" Fill="{ThemeResource HaloDividerBrush}" />
            <!--
              Fine print sits a step below the version data: same mono face, one size
              smaller, so the card reads name, then build, then notice. It stays on the
              readable end of the text ramp rather than the dimmest one, because a
              notice nobody can read is not a notice. The holder and the license wording
              track LICENSE and licenses/TERMS.txt.
            -->
            <StackPanel Spacing="3">
              <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText3Brush}" Text="© 2026 Last Projects" />
              <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText3Brush}" Text="Source-available license" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <ScrollViewer x:Name="SettingsScroller" Grid.Column="1" VerticalScrollBarVisibility="Hidden" ViewChanged="OnFormViewChanged">
        <StackPanel x:Name="SettingsForm" MaxWidth="680" HorizontalAlignment="Left" Padding="0,0,8,48" Spacing="36" SizeChanged="OnFormSizeChanged">
          <StackPanel x:Name="AppearanceSection" Spacing="14">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Appearance" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Choose how Halo looks. System follows your Windows setting." /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <RadioButton GroupName="AppTheme" AutomationProperties.Name="Light theme" Click="OnLightThemeClick" IsChecked="{x:Bind ViewModel.IsLightTheme, Mode=OneWay}" Style="{StaticResource HaloThemeCardRadioStyle}">
                <StackPanel Spacing="9">
                  <Border Width="132" Height="80" Background="#FFFFFFFF" BorderBrush="#22000000" BorderThickness="1" CornerRadius="6">
                        <Grid Padding="8" ColumnSpacing="8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                          <Rectangle Fill="#FFE6E6EA" RadiusX="3" RadiusY="3" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                            <Rectangle Height="5" Fill="#FFC8C8CE" RadiusX="2" RadiusY="2" />
                            <Rectangle Height="5" Width="46" HorizontalAlignment="Left" Fill="#FFC8C8CE" RadiusX="2" RadiusY="2" />
                            <Rectangle Height="5" Width="34" HorizontalAlignment="Left" Fill="#FF005FB8" RadiusX="2" RadiusY="2" />
                          </StackPanel>
                        </Grid>
                      </Border>
                  <TextBlock HorizontalAlignment="Center" FontSize="13" Text="Light" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="AppTheme" AutomationProperties.Name="Dark theme" Click="OnDarkThemeClick" IsChecked="{x:Bind ViewModel.IsDarkTheme, Mode=OneWay}" Style="{StaticResource HaloThemeCardRadioStyle}">
                <StackPanel Spacing="9">
                  <Border Width="132" Height="80" Background="#FF202024" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6">
                        <Grid Padding="8" ColumnSpacing="8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                          <Rectangle Fill="#FF313138" RadiusX="3" RadiusY="3" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                            <Rectangle Height="5" Fill="#FF54545C" RadiusX="2" RadiusY="2" />
                            <Rectangle Height="5" Width="46" HorizontalAlignment="Left" Fill="#FF54545C" RadiusX="2" RadiusY="2" />
                            <Rectangle Height="5" Width="34" HorizontalAlignment="Left" Fill="#FF60CDFF" RadiusX="2" RadiusY="2" />
                          </StackPanel>
                        </Grid>
                      </Border>
                  <TextBlock HorizontalAlignment="Center" FontSize="13" Text="Dark" />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="AppTheme" AutomationProperties.Name="Follow system theme" Click="OnSystemThemeClick" IsChecked="{x:Bind ViewModel.IsSystemTheme, Mode=OneWay}" Style="{StaticResource HaloThemeCardRadioStyle}">
                <StackPanel Spacing="9">
                  <!-- Split down the middle so the card reads as "either one". -->
                  <Grid Width="132" Height="80">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="#FF202024" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" />
                    <Border Background="#FFFFFFFF" CornerRadius="6,0,0,6" />
                    <Grid Grid.ColumnSpan="2" Padding="8" ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Rectangle Fill="#FFE6E6EA" RadiusX="3" RadiusY="3" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                        <Rectangle Height="5" Fill="#FF54545C" RadiusX="2" RadiusY="2" />
                        <Rectangle Height="5" Width="46" HorizontalAlignment="Left" Fill="#FF54545C" RadiusX="2" RadiusY="2" />
                        <Rectangle Height="5" Width="34" HorizontalAlignment="Left" Fill="#FF60CDFF" RadiusX="2" RadiusY="2" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                  <TextBlock HorizontalAlignment="Center" FontSize="13" Text="System" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="AddonsSection" Spacing="14">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Addons" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Catalogs, streams and subtitles come from these. Order sets priority." /></StackPanel>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="AddonUrlBox" Height="32" PlaceholderText="https://addon.example.com/manifest.json" /><Button Grid.Column="1" Height="32" Padding="18,0" Click="OnAddAddonClick" Content="Add" FontSize="13" IsEnabled="{x:Bind ViewModel.CanEditAddons, Mode=OneWay}" Style="{StaticResource HaloAccentButtonStyle}" /></Grid>
            <InfoBar x:Name="AddonNotice" IsOpen="True" Severity="Informational" Title="Addon" Message="{x:Bind ViewModel.AddonNoticeText, Mode=OneWay}" Visibility="{x:Bind ViewModel.AddonNoticeVisibility, Mode=OneWay}" />
            <StackPanel HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.AddonLoadingVisibility, Mode=OneWay}"><ProgressRing IsActive="True" /><TextBlock Text="Refreshing addons…" /></StackPanel>
            <StackPanel HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.AddonErrorVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource HaloCriticalBrush}" Text="Addons could not be refreshed." /><Button Click="OnRetrySettingsClick" Content="Retry" /></StackPanel>
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource HaloText3Brush}" Text="No addons are installed for this account." Visibility="{x:Bind ViewModel.AddonEmptyVisibility, Mode=OneWay}" />
            <!-- One card with hairline dividers between rows, as in the design. -->
            <Border Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.AddonContentVisibility, Mode=OneWay}">
              <ItemsControl x:Name="AddonList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:AddonRowViewModel">
                    <Border Padding="14,13" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,0,0,1">
                      <Grid ColumnSpacing="13"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource HaloText4Brush}" Glyph="&#xE76F;" ToolTipService.ToolTip="Addon order is managed by the server list" /><Border Grid.Column="1" Width="34" Height="34" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="11" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Initials}" /></Border><StackPanel Grid.Column="2" Spacing="3"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind Version}" /><Border Padding="7,2" VerticalAlignment="Center" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3" Visibility="{x:Bind GlobalVisibility}"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" Foreground="{ThemeResource HaloText3Brush}" Text="GLOBAL" /></Border><Border Padding="7,2" VerticalAlignment="Center" Background="{ThemeResource HaloAccentTintBrush}" CornerRadius="3" Visibility="{x:Bind YoursVisibility}"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" Foreground="{ThemeResource HaloAccentBrush}" Text="YOURS" /></Border></StackPanel><TextBlock Foreground="{ThemeResource HaloText3Brush}" FontSize="12" Text="{x:Bind Provides}" /></StackPanel><ToggleSwitch Grid.Column="3" VerticalAlignment="Center" IsEnabled="{x:Bind CanEdit}" IsOn="{x:Bind Enabled}" Style="{StaticResource HaloToggleSwitchStyle}" Tag="{x:Bind Id}" Toggled="OnAddonToggled" /><Button Grid.Column="4" Width="28" Height="28" MinWidth="0" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Remove addon" Click="OnDeleteAddonClick" CornerRadius="4" IsEnabled="{x:Bind CanEdit}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Remove addon"><FontIcon FontSize="12" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE74D;" /></Button></Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PlaybackSection" Spacing="10">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Playback" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Applied to every stream mpv opens. Changes take effect on the next file." /></StackPanel>
            <Border Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <local:SettingRow Label="Default audio language" Hint="Picked when the file offers a match"><local:SettingRow.SettingContent><ComboBox Width="148" Height="30" SelectedIndex="{x:Bind ViewModel.AudioLanguageIndex, Mode=TwoWay}" FontSize="13"><ComboBoxItem Content="English" /><ComboBoxItem Content="Japanese" /><ComboBoxItem Content="German" /><ComboBoxItem Content="Spanish" /><ComboBoxItem Content="Original" /></ComboBox></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Default subtitles" Hint="Falls back to addon results"><local:SettingRow.SettingContent><ComboBox Width="148" Height="30" SelectedIndex="{x:Bind ViewModel.SubtitleLanguageIndex, Mode=TwoWay}" FontSize="13"><ComboBoxItem Content="Off" /><ComboBoxItem Content="English" /><ComboBoxItem Content="Japanese" /><ComboBoxItem Content="German" /><ComboBoxItem Content="Spanish" /></ComboBox></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Autoplay next episode" Hint="8 second countdown, cancellable"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.AutoplayNext, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Resume where I left off" Hint="Ignored under 30 seconds watched"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.ResumePlayback, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /></local:SettingRow.SettingContent></local:SettingRow>
                <Rectangle Height="1" Fill="{ThemeResource HaloDividerBrush}" />
                <local:SettingRow Label="Hardware decoding" Hint="mpv hwdec=d3d11va-copy"><local:SettingRow.SettingContent><ToggleSwitch IsOn="{x:Bind ViewModel.HardwareDecoding, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /></local:SettingRow.SettingContent></local:SettingRow>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="SubtitlesSection" Spacing="12">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource HaloSectionTitle}" Text="Subtitles" /><TextBlock Style="{StaticResource HaloBodySmall}" Text="Appearance applies live during playback." /></StackPanel>
            <!-- Height comes from the controls rather than a fixed number, so a row added to the
                 card cannot push its last control out of sight. The preview stretches to match. -->
            <Grid MinHeight="220" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
              <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Text="Size" />
                    <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="50" Maximum="200" Value="{x:Bind ViewModel.SubtitleSize, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" FontSize="11" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.SubtitleSizeLabel, Mode=OneWay}" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="92,-4,44,0"><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="9.5" Foreground="{ThemeResource HaloText4Brush}" Text="50" /><TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" FontSize="9.5" Foreground="{ThemeResource HaloText4Brush}" Text="100" /><TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource HaloMonoFont}" FontSize="9.5" Foreground="{ThemeResource HaloText4Brush}" Text="200" /></Grid>
                  <Grid Margin="0,16,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Text="Font" />
                    <Border Grid.Column="1" Style="{StaticResource HaloSegmentedTrayStyle}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SubtitleFont" IsChecked="{x:Bind ViewModel.IsDefaultFont, Mode=OneWay}" Click="OnDefaultFontClick" Content="Default" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" ToolTipService.ToolTip="Leaves the face to the player" />
                        <RadioButton GroupName="SubtitleFont" IsChecked="{x:Bind ViewModel.IsSystemFont, Mode=OneWay}" Click="OnSystemFontClick" Content="System" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleFont" IsChecked="{x:Bind ViewModel.IsSerifFont, Mode=OneWay}" Click="OnSerifFontClick" Content="Serif" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleFont" IsChecked="{x:Bind ViewModel.IsMonoFont, Mode=OneWay}" Click="OnMonoFontClick" Content="Mono" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid Margin="0,10,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Text="Outline" />
                    <Border Grid.Column="1" Style="{StaticResource HaloSegmentedTrayStyle}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SubtitleOutline" IsChecked="{x:Bind ViewModel.IsNoOutline, Mode=OneWay}" Click="OnNoOutlineClick" Content="None" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleOutline" IsChecked="{x:Bind ViewModel.IsThinOutline, Mode=OneWay}" Click="OnThinOutlineClick" Content="Thin" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleOutline" IsChecked="{x:Bind ViewModel.IsNormalOutline, Mode=OneWay}" Click="OnNormalOutlineClick" Content="Normal" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                        <RadioButton GroupName="SubtitleOutline" IsChecked="{x:Bind ViewModel.IsThickOutline, Mode=OneWay}" Click="OnHeavyOutlineClick" Content="Thick" FontSize="12.5" Padding="12,4" Style="{StaticResource HaloSegmentedRadioStyle}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid Margin="0,10,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="13.5" Text="Shadow" /><ToggleSwitch Grid.Column="1" HorizontalAlignment="Left" IsOn="{x:Bind ViewModel.SubtitleShadow, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /></Grid>
                  <!--
                    The size and font choices above always reach a plain text track. This
                    row decides whether they also override a track that ships its own
                    styling, which is the only case where the two can disagree.
                  -->
                  <Grid Margin="0,10,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock FontSize="13.5" Text="Track styling" /></StackPanel><StackPanel Grid.Column="1" Spacing="3"><ToggleSwitch HorizontalAlignment="Left" IsOn="{x:Bind ViewModel.SubtitleTrackStyling, Mode=TwoWay}" Style="{StaticResource HaloToggleSwitchStyle}" /><TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText3Brush}" Text="On, a styled track keeps its own look. Off, these settings win." TextWrapping="Wrap" /></StackPanel></Grid>
                </StackPanel>
              </Border>
              <!--
                A stand-in for a video frame rather than a themed surface, because a
                video frame is what subtitles are drawn over. The stripe is the dark
                asset in both themes so the caption keeps the contrast playback gives
                it; the light palette used to leave white text on a near-white panel.
              -->
              <!-- Capped because the stripe asset is 420px tall and would otherwise drive the
                   whole row taller than the card it sits beside. -->
              <Border Grid.Column="1" MaxHeight="300" Background="{StaticResource HaloSubtitleStageBrush}" BorderBrush="{StaticResource HaloSubtitleStageStrokeBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                  <Image Source="ms-appx:///Assets/stripe-dark.png" Stretch="UniformToFill" />
                  <Rectangle Fill="{StaticResource HaloSubtitleStageScrimBrush}" />
                  <TextBlock Margin="12,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{StaticResource HaloSubtitleStageTextBrush}" Style="{StaticResource HaloMonoKicker}" Text="PREVIEW" />
                  <!--
                    The copies share one layout slot so they wrap identically; the
                    offsets come from a render transform, which does not affect layout.
                    Giving them different margins made the caption read as several
                    overlapping strings. The border copies ring the glyphs rather than
                    trailing them, so thickness reads as a border instead of a second
                    ghosted caption, and the shadow copy is the only trailing one.
                  -->
                  <Grid Margin="14,0,14,16" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource SubtitlePreviewLayerStyle}" Foreground="{StaticResource HaloSubtitleShadowBrush}" FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}" FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" Visibility="{x:Bind ViewModel.PreviewShadowVisibility, Mode=OneWay}"><TextBlock.RenderTransform><TranslateTransform X="{x:Bind ViewModel.PreviewShadowOffset, Mode=OneWay}" Y="{x:Bind ViewModel.PreviewShadowOffset, Mode=OneWay}" /></TextBlock.RenderTransform></TextBlock>
