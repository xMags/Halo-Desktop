<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SearchPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <local:SectionHeader Title="Search" Crumb="{x:Bind ViewModel.Crumb, Mode=OneWay}" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="24,8,24,40">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="232" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,28,0" Spacing="20">
          <AutoSuggestBox
            MaxWidth="720"
            HorizontalAlignment="Stretch"
            PlaceholderText="Search movies and series"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            QuerySubmitted="OnQuerySubmitted" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OnAllFilterClick"><TextBlock><Run Text="All " /><Run Text="{x:Bind ViewModel.AllCount, Mode=OneWay}" /></TextBlock></Button>
            <Button Click="OnMoviesFilterClick"><TextBlock><Run Text="Movies " /><Run Text="{x:Bind ViewModel.MovieCount, Mode=OneWay}" /></TextBlock></Button>
            <Button Click="OnSeriesFilterClick"><TextBlock><Run Text="Series " /><Run Text="{x:Bind ViewModel.SeriesCount, Mode=OneWay}" /></TextBlock></Button>
            <Button Click="OnPeopleFilterClick" Content="People 0" />
            <Button Click="OnClearClick" Content="Clear" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource HaloMonoData}" Text="4 ADDONS · 128 MS" />
          </StackPanel>
          <StackPanel Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}" Spacing="24">
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.TopMatchVisibility, Mode=OneWay}">
              <TextBlock Text="TOP MATCH" Style="{StaticResource HaloMonoKicker}" />
              <Button HorizontalContentAlignment="Stretch" Click="OnTopMatchClick" Style="{StaticResource HaloCardButtonStyle}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <local:PlaceholderArt Width="92" Height="138" />
                  <StackPanel Grid.Column="1" Margin="16,2,0,0" Spacing="7">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.TopMatchTitle, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.TopMatchMeta, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource HaloBodySmall}" Text="{x:Bind ViewModel.TopMatchSynopsis, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="6"><Button Style="{StaticResource HaloChipButtonStyle}" Content="IN LIBRARY" /><Button Style="{StaticResource HaloChipButtonStyle}" Content="4 DOWNLOADED" /></StackPanel>
                  </StackPanel>
                </Grid>
              </Button>
            </StackPanel>
            <ItemsControl x:Name="ResultsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SearchGroup">
                  <local:MediaShelf Margin="0,0,0,28" Title="{x:Bind Title}" SourceLabel="{x:Bind SourceLabel}" ItemsSource="{x:Bind Items}" ItemClick="OnShelfItemClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Padding="14" VerticalAlignment="Top" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.RecentVisibility, Mode=OneWay}">
          <StackPanel Spacing="10">
            <TextBlock Text="RECENT" Style="{StaticResource HaloMonoKicker}" />
            <ItemsControl x:Name="RecentList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:RecentSearchViewModel">
                  <Button Padding="6" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="OnRecentClick" Tag="{x:Bind Term}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="12.5" Text="{x:Bind Term}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource HaloMonoData}" Text="{x:Bind Age}" /></Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
