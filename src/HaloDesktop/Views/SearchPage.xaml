<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SearchPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <local:SectionHeader Title="Search" Crumb="{x:Bind ViewModel.Crumb, Mode=OneWay}" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,8,24,40">

        <!-- Search field: accent underline, inline resolve stats and a clear affordance. -->
        <Grid MaxWidth="720" Height="40" HorizontalAlignment="Left" Width="720">
          <Border Background="{ThemeResource HaloCtrlBrush}" BorderBrush="{ThemeResource HaloCtrlStrokeBrush}" BorderThickness="1" CornerRadius="4" />
          <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{ThemeResource HaloAccentBrush}" RadiusX="1" RadiusY="1" />
          <Grid Margin="12,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon VerticalAlignment="Center" FontSize="15" Foreground="{ThemeResource HaloAccentBrush}" Glyph="&#xE721;" />
            <!-- The TextBox supplies its own clear button, so the row adds only the resolve stats. -->
            <TextBox
              x:Name="QueryBox"
              Grid.Column="1"
              Padding="0"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              FontSize="15"
              KeyDown="OnQueryKeyDown"
              PlaceholderText="Search movies and series"
              Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource HaloMonoData}" Text="4 ADDONS · 128 MS" />
          </Grid>
        </Grid>

        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" Spacing="8">
          <RadioButton GroupName="SearchFilter" IsChecked="True" Click="OnAllFilterClick" Content="All" Style="{StaticResource HaloChipRadioStyle}" />
          <RadioButton GroupName="SearchFilter" Click="OnMoviesFilterClick" Content="Movies" Style="{StaticResource HaloChipRadioStyle}" />
          <RadioButton GroupName="SearchFilter" Click="OnSeriesFilterClick" Content="Series" Style="{StaticResource HaloChipRadioStyle}" />
          <RadioButton GroupName="SearchFilter" Click="OnPeopleFilterClick" Content="People" Style="{StaticResource HaloChipRadioStyle}" />
        </StackPanel>

        <Grid Margin="0,22,0,0" ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="232" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.TopMatchVisibility, Mode=OneWay}">
            <TextBlock Text="TOP MATCH" Style="{StaticResource HaloMonoKicker}" />
            <Button HorizontalContentAlignment="Stretch" Click="OnTopMatchClick" Style="{StaticResource HaloCardButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <local:PlaceholderArt Width="92" Height="138" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="16,2,0,0" Spacing="7">
                  <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.TopMatchTitle, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.TopMatchMeta, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource HaloBodySmall}" Text="{x:Bind ViewModel.TopMatchSynopsis, Mode=OneWay}" />
                  <StackPanel Margin="0,5,0,0" Orientation="Horizontal" Spacing="8">
                    <Border Padding="9,3" Background="{ThemeResource HaloAccentTintBrush}" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="10" Foreground="{ThemeResource HaloAccentBrush}" Text="IN LIBRARY" /></Border>
                    <Border Padding="9,3" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="10" Foreground="{ThemeResource HaloText2Brush}" Text="4 DOWNLOADED" /></Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="10" Visibility="{x:Bind ViewModel.RecentVisibility, Mode=OneWay}">
            <TextBlock Text="RECENT" Style="{StaticResource HaloMonoKicker}" />
            <Border Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
              <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:RecentSearchViewModel">
                    <Button Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="OnRecentClick" Tag="{x:Bind Term}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE823;" />
                        <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Term}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" FontSize="9.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind Age}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </Grid>

        <ItemsControl x:Name="ResultsList" Margin="0,26,0,0" Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:SearchGroup">
              <local:MediaShelf Margin="0,0,0,26" Title="{x:Bind Title}" SourceLabel="{x:Bind SourceLabel}" ItemsSource="{x:Bind Items}" ItemClick="OnShelfItemClick" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
