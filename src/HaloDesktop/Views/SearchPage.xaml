<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SearchPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  ContextRequested="OnContextRequested"
  NavigationCacheMode="Required">
  <Page.Resources>
    <!-- A borderless row or pill part: no plate at rest, the subtle wash under the pointer. -->
    <Style x:Key="SearchRowButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- A text link: accent words, no plate. -->
    <Style x:Key="SearchLinkButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{ThemeResource HaloAccentBrush}" />
    </Style>
    <!-- The slot's one primary action: a 38 high pill, semibold. -->
    <Style x:Key="SearchSlotButtonStyle" BasedOn="{StaticResource HaloAccentButtonStyle}" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The "Enter" key hint beside a slot's primary action. -->
    <Style x:Key="SearchKeyHintStyle" TargetType="Border">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="SearchKeyHintTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource HaloMonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
    </Style>
    <!-- A slot's title: Display 24, semibold. -->
    <Style x:Key="SearchSlotTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CharacterSpacing" Value="-10" />
      <Setter Property="LineHeight" Value="29" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A value in a slot's meta row set in mono caps: the kind, a host. -->
    <Style x:Key="SearchSlotMonoStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CharacterSpacing" Value="40" />
      <Setter Property="FontFamily" Value="{StaticResource HaloMonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource HaloFontCaption}" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
    </Style>
    <Style x:Key="SearchSlotMetaStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{StaticResource HaloFontSmall}" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
    </Style>
    <!-- A section's title: sentence case and semibold, no caps. -->
    <Style x:Key="SearchSectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
      <Setter Property="FontSize" Value="{StaticResource HaloFontEmphasis}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
    </Style>
    <!-- An empty or error state's one faint glyph, over its words. -->
    <Style x:Key="SearchEmptyGlyphStyle" TargetType="FontIcon">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="36" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText4Brush}" />
    </Style>
    <!-- An empty or error state's title and sentence. -->
    <Style x:Key="SearchEmptyTitleStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
      <Setter Property="FontSize" Value="{StaticResource HaloFontSubtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SearchEmptyTextStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{StaticResource HaloFontLabel}" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- One item of the empty page's legend: a line glyph over its label. Not clickable. -->
    <Style x:Key="SearchHintStyle" TargetType="StackPanel">
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Spacing" Value="12" />
    </Style>
    <Style x:Key="SearchHintGlyphStyle" TargetType="FontIcon">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
    </Style>
    <Style x:Key="SearchHintLabelStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{StaticResource HaloFontLabel}" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- `.top-match` and `.search-grid`'s shared poster template. -->
    <DataTemplate x:Key="SearchPosterTemplate" x:DataType="local:MediaSummary">
      <local:PosterCard
        Title="{x:Bind Title}"
        Meta="{x:Bind Meta}"
        Poster="{x:Bind Poster}" MetaId="{x:Bind Id}"
        KindLabel="{x:Bind KindLabel}"
        FillsColumn="True"
        Tag="{x:Bind}"
        Click="OnPosterClick" />
    </DataTemplate>
    <!--
      One person of the people row: a poster card holding their portrait, the
      2:3 shape TMDB's profile photos come in and the person page shows, so no
      face is cropped. A faint figure stands in until, unless, the photo loads.
      Under it the name and what they are; the known-for titles are its tooltip.
    -->
    <DataTemplate x:Key="SearchPersonTemplate" x:DataType="local:SearchPersonViewModel">
      <local:PosterCard
        Title="{x:Bind Name}"
        Meta="{x:Bind Role}"
        Poster="{x:Bind Photo}"
        KindLabel="PERSON"
        AutomationProperties.Name="{x:Bind Name}"
        ToolTipService.ToolTip="{x:Bind LineToolTip}"
        Tag="{x:Bind}"
        Click="OnPersonClick" />
    </DataTemplate>
  </Page.Resources>
  <Grid>
    <!--
      The action card's glyph tile and the status line's colour. Set from the
      code-behind by name, so every brush stays a theme resource and follows
      a theme change.
    -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ActionToneStates">
        <VisualState x:Name="ToneAccent" />
        <VisualState x:Name="ToneWarn">
          <VisualState.Setters>
            <Setter Target="ActionTile.Background" Value="{ThemeResource HaloCautionTintBrush}" />
            <Setter Target="ActionIdGlyph.Foreground" Value="{ThemeResource HaloCautionBrush}" />
            <Setter Target="ActionLinkGlyph.Foreground" Value="{ThemeResource HaloCautionBrush}" />
            <Setter Target="ActionMagnetGlyph.Stroke" Value="{ThemeResource HaloCautionBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="ToneBad">
          <VisualState.Setters>
            <Setter Target="ActionTile.Background" Value="{ThemeResource HaloCriticalTintBrush}" />
            <Setter Target="ActionIdGlyph.Foreground" Value="{ThemeResource HaloCriticalBrush}" />
            <Setter Target="ActionLinkGlyph.Foreground" Value="{ThemeResource HaloCriticalBrush}" />
            <Setter Target="ActionMagnetGlyph.Stroke" Value="{ThemeResource HaloCriticalBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="ToneMute">
          <VisualState.Setters>
            <Setter Target="ActionIdGlyph.Foreground" Value="{ThemeResource HaloText3Brush}" />
            <Setter Target="ActionLinkGlyph.Foreground" Value="{ThemeResource HaloText3Brush}" />
            <Setter Target="ActionMagnetGlyph.Stroke" Value="{ThemeResource HaloText3Brush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ActionGlyphStates">
        <VisualState x:Name="GlyphId" />
        <VisualState x:Name="GlyphPoster">
          <VisualState.Setters>
            <Setter Target="ActionTile.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="GlyphLink">
          <VisualState.Setters>
            <Setter Target="ActionIdGlyph.Visibility" Value="Collapsed" />
            <Setter Target="ActionLinkGlyph.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="GlyphMagnet">
          <VisualState.Setters>
            <Setter Target="ActionIdGlyph.Visibility" Value="Collapsed" />
            <Setter Target="ActionMagnetGlyph.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="StatusStates">
        <VisualState x:Name="StatusNormal" />
        <VisualState x:Name="StatusFailure">
          <VisualState.Setters>
            <Setter Target="StatusLabel.Foreground" Value="{ThemeResource HaloCautionBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <!-- No page title: the centred pill leads the page. -->
    <ScrollView x:Name="SearchScroller" ContentOrientation="Vertical"
      HorizontalScrollMode="Disabled"
      VerticalScrollBarVisibility="Hidden">
      <!-- 40 above and below; the sides are the layout step's gutter. -->
      <StackPanel x:Name="PageBody" Padding="24,40,24,40">

        <!--
          The head: the pill, centred and at most 560 wide, the suggestions
          hanging from it over whatever is below, and the kind filters under it.
          Drawn above the sections after it, so the suggestions cover them.
        -->
        <StackPanel x:Name="SearchHead" Canvas.ZIndex="5">
          <Grid x:Name="FieldColumn" MaxWidth="560">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="QueryField" Height="56" SizeChanged="OnQueryFieldSizeChanged">
              <Grid.Resources>
                <!-- A pill at rest and with the caret: a quiet fill and a 1px ring, never the stock accent underline. -->
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                <!-- Brushes over the token colours, as the app overrides control brushes
                     elsewhere: an alias to a theme brush resolves once, to the wrong theme. -->
                <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource HaloCtrlColor}" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource HaloCtrlHoverColor}" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource HaloTextBoxFocusFillColor}" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource HaloCtrlStrokeColor}" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource HaloCtrlStrokeColor}" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource HaloHoverCardStrokeColor}" />
              </Grid.Resources>
              <TextBox
                x:Name="QueryBox"
                Height="56"
                Padding="28,16,88,0"
                VerticalContentAlignment="Center"
                BorderThickness="1"
                CornerRadius="28"
                FontSize="{StaticResource HaloFontEmphasis}"
                IsSpellCheckEnabled="False"
                MaxLength="2048"
                PlaceholderText="{x:Bind ViewModel.Placeholder, Mode=OneWay}"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                GotFocus="OnQueryGotFocus"
                KeyDown="OnQueryKeyDown"
                Loaded="OnQueryBoxLoaded"
                LostFocus="OnQueryLostFocus" />
              <!-- Shown whenever there is text, not only while the box has the caret; pressing it keeps the caret in the box. -->
              <Button
                Width="28"
                Height="28"
                MinWidth="0"
                Margin="0,0,52,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Clear"
                Background="{ThemeResource HaloSubtleBrush}"
                BorderThickness="0"
                Click="OnClearClick"
                CornerRadius="14"
                IsTabStop="False"
                ToolTipService.ToolTip="Clear"
                Visibility="{x:Bind ViewModel.ClearVisibility, Mode=OneWay}">
                <FontIcon FontSize="10" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE894;" />
              </Button>
              <FontIcon Margin="0,0,22,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE721;" IsHitTestVisible="False" />
            </Grid>
            <!-- The suggestions: 6 under the pill, as wide as it; they take no room of their own. -->
            <Canvas Grid.Row="1" Height="0" VerticalAlignment="Top" Canvas.ZIndex="1">
              <Border
                x:Name="SuggestionPanel"
                Canvas.Top="6"
                Width="480"
                Padding="0,6"
                Background="{ThemeResource HaloFlyoutBrush}"
                BorderBrush="{ThemeResource HaloCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Visibility="{x:Bind ViewModel.SuggestionsVisibility, Mode=OneWay}">
                <ItemsControl x:Name="SuggestionList" AutomationProperties.Name="Search suggestions" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RecentSearchViewModel">
                      <!-- Taken without moving the caret, so the box never loses focus to the list. -->
                      <Button
                        Padding="22,11"
                        AllowFocusOnInteraction="False"
                        Click="OnSuggestionClick"
                        Style="{StaticResource SearchRowButtonStyle}"
                        Tag="{x:Bind Term}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                          <FontIcon VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE721;" />
                          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Term}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Canvas>
          </Grid>
          <StackPanel x:Name="FilterChips" Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
            <RadioButton x:Name="AllChip" GroupName="SearchFilter" IsChecked="True" Click="OnAllFilterClick" Content="All" Style="{StaticResource HaloQuietChipRadioStyle}" />
            <RadioButton x:Name="MoviesChip" GroupName="SearchFilter" Click="OnMoviesFilterClick" Content="Movies" Style="{StaticResource HaloQuietChipRadioStyle}" />
            <RadioButton x:Name="SeriesChip" GroupName="SearchFilter" Click="OnSeriesFilterClick" Content="Series" Style="{StaticResource HaloQuietChipRadioStyle}" />
          </StackPanel>
        </StackPanel>

        <!--
          One status line whenever a query is active: the search under way,
          catalogs still out, or the ones that did not answer. Its text
          changes; its height never does. The text has the star column, so a
          long sentence ends in an ellipsis instead of running off the page.
        -->
        <Grid Height="20" MaxWidth="720" Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ProgressRing
            Width="12"
            Height="12"
            MinWidth="0"
            MinHeight="0"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.StillAsking, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.StillAsking, Mode=OneWay}" />
          <TextBlock
            x:Name="StatusLabel"
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="{StaticResource HaloFontCaption}"
            Foreground="{ThemeResource HaloText3Brush}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- The body: 22 under the status line, its sections 30 apart. -->
        <StackPanel Margin="0,22,0,0" Spacing="30">

          <!--
            Recent: one centred line, the label, up to six outline pills and
            Clear. Whatever does not fit the line is clipped away.
          -->
          <Grid MaxWidth="920" HorizontalAlignment="Center" ColumnSpacing="10" Visibility="{x:Bind ViewModel.RecentVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource HaloFontCaption}" Foreground="{ThemeResource HaloText3Brush}" Text="Recent" />
            <ItemsControl x:Name="RecentList" Grid.Column="1" Height="30" IsTabStop="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:RecentSearchViewModel">
                  <Border
                    Height="30"
                    MaxWidth="260"
                    BorderBrush="{ThemeResource HaloCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="15">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Button
                        Padding="12,0,4,0"
                        VerticalAlignment="Stretch"
                        Click="OnRecentClick"
                        CornerRadius="15,0,0,15"
                        Style="{StaticResource SearchRowButtonStyle}"
                        Tag="{x:Bind Term}">
                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource HaloFontSmall}" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Term}" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <Button
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind RemoveLabel}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnForgetClick"
                        CornerRadius="10"
                        Style="{StaticResource HaloDangerIconButtonStyle}"
                        Tag="{x:Bind Term}"
                        ToolTipService.ToolTip="Remove">
                        <FontIcon FontSize="9" Glyph="&#xE711;" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
              Grid.Column="2"
              VerticalAlignment="Center"
              Click="OnClearRecentClick"
              Content="Clear"
              FontSize="{StaticResource HaloFontCaption}"
              Foreground="{ThemeResource HaloText3Brush}"
              Style="{StaticResource SearchLinkButtonStyle}" />
          </Grid>

          <!--
            `.hero`: what the box accepts, as a legend (the items do nothing
            when clicked). People show only when the server can search them;
            magnets join it when the app can do them. The code-behind places
            the shown items in the grid.
          -->
          <StackPanel Padding="0,96,0,40" Spacing="32" Visibility="{x:Bind ViewModel.HintsVisibility, Mode=OneWay}">
            <TextBlock
              HorizontalAlignment="Center"
              FontFamily="Segoe UI Variable Display"
              FontSize="{StaticResource HaloFontShelf}"
              Foreground="{ThemeResource HaloText3Brush}"
              Text="You can search anything&#x2026;"
              TextAlignment="Center"
              TextWrapping="Wrap" />
            <!-- At least 170 per item, at most 760 in all; two columns on a narrow window (code-behind). -->
            <Grid x:Name="HintsGrid" MaxWidth="760" ColumnSpacing="16" RowSpacing="20" SizeChanged="OnHintsGridSizeChanged">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel x:Name="HintTitles" Style="{StaticResource SearchHintStyle}">
                <FontIcon Glyph="&#xE8B2;" Style="{StaticResource SearchHintGlyphStyle}" />
                <TextBlock Style="{StaticResource SearchHintLabelStyle}" Text="Movies &amp; Series" />
              </StackPanel>
              <StackPanel x:Name="HintPeople" Grid.Column="1" Style="{StaticResource SearchHintStyle}" Visibility="{x:Bind ViewModel.PeopleHintVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE77B;" Style="{StaticResource SearchHintGlyphStyle}" />
                <TextBlock Style="{StaticResource SearchHintLabelStyle}" Text="Actors, Directors &amp; Writers" />
              </StackPanel>
              <StackPanel x:Name="HintLinks" Grid.Column="1" Style="{StaticResource SearchHintStyle}">
                <FontIcon Glyph="&#xE71B;" Style="{StaticResource SearchHintGlyphStyle}" />
                <TextBlock Style="{StaticResource SearchHintLabelStyle}" Text="{x:Bind ViewModel.LinksHintText, Mode=OneWay}" />
              </StackPanel>
              <StackPanel x:Name="HintIds" Grid.Column="2" Style="{StaticResource SearchHintStyle}">
                <!-- No IMDb mark in Segoe Fluent Icons: the word, heavy, in a rounded frame, as tall as the other glyphs. -->
                <Border Height="30" Padding="0,5" HorizontalAlignment="Center">
                  <Border
                    Padding="5,0"
                    BorderBrush="{ThemeResource HaloText3Brush}"
                    BorderThickness="1.5"
                    CornerRadius="4">
                    <TextBlock
                      VerticalAlignment="Center"
                      CharacterSpacing="-20"
                      FontSize="12"
                      FontWeight="ExtraBold"
                      Foreground="{ThemeResource HaloText3Brush}"
                      Text="IMDb" />
                  </Border>
                </Border>
                <TextBlock Style="{StaticResource SearchHintLabelStyle}" Text="IMDb / TVDB Links" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!--
            Everything a query shows, dimmed as one while the next query's answers
            are awaited. Only its plain Opacity is set (from code-behind): no
            transition or composition visual on this element, see the crash
            lessons on mixing the two XAML API families.
          -->
          <StackPanel x:Name="ResultsBlock" Spacing="26">
            <!--
              The slot, as the top match: the title's art across the card under
              the hero's scrim, its poster, and the one thing it does. Clicking
              anywhere else opens the title page too; the Tag is what a
              right-click opens the poster menu for.
            -->
            <Grid
              x:Name="TopMatchCard"
              MinHeight="176"
              Background="{ThemeResource HaloCardBrush}"
              CornerRadius="16"
              PointerCanceled="OnTopMatchPointerExited"
              PointerEntered="OnTopMatchPointerEntered"
              PointerExited="OnTopMatchPointerExited"
              Tag="{x:Bind ViewModel.TopMatch, Mode=OneWay}"
              Tapped="OnTopMatchTapped"
              Visibility="{x:Bind ViewModel.TopMatchVisibility, Mode=OneWay}">
              <Grid x:Name="TopMatchContent" MinHeight="176" Padding="28,22" ColumnSpacing="22" SizeChanged="OnTopMatchContentSizeChanged">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="TopMatchPosterColumn" Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                  x:Name="TopMatchPoster"
                  Height="150"
                  VerticalAlignment="Center"
                  BorderBrush="{ThemeResource HaloCardStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource HaloArtCornerRadius}">
                  <local:PlaceholderArt x:Name="TopMatchPlaceholder" />
                  <local:ArtworkImage
                    x:Name="TopMatchArtwork"
                    DecodeWidth="168"
                    MetaId="{x:Bind ViewModel.TopMatchMetaId, Mode=OneWay}"
                    SourceUrl="{x:Bind ViewModel.TopMatchPoster, Mode=OneWay}" />
                </Grid>
                <StackPanel x:Name="TopMatchText" Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                  <TextBlock Foreground="{ThemeResource HaloText3Brush}" Style="{StaticResource HaloMonoKicker}" Text="TOP MATCH" />
                  <TextBlock
                    MaxLines="2"
                    Style="{StaticResource SearchSlotTitleStyle}"
                    Text="{x:Bind ViewModel.TopMatchTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Foreground="{ThemeResource HaloCautionBrush}" Style="{StaticResource SearchSlotMetaStyle}" Text="{x:Bind ViewModel.TopMatchRating, Mode=OneWay}" Visibility="{x:Bind ViewModel.TopMatchRatingVisibility, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SearchSlotMonoStyle}" Text="{x:Bind ViewModel.TopMatchKind, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SearchSlotMetaStyle}" Text="{x:Bind ViewModel.TopMatchYear, Mode=OneWay}" Visibility="{x:Bind ViewModel.TopMatchYearVisibility, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SearchSlotMetaStyle}" Text="In library" Visibility="{x:Bind ViewModel.TopMatchInLibraryVisibility, Mode=OneWay}" />
                  </StackPanel>
                  <!-- About 62 characters to a line. -->
                  <TextBlock
                    MaxWidth="500"
                    HorizontalAlignment="Left"
                    FontSize="{StaticResource HaloFontLabel}"
                    Foreground="{ThemeResource HaloText2Brush}"
                    LineHeight="20"
                    MaxLines="3"
                    Text="{x:Bind ViewModel.TopMatchBlurb, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.TopMatchBlurbVisibility, Mode=OneWay}" />
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="10">
                    <Button Click="OnTopMatchOpenClick" Content="Open title" Style="{StaticResource SearchSlotButtonStyle}" />
                    <Border Style="{StaticResource SearchKeyHintStyle}">
                      <TextBlock Style="{StaticResource SearchKeyHintTextStyle}" Text="Enter" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <!-- The 1px frame, and the stronger one under the pointer, crossfading as a poster card's do. -->
              <Border BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False" />
              <Border x:Name="TopMatchHoverRing" BorderBrush="{ThemeResource HaloText4Brush}" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False" Opacity="0">
                <Border.OpacityTransition>
                  <ScalarTransition Duration="0:0:0.12" />
                </Border.OpacityTransition>
              </Border>
            </Grid>

            <!--
              The slot, as the action card, while the box holds a pasted link or
              id: what it is and, when there is one, the single thing it does
              (Enter, a click on the card, or its button). One card for every
              kind of paste; later kinds only add states to it.
            -->
            <Grid
              x:Name="ActionCard"
              MinHeight="176"
              Padding="28,22"
              Background="{ThemeResource HaloCardBrush}"
              BorderBrush="{ThemeResource HaloCardStrokeBrush}"
              BorderThickness="1"
              ColumnSpacing="22"
              CornerRadius="16"
              SizeChanged="OnActionCardSizeChanged"
              Tapped="OnActionCardTapped"
              Visibility="{x:Bind ViewModel.ActionCardVisibility, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid x:Name="ActionVisual">
                <Grid
                  x:Name="ActionPosterFrame"
                  Width="100"
                  Height="150"
                  VerticalAlignment="Center"
                  BorderBrush="{ThemeResource HaloCardStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource HaloArtCornerRadius}"
                  Visibility="{x:Bind ViewModel.ActionPosterVisibility, Mode=OneWay}">
                  <local:PlaceholderArt />
                  <local:ArtworkImage
                    DecodeWidth="168"
                    MetaId="{x:Bind ViewModel.ActionMetaId, Mode=OneWay}"
                    SourceUrl="{x:Bind ViewModel.ActionPoster, Mode=OneWay}" />
                </Grid>
                <!-- The glyph tile; its fill, glyph and colour are visual states. -->
                <Border
                  x:Name="ActionTile"
                  Width="56"
                  Height="56"
                  VerticalAlignment="Top"
                  Background="{ThemeResource HaloSubtleBrush}"
                  CornerRadius="14">
                  <Grid>
                    <FontIcon x:Name="ActionIdGlyph" FontSize="24" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE779;" />
                    <FontIcon x:Name="ActionLinkGlyph" FontSize="24" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE71B;" Visibility="Collapsed" />
                    <!-- No magnet in Segoe Fluent Icons: the mockup's own line glyph. -->
                    <Viewbox Width="24" Height="24">
                      <!-- The glyph's own 24 square, so the Viewbox scales that and not the path's bounds. -->
                      <Canvas Width="24" Height="24">
                        <Path
                          x:Name="ActionMagnetGlyph"
                          Data="M6,4 H10 V12 A2,2 0 0 0 14,12 V4 H18 V12 A6,6 0 0 1 6,12 Z M6,8 H10 M14,8 H18"
                          Stroke="{ThemeResource HaloText2Brush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.6"
                          Visibility="Collapsed" />
                      </Canvas>
                    </Viewbox>
                  </Grid>
                </Border>
              </Grid>
              <StackPanel x:Name="ActionText" Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                <TextBlock Foreground="{ThemeResource HaloText3Brush}" Style="{StaticResource HaloMonoKicker}" Text="{x:Bind ViewModel.ActionKicker, Mode=OneWay}" />
                <TextBlock Style="{StaticResource SearchSlotTitleStyle}" Text="{x:Bind ViewModel.ActionTitle, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.ActionMetaVisibility, Mode=OneWay}">
                  <TextBlock Foreground="{ThemeResource HaloCautionBrush}" Style="{StaticResource SearchSlotMetaStyle}" Text="{x:Bind ViewModel.ActionRating, Mode=OneWay}" Visibility="{x:Bind ViewModel.ActionRatingVisibility, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource SearchSlotMonoStyle}" Text="{x:Bind ViewModel.ActionMono, Mode=OneWay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.ActionMonoVisibility, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource SearchSlotMetaStyle}" Text="{x:Bind ViewModel.ActionYear, Mode=OneWay}" Visibility="{x:Bind ViewModel.ActionYearVisibility, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource SearchSlotMonoStyle}" Text="{x:Bind ViewModel.ActionTail, Mode=OneWay}" Visibility="{x:Bind ViewModel.ActionTailVisibility, Mode=OneWay}" />
                </StackPanel>
                <!-- A magnet the server is still fetching: 4 high, at most 420 wide. -->
                <ProgressBar
                  Height="4"
                  MinHeight="0"
                  MaxWidth="420"
                  HorizontalAlignment="Stretch"
                  Background="{ThemeResource HaloProgressTrackBrush}"
                  CornerRadius="2"
                  Foreground="{ThemeResource HaloAccentBrush}"
                  IsIndeterminate="False"
                  Maximum="100"
                  Minimum="0"
                  Value="{x:Bind ViewModel.ActionProgress, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.ActionProgressVisibility, Mode=OneWay}">
                  <ProgressBar.Resources>
                    <x:Double x:Key="ProgressBarTrackHeight">4</x:Double>
                    <x:Double x:Key="ProgressBarMinHeight">4</x:Double>
                  </ProgressBar.Resources>
                </ProgressBar>
                <TextBlock
                  MaxWidth="500"
                  HorizontalAlignment="Left"
                  FontSize="{StaticResource HaloFontSmall}"
                  Foreground="{ThemeResource HaloText3Brush}"
                  Text="{x:Bind ViewModel.ActionSecondary, Mode=OneWay}"
                  TextWrapping="Wrap"
                  Visibility="{x:Bind ViewModel.ActionSecondaryVisibility, Mode=OneWay}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.ActionButtonVisibility, Mode=OneWay}">
                  <Button
                    AutomationProperties.Name="{x:Bind ViewModel.ActionButtonLabel, Mode=OneWay}"
                    Click="OnActionButtonClick"
                    Style="{StaticResource SearchSlotButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE768;" Visibility="{x:Bind ViewModel.ActionButtonGlyphVisibility, Mode=OneWay}" />
                      <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ActionButtonLabel, Mode=OneWay}" />
                    </StackPanel>
                  </Button>
                  <Border Style="{StaticResource SearchKeyHintStyle}">
                    <TextBlock Style="{StaticResource SearchKeyHintTextStyle}" Text="Enter" />
                  </Border>
                </StackPanel>
                <!-- A magnet card's standard button (Cancel, Try again, Play as
                     unidentified video): a click only, so it has no Enter hint. -->
                <Button
                  Height="38"
                  Margin="0,8,0,0"
                  Padding="20,0"
                  CornerRadius="19"
                  AutomationProperties.Name="{x:Bind ViewModel.ActionPlainButtonLabel, Mode=OneWay}"
                  Click="OnActionPlainButtonClick"
                  Visibility="{x:Bind ViewModel.ActionPlainButtonVisibility, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE768;" Visibility="{x:Bind ViewModel.ActionPlainButtonGlyphVisibility, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ActionPlainButtonLabel, Mode=OneWay}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- The slot's placeholder on a visit's first search: its size, nothing inside. -->
            <Border
              x:Name="TopMatchSkeleton"
              Height="176"
              AutomationProperties.AccessibilityView="Raw"
              Background="{ThemeResource HaloSubtleBrush}"
              CornerRadius="16"
              IsHitTestVisible="False"
              Visibility="{x:Bind ViewModel.TopMatchSkeletonVisibility, Mode=OneWay}" />

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}">
              <TextBlock Style="{StaticResource SearchSectionTitleStyle}" Text="In your library" />
              <ItemsRepeater x:Name="LibraryGrid" VerticalCacheLength="4" ElementPrepared="OnGridElementPrepared" ItemTemplate="{StaticResource SearchPosterTemplate}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout x:Name="LibraryLayout" ItemsStretch="Uniform" MinColumnSpacing="22" MinRowSpacing="14" Orientation="Horizontal" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>

            <!-- PEOPLE, when its answer came with the results: before them. -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.PeopleAboveVisibility, Mode=OneWay}">
              <TextBlock Style="{StaticResource SearchSectionTitleStyle}" Text="People" />
              <ItemsRepeater x:Name="PeopleAboveGrid" ItemTemplate="{StaticResource SearchPersonTemplate}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout ItemsStretch="None" MinColumnSpacing="18" MinItemWidth="132" MinRowSpacing="14" Orientation="Horizontal" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource SearchSectionTitleStyle}" Text="Results" />
                <TextBlock Margin="0,0,0,1" VerticalAlignment="Bottom" FontSize="{StaticResource HaloFontLabel}" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ViewModel.ResultCountText, Mode=OneWay}" />
              </StackPanel>
              <ItemsRepeater x:Name="ResultsGrid" VerticalCacheLength="4" ElementPrepared="OnGridElementPrepared" ItemTemplate="{StaticResource SearchPosterTemplate}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout x:Name="ResultsLayout" ItemsStretch="Uniform" MinColumnSpacing="22" MinRowSpacing="14" Orientation="Horizontal" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>

            <!-- The results' placeholders: the section's header, then twelve poster frames. -->
            <StackPanel
              x:Name="ResultsSkeleton"
              AutomationProperties.AccessibilityView="Raw"
              IsHitTestVisible="False"
              Spacing="12"
              Visibility="{x:Bind ViewModel.ResultsSkeletonVisibility, Mode=OneWay}">
              <TextBlock Style="{StaticResource SearchSectionTitleStyle}" Text="Results" />
              <local:WrapPanel x:Name="ResultsSkeletonGrid" HorizontalSpacing="22" VerticalSpacing="14">
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
                <local:PosterSkeleton />
              </local:WrapPanel>
            </StackPanel>

            <!-- PEOPLE, when its answer came after the results: under them, so nothing shown moves. -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.PeopleBelowVisibility, Mode=OneWay}">
              <TextBlock Style="{StaticResource SearchSectionTitleStyle}" Text="People" />
              <ItemsRepeater x:Name="PeopleBelowGrid" ItemTemplate="{StaticResource SearchPersonTemplate}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout ItemsStretch="None" MinColumnSpacing="18" MinItemWidth="132" MinRowSpacing="14" Orientation="Horizontal" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>
          </StackPanel>

          <!-- `.empty`: the states a query can end in with nothing to show, centred, 44 above and below. -->
          <StackPanel Padding="0,56" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.FilteredEmptyVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE71C;" Style="{StaticResource SearchEmptyGlyphStyle}" />
            <TextBlock Style="{StaticResource SearchEmptyTextStyle}" Text="{x:Bind ViewModel.FilteredEmptyText, Mode=OneWay}" />
            <Button
              HorizontalAlignment="Center"
              Click="OnShowAllResultsClick"
              Content="Show all results"
              FontSize="{StaticResource HaloFontLabel}"
              Style="{StaticResource SearchLinkButtonStyle}" />
          </StackPanel>
          <StackPanel Padding="0,56" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.NothingFoundVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE721;" Style="{StaticResource SearchEmptyGlyphStyle}" />
            <TextBlock Style="{StaticResource SearchEmptyTitleStyle}" Text="No matching titles" />
            <TextBlock Style="{StaticResource SearchEmptyTextStyle}" Text="Check the spelling, or try fewer words." />
          </StackPanel>
          <StackPanel Padding="0,56" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.AddonsUnreachableVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE7BA;" Style="{StaticResource SearchEmptyGlyphStyle}" />
            <TextBlock Style="{StaticResource SearchEmptyTitleStyle}" Text="Search could not reach your addons" />
            <TextBlock Style="{StaticResource SearchEmptyTextStyle}" Text="Check your connection and try again." />
            <Button Height="38" Margin="0,6,0,0" Padding="20,0" HorizontalAlignment="Center" Click="OnTryAgainClick" Content="Try again" CornerRadius="19" />
          </StackPanel>
          <StackPanel Padding="0,56" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.NoAddonsVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xEA86;" Style="{StaticResource SearchEmptyGlyphStyle}" />
            <TextBlock Style="{StaticResource SearchEmptyTitleStyle}" Text="None of your addons can search" />
            <TextBlock Style="{StaticResource SearchEmptyTextStyle}" Text="Add one that can, such as Cinemeta, in Settings." />
            <Button Height="38" Margin="0,6,0,0" Padding="20,0" HorizontalAlignment="Center" Click="OnOpenSettingsClick" Content="Open Settings" CornerRadius="19" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollView>
  </Grid>
</Page>
