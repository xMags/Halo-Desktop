<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.DetailPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  NavigationCacheMode="Required">
  <Grid>
  <!-- No section header: the hero backdrop runs to the top of the page and the back
       button sits on it. Everything here overlaps in one cell, back button last so it
       stays on top. -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
    <StackPanel Padding="0,0,0,48">
      <Grid Height="268">
        <local:PlaceholderArt Caption="BACKDROP" />
        <local:ArtworkImage SourceUrl="{x:Bind ViewModel.Background, Mode=OneWay}" FallbackUrl="{x:Bind ViewModel.Poster, Mode=OneWay}" />
        <Rectangle VerticalAlignment="Bottom" Height="140">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Offset="0" Color="#00202020" />
              <GradientStop Offset="1" Color="{ThemeResource HaloDetailScrimColor}" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
      <Grid Margin="24,-76,24,0" ColumnSpacing="20" RowSpacing="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="128" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="292" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Poster and title block are bottom-aligned, as in the design's hero row. -->
        <Grid Width="128" Height="192" VerticalAlignment="Top">
          <local:PlaceholderArt />
          <local:ArtworkImage SourceUrl="{x:Bind ViewModel.Poster, Mode=OneWay}" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Spacing="8">
          <TextBlock Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoKicker}" Text="{x:Bind ViewModel.Kicker, Mode=OneWay}" />
          <TextBlock Style="{StaticResource HaloDetailTitle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
          <TextBlock Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.MetaLine, Mode=OneWay}" />
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="10">
            <Button Height="36" Padding="18,0" AutomationProperties.Name="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}" Click="OnResumeClick" Style="{StaticResource HaloAccentButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon VerticalAlignment="Center" FontSize="{StaticResource HaloFontLabel}" Glyph="&#xE768;" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Height="36" Padding="16,0" Background="{ThemeResource HaloAccentTintBrush}" BorderBrush="{ThemeResource HaloAccentBrush}" Foreground="{ThemeResource HaloAccentBrush}" Content="{x:Bind ViewModel.LibraryLabel, Mode=OneWay}" Click="OnLibraryClick" />
            <Button AutomationProperties.Name="Choose a download source" Click="OnDownloadsClick" Style="{StaticResource HaloIconButtonStyle}" ToolTipService.ToolTip="Choose a download source">
              <FontIcon FontSize="{StaticResource HaloFontEmphasis}" Glyph="&#xE896;" />
            </Button>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="14" Visibility="{x:Bind ViewModel.EpisodeSectionVisibility, Mode=OneWay}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="SeasonPicker" MinWidth="140" SelectedIndex="{x:Bind ViewModel.SeasonIndex, Mode=OneWay}" SelectionChanged="OnSeasonChanged" />
            <TextBlock Grid.Column="1" Margin="12,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.SeasonMeta, Mode=OneWay}" />
            <Button Grid.Column="3" Padding="8,3" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource HaloAccentBrush}" Click="OnBrowseSourcesClick" Content="{x:Bind ViewModel.SourceActionLabel, Mode=OneWay}" ToolTipService.ToolTip="Choose a source for the first episode shown" />
          </Grid>
          <ItemsControl x:Name="EpisodeList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:DetailEpisodeViewModel">
                <Button Margin="0,0,0,8" Padding="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnEpisodeClick" Style="{StaticResource HaloCardButtonStyle}" Tag="{x:Bind}">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="118" Height="66">
                      <local:PlaceholderArt />
                      <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                      <ProgressBar Height="3" VerticalAlignment="Bottom" Maximum="1" Value="{x:Bind Progress}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoData}" Text="{x:Bind Tag}" Visibility="{x:Bind InProgressVisibility}" />
                        <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind Tag}" Visibility="{x:Bind IdleVisibility}" />
                        <FontIcon Foreground="{ThemeResource HaloSuccessBrush}" Glyph="&#xE73E;" Visibility="{x:Bind WatchedVisibility}" />
                        <TextBlock FontSize="{StaticResource HaloFontEmphasis}" FontWeight="SemiBold" Text="{x:Bind Title}" />
                        <Border Padding="6,2" Background="{ThemeResource HaloSuccessTintBrush}" CornerRadius="3" Visibility="{x:Bind SavedVisibility}">
                          <TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="{StaticResource HaloFontCaption}" Foreground="{ThemeResource HaloSuccessBrush}" Text="SAVED" />
                        </Border>
                      </StackPanel>
                      <TextBlock Foreground="{ThemeResource HaloText3Brush}" FontSize="{StaticResource HaloFontLabel}" Text="{x:Bind Blurb}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                      <TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind Runtime}" />
                      <TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind Aired}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- The aside sits beside the episode list, not beside the hero, and takes the
             whole row instead when there is no episode list to sit beside. The view
             model owns the two arrangements so the switch is one decision, not four. -->
        <StackPanel
          Grid.Row="1"
          Grid.Column="{x:Bind ViewModel.AsideColumn, Mode=OneWay}"
          Grid.ColumnSpan="{x:Bind ViewModel.AsideColumnSpan, Mode=OneWay}"
          HorizontalAlignment="Left"
          Orientation="{x:Bind ViewModel.AsideOrientation, Mode=OneWay}"
          Spacing="12">
          <Border Width="{x:Bind ViewModel.AsideCardWidth, Mode=OneWay}" Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock Text="SYNOPSIS" Style="{StaticResource HaloMonoKicker}" />
              <TextBlock Style="{StaticResource HaloBodySmall}" Text="{x:Bind ViewModel.Synopsis, Mode=OneWay}" />
              <ItemsControl x:Name="FactsList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,4,0,0" Style="{StaticResource HaloMonoData}" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
          <Border Width="{x:Bind ViewModel.AsideCardWidth, Mode=OneWay}" Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock Text="AVAILABILITY" Style="{StaticResource HaloMonoKicker}" />
              <ItemsControl x:Name="AvailabilityList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,4,0,0" Style="{StaticResource HaloMonoData}" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Button Margin="0,6,0,0" Click="OnBrowseSourcesClick" Content="Browse all sources" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
  <!-- HeaderTitle is empty while the hero is up and names the title otherwise, so
       these two states still say which title is loading or failed. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"><ProgressRing HorizontalAlignment="Center" IsActive="True" /><TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" Style="{StaticResource HaloPageTitle}" /><TextBlock HorizontalAlignment="Center" Text="Loading title details…" /></StackPanel>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"><TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" Style="{StaticResource HaloPageTitle}" /><TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource HaloCriticalBrush}" Text="Title details could not be loaded." /><Button HorizontalAlignment="Center" Content="Retry" Click="OnRetryClick" /></StackPanel>

  <!-- Outside the scroller so it survives the loading and error states, which replace
       the scrolled content wholesale: a title that fails to load is exactly when there
       is nothing else to leave the page with. Carries its own scrim rather than the
       theme's translucent button fill, because it sits on photography that can be any
       brightness. -->
  <Button
    Width="34"
    Height="34"
    MinWidth="0"
    Margin="24,12,0,0"
    Padding="0"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    AutomationProperties.Name="Back"
    Background="#C0000000"
    BorderThickness="0"
    Click="OnBackClick"
    CornerRadius="4"
    ToolTipService.ToolTip="Back">
    <FontIcon FontSize="{StaticResource HaloFontEmphasis}" Foreground="White" Glyph="&#xE72B;" />
  </Button>
  </Grid>
</Page>
