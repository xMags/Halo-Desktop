<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.DetailPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Background="{ThemeResource HaloDetailGroundBrush}"
  ContextRequested="OnContextRequested"
  Loaded="OnLoaded"
  NavigationCacheMode="Disabled"
  SizeChanged="OnSizeChanged"
  Unloaded="OnUnloaded">
  <!--
    Each open of a title is a fresh page (no cache): another title, or the same one
    reached again, never inherits a season or a scroll position. The sheet and the
    player open over the shell without navigating it, so returning from either
    finds this page as it was left.

    Two layers, as the reference draws them: the title's art pinned behind the page
    (sharp across the hero, blurred and dimmed behind everything else) and the
    scroller over it, whose panels are frosted glass over the title's own colours.
  -->
  <Grid x:Name="PageRoot">
    <Grid IsHitTestVisible="False" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
      <!--
        `.detail-bg-blur`: the art decoded tiny and stretched over the page, which
        smooths it the way a wide blur does at a fraction of the cost, then dimmed.
      -->
      <Image x:Name="BlurredArt" Stretch="UniformToFill" />
      <Border Background="{ThemeResource HaloDetailBackdropDimBrush}" />
      <!-- The sharp art and its scrim: composition visuals under this host only. -->
      <Border x:Name="ArtHost" VerticalAlignment="Top" />
    </Grid>

    <ScrollView ContentOrientation="Vertical"
      x:Name="PageScroller"
      HorizontalScrollMode="Disabled"
      VerticalScrollBarVisibility="Auto"
      ViewChanged="OnPageScrolled"
      Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
      <StackPanel>
        <local:DetailHero x:Name="Hero" />
        <StackPanel x:Name="Panels" Padding="32,0,32,56" Spacing="20">
          <local:DetailEpisodesPanel x:Name="EpisodesPanel" Visibility="{x:Bind ViewModel.EpisodesVisibility, Mode=OneWay}" />
          <local:DetailCreditsPanel x:Name="CreditsPanel" />
          <local:DetailSimilarPanel x:Name="SimilarPanel" />
        </StackPanel>
      </StackPanel>
    </ScrollView>

    <!-- `DetailSkeleton`: the hero's blocks, pulsing, where they will land. -->
    <Grid
      x:Name="SkeletonHost"
      Height="480"
      VerticalAlignment="Top"
      IsHitTestVisible="False"
      Visibility="{x:Bind ViewModel.SkeletonVisibility, Mode=OneWay}">
      <StackPanel
        x:Name="SkeletonBody"
        Width="560"
        Margin="32,0,32,40"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom">
        <Border Width="340" Height="72" HorizontalAlignment="Left" Background="{ThemeResource HaloDetailSkeletonBrush}" CornerRadius="8" />
        <Border Width="300" Height="14" Margin="0,20,0,0" HorizontalAlignment="Left" Background="{ThemeResource HaloDetailSkeletonBrush}" CornerRadius="4" />
        <Border Height="14" Margin="0,18,0,0" Background="{ThemeResource HaloDetailSkeletonBrush}" CornerRadius="4" />
        <Border Width="448" Height="14" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{ThemeResource HaloDetailSkeletonBrush}" CornerRadius="4" />
        <StackPanel Margin="0,28,0,0" Orientation="Horizontal" Spacing="12">
          <Border Width="140" Height="46" Background="{ThemeResource HaloDetailSkeletonBrush}" CornerRadius="10" />
          <Border Width="46" Height="46" Background="{ThemeResource HaloDetailSkeletonBrush}" CornerRadius="23" />
          <Border Width="46" Height="46" Background="{ThemeResource HaloDetailSkeletonBrush}" CornerRadius="23" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <StackPanel
      x:Name="ErrorLine"
      Margin="32,72,32,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Spacing="12"
      Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
      <TextBlock Foreground="{ThemeResource HaloCriticalBrush}" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="Wrap" />
      <Button HorizontalAlignment="Left" Click="OnRetryClick" Content="Retry" />
    </StackPanel>

    <!--
      The compact bar takes over the top once the main button scrolls out of sight.
      It slides and fades with property transitions only; it is never handed a
      composition visual.
    -->
    <Grid
      x:Name="CompactBar"
      Height="64"
      Padding="86,0,32,0"
      VerticalAlignment="Top"
      Background="{ThemeResource HaloDetailCompactBarBrush}"
      BorderBrush="{ThemeResource HaloDetailEdgeBrush}"
      BorderThickness="0,0,0,1"
      ColumnSpacing="16"
      IsHitTestVisible="False"
      Opacity="0"
      Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
      <Grid.OpacityTransition>
        <ScalarTransition Duration="0:0:0.3" />
      </Grid.OpacityTransition>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image
        x:Name="CompactLogo"
        MaxWidth="220"
        Height="28"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        ImageFailed="OnCompactLogoFailed"
        Stretch="Uniform"
        Visibility="{x:Bind ViewModel.LogoVisibility, Mode=OneWay}" />
      <TextBlock
        VerticalAlignment="Center"
        FontSize="16"
        FontWeight="SemiBold"
        Foreground="{ThemeResource HaloDetailInkBrush}"
        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
        TextTrimming="CharacterEllipsis"
        Visibility="{x:Bind ViewModel.TitleVisibility, Mode=OneWay}" />
      <TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        FontSize="13"
        Foreground="{ThemeResource HaloDetailInk55Brush}"
        Text="{x:Bind ViewModel.TimeLeft, Mode=OneWay}"
        Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}" />
      <Button
        x:Name="CompactPlay"
        Grid.Column="2"
        VerticalAlignment="Center"
        AutomationProperties.Name="{x:Bind ViewModel.PlayLabel, Mode=OneWay}"
        Click="OnPlayClick"
        IsTabStop="False"
        Style="{StaticResource HaloDetailSmallPlayButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE768;" />
          <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PlayLabel, Mode=OneWay}" />
        </StackPanel>
      </Button>
    </Grid>

    <!--
      Outside the scroller so it survives the loading and error states: a title that
      fails to load is exactly when there is nothing else to leave the page with.
    -->
    <Button
      x:Name="BackButton"
      Width="38"
      Height="38"
      Margin="32,13,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      AutomationProperties.Name="Back"
      Click="OnBackClick"
      CornerRadius="19"
      Style="{StaticResource HaloDetailRoundButtonStyle}"
      ToolTipService.ToolTip="Back">
      <FontIcon FontSize="16" Glyph="&#xE72B;" />
    </Button>
  </Grid>
</Page>
