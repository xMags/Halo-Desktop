<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  NavigationCacheMode="Required">
  <Grid>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"><ProgressRing IsActive="True" /><TextBlock Text="Loading your Halo home…" /></StackPanel>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource HaloCriticalBrush}" Text="Home could not be refreshed." /><Button Content="Retry" Click="OnRetryClick" /></StackPanel>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"><TextBlock Text="No titles are available from your visible addon catalogs." /><Button Content="Open Addons" Click="OnOpenSettingsClick" /></StackPanel>
  <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Hidden" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
    <StackPanel Padding="0,0,0,48" Spacing="28">
      <local:SectionHeader ContentPadding="{x:Bind ViewModel.HeaderPadding, Mode=OneWay}" Title="Home">
        <local:SectionHeader.RightContent>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <AutoSuggestBox
              x:Name="HomeSearchBox"
              Width="300"
              Height="32"
              VerticalAlignment="Center"
              FontSize="13"
              PlaceholderText="Search movies and series"
              QueryIcon="Find"
              QuerySubmitted="OnSearchSubmitted" />
            <Border Style="{StaticResource HaloSegmentedTrayStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="HomeFilter" IsChecked="True" Click="OnAllFilterClick" Content="All" Style="{StaticResource HaloSegmentedRadioStyle}" />
                <RadioButton GroupName="HomeFilter" Click="OnMoviesFilterClick" Content="Movies" Style="{StaticResource HaloSegmentedRadioStyle}" />
                <RadioButton GroupName="HomeFilter" Click="OnSeriesFilterClick" Content="Series" Style="{StaticResource HaloSegmentedRadioStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </local:SectionHeader.RightContent>
      </local:SectionHeader>
      <InfoBar
        Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}"
        IsClosable="False"
        IsOpen="True"
        Message="Home could not refresh its addon catalogs. Your previous titles are still available."
        Severity="Warning"
        Visibility="{x:Bind ViewModel.RefreshErrorVisibility, Mode=OneWay}">
        <InfoBar.ActionButton>
          <Button Content="Retry" Click="OnRetryClick" />
        </InfoBar.ActionButton>
      </InfoBar>
      <!--
        The featured strip is a FlipView advanced by a dispatcher timer, with a
        pips pager underneath for position and manual jumps. Hovering over the
        strip pauses the advance, and leaving the page stops it entirely: a timer
        ticking behind another page would animate a carousel nobody is looking at.
      -->
      <Grid
        Height="{x:Bind ViewModel.HeroHeight, Mode=OneWay}"
        Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}"
        CornerRadius="8"
        PointerEntered="OnFeaturedPointerEntered"
        PointerExited="OnFeaturedPointerExited"
        Visibility="{x:Bind ViewModel.FeaturedVisibility, Mode=OneWay}">
        <!--
          Transparent, and with the control's own rounding off. The stock style
          paints an opaque plate behind the cards and rounds itself a second
          time inside the hero's corners, so any moment a card is not exactly
          filling the viewport, that plate shows down the edge as a pale strip.
          The hero Grid already supplies the corners and there is nothing behind
          the cards that should ever be seen.
        -->
        <FlipView
          x:Name="FeaturedFlip"
          Background="Transparent"
          CornerRadius="0"
          AutomationProperties.Name="Featured titles"
          KeyDown="OnFeaturedKeyDown"
          SelectedIndex="{x:Bind ViewModel.FeaturedIndex, Mode=TwoWay}">
          <FlipView.ItemTemplate>
            <DataTemplate x:DataType="local:FeaturedItem">
              <!-- The wheel is taken here, on the card itself, because FlipView
                   handles PointerWheelChanged at control level: anything attached
                   to the FlipView or above it only runs after the flip already
                   happened. See OnHeroPointerWheelChanged. -->
              <Grid Background="Transparent" Loaded="OnHeroCardLoaded" PointerWheelChanged="OnHeroPointerWheelChanged">
                <local:PlaceholderArt Caption="BACKDROP 1920×1080" />
                <local:ArtworkImage SourceUrl="{x:Bind Background, Mode=OneWay}" />
                <Rectangle>
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                      <GradientStop Offset="0" Color="{ThemeResource HaloHeroScrim1Color}" />
                      <GradientStop Offset="0.52" Color="{ThemeResource HaloHeroScrim2Color}" />
                      <GradientStop Offset="0.92" Color="#0018181A" />
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <StackPanel Width="580" Margin="40,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
                  <TextBlock Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoKicker}" Text="FEATURED" />
                  <TextBlock FontSize="{x:Bind TitleSize, Mode=OneWay}" Style="{StaticResource HaloHeroTitle}" Text="{x:Bind Title}" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="13" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind Rating, Mode=OneWay}" />
                    <TextBlock FontSize="13" Foreground="{ThemeResource HaloText4Brush}" Text="·" />
                    <TextBlock FontSize="13" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Meta, Mode=OneWay}" />
                  </StackPanel>
                  <!-- Clamped because the hero is a fixed height and the synopsis is
                       the addon's description verbatim: an overview that runs long
                       used to push the action buttons out through the clip. -->
                  <TextBlock MaxWidth="520" MaxLines="3" Style="{StaticResource HaloBody}" Text="{x:Bind Synopsis, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                    <Button Height="36" Padding="18,0" AutomationProperties.Name="Open featured title" Tag="{x:Bind}" Click="OnFeaturedActionClick" Style="{StaticResource HaloAccentButtonStyle}">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE768;" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ActionLabel, Mode=OneWay}" />
                      </StackPanel>
                    </Button>
                    <Button Height="36" Padding="18,0" Tag="{x:Bind}" Click="OnFeaturedDetailsClick" Content="Details" />
                    <!--
                      The filled star and the outline are separate icons swapped
                      by visibility, so each keeps its own themed brush without a
                      value converter.
                    -->
                    <Button
                      Height="36"
                      Padding="14,0"
                      AutomationProperties.Name="{x:Bind LibraryLabel, Mode=OneWay}"
                      Tag="{x:Bind}"
                      Click="OnFeaturedLibraryClick"
                      IsEnabled="{x:Bind LibraryEnabled, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Foreground="{ThemeResource HaloCautionBrush}" Glyph="&#xE735;" Visibility="{x:Bind InLibraryVisibility, Mode=OneWay}" />
                        <FontIcon FontSize="14" Glyph="&#xE734;" Visibility="{x:Bind NotInLibraryVisibility, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind LibraryLabel, Mode=OneWay}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <TextBlock
                    Foreground="{ThemeResource HaloCriticalBrush}"
                    Text="{x:Bind LibraryErrorText, Mode=OneWay}"
                    Visibility="{x:Bind LibraryErrorVisibility, Mode=OneWay}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </FlipView.ItemTemplate>
        </FlipView>
        <PipsPager
          Margin="0,0,0,14"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          NumberOfPages="{x:Bind ViewModel.FeaturedCount, Mode=OneWay}"
          SelectedPageIndex="{x:Bind ViewModel.FeaturedIndex, Mode=TwoWay}" />
      </Grid>
      <StackPanel Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}" Visibility="{x:Bind ViewModel.ContinueVisibility, Mode=OneWay}">
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource HaloShelfTitle}" Text="Continue watching" />
          <TextBlock Grid.Column="1" Margin="10,0,0,2" VerticalAlignment="Bottom" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.ContinueCountLabel, Mode=OneWay}" />
          <Button Grid.Column="3" Padding="8,3" Background="Transparent" BorderThickness="0" FontSize="13" Foreground="{ThemeResource HaloAccentBrush}" Content="See all" AutomationProperties.Name="See all in progress titles" Click="OnContinueSeeAllClick" />
          <Button Grid.Column="4" Width="28" Height="28" MinWidth="0" Margin="8,0,0,0" Padding="0" AutomationProperties.Name="Scroll Continue watching left" Click="OnContinueScrollLeft" ToolTipService.ToolTip="Scroll left">
            <FontIcon FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76B;" />
          </Button>
          <Button Grid.Column="5" Width="28" Height="28" MinWidth="0" Margin="6,0,0,0" Padding="0" AutomationProperties.Name="Scroll Continue watching right" Click="OnContinueScrollRight" ToolTipService.ToolTip="Scroll right">
            <FontIcon FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76C;" />
          </Button>
        </Grid>
        <ScrollViewer x:Name="ContinueScroller" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
          <!-- The wheel handler belongs on the content, not on the scroller. A
               ScrollViewer class-handles the wheel before any handler attached to
               the scroller itself, and marks it handled, so one attached there is
               never called. The transparent background makes the gaps between
               cards hit-testable too, so the strip answers everywhere. -->
          <Grid Background="Transparent" PointerWheelChanged="OnStripPointerWheelChanged">
            <!-- The last list on this page that realised everything it was given. -->
            <ItemsRepeater x:Name="ContinueList">
            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="14" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="local:ContinueItem">
                <local:ContinueCard
                  Title="{x:Bind Name}"
                  Meta="{x:Bind Sub}"
                  Art="{x:Bind Art, Mode=OneWay}"
                  EpisodeTag="{x:Bind Tag}"
                  TimeLeft="{x:Bind TimeLeft}"
                  Progress="{x:Bind Progress}"
                  Tag="{x:Bind}"
                  Click="OnContinueItemClick" />
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </Grid>
        </ScrollViewer>
      </StackPanel>
      <!--
        A repeater, not an items control: the catalog cap allows eight shelves plus
        the library, and an items control realises every one of them at page load.
        Each shelf carries its own scroll viewer and repeater, and every one of
        those recomputes its realisation window on each scroll frame, on screen or
        not. Virtualising here keeps that work to the shelves actually in view.
      -->
      <ItemsRepeater x:Name="ShelfList" Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Vertical" Spacing="28" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="local:Shelf">
            <local:MediaShelf Title="{x:Bind Title}" SourceLabel="{x:Bind SourceLabel}" ItemsSource="{x:Bind Items}" ItemClick="OnShelfItemClick" SeeAllClick="OnShelfSeeAllClick" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</Page>
