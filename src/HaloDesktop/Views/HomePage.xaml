<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  ContextRequested="OnContextRequested"
  NavigationCacheMode="Required">
  <Page.Resources>
    <!--
      The hero's position pips: 8x6 bars in Text4 that lighten under the
      pointer. The active one widens into the 28px track its fill crosses over
      one dwell, and keeps its track colour under the pointer. Templated down
      to the bar itself: the stock Button chrome would pad and plate a 6px pip.
    -->
    <Style x:Key="HeroPipStyle" TargetType="Button">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{ThemeResource HaloText4Brush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="PipRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="PipRoot.Background" Value="{ThemeResource HaloText3Brush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="PipRoot.Background" Value="{ThemeResource HaloText3Brush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{TemplateBinding Content}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeroActivePipStyle" TargetType="Button" BasedOn="{StaticResource HeroPipStyle}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{TemplateBinding Content}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>
  <Grid>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource HaloCriticalBrush}" Text="Home could not be refreshed." /><Button Content="Retry" Click="OnRetryClick" /></StackPanel>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"><TextBlock Text="No titles are available from your visible addon catalogs." /><Button Content="Open Addons" Click="OnOpenSettingsClick" /></StackPanel>
  <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Hidden" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
    <StackPanel Padding="0,0,0,48" Spacing="28">
      <local:SectionHeader ContentPadding="{x:Bind ViewModel.HeaderPadding, Mode=OneWay}" Title="Home">
        <local:SectionHeader.RightContent>
          <!-- The search box and the filter tray share one height (32), one
               corner and one hairline edge, so the pair reads as a set. -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <AutoSuggestBox
              x:Name="HomeSearchBox"
              Width="300"
              Height="32"
              VerticalAlignment="Center"
              Background="{ThemeResource HaloCtrlBrush}"
              BorderBrush="{ThemeResource HaloCtrlStrokeBrush}"
              BorderThickness="1"
              CornerRadius="6"
              FontSize="{StaticResource HaloFontBody}"
              PlaceholderText="Search movies and series"
              QueryIcon="Find"
              QuerySubmitted="OnSearchSubmitted" />
            <Border VerticalAlignment="Center" Style="{StaticResource HaloSegmentedTrayStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="HomeFilter" IsChecked="True" Click="OnAllFilterClick" Content="All" Style="{StaticResource HaloSegmentedRadioStyle}" />
                <RadioButton GroupName="HomeFilter" Click="OnMoviesFilterClick" Content="Movies" Style="{StaticResource HaloSegmentedRadioStyle}" />
                <RadioButton GroupName="HomeFilter" Click="OnSeriesFilterClick" Content="Series" Style="{StaticResource HaloSegmentedRadioStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </local:SectionHeader.RightContent>
      </local:SectionHeader>
      <InfoBar
        Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}"
        IsClosable="False"
        IsOpen="True"
        Message="Home could not refresh its addon catalogs. Your previous titles are still available."
        Severity="Warning"
        Visibility="{x:Bind ViewModel.RefreshErrorVisibility, Mode=OneWay}">
        <InfoBar.ActionButton>
          <Button Content="Retry" Click="OnRetryClick" />
        </InfoBar.ActionButton>
      </InfoBar>
      <!--
        `HeroSkeleton`: shown while the shelf list loads, then until the
        shelves that have answered fix the carousel's picks. The hero's frame
        with its scrim, the body's bars where the body will be, and the pips.
        The body's bars pulse; the frame and the pips do not, as in the
        reference.
      -->
      <Grid
        x:Name="HeroSkeleton"
        Height="{x:Bind ViewModel.HeroHeight, Mode=OneWay}"
        Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}"
        AutomationProperties.AccessibilityView="Raw"
        BorderBrush="{ThemeResource HaloCardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="8"
        IsHitTestVisible="False"
        Visibility="{x:Bind ViewModel.FeaturedSkeletonVisibility, Mode=OneWay}">
        <Rectangle Fill="{ThemeResource HaloHeroSkeletonScrimBrush}" />
        <StackPanel
          x:Name="HeroSkeletonBody"
          Width="580"
          Margin="40,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Spacing="10">
          <Border Width="80" Height="12" Margin="0,0,0,4" HorizontalAlignment="Left" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60*" />
              <ColumnDefinition Width="40*" />
            </Grid.ColumnDefinitions>
            <Border MaxWidth="420" Height="{x:Bind ViewModel.HeroTitleSize, Mode=OneWay}" HorizontalAlignment="Stretch" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="6" />
          </Grid>
          <Border Width="240" Height="14" Margin="0,0,0,12" HorizontalAlignment="Left" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
          <StackPanel MaxWidth="500" Margin="0,0,0,12" HorizontalAlignment="Left" Spacing="6">
            <Border Width="500" Height="13" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
            <Border Width="460" Height="13" HorizontalAlignment="Left" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
            <Border Width="300" Height="13" HorizontalAlignment="Left" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
          </StackPanel>
          <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
            <Border Width="104" Height="32" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
            <Border Width="88" Height="32" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
            <Border Width="128" Height="32" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
          </StackPanel>
        </StackPanel>
        <StackPanel Margin="0,0,0,14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
          <Border Width="28" Height="6" Background="{ThemeResource HaloText4Brush}" CornerRadius="3" Opacity="0.5" />
          <Border Width="8" Height="6" Background="{ThemeResource HaloText4Brush}" CornerRadius="3" Opacity="0.3" />
          <Border Width="8" Height="6" Background="{ThemeResource HaloText4Brush}" CornerRadius="3" Opacity="0.3" />
        </StackPanel>
      </Grid>
      <!--
        The featured hero. The backdrops, their crossfade, the bottom fade and
        the scrim are drawn into HeroArtHost by HomeHeroPresenter; the body
        shows whichever title the view model has current. The Tag is what a
        right-click anywhere on the hero opens the title's menu for.
      -->
      <Grid
        x:Name="HeroRoot"
        Height="{x:Bind ViewModel.HeroHeight, Mode=OneWay}"
        Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}"
        Background="Transparent"
        CornerRadius="8"
        PointerEntered="OnFeaturedPointerEntered"
        PointerExited="OnFeaturedPointerExited"
        PointerCanceled="OnFeaturedPointerExited"
        Tag="{x:Bind ViewModel.CurrentFeatured, Mode=OneWay}"
        Visibility="{x:Bind ViewModel.FeaturedVisibility, Mode=OneWay}">
        <local:PlaceholderArt x:Name="HeroPlaceholder" />
        <Grid x:Name="HeroArtHost" IsHitTestVisible="False" />
        <StackPanel
          x:Name="HeroBody"
          Width="580"
          Margin="40,0,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Spacing="10">
          <TextBlock Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoKicker}" Text="FEATURED" />
          <Grid>
            <!-- Sized to the logo, so the shadow host under it is too. -->
            <Grid x:Name="HeroLogoFrame" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
              <Grid x:Name="HeroLogoShadowHost" IsHitTestVisible="False" />
              <Image
                x:Name="HeroLogo"
                MaxWidth="380"
                MaxHeight="{x:Bind ViewModel.HeroLogoMaxHeight, Mode=OneWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{x:Bind ViewModel.CurrentFeatured.Title, Mode=OneWay}"
                Stretch="Uniform"
                ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFeatured.Title, Mode=OneWay}" />
            </Grid>
            <TextBlock
              x:Name="HeroTitleText"
              FontSize="{x:Bind ViewModel.HeroTitleSize, Mode=OneWay}"
              Style="{StaticResource HaloHeroTitle}"
              Text="{x:Bind ViewModel.CurrentFeatured.Title, Mode=OneWay}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind ViewModel.CurrentFeatured.Rating, Mode=OneWay}" Visibility="{x:Bind ViewModel.CurrentFeatured.RatingVisibility, Mode=OneWay}" />
            <TextBlock FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloText4Brush}" Text="·" Visibility="{x:Bind ViewModel.CurrentFeatured.FactsSeparatorVisibility, Mode=OneWay}" />
            <TextBlock FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.CurrentFeatured.Meta, Mode=OneWay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.CurrentFeatured.MetaVisibility, Mode=OneWay}" />
          </StackPanel>
          <!-- Clamped because the hero is a fixed height and the synopsis is
               the addon's description verbatim: an overview that runs long
               used to push the action buttons out through the clip. -->
          <!-- Left-aligned: capped narrower than the column, a stretched block
               would sit centred in it, out of line with the title above. -->
          <TextBlock
            MaxWidth="520"
            HorizontalAlignment="Left"
            MaxLines="3"
            Style="{StaticResource HaloBody}"
            Text="{x:Bind ViewModel.CurrentFeatured.Synopsis, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind ViewModel.CurrentFeatured.SynopsisVisibility, Mode=OneWay}" />
          <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
            <Button Height="36" Padding="18,0" AutomationProperties.Name="{x:Bind ViewModel.CurrentFeatured.ActionLabel, Mode=OneWay}" Tag="{x:Bind ViewModel.CurrentFeatured, Mode=OneWay}" Click="OnFeaturedActionClick" Style="{StaticResource HaloAccentButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon VerticalAlignment="Center" FontSize="{StaticResource HaloFontLabel}" Glyph="&#xE768;" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.CurrentFeatured.ActionLabel, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Height="36" Padding="18,0" Tag="{x:Bind ViewModel.CurrentFeatured, Mode=OneWay}" Click="OnFeaturedDetailsClick" Content="Details" />
            <!--
              The filled star and the outline are separate icons swapped
              by visibility, so each keeps its own themed brush without a
              value converter.
            -->
            <Button
              Height="36"
              Padding="14,0"
              AutomationProperties.Name="{x:Bind ViewModel.CurrentFeatured.LibraryLabel, Mode=OneWay}"
              Tag="{x:Bind ViewModel.CurrentFeatured, Mode=OneWay}"
              Click="OnFeaturedLibraryClick"
              IsEnabled="{x:Bind ViewModel.CurrentFeatured.LibraryEnabled, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="{StaticResource HaloFontEmphasis}" Foreground="{ThemeResource HaloCautionBrush}" Glyph="&#xE735;" Visibility="{x:Bind ViewModel.CurrentFeatured.InLibraryVisibility, Mode=OneWay}" />
                <FontIcon FontSize="{StaticResource HaloFontEmphasis}" Glyph="&#xE734;" Visibility="{x:Bind ViewModel.CurrentFeatured.NotInLibraryVisibility, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.CurrentFeatured.LibraryLabel, Mode=OneWay}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock
            Foreground="{ThemeResource HaloCriticalBrush}"
            Text="{x:Bind ViewModel.CurrentFeatured.LibraryErrorText, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.CurrentFeatured.LibraryErrorVisibility, Mode=OneWay}" />
        </StackPanel>
        <!-- Five pips, the carousel's length; the presenter shows as many as
             there are titles. Left and Right step between them. -->
        <StackPanel
          x:Name="HeroPips"
          Margin="0,0,0,14"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          AutomationProperties.Name="Featured titles"
          KeyDown="OnFeaturedKeyDown"
          Orientation="Horizontal"
          Spacing="8">
          <Button x:Name="HeroPip0" Click="OnHeroPipClick" Style="{StaticResource HeroPipStyle}" Tag="0">
            <Border x:Name="HeroPipFill0" Background="{ThemeResource HaloText1Brush}" CornerRadius="3" RenderTransformOrigin="0,0.5" Visibility="Collapsed">
              <Border.RenderTransform><ScaleTransform x:Name="HeroPipScale0" /></Border.RenderTransform>
            </Border>
          </Button>
          <Button x:Name="HeroPip1" Click="OnHeroPipClick" Style="{StaticResource HeroPipStyle}" Tag="1">
            <Border x:Name="HeroPipFill1" Background="{ThemeResource HaloText1Brush}" CornerRadius="3" RenderTransformOrigin="0,0.5" Visibility="Collapsed">
              <Border.RenderTransform><ScaleTransform x:Name="HeroPipScale1" /></Border.RenderTransform>
            </Border>
          </Button>
          <Button x:Name="HeroPip2" Click="OnHeroPipClick" Style="{StaticResource HeroPipStyle}" Tag="2">
            <Border x:Name="HeroPipFill2" Background="{ThemeResource HaloText1Brush}" CornerRadius="3" RenderTransformOrigin="0,0.5" Visibility="Collapsed">
              <Border.RenderTransform><ScaleTransform x:Name="HeroPipScale2" /></Border.RenderTransform>
            </Border>
          </Button>
          <Button x:Name="HeroPip3" Click="OnHeroPipClick" Style="{StaticResource HeroPipStyle}" Tag="3">
            <Border x:Name="HeroPipFill3" Background="{ThemeResource HaloText1Brush}" CornerRadius="3" RenderTransformOrigin="0,0.5" Visibility="Collapsed">
              <Border.RenderTransform><ScaleTransform x:Name="HeroPipScale3" /></Border.RenderTransform>
            </Border>
          </Button>
          <Button x:Name="HeroPip4" Click="OnHeroPipClick" Style="{StaticResource HeroPipStyle}" Tag="4">
            <Border x:Name="HeroPipFill4" Background="{ThemeResource HaloText1Brush}" CornerRadius="3" RenderTransformOrigin="0,0.5" Visibility="Collapsed">
              <Border.RenderTransform><ScaleTransform x:Name="HeroPipScale4" /></Border.RenderTransform>
            </Border>
          </Button>
        </StackPanel>
      </Grid>
      <!--
        `ShelfSkeleton` twice, while the shelf list itself loads: a title bar
        150 and then 180 wide, a 48px bar at the far end, and six skeleton
        cards. Each pulses as a whole.
      -->
      <StackPanel
        Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}"
        AutomationProperties.AccessibilityView="Raw"
        IsHitTestVisible="False"
        Spacing="28"
        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
        <StackPanel x:Name="ShelfSkeleton0">
          <Grid Height="28" Margin="0,0,0,12">
            <Border Width="150" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
            <Border Width="48" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
          </Grid>
          <StackPanel Margin="0,-4,0,0" Orientation="Horizontal" Spacing="14">
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="ShelfSkeleton1">
          <Grid Height="28" Margin="0,0,0,12">
            <Border Width="180" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
            <Border Width="48" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
          </Grid>
          <StackPanel Margin="0,-4,0,0" Orientation="Horizontal" Spacing="14">
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
            <local:PosterSkeleton />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}" Visibility="{x:Bind ViewModel.ContinueVisibility, Mode=OneWay}">
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource HaloShelfTitle}" Text="Continue watching" />
          <TextBlock Grid.Column="1" Margin="10,0,0,2" VerticalAlignment="Bottom" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.ContinueCountLabel, Mode=OneWay}" />
          <Button Grid.Column="3" Padding="8,3" Background="Transparent" BorderThickness="0" FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloAccentBrush}" Content="See all" AutomationProperties.Name="See all in progress titles" Click="OnContinueSeeAllClick" />
          <Button x:Name="ContinueScrollLeftButton" Grid.Column="4" Width="28" Height="28" MinWidth="0" Margin="8,0,0,0" Padding="0" AutomationProperties.Name="Scroll Continue watching left" Click="OnContinueScrollLeft" ToolTipService.ToolTip="Scroll left">
            <FontIcon FontSize="{StaticResource HaloFontLabel}" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76B;" />
          </Button>
          <Button x:Name="ContinueScrollRightButton" Grid.Column="5" Width="28" Height="28" MinWidth="0" Margin="6,0,0,0" Padding="0" AutomationProperties.Name="Scroll Continue watching right" Click="OnContinueScrollRight" ToolTipService.ToolTip="Scroll right">
            <FontIcon FontSize="{StaticResource HaloFontLabel}" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76C;" />
          </Button>
        </Grid>
        <!-- Holds the strip. No edge fades: see MediaShelf.xaml. -->
        <Grid>
          <ScrollViewer x:Name="ContinueScroller" Margin="0,-4,0,0" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" ZoomMode="Disabled" ViewChanged="OnContinueViewChanged" SizeChanged="OnContinueScrollerSizeChanged">
            <!-- The wheel handler belongs on the content, not on the scroller. A
                 ScrollViewer class-handles the wheel before any handler attached to
                 the scroller itself, and marks it handled, so one attached there is
                 never called. The transparent background makes the gaps between
                 cards hit-testable too, so the strip answers everywhere. -->
            <Grid Background="Transparent" PointerWheelChanged="OnStripPointerWheelChanged" SizeChanged="OnContinueScrollerSizeChanged">
              <!-- The last list on this page that realised everything it was given. -->
              <ItemsRepeater x:Name="ContinueList">
              <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="14" /></ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <!-- The slot is sized so whole cards fill the strip (WholeCardStrip);
                     the card stretches to it and keeps its 16:9 still. -->
                <DataTemplate x:DataType="local:ContinueItem">
                  <Grid>
                    <local:ContinueCard
                      Title="{x:Bind Name}"
                      Meta="{x:Bind Sub}"
                      Art="{x:Bind Art, Mode=OneWay}"
                      EpisodeTag="{x:Bind Tag}"
                      TimeLeft="{x:Bind TimeLeft}"
                      Progress="{x:Bind Progress}"
                      Tag="{x:Bind}"
                      Click="OnContinueItemClick" />
                  </Grid>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </Grid>
          </ScrollViewer>
        </Grid>
      </StackPanel>
      <!--
        A repeater, not an items control: the catalog cap allows sixteen shelves
        plus the history and the library, and an items control realises every
        one of them at page load. Each shelf carries its own scroll viewer and
        repeater, and every one of those recomputes its realisation window on
        each scroll frame, on screen or not. Virtualising here keeps that work
        to the shelves actually in view. The shelf hands itself through Tag so
        its See all knows where it leads.
      -->
      <ItemsRepeater x:Name="ShelfList" Margin="{x:Bind ViewModel.ContentPadding, Mode=OneWay}" ElementPrepared="OnShelfElementPrepared">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Vertical" Spacing="28" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="local:Shelf">
            <local:MediaShelf Title="{x:Bind Title}" SourceLabel="{x:Bind SourceLabel}" ItemsSource="{x:Bind Items}" IsLoading="{x:Bind IsLoading}" Tag="{x:Bind}" ItemClick="OnShelfItemClick" SeeAllClick="OnShelfSeeAllClick" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</Page>
