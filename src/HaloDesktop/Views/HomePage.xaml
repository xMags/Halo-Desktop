<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  NavigationCacheMode="Required">
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel Padding="0,0,0,48" Spacing="28">
      <local:SectionHeader Title="Home" Crumb="ALL CATALOGS">
        <local:SectionHeader.RightContent>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <AutoSuggestBox
              x:Name="HomeSearchBox"
              Width="300"
              Height="32"
              VerticalAlignment="Center"
              FontSize="13"
              PlaceholderText="Search movies and series"
              QueryIcon="Find"
              QuerySubmitted="OnSearchSubmitted" />
            <Border Style="{StaticResource HaloSegmentedTrayStyle}">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="HomeFilter" IsChecked="True" Click="OnAllFilterClick" Content="All" Style="{StaticResource HaloSegmentedRadioStyle}" />
                <RadioButton GroupName="HomeFilter" Click="OnMoviesFilterClick" Content="Movies" Style="{StaticResource HaloSegmentedRadioStyle}" />
                <RadioButton GroupName="HomeFilter" Click="OnSeriesFilterClick" Content="Series" Style="{StaticResource HaloSegmentedRadioStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </local:SectionHeader.RightContent>
      </local:SectionHeader>
      <Grid Height="304" Margin="24,0" CornerRadius="8">
        <local:PlaceholderArt Caption="BACKDROP 1920×1080" />
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Offset="0" Color="{ThemeResource HaloHeroScrim1Color}" />
              <GradientStop Offset="0.52" Color="{ThemeResource HaloHeroScrim2Color}" />
              <GradientStop Offset="0.92" Color="#0018181A" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <StackPanel Width="580" Margin="40,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
          <TextBlock Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoKicker}" Text="FEATURED" />
          <TextBlock Style="{StaticResource HaloHeroTitle}" Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind ViewModel.HeroRating, Mode=OneWay}" />
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloText4Brush}" Text="·" />
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.HeroMeta, Mode=OneWay}" />
          </StackPanel>
          <TextBlock MaxWidth="520" Style="{StaticResource HaloBody}" Text="{x:Bind ViewModel.HeroSynopsis, Mode=OneWay}" />
          <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
            <Button Height="36" Padding="18,0" AutomationProperties.Name="Resume S02E04" Click="OnResumeClick" Style="{StaticResource HaloAccentButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE768;" />
                <TextBlock VerticalAlignment="Center" Text="Resume S02E04" />
              </StackPanel>
            </Button>
            <Button Height="36" Padding="18,0" Click="OnDetailsClick" Content="Details" />
            <Button AutomationProperties.Name="Add to bookmarks" Style="{StaticResource HaloIconButtonStyle}" ToolTipService.ToolTip="Bookmarking is not available in this prototype">
              <FontIcon FontSize="14" Glyph="&#xE734;" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
      <StackPanel Margin="24,0">
        <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="10">
          <TextBlock Style="{StaticResource HaloShelfTitle}" Text="Continue watching" />
          <TextBlock VerticalAlignment="Bottom" Style="{StaticResource HaloMonoData}" Text="4 IN PROGRESS" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
          <ItemsControl x:Name="ContinueList" PointerWheelChanged="OnContinueWheelChanged">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ContinueItem">
                <Button Width="268" Padding="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="OnContinueItemClick">
                  <StackPanel>
                    <Grid Height="151">
                      <local:PlaceholderArt />
                      <local:TagChip Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Text="{x:Bind Tag}" />
                      <local:TagChip Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="{x:Bind TimeLeft}" />
                      <ProgressBar Height="3" VerticalAlignment="Bottom" Maximum="1" Value="{x:Bind Progress}" />
                    </Grid>
                    <TextBlock Margin="1,8,1,0" FontSize="13" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="1,3,1,0" Style="{StaticResource HaloMonoData}" Text="{x:Bind Sub}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
      <ItemsControl x:Name="ShelfList" Margin="24,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:Shelf">
            <local:MediaShelf Margin="0,0,0,28" Title="{x:Bind Title}" SourceLabel="{x:Bind SourceLabel}" ItemsSource="{x:Bind Items}" ItemClick="OnShelfItemClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
