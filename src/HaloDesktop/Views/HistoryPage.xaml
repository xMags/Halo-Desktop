<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.HistoryPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  ContextRequested="OnContextRequested"
  NavigationCacheMode="Required">
  <Page.Resources>
    <!-- `.icon-btn.icon-btn-bare` in `.history-actions`: 32 square, no plate at rest, the Text2 glyph. -->
    <Style x:Key="HistoryActionButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
      <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
    </Style>
    <!--
      `.history-grid`: as many columns as fit at 400 (or the whole width when
      narrower, which the page sets as the width changes), stretched to share
      the row, 8 apart. One layout for every section, so they all agree.
      Cards are 96 tall: the 78 thumbnail, 8 above and below, the 1px frame.
    -->
    <UniformGridLayout
      x:Key="HistoryCardLayout"
      ItemsStretch="Fill"
      MinColumnSpacing="8"
      MinItemHeight="96"
      MinItemWidth="400"
      MinRowSpacing="8"
      Orientation="Horizontal" />
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <local:SectionHeader x:Name="Header" Title="History">
      <local:SectionHeader.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <!-- `SearchBox`: 300 x 32 at 15px, its Clear button shown whenever it holds text. -->
          <Grid Width="300" Height="32" VerticalAlignment="Center">
            <TextBox
              x:Name="QueryBox"
              Height="32"
              Padding="11,5,66,0"
              VerticalContentAlignment="Center"
              AutomationProperties.Name="Search history"
              FontSize="{StaticResource HaloFontBody}"
              IsSpellCheckEnabled="False"
              Loaded="OnQueryBoxLoaded"
              PlaceholderText="Search history"
              Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
              <Button
                Width="28"
                Height="24"
                MinWidth="0"
                Padding="0"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Clear"
                Background="Transparent"
                BorderThickness="0"
                Click="OnClearQueryClick"
                IsTabStop="False"
                ToolTipService.ToolTip="Clear"
                Visibility="{x:Bind ViewModel.ClearQueryVisibility, Mode=OneWay}">
                <FontIcon FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE894;" />
              </Button>
              <FontIcon Width="32" FontSize="12" Foreground="{ThemeResource HaloText1Brush}" Glyph="&#xE721;" IsHitTestVisible="False" />
            </StackPanel>
          </Grid>
          <Border VerticalAlignment="Center" Style="{StaticResource HaloSegmentedTrayStyle}">
            <StackPanel Orientation="Horizontal">
              <RadioButton GroupName="HistoryFilter" IsChecked="True" Click="OnAllFilterClick" Content="All" Style="{StaticResource HaloSegmentedRadioStyle}" />
              <RadioButton GroupName="HistoryFilter" Click="OnMoviesFilterClick" Content="Movies" Style="{StaticResource HaloSegmentedRadioStyle}" />
              <RadioButton GroupName="HistoryFilter" Click="OnSeriesFilterClick" Content="Series" Style="{StaticResource HaloSegmentedRadioStyle}" />
            </StackPanel>
          </Border>
          <Button
            Height="32"
            Padding="14,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="Clear history"
            Click="OnClearHistoryClick"
            FontSize="{StaticResource HaloFontLabel}"
            IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}"
            Style="{StaticResource HaloDangerOutlineButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon VerticalAlignment="Center" FontSize="13" Glyph="&#xE74D;" />
              <TextBlock VerticalAlignment="Center" Text="Clear history" />
            </StackPanel>
          </Button>
        </StackPanel>
      </local:SectionHeader.RightContent>
    </local:SectionHeader>

    <!-- `.history-scroll`: 8 above, the gutter at the sides, 32 below. -->
    <ScrollViewer
      x:Name="HistoryScroller"
      Grid.Row="1"
      HorizontalScrollBarVisibility="Disabled"
      HorizontalScrollMode="Disabled"
      SizeChanged="OnScrollerSizeChanged"
      VerticalScrollBarVisibility="Hidden">
      <StackPanel x:Name="HistoryBody" Padding="24,8,24,32">
        <!-- `.state-note`: 15px Text3, inset by the gutter again and 14 above and below. -->
        <StackPanel
          x:Name="ErrorNote"
          Margin="24,14,24,14"
          Orientation="Horizontal"
          Spacing="12"
          Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloCriticalBrush}" Text="Your history could not be loaded." />
          <Button VerticalAlignment="Center" Click="OnRetryClick" Content="Retry" />
        </StackPanel>
        <TextBlock
          x:Name="StateNote"
          Margin="24,14,24,14"
          FontSize="{StaticResource HaloFontBody}"
          Foreground="{ThemeResource HaloText3Brush}"
          Text="{x:Bind ViewModel.Note, Mode=OneWay}"
          TextWrapping="Wrap"
          Visibility="{x:Bind ViewModel.NoteVisibility, Mode=OneWay}" />
        <ItemsRepeater x:Name="GroupsRepeater">
          <ItemsRepeater.Layout>
            <StackLayout Spacing="24" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:HistoryGroupViewModel">
              <StackPanel>
                <!-- `.history-label`: mono 700 12px, .06em, capitals, Text3; the count regular at .75. -->
                <StackPanel Margin="2,8,0,10" Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    CharacterSpacing="60"
                    FontFamily="{StaticResource HaloMonoBoldFont}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{ThemeResource HaloText3Brush}"
                    Text="{x:Bind Label}" />
                  <TextBlock
                    CharacterSpacing="60"
                    FontFamily="{StaticResource HaloMonoFont}"
                    FontSize="12"
                    Foreground="{ThemeResource HaloText3Brush}"
                    Opacity="0.75"
                    Text="{x:Bind Count}" />
                </StackPanel>
                <ItemsRepeater
                  ElementPrepared="OnCardPrepared"
                  ItemsSource="{x:Bind Entries}"
                  Layout="{StaticResource HistoryCardLayout}">
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryEntryViewModel">
                      <!--
                        `.history-row`: the control fill and stroke, radius 8, the
                        hover fill under the pointer. The two fills are separate
                        plates swapped by opacity, so both keep their theme
                        brushes. The buttons on the right fade in over 120ms on
                        hover or focus and keep their room when hidden. Nothing
                        here takes a composition visual, so the opacity
                        transition is the only animation API on the card.
                      -->
                      <Grid
                        BorderBrush="{ThemeResource HaloCtrlStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        GotFocus="OnCardGotFocus"
                        LostFocus="OnCardLostFocus"
                        PointerCanceled="OnCardPointerExited"
                        PointerEntered="OnCardPointerEntered"
                        PointerExited="OnCardPointerExited"
                        Tag="{x:Bind}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RestPlate" Grid.ColumnSpan="2" Background="{ThemeResource HaloCtrlBrush}" CornerRadius="7" />
                        <Border x:Name="HoverPlate" Grid.ColumnSpan="2" Background="{ThemeResource HaloCtrlHoverBrush}" CornerRadius="7" Opacity="0" />
                        <!-- `.history-open`: everything but the buttons; resumes, or opens the title page once finished. -->
                        <Button
                          Padding="8,8,4,8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="{x:Bind OpenLabel}"
                          Background="Transparent"
                          BorderThickness="0"
                          Click="OnEntryClick"
                          CornerRadius="7,0,0,7"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="{x:Bind OpenLabel}">
                          <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                          </Button.Resources>
                          <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- `.history-thumb`: 52 x 78, radius 4; the poster, then metahub's, then the plain fill. -->
                            <Border Width="52" Height="78" Background="{ThemeResource HaloCardBrush}" CornerRadius="4">
                              <Grid>
                                <local:ArtworkImage DecodeWidth="104" MetaId="{x:Bind MetaId}" SourceUrl="{x:Bind Poster}" />
                                <!-- `.art-progress`: 3px, the dark track and the accent fill. -->
                                <Grid Height="3" VerticalAlignment="Bottom" Background="{StaticResource HaloProgressTrackBrush}" Visibility="{x:Bind ProgressVisibility}">
                                  <Border Width="{x:Bind ProgressWidth}" HorizontalAlignment="Left" Background="{ThemeResource HaloAccentBrush}" />
                                </Grid>
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                              <TextBlock
                                FontSize="15"
                                Foreground="{ThemeResource HaloText1Brush}"
                                LineHeight="20"
                                MaxLines="1"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                LineHeight="16"
                                MaxLines="1"
                                Style="{StaticResource HaloMonoData}"
                                Text="{x:Bind Meta}"
                                TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="13"
                                Foreground="{ThemeResource HaloText3Brush}"
                                Text="{x:Bind Time}"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind FullTime}" />
                            </StackPanel>
                          </Grid>
                        </Button>
                        <!-- `.history-actions`. -->
                        <StackPanel
                          x:Name="Actions"
                          Grid.Column="1"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Opacity="0"
                          Orientation="Horizontal"
                          Spacing="2">
                          <StackPanel.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                          </StackPanel.OpacityTransition>
                          <Button
                            AutomationProperties.Name="{x:Bind PlayLabel}"
                            Click="OnPlayClick"
                            Style="{StaticResource HistoryActionButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind PlayLabel}">
                            <FontIcon FontSize="16" Glyph="{x:Bind PlayGlyph}" />
                          </Button>
                          <Button
                            AutomationProperties.Name="More options"
                            Click="OnMoreClick"
                            Style="{StaticResource HistoryActionButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="More options">
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
