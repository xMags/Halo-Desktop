<?xml version="1.0" encoding="utf-8"?>
<!--
  History as a timeline, in Windows' own (Fluent) shapes, laid out as Downloads
  is: the title, then the tabs on the left with the search and a menu on the
  right. Each section (Today, Yesterday, Earlier this week, then a month) has
  its heading in a column on the left and its videos as rows of one card on
  the right. A row's buttons replace its time while the pointer is over it or
  focus is inside it; Clear history waits in the header's menu.
-->
<Page
  x:Class="HaloDesktop.HistoryPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  ContextRequested="OnContextRequested"
  Loaded="OnLoaded"
  NavigationCacheMode="Required"
  Unloaded="OnUnloaded">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="HistoryTrackBrush" Color="#29FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="HistoryTrackBrush" Color="#1F000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- A command bar button: no plate at rest, as Downloads' header has. -->
      <Style x:Key="HistorySubtleButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The title; under it the tabs on the left, the search and the menu on the right. -->
    <Grid Padding="32,28,32,4" RowSpacing="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        FontFamily="Segoe UI Variable Display"
        FontSize="28"
        FontWeight="SemiBold"
        Foreground="{ThemeResource HaloText1Brush}"
        Text="History" />
      <Grid Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <SelectorBar x:Name="FilterBar" HorizontalAlignment="Left" SelectionChanged="OnFilterSelectionChanged">
          <SelectorBarItem x:Name="AllFilterItem" IsSelected="True" Text="{x:Bind ViewModel.AllTabText, Mode=OneWay}" />
          <SelectorBarItem x:Name="MoviesFilterItem" Text="{x:Bind ViewModel.MoviesTabText, Mode=OneWay}" />
          <SelectorBarItem x:Name="SeriesFilterItem" Text="{x:Bind ViewModel.SeriesTabText, Mode=OneWay}" />
          <SelectorBarItem x:Name="InProgressFilterItem" Text="{x:Bind ViewModel.InProgressTabText, Mode=OneWay}" />
        </SelectorBar>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
          <!-- The search box, its Clear button shown whenever it holds text. -->
          <Grid Width="280" Height="32">
            <TextBox
              x:Name="QueryBox"
              Height="32"
              Padding="11,5,62,0"
              VerticalContentAlignment="Center"
              AutomationProperties.Name="Search history"
              IsSpellCheckEnabled="False"
              Loaded="OnQueryBoxLoaded"
              PlaceholderText="Search history"
              Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
              <Button
                Width="28"
                Height="24"
                MinWidth="0"
                Padding="0"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Clear search"
                Background="Transparent"
                BorderThickness="0"
                Click="OnClearQueryClick"
                IsTabStop="False"
                ToolTipService.ToolTip="Clear search"
                Visibility="{x:Bind ViewModel.ClearQueryVisibility, Mode=OneWay}">
                <FontIcon FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE894;" />
              </Button>
              <FontIcon Width="30" FontSize="13" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE721;" IsHitTestVisible="False" />
            </StackPanel>
          </Grid>
          <Button AutomationProperties.Name="More history actions" Style="{StaticResource HistorySubtleButtonStyle}" ToolTipService.ToolTip="More history actions">
            <FontIcon FontSize="14" Glyph="&#xE712;" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem
                  MinWidth="220"
                  Click="OnClearHistoryClick"
                  IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}"
                  Style="{StaticResource HaloDangerMenuFlyoutItemStyle}"
                  Text="Clear history…">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- A long history needs to show where it is and to be dragged through, so
         the standard bar shows: a thin line at rest, full width under the pointer. -->
    <ScrollViewer
      x:Name="HistoryScroller"
      Grid.Row="1"
      HorizontalScrollBarVisibility="Disabled"
      HorizontalScrollMode="Disabled"
      VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="32,16,32,40" Spacing="28">
        <Grid Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
          <InfoBar IsClosable="False" IsOpen="True" Message="Check the connection to your Halo server." Severity="Error" Title="Your history could not be loaded.">
            <InfoBar.ActionButton>
              <Button Click="OnRetryClick" Content="Retry" />
            </InfoBar.ActionButton>
          </InfoBar>
        </Grid>
        <TextBlock
          FontSize="{StaticResource HaloFontBody}"
          Foreground="{ThemeResource HaloText2Brush}"
          Text="{x:Bind ViewModel.Note, Mode=OneWay}"
          TextWrapping="Wrap"
          Visibility="{x:Bind ViewModel.NoteVisibility, Mode=OneWay}" />
        <!--
          The sections are a plain items control, every one built: there are only
          a few dozen (today, yesterday, this week, then one per month). A
          virtualising repeater here guessed the height of the sections it had not
          built, and dragging the scrollbar into them met their real heights, so
          the page's length changed under the thumb and pushed it back. The rows
          inside each section still virtualise; they are one height, so each
          card's height is exact.
        -->
        <ItemsControl x:Name="GroupsList" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="28" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:HistoryGroupViewModel">
              <!--
                The heading's first line sits on the first row's title line: the
                card's 1px edge, the row's 8 above, then the 4 that centres the
                two text lines (46) on the 54 poster make 13.
              -->
              <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,13,0,0" Spacing="2">
                  <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource HaloText1Brush}"
                    LineHeight="20"
                    LineStackingStrategy="BlockLineHeight"
                    Text="{x:Bind Label}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                  <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource HaloText3Brush}"
                    LineHeight="18"
                    LineStackingStrategy="BlockLineHeight"
                    Text="{x:Bind Count}" />
                </StackPanel>
                <Border
                  Grid.Column="1"
                  Background="{ThemeResource HaloCardBrush}"
                  BorderBrush="{ThemeResource HaloCardStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                  <ItemsRepeater ElementPrepared="OnCardPrepared" ItemsSource="{x:Bind Entries}">
                    <ItemsRepeater.Layout>
                      <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="local:HistoryEntryViewModel">
                        <!--
                          One row, 70 tall: the 54 poster and 8 above and below.
                          The hover wash is a plate faded by opacity, so it keeps
                          its theme brush; the time and the buttons share the
                          right-hand cell and swap over 120ms.
                        -->
                        <Grid
                          Height="70"
                          GotFocus="OnCardGotFocus"
                          LostFocus="OnCardLostFocus"
                          PointerCanceled="OnCardPointerExited"
                          PointerEntered="OnCardPointerEntered"
                          PointerExited="OnCardPointerExited"
                          Tag="{x:Bind}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border x:Name="HoverPlate" Grid.ColumnSpan="2" Background="{ThemeResource HaloCtrlAltTertiaryBrush}" Opacity="0">
                            <Border.OpacityTransition>
                              <ScalarTransition Duration="0:0:0.12" />
                            </Border.OpacityTransition>
                          </Border>
                          <!-- The rule above every row but the first, from the text's edge. -->
                          <Border
                            Grid.ColumnSpan="2"
                            Height="1"
                            Margin="62,0,0,0"
                            VerticalAlignment="Top"
                            Background="{ThemeResource HaloCardStrokeBrush}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind DividerVisibility}" />
                          <!-- Everything but the buttons: resumes, or opens the title page once finished. -->
                          <Button
                            Padding="12,8,12,8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="{x:Bind OpenLabel}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnEntryClick"
                            CornerRadius="0"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind OpenLabel}">
                            <Button.Resources>
                              <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                              <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                              <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>
                            <Grid ColumnSpacing="14">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <!-- The poster, then metahub's, then the plain fill. -->
                              <Border Width="36" Height="54" Background="{ThemeResource HaloCtrlAltTertiaryBrush}" CornerRadius="4">
                                <local:ArtworkImage DecodeWidth="72" MetaId="{x:Bind MetaId}" SourceUrl="{x:Bind Poster}" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock
                                  FontSize="15"
                                  Foreground="{ThemeResource HaloText1Brush}"
                                  LineHeight="20"
                                  LineStackingStrategy="BlockLineHeight"
                                  Text="{x:Bind Title}"
                                  TextTrimming="CharacterEllipsis"
                                  TextWrapping="NoWrap" />
                                <!-- The tag, then the bar and the time left, or the check and Watched. -->
                                <StackPanel Height="20" Orientation="Horizontal" Spacing="10">
                                  <Border
                                    Height="20"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource HaloCtrlBrush}"
                                    BorderBrush="{ThemeResource HaloCtrlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                      VerticalAlignment="Center"
                                      CharacterSpacing="40"
                                      FontFamily="{StaticResource HaloMonoBoldFont}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="{ThemeResource HaloText2Brush}"
                                      Text="{x:Bind Tag}" />
                                  </Border>
                                  <Grid
                                    Width="120"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource HistoryTrackBrush}"
                                    CornerRadius="2"
                                    Visibility="{x:Bind ProgressVisibility}">
                                    <Border Width="{x:Bind ProgressWidth}" HorizontalAlignment="Left" Background="{ThemeResource HaloAccentBrush}" CornerRadius="2" />
                                  </Grid>
                                  <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      Foreground="{ThemeResource HaloSuccessBrush}"
                                      Glyph="&#xE73E;"
                                      Visibility="{x:Bind WatchedVisibility}" />
                                    <TextBlock
                                      VerticalAlignment="Center"
                                      FontSize="13"
                                      Foreground="{ThemeResource HaloText2Brush}"
                                      Text="{x:Bind State}" />
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Grid>
                          </Button>
                          <!-- The time at rest, the buttons in its place on hover or focus. -->
                          <Grid Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock
                              x:Name="TimeText"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              FontSize="13"
                              Foreground="{ThemeResource HaloText3Brush}"
                              Text="{x:Bind Time}"
                              TextWrapping="NoWrap"
                              ToolTipService.ToolTip="{x:Bind FullTime}">
                              <TextBlock.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.12" />
                              </TextBlock.OpacityTransition>
                            </TextBlock>
                            <StackPanel
                              x:Name="Actions"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Opacity="0"
                              Orientation="Horizontal"
                              Spacing="4">
                              <StackPanel.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.12" />
                              </StackPanel.OpacityTransition>
                              <Button
                                Height="32"
                                Padding="12,0"
                                AutomationProperties.Name="{x:Bind PlayLabel}"
                                Click="OnPlayClick"
                                CornerRadius="4"
                                Style="{StaticResource AccentButtonStyle}"
                                Tag="{x:Bind}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="{x:Bind PlayGlyph}" />
                                  <TextBlock VerticalAlignment="Center" Text="{x:Bind PlayLabel}" />
                                </StackPanel>
                              </Button>
                              <Button
                                AutomationProperties.Name="More options"
                                Click="OnMoreClick"
                                Style="{StaticResource HistorySubtleButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="More options">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
