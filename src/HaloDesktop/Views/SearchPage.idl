// The top match is the shared MediaSummary model.
import "Models/Models.idl";

namespace HaloDesktop
{
    // How the action card's glyph tile reads: working or ready, can't go on
    // through no fault of the viewer's, refused or failed, or simply not possible.
    enum SearchActionTone
    {
        Accent,
        Warn,
        Bad,
        Mute,
    };

    // What the action card leads with: the found title's poster, or a glyph tile.
    enum SearchActionGlyph
    {
        Poster,
        Id,
        Link,
        Magnet,
    };

    // A past search, as a recent pill or a suggestion under the box.
    [default_interface]
    runtimeclass RecentSearchViewModel
    {
        String Term { get; };
        String RemoveLabel { get; };
    }

    // One person in the people row: their photo (initials until it loads),
    // name and what they are known for.
    [default_interface]
    runtimeclass SearchPersonViewModel
    {
        String Name { get; };
        String Line { get; };
        // What they are ("Actor"), under the portrait; empty when unknown.
        String Role { get; };
        // The whole line, known-for titles included, as the card's tooltip;
        // null when there is nothing to say.
        Object LineToolTip { get; };
        String Photo { get; };
        String Initials { get; };
    }

    runtimeclass SearchViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Query;
        Microsoft.UI.Xaml.Visibility ClearVisibility { get; };
        Object Suggestions { get; };
        Object RecentItems { get; };
        Object LibraryItems { get; };
        Object ResultItems { get; };
        // The people row: between the top match and the results when it came
        // with them, under the results when it came later.
        Object PeopleItems { get; };
        Microsoft.UI.Xaml.Visibility PeopleAboveVisibility { get; };
        Microsoft.UI.Xaml.Visibility PeopleBelowVisibility { get; };
        // People search, when the server has it: the legend's item and the box's words.
        Microsoft.UI.Xaml.Visibility PeopleHintVisibility { get; };
        // The legend's link item: "HTTP & Magnet Links" when the server opens magnets.
        String LinksHintText { get; };
        String Placeholder { get; };
        Boolean ShowKindBadges { get; };
        String ResultCountText { get; };
        String StatusText { get; };
        Boolean StillAsking { get; };
        Boolean ResultsStale { get; };
        String FilteredEmptyText { get; };

        MediaSummary TopMatch { get; };
        String TopMatchTitle { get; };
        String TopMatchRating { get; };
        String TopMatchKind { get; };
        String TopMatchYear { get; };
        String TopMatchBlurb { get; };
        String TopMatchPoster { get; };
        String TopMatchMetaId { get; };
        String TopMatchBackdrop { get; };
        String TopMatchSoftBackdrop { get; };
        Microsoft.UI.Xaml.Visibility TopMatchRatingVisibility { get; };
        Microsoft.UI.Xaml.Visibility TopMatchYearVisibility { get; };
        Microsoft.UI.Xaml.Visibility TopMatchInLibraryVisibility { get; };
        Microsoft.UI.Xaml.Visibility TopMatchBlurbVisibility { get; };

        Microsoft.UI.Xaml.Visibility SuggestionsVisibility { get; };
        Microsoft.UI.Xaml.Visibility RecentVisibility { get; };
        Microsoft.UI.Xaml.Visibility HintsVisibility { get; };
        Microsoft.UI.Xaml.Visibility NoAddonsVisibility { get; };
        Microsoft.UI.Xaml.Visibility TopMatchVisibility { get; };
        Microsoft.UI.Xaml.Visibility TopMatchSkeletonVisibility { get; };
        Microsoft.UI.Xaml.Visibility LibraryVisibility { get; };
        Microsoft.UI.Xaml.Visibility ResultsVisibility { get; };
        Microsoft.UI.Xaml.Visibility ResultsSkeletonVisibility { get; };
        Microsoft.UI.Xaml.Visibility StatusVisibility { get; };
        Boolean StatusFailed { get; };
        Microsoft.UI.Xaml.Visibility FilteredEmptyVisibility { get; };
        Microsoft.UI.Xaml.Visibility NothingFoundVisibility { get; };
        Microsoft.UI.Xaml.Visibility AddonsUnreachableVisibility { get; };

        // The card in the top match's place for a pasted link or id.
        Microsoft.UI.Xaml.Visibility ActionCardVisibility { get; };
        SearchActionTone ActionTone { get; };
        SearchActionGlyph ActionGlyph { get; };
        String ActionKicker { get; };
        String ActionTitle { get; };
        String ActionRating { get; };
        String ActionMono { get; };
        String ActionYear { get; };
        Microsoft.UI.Xaml.Visibility ActionMetaVisibility { get; };
        Microsoft.UI.Xaml.Visibility ActionRatingVisibility { get; };
        Microsoft.UI.Xaml.Visibility ActionMonoVisibility { get; };
        Microsoft.UI.Xaml.Visibility ActionYearVisibility { get; };
        String ActionTail { get; };
        Microsoft.UI.Xaml.Visibility ActionTailVisibility { get; };
        // 0 to 100 while the server fetches a magnet.
        Double ActionProgress { get; };
        Microsoft.UI.Xaml.Visibility ActionProgressVisibility { get; };
        String ActionSecondary { get; };
        Microsoft.UI.Xaml.Visibility ActionSecondaryVisibility { get; };
        String ActionPoster { get; };
        String ActionMetaId { get; };
        Microsoft.UI.Xaml.Visibility ActionPosterVisibility { get; };
        String ActionButtonLabel { get; };
        Microsoft.UI.Xaml.Visibility ActionButtonVisibility { get; };
        Microsoft.UI.Xaml.Visibility ActionButtonGlyphVisibility { get; };
        void ActivateAction();
        // The magnet card's standard button, by click only.
        String ActionPlainButtonLabel { get; };
        Microsoft.UI.Xaml.Visibility ActionPlainButtonVisibility { get; };
        Microsoft.UI.Xaml.Visibility ActionPlainButtonGlyphVisibility { get; };
        void ActivatePlainAction();

        void SetFilter(Int32 index);
        void SetBoxFocused(Boolean focused);
        void Submit();
        void ClearQuery();
        void SearchAgain(String term);
        void Forget(String term);
        void ForgetAll();
        void ShowAllResults();
        // The empty states' buttons: the same query asked again, and Settings.
        void RetrySearch();
        void OpenSettings();
        void OpenDetail(Object item);
        void OpenTopMatch();
        void OpenPerson(Object item);
        void Arrive(String query);
        void Shown();
        void Hidden();
    }

    [default_interface]
    runtimeclass SearchPage : Microsoft.UI.Xaml.Controls.Page
    {
        SearchPage();
        SearchViewModel ViewModel { get; };
    }
}
