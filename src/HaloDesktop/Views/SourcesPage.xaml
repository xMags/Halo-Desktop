<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SourcesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <local:SectionHeader Title="Sources" />
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"><ProgressRing IsActive="True" /><TextBlock Text="Resolving fresh sources…" /></StackPanel>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource HaloCriticalBrush}" Text="Sources could not be resolved." /><Button Content="Retry" Click="OnRetryClick" /></StackPanel>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"><TextBlock Text="No playable sources were returned." /><TextBlock Foreground="{ThemeResource HaloText3Brush}" Text="Try again later or install another stream addon." /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
      <Grid Margin="24,8,24,48" ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="292" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="18">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <local:PlaceholderArt Width="62" Height="92" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoKicker}" Text="{x:Bind ViewModel.EpisodeLabel, Mode=OneWay}" />
              <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
              <TextBlock FontSize="12.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ViewModel.ResolveSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
              <RadioButton GroupName="SourceFilter" IsChecked="True" Click="OnAllFilterClick" Content="{x:Bind ViewModel.AllFilterLabel, Mode=OneWay}" Style="{StaticResource HaloChipRadioStyle}" />
              <RadioButton GroupName="SourceFilter" Click="OnInstantFilterClick" Content="{x:Bind ViewModel.InstantFilterLabel, Mode=OneWay}" Style="{StaticResource HaloChipRadioStyle}" />
              <RadioButton GroupName="SourceFilter" Click="On2160FilterClick" Content="{x:Bind ViewModel.Quality2160FilterLabel, Mode=OneWay}" Style="{StaticResource HaloChipRadioStyle}" />
              <RadioButton GroupName="SourceFilter" Click="On1080FilterClick" Content="{x:Bind ViewModel.Quality1080FilterLabel, Mode=OneWay}" Style="{StaticResource HaloChipRadioStyle}" />
            </StackPanel>
          </Grid>

          <Border
            x:Name="BestSourceCard"
            Padding="18"
            Background="{ThemeResource HaloAccentTintBrush}"
            BorderBrush="{ThemeResource HaloAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="18">
              <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind ViewModel.BestQuality, Mode=OneWay}" />
                <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.BestRange, Mode=OneWay}" />
              </StackPanel>
              <Rectangle Grid.Column="1" Fill="{ThemeResource HaloDividerBrush}" />
              <StackPanel Grid.Column="2" Spacing="7">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource HaloSuccessBrush}" Text="{x:Bind ViewModel.BestStatusLine, Mode=OneWay}" />
                  <Border Padding="6,2" Background="{ThemeResource HaloSuccessTintBrush}" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9.5" Foreground="{ThemeResource HaloSuccessBrush}" Text="{x:Bind ViewModel.BestStatusBadge, Mode=OneWay}" /></Border>
                </StackPanel>
                <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.BestFile, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="7">
                  <Border Padding="8,2" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.BestCodec, Mode=OneWay}" /></Border>
                  <Border Padding="8,2" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.BestAudio, Mode=OneWay}" /></Border>
                  <Border Padding="8,2" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.BestLanguages, Mode=OneWay}" /></Border>
                  <Border Padding="8,2" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.BestSize, Mode=OneWay}" /></Border>
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="3" VerticalAlignment="Center" Click="OnPlayClick" Content="Play" Style="{StaticResource HaloAccentButtonStyle}" />
            </Grid>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="VideoHeaderColumn" Width="0" /><ColumnDefinition x:Name="AudioHeaderColumn" Width="0" /><ColumnDefinition x:Name="LanguagesHeaderColumn" Width="0" /><ColumnDefinition Width="112" /><ColumnDefinition Width="76" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup>
                <VisualState x:Name="WideSourceHeaders">
                  <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1600" /></VisualState.StateTriggers>
                  <VisualState.Setters>
                    <Setter Target="VideoHeaderColumn.Width" Value="84" />
                    <Setter Target="AudioHeaderColumn.Width" Value="100" />
                    <Setter Target="LanguagesHeaderColumn.Width" Value="110" />
                    <Setter Target="VideoHeader.Visibility" Value="Visible" />
                    <Setter Target="AudioHeader.Visibility" Value="Visible" />
                    <Setter Target="LanguagesHeader.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock Style="{StaticResource HaloMonoKicker}" Text="QUALITY" />
            <TextBlock Grid.Column="1" Style="{StaticResource HaloMonoKicker}" Text="FILE" />
            <TextBlock x:Name="VideoHeader" Grid.Column="2" Style="{StaticResource HaloMonoKicker}" Text="VIDEO" Visibility="Collapsed" />
            <TextBlock x:Name="AudioHeader" Grid.Column="3" Style="{StaticResource HaloMonoKicker}" Text="AUDIO" Visibility="Collapsed" />
            <TextBlock x:Name="LanguagesHeader" Grid.Column="4" Style="{StaticResource HaloMonoKicker}" Text="LANGUAGES" Visibility="Collapsed" />
            <TextBlock Grid.Column="5" Style="{StaticResource HaloMonoKicker}" Text="STATUS" />
            <TextBlock Grid.Column="6" Style="{StaticResource HaloMonoKicker}" Text="SIZE" />
          </Grid>
          <ItemsControl x:Name="SourceList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SourceDisplayItemViewModel">
                <Grid>
                  <Grid Visibility="{x:Bind HeaderVisibility}" Margin="0,16,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind GroupName}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource HaloMonoData}" Text="{x:Bind GroupNote}" />
                    <Rectangle Grid.Column="2" Height="1" Margin="12,0" Fill="{ThemeResource HaloDividerBrush}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource HaloMonoData}" Text="{x:Bind GroupCount}" />
                  </Grid>
                  <Button Margin="0,0,0,6" Padding="10" HorizontalContentAlignment="Stretch" Click="OnSourceRowClick" PointerEntered="OnSourceRowPointerEntered" PointerExited="OnSourceRowPointerExited" Style="{StaticResource HaloCardButtonStyle}" Tag="{x:Bind Key}" Visibility="{x:Bind RowVisibility}">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="VideoColumn" Width="0" /><ColumnDefinition x:Name="AudioColumn" Width="0" /><ColumnDefinition x:Name="LanguagesColumn" Width="0" /><ColumnDefinition Width="112" /><ColumnDefinition Width="76" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                      <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                          <VisualState x:Name="WideSourceRow">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1600" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                              <Setter Target="VideoColumn.Width" Value="84" />
                              <Setter Target="AudioColumn.Width" Value="100" />
                              <Setter Target="LanguagesColumn.Width" Value="110" />
                              <Setter Target="VideoValue.Visibility" Value="Visible" />
                              <Setter Target="AudioValue.Visibility" Value="Visible" />
                              <Setter Target="LanguagesValue.Visibility" Value="Visible" />
                              <Setter Target="CompactTechnicalSummary.Visibility" Value="Collapsed" />
                            </VisualState.Setters>
                          </VisualState>
                        </VisualStateGroup>
                      </VisualStateManager.VisualStateGroups>
                      <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind Quality}" Visibility="{x:Bind Quality2160Visibility}" />
                        <TextBlock FontWeight="Bold" Text="{x:Bind Quality}" Visibility="{x:Bind Quality1080Visibility}" />
                        <TextBlock FontWeight="Bold" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind Quality}" Visibility="{x:Bind QualityOtherVisibility}" />
                        <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind Range}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="10.5" Text="{x:Bind File}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{ThemeResource HaloText3Brush}" FontSize="10.5" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CompactTechnicalSummary" Foreground="{ThemeResource HaloText3Brush}" FontSize="11.5"><Run Text="{x:Bind Codec}" /><Run Text=" · " /><Run Text="{x:Bind Audio}" /><Run Text=" · " /><Run Text="{x:Bind Languages}" /></TextBlock>
                      </StackPanel>
                      <TextBlock x:Name="VideoValue" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource HaloMonoData}" Text="{x:Bind Codec}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                      <TextBlock x:Name="AudioValue" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource HaloMonoData}" Text="{x:Bind Audio}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                      <TextBlock x:Name="LanguagesValue" Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource HaloMonoData}" Text="{x:Bind Languages}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                      <Grid Grid.Column="5" VerticalAlignment="Center">
                        <Border Padding="7,3" HorizontalAlignment="Left" Background="{ThemeResource HaloSuccessTintBrush}" CornerRadius="3" Visibility="{x:Bind InstantVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloSuccessBrush}" Text="INSTANT" /></Border>
                        <Border Padding="7,3" HorizontalAlignment="Left" Background="{ThemeResource HaloCautionTintBrush}" CornerRadius="3" Visibility="{x:Bind CachingVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloCautionBrush}" Text="CACHING" /></Border>
                        <Border Padding="7,3" HorizontalAlignment="Left" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3" Visibility="{x:Bind UncachedVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Text="UNCACHED" /></Border>
                        <Border Padding="7,3" HorizontalAlignment="Left" Background="{ThemeResource HaloSuccessTintBrush}" CornerRadius="3" Visibility="{x:Bind OnDiskVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloSuccessBrush}" Text="ON DISK" /></Border>
                        <Border Padding="7,3" HorizontalAlignment="Left" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3" Visibility="{x:Bind UnknownVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Text="UNKNOWN" /></Border>
                      </Grid>
                      <TextBlock Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource HaloMonoData}" Text="{x:Bind Size}" />
                      <TextBlock Grid.Column="7" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" Text="&#xE768;" />
                    </Grid>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12">
          <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8"><TextBlock Style="{StaticResource HaloMonoKicker}" Text="RESOLUTION" /><ItemsControl ItemsSource="{x:Bind ViewModel.ResolutionItems, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </Border>
          <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="9"><TextBlock Style="{StaticResource HaloMonoKicker}" Text="BY QUALITY" /><ItemsControl ItemsSource="{x:Bind ViewModel.QualityItems, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </Border>
          <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8"><TextBlock Style="{StaticResource HaloMonoKicker}" Text="PICKER RULES" /><TextBlock Text="Cached first   ON" /><TextBlock Text="{x:Bind ViewModel.PickerAudio, Mode=OneWay}" /><TextBlock Text="{x:Bind ViewModel.PickerSubtitles, Mode=OneWay}" /><TextBlock Text="{x:Bind ViewModel.PickerAutoplay, Mode=OneWay}" /><Button Margin="0,8,0,0" Click="OnEditPlaybackClick" Content="Edit in Playback" /></StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <!-- Anchored under the ranked pick, as in the design, instead of floating over the header. -->
    <TeachingTip
      x:Name="RankingTip"
      Target="{x:Bind BestSourceCard}"
      PreferredPlacement="Bottom"
      Title="{x:Bind ViewModel.TeachingTipTitle, Mode=OneWay}"
      Subtitle="{x:Bind ViewModel.TeachingTipBody, Mode=OneWay}"
      ActionButtonContent="Got it"
      ActionButtonClick="OnTeachingTipAction"
      Closed="OnTeachingTipClosed" />
  </Grid>
</Page>
