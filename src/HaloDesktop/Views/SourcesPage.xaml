<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.SourcesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Background="Transparent"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded">

  <Page.Resources>
    <!--
      The sheet arrives from the trailing edge under the scrim rather than fading
      in place, so the page it covers reads as still being there, just behind.
    -->
    <Storyboard x:Name="EnterStoryboard">
      <DoubleAnimation
        Storyboard.TargetName="Scrim"
        Storyboard.TargetProperty="Opacity"
        From="0"
        To="1"
        Duration="0:0:0.18">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="SheetTransform"
        Storyboard.TargetProperty="X"
        From="28"
        To="0"
        Duration="0:0:0.24">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="SheetLayer"
        Storyboard.TargetProperty="Opacity"
        From="0.4"
        To="1"
        Duration="0:0:0.24" />
    </Storyboard>

    <Storyboard x:Name="ExitStoryboard" Completed="OnExitCompleted">
      <DoubleAnimation
        Storyboard.TargetName="Scrim"
        Storyboard.TargetProperty="Opacity"
        To="0"
        Duration="0:0:0.16" />
      <DoubleAnimation
        Storyboard.TargetName="SheetTransform"
        Storyboard.TargetProperty="X"
        To="28"
        Duration="0:0:0.16">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="SheetLayer"
        Storyboard.TargetProperty="Opacity"
        To="0"
        Duration="0:0:0.16" />
    </Storyboard>

    <!-- One pulse shared by every skeleton bar, offset per card down the stack. -->
    <Storyboard x:Name="SkeletonStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="Skeleton0" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.3" />
      <DoubleAnimation Storyboard.TargetName="Skeleton1" Storyboard.TargetProperty="Opacity" From="0.55" To="1" BeginTime="0:0:0.1" Duration="0:0:1.3" />
      <DoubleAnimation Storyboard.TargetName="Skeleton2" Storyboard.TargetProperty="Opacity" From="0.55" To="1" BeginTime="0:0:0.2" Duration="0:0:1.3" />
      <DoubleAnimation Storyboard.TargetName="Skeleton3" Storyboard.TargetProperty="Opacity" From="0.55" To="1" BeginTime="0:0:0.3" Duration="0:0:1.3" />
    </Storyboard>

    <!--
      One column, not two. The block is already indented 114 px to line up under
      the prose, which leaves a two-column value about 110 px wide: narrow enough
      that "3840 x 2160 . Dolby Vision . H.265 10-bit" would be cut in half. A
      taller panel the viewer asked to open beats a truncated one.
    -->
    <DataTemplate x:Key="SourceSpecTemplate" x:DataType="local:SourceSpecItemViewModel">
      <Grid Margin="0,0,0,10" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock FontSize="12" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind Key}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Value}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SourceProviderTemplate" x:DataType="local:SourceProviderItemViewModel">
      <Grid Margin="0,0,0,8" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource HaloSuccessBrush}" Visibility="{x:Bind AnsweredVisibility}" />
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource HaloCriticalBrush}" Visibility="{x:Bind FailedVisibility}" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind Value}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SourceQualityTemplate" x:DataType="local:SourceQualityItemViewModel">
      <Grid Margin="0,0,0,9" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Label}" />
        <Grid Grid.Column="1" Height="3" VerticalAlignment="Center" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="2">
          <ProgressBar Height="3" Maximum="1" Value="{x:Bind Share}" Background="Transparent" Foreground="{ThemeResource HaloAccentBrush}" Visibility="{x:Bind TopTierVisibility}" />
          <ProgressBar Height="3" Maximum="1" Value="{x:Bind Share}" Background="Transparent" Foreground="{ThemeResource HaloChartDimBrush}" Visibility="{x:Bind MidTierVisibility}" />
          <ProgressBar Height="3" Maximum="1" Value="{x:Bind Share}" Background="Transparent" Foreground="{ThemeResource HaloText4Brush}" Visibility="{x:Bind LowTierVisibility}" />
        </Grid>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind Count}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SourcePickerRuleTemplate" x:DataType="local:SourcePickerRuleViewModel">
      <Grid Margin="0,0,0,7" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock FontSize="12.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind Name}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{ThemeResource HaloText1Brush}" Text="{x:Bind Value}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="SheetRoot">
    <!-- Clicking anywhere off the sheet dismisses it, exactly as the scrim implies. -->
    <Rectangle x:Name="Scrim" Fill="{ThemeResource HaloSheetScrimBrush}" Tapped="OnScrimTapped" />

    <Grid x:Name="SheetLayer" HorizontalAlignment="Right">
      <Grid.RenderTransform><TranslateTransform x:Name="SheetTransform" /></Grid.RenderTransform>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

      <Rectangle Width="34" Fill="{ThemeResource HaloSheetShadowBrush}" IsHitTestVisible="False" />

      <Border Grid.Column="1" Width="{x:Bind ViewModel.SheetWidth, Mode=OneWay}" Style="{StaticResource HaloSheetSurfaceStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Header -->
          <StackPanel Padding="32,26,32,18">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock
                  CharacterSpacing="60"
                  FontSize="12"
                  Foreground="{ThemeResource HaloText3Brush}"
                  Text="{x:Bind ViewModel.Kicker, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis"
                  Visibility="{x:Bind ViewModel.KickerVisibility, Mode=OneWay}" />
                <TextBlock
                  Margin="0,6,0,0"
                  CharacterSpacing="-10"
                  FontFamily="Segoe UI Variable Display"
                  FontSize="24"
                  FontWeight="SemiBold"
                  Foreground="{ThemeResource HaloText1Brush}"
                  Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ViewModel.CountLine, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button
                Grid.Column="1"
                Width="30"
                Height="30"
                MinWidth="0"
                Padding="0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Close sources"
                Background="Transparent"
                BorderThickness="0"
                Click="OnCloseClick"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="10" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE711;" />
              </Button>
            </Grid>

            <Grid Margin="0,18,0,0" ColumnSpacing="10" Visibility="{x:Bind ViewModel.FilterRowVisibility, Mode=OneWay}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton x:Name="AllFilter" GroupName="SourceSheetFilter" IsChecked="True" Click="OnAllFilterClick" Style="{StaticResource HaloFilterPillStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="All" />
                    <TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind ViewModel.AllFilterCount, Mode=OneWay}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PlaysNowFilter" GroupName="SourceSheetFilter" Click="OnPlaysNowFilterClick" Style="{StaticResource HaloFilterPillStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="Plays now" />
                    <TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind ViewModel.PlaysNowFilterCount, Mode=OneWay}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="UltraHdFilter" GroupName="SourceSheetFilter" Click="OnUltraHdFilterClick" Style="{StaticResource HaloFilterPillStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="4K" />
                    <TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind ViewModel.UltraHdFilterCount, Mode=OneWay}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FullHdFilter" GroupName="SourceSheetFilter" Click="OnFullHdFilterClick" Style="{StaticResource HaloFilterPillStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="Full HD" />
                    <TextBlock FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind ViewModel.FullHdFilterCount, Mode=OneWay}" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>

              <DropDownButton
                x:Name="SortButton"
                Grid.Column="1"
                Height="30"
                MinWidth="0"
                Padding="12,0"
                AutomationProperties.Name="Change how sources are sorted"
                Background="{ThemeResource HaloCtrlBrush}"
                BorderBrush="{ThemeResource HaloCtrlStrokeBrush}"
                BorderThickness="1"
                CornerRadius="4"
                FontSize="12.5"
                Foreground="{ThemeResource HaloText2Brush}"
                Content="{x:Bind ViewModel.SortLabel, Mode=OneWay}">
                <DropDownButton.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <RadioMenuFlyoutItem x:Name="RecommendedSort" GroupName="SourceSheetSort" IsChecked="True" Click="OnRecommendedSortClick" Text="Recommended" />
                    <RadioMenuFlyoutItem x:Name="BestPictureSort" GroupName="SourceSheetSort" Click="OnBestPictureSortClick" Text="Best picture" />
                    <RadioMenuFlyoutItem x:Name="SmallestFileSort" GroupName="SourceSheetSort" Click="OnSmallestFileSortClick" Text="Smallest file" />
                    <RadioMenuFlyoutItem x:Name="FastestStartSort" GroupName="SourceSheetSort" Click="OnFastestStartSortClick" Text="Fastest start" />
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </Grid>
          </StackPanel>

          <!-- Banner: one frame, two palettes, so the copy is written once. -->
          <Grid Grid.Row="1" Margin="32,0,32,16" Visibility="{x:Bind ViewModel.BannerVisibility, Mode=OneWay}">
            <Border Background="{ThemeResource HaloCautionTintBrush}" BorderBrush="{ThemeResource HaloCautionStrokeBrush}" BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.BannerCautionVisibility, Mode=OneWay}" />
            <Border Background="{ThemeResource HaloInfoBgBrush}" BorderBrush="{ThemeResource HaloInfoStrokeBrush}" BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.BannerInfoVisibility, Mode=OneWay}" />
            <Grid Padding="14,12" ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid Width="6" Height="6" Margin="0,7,0,0" VerticalAlignment="Top">
                <Ellipse Fill="{ThemeResource HaloCautionBrush}" Visibility="{x:Bind ViewModel.BannerCautionVisibility, Mode=OneWay}" />
                <Ellipse Fill="{ThemeResource HaloAccentBrush}" Visibility="{x:Bind ViewModel.BannerInfoVisibility, Mode=OneWay}" />
              </Grid>
              <StackPanel Grid.Column="1">
                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.BannerBody, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <Button
                Grid.Column="2"
                MinWidth="0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnRetryClick"
                Content="{x:Bind ViewModel.BannerAction, Mode=OneWay}"
                FontSize="12.5"
                Foreground="{ThemeResource HaloAccentBrush}" />
            </Grid>
          </Grid>

          <!-- Resolving -->
          <StackPanel Grid.Row="2" Padding="32,0,32,26" Visibility="{x:Bind ViewModel.ResolvingVisibility, Mode=OneWay}">
            <TextBlock FontSize="12.5" Foreground="{ThemeResource HaloText3Brush}" Text="Halo is asking every stream addon you have installed." TextWrapping="Wrap" />
            <StackPanel Margin="0,22,0,0" Spacing="8">
              <Border Height="86" Padding="18,15" Opacity="1" Style="{StaticResource HaloSourceCardStyle}">
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <Rectangle x:Name="Skeleton0" Width="52" Height="15" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="66" Height="9" Margin="0,7,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Rectangle Width="150" Height="11" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="238" Height="10" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="190" Height="8" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Height="86" Padding="18,15" Opacity="0.78" Style="{StaticResource HaloSourceCardStyle}">
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <Rectangle x:Name="Skeleton1" Width="52" Height="15" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="66" Height="9" Margin="0,7,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Rectangle Width="132" Height="11" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="252" Height="10" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="176" Height="8" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Height="86" Padding="18,15" Opacity="0.56" Style="{StaticResource HaloSourceCardStyle}">
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <Rectangle x:Name="Skeleton2" Width="52" Height="15" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="66" Height="9" Margin="0,7,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Rectangle Width="164" Height="11" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="220" Height="10" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="198" Height="8" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Height="86" Padding="18,15" Opacity="0.34" Style="{StaticResource HaloSourceCardStyle}">
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <Rectangle x:Name="Skeleton3" Width="52" Height="15" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="66" Height="9" Margin="0,7,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Rectangle Width="140" Height="11" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="230" Height="10" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="182" Height="8" Margin="0,9,0,0" HorizontalAlignment="Left" Fill="{ThemeResource HaloSubtleBrush}" RadiusX="4" RadiusY="4" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Empty, and the filter-returns-nothing case, which reads the same way. -->
          <Grid Grid.Row="2" Padding="32,0,32,40" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <StackPanel MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                Background="{ThemeResource HaloCardBrush}"
                BorderBrush="{ThemeResource HaloCardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="22">
                <FontIcon FontSize="18" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE721;" />
              </Border>
              <TextBlock
                Margin="0,16,0,0"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="{ThemeResource HaloText1Brush}"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
              <TextBlock
                Margin="0,7,0,0"
                FontSize="13.5"
                Foreground="{ThemeResource HaloText2Brush}"
                Text="{x:Bind ViewModel.EmptyBody, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
              <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Height="34" Padding="18,0" Click="OnRetryClick" Content="Look again" Style="{StaticResource HaloAccentButtonStyle}" />
                <Button Height="34" Padding="16,0" Click="OnManageAddonsClick" Content="Manage source addons" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- The list -->
          <!--
            The end-of-list breathing room is a margin on the content, not padding
            on the scroller. ScrollViewer padding insets the viewport rather than
            the extent, so as bottom padding it becomes a dead band the list can
            never scroll into: it just masks the last card above the footer.
          -->
          <ScrollViewer
            x:Name="ListScroller"
            Grid.Row="2"
            Padding="32,0,32,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
            <StackPanel Margin="0,0,0,26">
              <Grid x:Name="PickCard" Visibility="{x:Bind ViewModel.PickVisibility, Mode=OneWay}">
                <Border
                  Background="{ThemeResource HaloCardBrush}"
                  BorderBrush="{ThemeResource HaloInfoStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="10" />
                <Border CornerRadius="10">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.62">
                      <GradientStop Offset="0" Color="{ThemeResource HaloAccentTintColor}" />
                      <GradientStop Offset="0.62" Color="Transparent" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <StackPanel Padding="20">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid Width="6" Height="6" VerticalAlignment="Center">
                      <Ellipse Fill="{ThemeResource HaloSuccessBrush}" Visibility="{x:Bind ViewModel.PickInstantVisibility, Mode=OneWay}" />
                      <Ellipse Fill="{ThemeResource HaloAccentBrush}" Visibility="{x:Bind ViewModel.PickOnDiskVisibility, Mode=OneWay}" />
                      <Ellipse Fill="{ThemeResource HaloCautionBrush}" Visibility="{x:Bind ViewModel.PickCachingVisibility, Mode=OneWay}" />
                      <Ellipse Fill="{ThemeResource HaloText4Brush}" Visibility="{x:Bind ViewModel.PickColdVisibility, Mode=OneWay}" />
                    </Grid>
                    <Grid VerticalAlignment="Center">
                      <TextBlock FontSize="12.5" Foreground="{ThemeResource HaloSuccessBrush}" Text="{x:Bind ViewModel.PickStatusLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.PickInstantVisibility, Mode=OneWay}" />
                      <TextBlock FontSize="12.5" Foreground="{ThemeResource HaloAccentBrush}" Text="{x:Bind ViewModel.PickStatusLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.PickOnDiskVisibility, Mode=OneWay}" />
                      <TextBlock FontSize="12.5" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind ViewModel.PickStatusLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.PickCachingVisibility, Mode=OneWay}" />
                      <TextBlock FontSize="12.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ViewModel.PickStatusLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.PickColdVisibility, Mode=OneWay}" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource HaloText4Brush}" Text="&#x00B7;" />
                    <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource HaloText3Brush}" Text="Halo picked this for you" />
                  </StackPanel>
                  <!-- 104 rather than 78 so the widest badge, FULL HD beside HDR, still
                       fits the column the rows below share with it. -->
                  <Grid Margin="0,12,0,0" ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <local:QualityBadge
                      VerticalAlignment="Top"
                      Detail="{x:Bind ViewModel.PickQualityBadgeDetail, Mode=OneWay}"
                      LabelSize="13"
                      Tier="{x:Bind ViewModel.PickQualityBadgeTier, Mode=OneWay}"
                      Tone="{x:Bind ViewModel.PickQualityTone, Mode=OneWay}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="{x:Bind ViewModel.PickWhy, Mode=OneWay}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,5,0,0" FontSize="13.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.PickLine, Mode=OneWay}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{ThemeResource HaloAccentBrush}" Text="{x:Bind ViewModel.PickWatchNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.PickWatchNoteVisibility, Mode=OneWay}" />
                      <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind ViewModel.PickFileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Margin="0,18,0,0" Orientation="Horizontal" Spacing="8">
                    <Button Height="36" Padding="22,0" Click="OnPlayPickClick" Style="{StaticResource HaloAccentButtonStyle}">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE768;" />
                        <TextBlock VerticalAlignment="Center" Text="Play" />
                      </StackPanel>
                    </Button>
                    <Button Height="36" Padding="16,0" Click="OnDownloadPickClick">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon VerticalAlignment="Center" FontSize="13" Glyph="&#xE896;" />
                        <TextBlock VerticalAlignment="Center" Text="Save for offline" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
                <Border
                  BorderBrush="{ThemeResource HaloAccentBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  IsHitTestVisible="False"
                  Visibility="{x:Bind ViewModel.PickSelectionVisibility, Mode=OneWay}" />
              </Grid>

              <ItemsControl x:Name="SourceList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:SourceDisplayItemViewModel">
                    <Grid>
                      <!-- Group header -->
                      <Grid Margin="0,28,0,12" ColumnSpacing="10" Visibility="{x:Bind HeaderVisibility}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Bottom" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="{x:Bind GroupName}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom" FontSize="12.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind GroupNote}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Bottom" FontSize="12" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind GroupCount}" />
                      </Grid>

                      <!-- Reveal row for the collapsed cold group -->
                      <Button
                        Height="38"
                        Margin="0,0,0,8"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind ShowMoreLabel}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRevealColdClick"
                        Visibility="{x:Bind ShowMoreVisibility}">
                        <Grid>
                          <Rectangle
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{ThemeResource HaloCardStrokeBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1" />
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ShowMoreLabel}" />
                        </Grid>
                      </Button>

                      <!-- Source card -->
                      <Border Margin="0,0,0,8" Style="{StaticResource HaloSourceCardStyle}" Visibility="{x:Bind RowVisibility}">
                        <StackPanel>
                          <Grid>
                            <Button
                              Padding="18,15,136,15"
                              AutomationProperties.Name="Show source details"
                              Click="OnCardClick"
                              Style="{StaticResource HaloSheetRowButtonStyle}"
                              Tag="{x:Bind Key}">
                              <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <local:QualityBadge
                                  VerticalAlignment="Center"
                                  Detail="{x:Bind QualityBadgeDetail}"
                                  Tier="{x:Bind QualityBadgeTier}"
                                  Tone="{x:Bind QualityTone}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid Width="6" Height="6" VerticalAlignment="Center">
                                      <Ellipse Fill="{ThemeResource HaloSuccessBrush}" Visibility="{x:Bind InstantVisibility}" />
                                      <Ellipse Fill="{ThemeResource HaloAccentBrush}" Visibility="{x:Bind OnDiskVisibility}" />
                                      <Ellipse Fill="{ThemeResource HaloCautionBrush}" Visibility="{x:Bind CachingVisibility}" />
                                      <Ellipse Fill="{ThemeResource HaloText4Brush}" Visibility="{x:Bind ColdVisibility}" />
                                    </Grid>
                                    <Grid VerticalAlignment="Center">
                                      <TextBlock FontSize="13.5" Foreground="{ThemeResource HaloSuccessBrush}" Text="{x:Bind StatusLabel}" Visibility="{x:Bind InstantVisibility}" />
                                      <TextBlock FontSize="13.5" Foreground="{ThemeResource HaloAccentBrush}" Text="{x:Bind StatusLabel}" Visibility="{x:Bind OnDiskVisibility}" />
                                      <TextBlock FontSize="13.5" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind StatusLabel}" Visibility="{x:Bind CachingVisibility}" />
                                      <TextBlock FontSize="13.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind StatusLabel}" Visibility="{x:Bind ColdVisibility}" />
                                    </Grid>
                                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind SoundAndSize}" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind LanguageLine}" TextTrimming="CharacterEllipsis" />
                                  <StackPanel Margin="0,5,0,0" Orientation="Horizontal" Spacing="7" Visibility="{x:Bind WarningVisibility}">
                                    <FontIcon VerticalAlignment="Top" FontSize="11" Foreground="{ThemeResource HaloCautionBrush}" Glyph="&#xE7BA;" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind Warning}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <TextBlock Margin="0,5,0,0" FontSize="10.5" Foreground="{ThemeResource HaloText4Brush}" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                  Grid.Column="2"
                                  MaxWidth="112"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Foreground="{ThemeResource HaloText4Brush}"
                                  Text="{x:Bind Reason}"
                                  TextAlignment="Right"
                                  TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Button>
                            <StackPanel Margin="0,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                              <Button Height="32" MinWidth="0" Padding="16,0" Click="OnPlaySourceClick" Tag="{x:Bind Key}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <FontIcon VerticalAlignment="Center" FontSize="10" Glyph="&#xE768;" />
                                  <TextBlock VerticalAlignment="Center" FontSize="13" Text="Play" />
                                </StackPanel>
                              </Button>
                              <Grid Width="22">
                                <FontIcon FontSize="11" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE70D;" Visibility="{x:Bind ExpandGlyphVisibility, Mode=OneWay}" />
                                <FontIcon FontSize="11" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE70E;" Visibility="{x:Bind CollapseGlyphVisibility, Mode=OneWay}" />
                              </Grid>
                            </StackPanel>
                          </Grid>

                          <Border
                            Padding="114,16,18,18"
                            Background="{ThemeResource HaloSubtleBrush}"
                            BorderBrush="{ThemeResource HaloDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">
                            <StackPanel>
                              <ItemsControl ItemsSource="{x:Bind Specs}" ItemTemplate="{StaticResource SourceSpecTemplate}" />
                              <StackPanel Margin="0,14,0,0" Orientation="Horizontal" Spacing="8">
                                <Button Height="30" MinWidth="0" Padding="14,0" Click="OnDownloadSourceClick" Tag="{x:Bind Key}">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE896;" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12.5" Text="Save for offline" />
                                  </StackPanel>
                                </Button>
                                <Button Height="30" MinWidth="0" Padding="14,0" Click="OnCopyFileNameClick" FontSize="12.5" Content="Copy file name" Tag="{x:Bind Key}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>

                      <Border
                        Margin="0,0,0,8"
                        BorderBrush="{ThemeResource HaloAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Border Grid.Row="3" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloDividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
              <Button
                Padding="32,13"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="How this list was built"
                Background="Transparent"
                BorderThickness="0"
                Click="OnToggleInfoClick"
                CornerRadius="0">
                <Grid ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border MinWidth="18" Height="18" Padding="5,0" Background="{ThemeResource HaloCtrlBrush}" BorderBrush="{ThemeResource HaloCtrlStrokeBrush}" BorderThickness="1" CornerRadius="3">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" Foreground="{ThemeResource HaloText2Brush}" Text="&#x2191;&#x2193;" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="move" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border MinWidth="18" Height="18" Padding="5,0" Background="{ThemeResource HaloCtrlBrush}" BorderBrush="{ThemeResource HaloCtrlStrokeBrush}" BorderThickness="1" CornerRadius="3">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" Foreground="{ThemeResource HaloText2Brush}" Text="Enter" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="play" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border MinWidth="18" Height="18" Padding="5,0" Background="{ThemeResource HaloCtrlBrush}" BorderBrush="{ThemeResource HaloCtrlStrokeBrush}" BorderThickness="1" CornerRadius="3">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" Foreground="{ThemeResource HaloText2Brush}" Text="&#x2192;" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="details" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border MinWidth="18" Height="18" Padding="5,0" Background="{ThemeResource HaloCtrlBrush}" BorderBrush="{ThemeResource HaloCtrlStrokeBrush}" BorderThickness="1" CornerRadius="3">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" Foreground="{ThemeResource HaloText2Brush}" Text="Esc" />
                      </Border>
                      <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="close" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource HaloAccentBrush}" Text="How this list was built" />
                  <Grid Grid.Column="3">
                    <FontIcon FontSize="10" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE70D;" Visibility="{x:Bind ViewModel.InfoExpandGlyphVisibility, Mode=OneWay}" />
                    <FontIcon FontSize="10" Foreground="{ThemeResource HaloText3Brush}" Glyph="&#xE70E;" Visibility="{x:Bind ViewModel.InfoCollapseGlyphVisibility, Mode=OneWay}" />
                  </Grid>
                </Grid>
              </Button>

              <Grid Padding="32,4,32,22" ColumnSpacing="28" Visibility="{x:Bind ViewModel.InfoVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Margin="0,0,0,10" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="Providers" />
                  <ItemsControl x:Name="ProviderList" ItemTemplate="{StaticResource SourceProviderTemplate}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Margin="0,0,0,10" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="Quality mix" />
                  <ItemsControl x:Name="QualityList" ItemTemplate="{StaticResource SourceQualityTemplate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Margin="0,0,0,10" FontSize="11.5" Foreground="{ThemeResource HaloText4Brush}" Text="How Halo chose" />
                  <ItemsControl x:Name="PickerRuleList" ItemTemplate="{StaticResource SourcePickerRuleTemplate}" />
                  <Button
                    Margin="0,6,0,0"
                    MinWidth="0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnEditPlaybackClick"
                    Content="Change these in Playback"
                    FontSize="12.5"
                    Foreground="{ThemeResource HaloAccentBrush}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
