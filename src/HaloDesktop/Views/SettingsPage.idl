namespace HaloDesktop
{
    [default_interface]
    runtimeclass AddonRowViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Id { get; };
        String Initials { get; };
        String Name { get; };
        String Version { get; };
        String Provides { get; };
        Boolean IsGlobal { get; };
        Boolean IsShadowed { get; };
        Boolean CatalogsShown;
        Boolean CatalogSwitchEnabled { get; };
        String CatalogSwitchLabel { get; };
        String GripToolTip { get; };
        Double IdentityOpacity { get; };
        Microsoft.UI.Xaml.Visibility GlobalVisibility { get; };
        Microsoft.UI.Xaml.Visibility YoursVisibility { get; };
        Microsoft.UI.Xaml.Visibility CatalogSwitchVisibility { get; };
        Microsoft.UI.Xaml.Visibility InstallForEveryoneVisibility { get; };
        Microsoft.UI.Xaml.Visibility RemoveVisibility { get; };
        Boolean ListActionsEnabled { get; };
        Microsoft.UI.Xaml.Thickness DividerThickness { get; };
        Double ActionSlotWidth { get; };
        Microsoft.UI.Xaml.Visibility ActionSlotVisibility { get; };
    }

    runtimeclass SettingsViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String UserName { get; };
        String DisplayName { get; };
        String SignedInLine { get; };
        String AccountRoleLine { get; };
        // The account section of an account, or of Halo used without one.
        Microsoft.UI.Xaml.Visibility SignedInAccountVisibility { get; };
        Microsoft.UI.Xaml.Visibility DeviceAccountVisibility { get; };
        String VersionLine { get; };
        String ServerStatusLine { get; };
        Microsoft.UI.Xaml.Visibility ServerCheckingVisibility { get; };
        Microsoft.UI.Xaml.Visibility ServerConnectedVisibility { get; };
        Microsoft.UI.Xaml.Visibility ServerUnavailableVisibility { get; };
        Windows.Foundation.Collections.IObservableVector<Object> GlobalAddons { get; };
        Windows.Foundation.Collections.IObservableVector<Object> OwnAddons { get; };
        Microsoft.UI.Xaml.Visibility GlobalAddonsVisibility { get; };
        Microsoft.UI.Xaml.Visibility OwnAddonsVisibility { get; };
        Boolean CanReorderGlobal { get; };
        Boolean CanReorderOwn { get; };
        String AddonUrl;
        Boolean CanAddAddon { get; };
        String AddButtonText { get; };
        String AddErrorText { get; };
        Microsoft.UI.Xaml.Visibility AddErrorVisibility { get; };
        String ListErrorText { get; };
        Microsoft.UI.Xaml.Visibility ListErrorVisibility { get; };
        String AddonNoticeText { get; };
        Microsoft.UI.Xaml.Visibility AddonNoticeVisibility { get; };
        String AccountNoticeText { get; };
        Microsoft.UI.Xaml.Visibility AccountNoticeVisibility { get; };
        Microsoft.UI.Xaml.Visibility AddonLoadingVisibility { get; };
        Microsoft.UI.Xaml.Visibility AddonErrorVisibility { get; };
        Microsoft.UI.Xaml.Visibility AddonEmptyVisibility { get; };
        Microsoft.UI.Xaml.Visibility AddonContentVisibility { get; };
        Windows.Foundation.Collections.IObservableVector<Object> CatalogLanguageOptions { get; };
        Int32 CatalogLanguageIndex;
        Microsoft.UI.Xaml.Visibility CatalogLanguageVisibility { get; };
        Double SubtitleSize;
        String SubtitleSizeLabel { get; };
        String PreviewText { get; };
        Double PreviewFontSize { get; };
        Microsoft.UI.Xaml.Media.FontFamily PreviewFontFamily { get; };
        Int32 FontIndex { get; };
        Int32 OutlineIndex { get; };
        Boolean IsDefaultFont { get; };
        Boolean IsSystemFont { get; };
        Boolean IsSerifFont { get; };
        Boolean IsMonoFont { get; };
        Boolean IsNoOutline { get; };
        Boolean IsThinOutline { get; };
        Boolean IsNormalOutline { get; };
        Boolean IsThickOutline { get; };
        Int32 AudioLanguageIndex;
        Int32 SubtitleLanguageIndex;
        Microsoft.UI.Xaml.Visibility PreviewOutlineVisibility { get; };
        Double PreviewOutlineOffset { get; };
        Double PreviewOutlineNegativeOffset { get; };
        Microsoft.UI.Xaml.Visibility PreviewShadowVisibility { get; };
        Double PreviewShadowOffset { get; };
        Boolean AutoplayNext;
        Boolean SubtitleShadow;
        Boolean SubtitleTrackStyling;
        Boolean ResumePlayback;
        Boolean HardwareDecoding;
        Boolean DiscordPresence;
        Boolean TranslucentWindow;
        Boolean TranslucentWindowSupported { get; };
        void Refresh();
        void ProbeHealth();
        void CancelHealthProbe();
        void AddAddon();
        void ToggleAddon(String id, Boolean enabled);
        void RemoveAddon(String id);
        void InstallForEveryone(String id);
        void CommitReorder(Boolean global);
        void MoveAddon(String id, Int32 offset);
        Boolean IsLightTheme { get; };
        Boolean IsDarkTheme { get; };
        Boolean IsSystemTheme { get; };
        void SetTheme(Int32 index);
        void SetFont(Int32 index);
        void SetOutline(Int32 index);
        void SignOut();
        // Opens the sign-in screen over Halo without an account.
        void SignInToSync();
    }

    [default_interface]
    // Settings' TMDB key card, for Halo without an account (ViewModels/TmdbKeyViewModel.h).
    runtimeclass TmdbKeyViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String KeyText;
        Boolean CanSave { get; };
        String SaveButtonText { get; };
        String StatusText { get; };
        Microsoft.UI.Xaml.Visibility StatusOkVisibility { get; };
        Microsoft.UI.Xaml.Visibility StatusProblemVisibility { get; };
        Microsoft.UI.Xaml.Visibility EntryVisibility { get; };
        Microsoft.UI.Xaml.Visibility SavedVisibility { get; };
        void Save();
        void Remove();
    }

    runtimeclass SettingsPage : Microsoft.UI.Xaml.Controls.Page
    {
        SettingsPage();
        SettingsViewModel ViewModel { get; };
        TmdbKeyViewModel TmdbKey { get; };
        // The word Windows Settings shows beside a switch: "On" or "Off".
        static String OnOffText(Boolean isOn);
    }
}
