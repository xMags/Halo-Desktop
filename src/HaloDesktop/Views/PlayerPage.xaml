<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.PlayerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Space" Invoked="OnSpaceInvoked" />
    <KeyboardAccelerator Key="Left" Invoked="OnLeftInvoked" />
    <KeyboardAccelerator Key="Right" Invoked="OnRightInvoked" />
    <KeyboardAccelerator Key="Up" Invoked="OnUpInvoked" />
    <KeyboardAccelerator Key="Down" Invoked="OnDownInvoked" />
    <KeyboardAccelerator Key="F" Invoked="OnFullscreenInvoked" />
    <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
  </Page.KeyboardAccelerators>
  <Grid Background="#FF090A0C">
    <local:PlaceholderArt Caption="SIMULATED PLAYBACK" />
    <local:PlayerOsd x:Name="PlayerOverlay" />
  </Grid>
</Page>
