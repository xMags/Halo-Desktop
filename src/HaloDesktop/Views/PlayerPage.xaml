<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.PlayerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  KeyboardAcceleratorPlacementMode="Hidden"
  Loaded="OnLoaded"
  RequestedTheme="Dark"
  Unloaded="OnUnloaded">
  <!-- The mode above belongs on the element that owns the accelerators. WinUI otherwise
       floats a key-combination tooltip anywhere the pointer happens to rest. -->
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Space" Invoked="OnSpaceInvoked" />
    <KeyboardAccelerator Key="Left" Invoked="OnLeftInvoked" />
    <KeyboardAccelerator Key="Right" Invoked="OnRightInvoked" />
    <KeyboardAccelerator Key="Up" Invoked="OnUpInvoked" />
    <KeyboardAccelerator Key="Down" Invoked="OnDownInvoked" />
    <KeyboardAccelerator Key="F" Invoked="OnFullscreenInvoked" />
    <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
  </Page.KeyboardAccelerators>
  <Grid
    x:Name="PlayerRoot"
    Background="#FF050506"
    SizeChanged="OnPlayerSizeChanged">

    <!-- mpv paints through a native child HWND. The Popup owns the only XAML
         surface that can composite controls above that child window. PlayerPage
         closes and detaches it explicitly before XAML teardown. -->
    <local:VideoHostControl
      x:Name="VideoHost"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch" />

    <Popup x:Name="OverlayPopup" ShouldConstrainToRootBounds="False">
      <Grid
        x:Name="OverlayHost"
        Background="Transparent"
        IsTabStop="True"
        PreviewKeyDown="OnOverlayPreviewKeyDown"
        UseSystemFocusVisuals="False">
        <local:PlayerOsd x:Name="PlayerOverlay" />
        <InfoBar
          x:Name="SubtitleNotice"
          MaxWidth="520"
          Margin="24,72,24,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsClosable="True"
          IsOpen="False"
          Message="That subtitle could not be loaded. Try another subtitle."
          Severity="Warning"
          Title="Subtitle unavailable" />
        <Border
          x:Name="MediaPrompt"
          Width="360"
          Padding="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="#EC1A1A1E"
          CornerRadius="10">
          <Border.Visibility>Collapsed</Border.Visibility>
          <StackPanel Spacing="12">
            <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="White"
              Text="Playback unavailable" />
            <TextBlock
              x:Name="MediaPromptMessage"
              Foreground="#A8FFFFFF"
              Text="Return to Sources and choose another source."
              TextWrapping="Wrap" />
            <Button
              HorizontalAlignment="Left"
              Click="OnCloseErrorClick"
              Content="Back to Sources"
              Style="{StaticResource HaloAccentButtonStyle}" />
          </StackPanel>
        </Border>
      </Grid>
    </Popup>
  </Grid>
</Page>
