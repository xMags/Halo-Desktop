<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.DetailCreditCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Width="128"
  IsTabStop="False"
  PointerCanceled="OnHoverEnded"
  PointerEntered="OnHoverStarted"
  PointerExited="OnHoverEnded">
  <!--
    `.credit`: a person's 128x160 card, initials under the photo until (unless)
    it loads; pressing it looks them up on IMDb in the browser. The hover zoom,
    badge and underline are plain property transitions; nothing in this card is
    handed a composition visual.
  -->
  <Button
    HorizontalAlignment="Stretch"
    AutomationProperties.Name="{x:Bind Credit.Tooltip}"
    Click="OnClick"
    Style="{StaticResource HaloDetailBareButtonStyle}"
    ToolTipService.ToolTip="{x:Bind Credit.Tooltip}">
    <StackPanel>
      <Grid
        Width="128"
        Height="160"
        Background="{StaticResource HaloDetailArtBrush}"
        BorderBrush="{StaticResource HaloDetailArtRingBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <TextBlock
          x:Name="InitialsText"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontFamily="Segoe UI Variable Display"
          FontSize="30"
          FontWeight="SemiBold"
          Foreground="{StaticResource HaloDetailInk45Brush}"
          Text="{x:Bind Credit.Initials}" />
        <!-- Its zoom's centre and transition are set in code. -->
        <local:ArtworkImage
          x:Name="Photo"
          DecodeWidth="256"
          Placeholder="{x:Bind InitialsText}"
          SourceUrl="{x:Bind Credit.Photo}" />
        <Border
          x:Name="OpenBadge"
          Width="24"
          Height="24"
          Margin="8"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Background="{StaticResource HaloDetailBadgeBrush}"
          CornerRadius="12"
          IsHitTestVisible="False"
          Opacity="0">
          <Border.OpacityTransition>
            <ScalarTransition Duration="0:0:0.15" />
          </Border.OpacityTransition>
          <FontIcon FontSize="12" Foreground="{StaticResource HaloDetailInkBrush}" Glyph="&#xE8A7;" />
        </Border>
      </Grid>
      <TextBlock
        x:Name="NameText"
        Margin="0,10,0,0"
        FontSize="14"
        FontWeight="Medium"
        Foreground="{StaticResource HaloDetailInkBrush}"
        Text="{x:Bind Credit.Name}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        Margin="0,3,0,0"
        FontSize="13"
        Foreground="{StaticResource HaloDetailInk50Brush}"
        Text="{x:Bind Credit.Role}"
        TextTrimming="CharacterEllipsis"
        Visibility="{x:Bind Credit.RoleVisibility}" />
    </StackPanel>
  </Button>
</UserControl>
