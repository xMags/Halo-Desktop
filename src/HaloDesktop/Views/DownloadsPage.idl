namespace HaloDesktop
{
    // One download as the page draws it: a queue row, a ready card and the
    // detail pane all read the same row. Updated in place on every progress
    // tick; only what changed is announced.
    runtimeclass DownloadRowViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Id { get; };
        String Tag { get; };
        String EpisodeLabel { get; };
        Microsoft.UI.Xaml.Visibility EpisodeLabelVisibility { get; };
        String Name { get; };
        String Sub { get; };
        // What Narrator reads for the row or card.
        String AccessibleName { get; };
        String MetaId { get; };
        String RowArtwork { get; };
        // The art saved beside the video as a file address, its logo as a
        // file path; the logo on the network. See DownloadRow.
        String SavedArtwork { get; };
        String SavedLogo { get; };
        String OnlineLogo { get; };
        Double Progress { get; };
        Microsoft.UI.Xaml.GridLength ProgressDone { get; };
        Microsoft.UI.Xaml.GridLength ProgressRest { get; };
        String PercentText { get; };
        String Lead { get; };
        Microsoft.UI.Xaml.Visibility ToneNormalVisibility { get; };
        Microsoft.UI.Xaml.Visibility ToneCautionVisibility { get; };
        Microsoft.UI.Xaml.Visibility ToneCriticalVisibility { get; };
        String DownloadedLine { get; };
        // The queue row's mono line in three runs: the first part, the parts
        // between, and the last one (which a paused row colours caution).
        String MetaLead { get; };
        String MetaMiddle { get; };
        String MetaLast { get; };
        Microsoft.UI.Xaml.Visibility UpNextVisibility { get; };
        Microsoft.UI.Xaml.Visibility TransferBodyVisibility { get; };
        Double ThumbOpacity { get; };
        Microsoft.UI.Xaml.Visibility ChooseSourceVisibility { get; };
        Microsoft.UI.Xaml.Visibility PauseVisibility { get; };
        Microsoft.UI.Xaml.Visibility ResumeVisibility { get; };
        Microsoft.UI.Xaml.Visibility RetryVisibility { get; };
        Microsoft.UI.Xaml.Visibility PanePauseVisibility { get; };
        Microsoft.UI.Xaml.Visibility PaneResumeVisibility { get; };
        String StatePill { get; };
        Microsoft.UI.Xaml.Visibility StateAccentVisibility { get; };
        Microsoft.UI.Xaml.Visibility StateCautionVisibility { get; };
        Microsoft.UI.Xaml.Visibility StateCriticalVisibility { get; };
        Microsoft.UI.Xaml.Visibility StateNeutralVisibility { get; };
        Microsoft.UI.Xaml.Visibility FailedNoteVisibility { get; };
        String PaneMeta { get; };
        String QualityLine { get; };
        String Subs { get; };
        String AddedFact { get; };
        // "Size" for a finished file, "Downloaded" for a transfer.
        String SizeFactLabel { get; };
        String FileName { get; };
        String CardTitle { get; };
        String CardSub { get; };
        Microsoft.UI.Xaml.Visibility CardSubVisibility { get; };
        String CardMeta { get; };
        String QualityBadge { get; };
        Microsoft.UI.Xaml.Visibility QualityBadgeGoldVisibility { get; };
        Microsoft.UI.Xaml.Visibility QualityBadgePlainVisibility { get; };
        Boolean IsSelected { get; };
        Microsoft.UI.Xaml.Visibility SelectedVisibility { get; };
        // The hairline above a queue row: not over the first row, nor beside the selected one.
        Microsoft.UI.Xaml.Visibility TopRuleVisibility { get; };
        // The row's progress bar draws its paused look.
        Boolean IsPaused { get; };
        // The row's details (quality, size, subtitle, added, file) are open.
        Boolean IsExpanded { get; };
        Microsoft.UI.Xaml.Visibility DetailsVisibility { get; };
        // The details chevron: 0 shut, 180 open.
        // The chevron's turn, in degrees: up while the details are open.
        Single ChevronRotation { get; };
    }

    runtimeclass DownloadsViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String ActionErrorText { get; };
        Microsoft.UI.Xaml.Visibility ActionErrorVisibility { get; };
        String SummaryLine { get; };
        Microsoft.UI.Xaml.Visibility SummaryVisibility { get; };
        String FilterAllCount { get; };
        // Whether there is anything for Delete all to remove.
        Boolean CanDeleteAll { get; };
        String FilterActiveCount { get; };
        String FilterReadyCount { get; };
        String FilterFailedCount { get; };
        Int32 FilterIndex { get; };
        String PauseAllLabel { get; };
        String PauseAllGlyph { get; };
        Microsoft.UI.Xaml.Visibility PauseAllVisibility { get; };
        Boolean IsPausedAll { get; };
        String RateValue { get; };
        String RateUnit { get; };
        Microsoft.UI.Xaml.Visibility RateUnitVisibility { get; };
        Microsoft.UI.Xaml.Visibility RateNormalVisibility { get; };
        Microsoft.UI.Xaml.Visibility RateIdleVisibility { get; };
        Microsoft.UI.Xaml.Visibility RatePausedVisibility { get; };
        String ConnectionsText { get; };
        Microsoft.UI.Xaml.Visibility ConnectionsVisibility { get; };
        String RateNoteText { get; };
        Microsoft.UI.Xaml.Visibility RateNoteVisibility { get; };
        String PeakText { get; };
        String StorageValue { get; };
        String StorageUnitLine { get; };
        String StoredLine { get; };
        String InFlightLine { get; };
        Microsoft.UI.Xaml.GridLength StoredWidth { get; };
        Microsoft.UI.Xaml.GridLength FlightWidth { get; };
        Microsoft.UI.Xaml.GridLength FreeWidth { get; };
        Microsoft.UI.Xaml.Visibility StoredVisibility { get; };
        Microsoft.UI.Xaml.Visibility FlightVisibility { get; };
        Microsoft.UI.Xaml.Visibility QueueVisibility { get; };
        Microsoft.UI.Xaml.Visibility ReadySectionVisibility { get; };
        String ReadyHeadline { get; };
        Microsoft.UI.Xaml.Visibility EmptyVisibility { get; };
        Microsoft.UI.Xaml.Visibility NoMatchesVisibility { get; };
        String NoMatchesLine { get; };
        DownloadRowViewModel SelectedRow { get; };
        Microsoft.UI.Xaml.Visibility DetailVisibility { get; };
        Microsoft.UI.Xaml.Visibility FolderVisibility { get; };
        Microsoft.UI.Xaml.Visibility SelectedReadyVisibility { get; };
        Microsoft.UI.Xaml.Visibility SelectedTransferVisibility { get; };
        Microsoft.UI.Xaml.Visibility RunningVisibility { get; };
        Microsoft.UI.Xaml.Visibility WaitingVisibility { get; };
        Microsoft.UI.Xaml.Visibility AttentionVisibility { get; };
        String WaitingLine { get; };
        String StatusLine { get; };
        void Select(String id);
        void ToggleDetails(String id);
        void SetFilter(Int32 index);
        void Pause(String id);
        void Resume(String id);
        void Retry(String id);
        void Cancel(String id);
        // Deletes that finished download only; anything else is refused.
        void Delete(String id);
        void ChooseSourceFor(String id);
        void Play(String id);
        void OpenDownloadFolder();
        void RevealSelected();
        // The download's title page: the film's, or for an episode its show's.
        void OpenDetails(String id);
        void RetryFailed();
        void PauseAll();
        void ResumeAll();
        void PauseSelected();
        void ResumeSelected();
        void CancelSelected();
        void DeleteAll();
        void OpenPlayer();
        void ChooseSource();
        void BrowseLibrary();
    }

    // A finished download as an artwork card in the "Ready to watch" grid.
    [default_interface]
    runtimeclass DownloadReadyCard : Microsoft.UI.Xaml.Controls.UserControl
    {
        DownloadReadyCard();
        DownloadRowViewModel Row;
        // A single click selects the card; a double click or its play button plays.
        event Microsoft.UI.Xaml.RoutedEventHandler Selected;
        event Microsoft.UI.Xaml.RoutedEventHandler PlayRequested;
    }

    [default_interface]
    runtimeclass DownloadsPage : Microsoft.UI.Xaml.Controls.Page
    {
        DownloadsPage();
        DownloadsViewModel ViewModel { get; };
    }
}
