<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.LibraryPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  ContextRequested="OnContextRequested"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <!-- The title; under it the tabs on the left and the sort on the right, as
         Downloads and History lay theirs out. The sides follow the page's
         gutter (ApplyLayoutMetrics), so the title sits over the first poster. -->
    <Grid x:Name="LibraryHeader" Padding="24,28,24,4" RowSpacing="6">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="Library" />
      <Grid Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <SelectorBar x:Name="FilterBar" HorizontalAlignment="Left" SelectionChanged="OnFilterSelectionChanged">
          <SelectorBarItem x:Name="AllFilterItem" IsSelected="True" Text="{x:Bind ViewModel.AllLabel, Mode=OneWay}" />
          <SelectorBarItem x:Name="MoviesFilterItem" Text="{x:Bind ViewModel.MoviesLabel, Mode=OneWay}" />
          <SelectorBarItem x:Name="SeriesFilterItem" Text="{x:Bind ViewModel.SeriesLabel, Mode=OneWay}" />
        </SelectorBar>
      <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource HaloFontLabel}" Foreground="{ThemeResource HaloText3Brush}" Text="Sort by" />
      <Button x:Name="SortButton" Grid.Column="2" Height="32" Padding="11,0" VerticalAlignment="Center" AutomationProperties.Name="Sort by" HorizontalContentAlignment="Left" FontSize="{StaticResource HaloFontBody}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock x:Name="SortLabel" VerticalAlignment="Center" Text="Recently added" />
              <FontIcon VerticalAlignment="Center" FontSize="{StaticResource HaloFontSmall}" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE70D;" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <RadioMenuFlyoutItem GroupName="LibrarySort" IsChecked="True" Text="Recently added" Click="OnSortClick" />
                <RadioMenuFlyoutItem GroupName="LibrarySort" Text="Title A–Z" Click="OnSortClick" />
                <RadioMenuFlyoutItem GroupName="LibrarySort" Text="Recently watched" Click="OnSortClick" />
              </MenuFlyout>
        </Button.Flyout>
      </Button>
      </Grid>
    </Grid>
    <ScrollView x:Name="LibraryScroller" ContentOrientation="Vertical"
      Grid.Row="1"
      HorizontalScrollMode="Disabled"
      VerticalScrollBarVisibility="Hidden">
      <StackPanel>
        <!-- `.state-note`: 15px Text3, 14 above and below, in the gutter. -->
        <StackPanel x:Name="ErrorNote" Margin="24,14,24,14" Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloCriticalBrush}" Text="Library could not be refreshed." />
          <Button VerticalAlignment="Center" Click="OnRetryClick" Content="Retry" />
        </StackPanel>
        <TextBlock
          x:Name="EmptyNote"
          Margin="24,14,24,14"
          FontSize="{StaticResource HaloFontBody}"
          Foreground="{ThemeResource HaloText3Brush}"
          Text="Nothing saved yet. Open a title and use its star button to keep it here."
          TextWrapping="Wrap"
          Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        <TextBlock
          x:Name="FilteredEmptyNote"
          Margin="24,14,24,14"
          FontSize="{StaticResource HaloFontBody}"
          Foreground="{ThemeResource HaloText3Brush}"
          Text="{x:Bind ViewModel.FilteredEmptyText, Mode=OneWay}"
          TextWrapping="Wrap"
          Visibility="{x:Bind ViewModel.FilteredEmptyVisibility, Mode=OneWay}" />
        <!--
          `.lib-grid` while the library loads: twelve poster skeletons, stretched
          the same way as the cards that replace them. The wrapper takes the
          pulse; nothing inside it animates on its own.
        -->
        <Grid
          x:Name="LibrarySkeleton"
          AutomationProperties.AccessibilityView="Raw"
          IsHitTestVisible="False"
          Visibility="{x:Bind ViewModel.SkeletonVisibility, Mode=OneWay}">
          <ItemsRepeater x:Name="SkeletonGrid" Margin="24,16,24,32">
            <ItemsRepeater.Layout>
              <UniformGridLayout x:Name="SkeletonLayout" ItemsStretch="Uniform" MinColumnSpacing="4" MinRowSpacing="4" Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate>
                <local:PosterSkeleton FillsColumn="True" ShowKindBadge="True" />
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </Grid>
        <!--
          `.lib-grid`: as many columns as fit at the poster width, stretched to
          share the row, 4 apart; each card keeps the 4px band above its art it
          lifts into on hover.
        -->
        <ItemsRepeater x:Name="LibraryGrid" VerticalCacheLength="4" Margin="24,16,24,32" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <UniformGridLayout x:Name="LibraryLayout" ItemsStretch="Uniform" MinColumnSpacing="4" MinRowSpacing="4" Orientation="Horizontal" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:MediaSummary">
              <local:PosterCard Title="{x:Bind Title}" Meta="{x:Bind Meta}" Poster="{x:Bind Poster}" MetaId="{x:Bind Id}" KindLabel="{x:Bind KindLabel}" ShowKindBadge="True" FillsColumn="True" Tag="{x:Bind}" Click="OnPosterClick" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollView>
  </Grid>
</Page>
