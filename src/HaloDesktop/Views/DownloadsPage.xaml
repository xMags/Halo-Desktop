<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.DownloadsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Background="{ThemeResource DlBgBrush}"
  Loaded="OnLoaded"
  NavigationCacheMode="Required"
  SizeChanged="OnPageSizeChanged"
  Unloaded="OnUnloaded">
  <Page.Resources>
    <ResourceDictionary>
      <!-- One row of the pane's facts. -->
      <Style x:Key="DlFactLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource DlDimBrush}" />
      </Style>
      <Style x:Key="DlFactValueStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource HaloMonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource DlTextBrush}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="DlStatePillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HaloMonoBoldFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
      </Style>
      <Style x:Key="DlEmptyStepStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource DlMetaBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <!-- 380px, 320px below a 1200px content surface (set in OnPageSizeChanged). -->
      <ColumnDefinition x:Name="PaneColumn" Width="380" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="MainColumn" SizeChanged="OnMainSizeChanged">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- `.dl-head`: the title, the summary, and the filters with the bulk actions. -->
      <Grid Padding="32,28,32,0" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          VerticalAlignment="Center"
          FontFamily="Segoe UI Variable Display"
          FontSize="30"
          FontWeight="SemiBold"
          Foreground="{ThemeResource DlTextBrush}"
          Text="Downloads" />
        <TextBlock
          Grid.Column="1"
          Padding="0,6,0,0"
          VerticalAlignment="Center"
          FontSize="14"
          Foreground="{ThemeResource DlDimBrush}"
          Text="{x:Bind ViewModel.SummaryLine, Mode=OneWay}"
          TextTrimming="CharacterEllipsis"
          TextWrapping="NoWrap"
          Visibility="{x:Bind ViewModel.SummaryVisibility, Mode=OneWay}" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <Border Padding="4" Background="{ThemeResource DlSurfaceBrush}" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton x:Name="AllFilter" AutomationProperties.Name="All" Click="OnAllFilterClick" GroupName="DownloadFilter" IsChecked="True" Style="{StaticResource DlFilterPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="All" /><TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.FilterAllCount, Mode=OneWay}" /></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ActiveFilter" AutomationProperties.Name="Active" Click="OnActiveFilterClick" GroupName="DownloadFilter" Style="{StaticResource DlFilterPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Active" /><TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.FilterActiveCount, Mode=OneWay}" /></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ReadyFilter" AutomationProperties.Name="Ready" Click="OnReadyFilterClick" GroupName="DownloadFilter" Style="{StaticResource DlFilterPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Ready" /><TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.FilterReadyCount, Mode=OneWay}" /></StackPanel>
              </RadioButton>
              <RadioButton x:Name="FailedFilter" AutomationProperties.Name="Failed" Click="OnFailedFilterClick" GroupName="DownloadFilter" Style="{StaticResource DlFilterPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Failed" /><TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.FilterFailedCount, Mode=OneWay}" /></StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <Button AutomationProperties.Name="{x:Bind ViewModel.PauseAllLabel, Mode=OneWay}" Click="OnPauseAllClick" Style="{StaticResource DlButtonStyle}" Visibility="{x:Bind ViewModel.PauseAllVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="13" Glyph="{x:Bind ViewModel.PauseAllGlyph, Mode=OneWay}" /><TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PauseAllLabel, Mode=OneWay}" /></StackPanel>
          </Button>
          <Button AutomationProperties.Name="More download actions" Content="&#xE712;" Style="{StaticResource DlIconButtonStyle}" ToolTipService.ToolTip="More download actions">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem MinWidth="236" Click="OnManageFolderClick" Text="Manage download folder" />
                <MenuFlyoutItem Click="OnOpenFolderClick" Text="Open folder in Explorer" />
                <MenuFlyoutItem Click="OnRetryFailedClick" Text="Retry all failed transfers" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
        <StackPanel Padding="32,20,32,32" Spacing="20">
          <InfoBar
            IsOpen="True"
            Message="{x:Bind ViewModel.ActionErrorText, Mode=OneWay}"
            Severity="Error"
            Title="Download action failed"
            Visibility="{x:Bind ViewModel.ActionErrorVisibility, Mode=OneWay}" />

          <!-- `.dl-queue-panel`: rate, the minute of throughput and storage over every unfinished transfer. -->
          <Border Padding="22,20,22,4" Background="{ThemeResource DlPanelBrush}" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="1" CornerRadius="16">
            <StackPanel>
              <!-- The storage block moves under the chart below an 840px column (OnMainSizeChanged). -->
              <Grid x:Name="Instrument" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition x:Name="InstrumentRuleColumn" Width="57" />
                  <ColumnDefinition x:Name="InstrumentStorageColumn" Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Bottom">
                      <TextBlock CharacterSpacing="-20" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="40" FontWeight="SemiBold" Foreground="{ThemeResource DlTextBrush}" Text="{x:Bind ViewModel.RateValue, Mode=OneWay}" Visibility="{x:Bind ViewModel.RateNormalVisibility, Mode=OneWay}" />
                      <TextBlock CharacterSpacing="-20" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="40" FontWeight="SemiBold" Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind ViewModel.RateValue, Mode=OneWay}" Visibility="{x:Bind ViewModel.RateIdleVisibility, Mode=OneWay}" />
                      <TextBlock CharacterSpacing="-20" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="40" FontWeight="SemiBold" Foreground="{ThemeResource DlCautionBrush}" Text="{x:Bind ViewModel.RateValue, Mode=OneWay}" Visibility="{x:Bind ViewModel.RatePausedVisibility, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Padding="0,0,0,5" VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="16" Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind ViewModel.RateUnit, Mode=OneWay}" Visibility="{x:Bind ViewModel.RateUnitVisibility, Mode=OneWay}" />
                    <Border Grid.Column="2" Margin="6,0,0,4" Padding="10,4" VerticalAlignment="Bottom" Background="{ThemeResource DlSuccessBgBrush}" CornerRadius="999" Visibility="{x:Bind ViewModel.ConnectionsVisibility, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource DlSuccessBrush}" />
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource DlSuccessBrush}" Text="{x:Bind ViewModel.ConnectionsText, Mode=OneWay}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="2" Margin="6,0,0,5" VerticalAlignment="Bottom" FontSize="13" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.RateNoteText, Mode=OneWay}" Visibility="{x:Bind ViewModel.RateNoteVisibility, Mode=OneWay}" />
                    <TextBlock Grid.Column="4" Padding="0,0,0,5" VerticalAlignment="Bottom" Style="{StaticResource DlKickerStyle}" Text="{x:Bind ViewModel.PeakText, Mode=OneWay}" />
                  </Grid>
                  <!-- The bars are built and eased by DownloadsChartPresenter; their fill follows this hidden source's theme brush. -->
                  <Border x:Name="ChartBrushSource" Background="{ThemeResource DlChartBarBrush}" Visibility="Collapsed" />
                  <Grid x:Name="ChartHost" Height="76" AutomationProperties.Name="Throughput over the last minute" ColumnSpacing="4" />
                  <Grid>
                    <TextBlock Foreground="{ThemeResource DlFaintBrush}" Style="{StaticResource DlKickerStyle}" Text="60 S AGO" />
                    <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource DlFaintBrush}" Style="{StaticResource DlKickerStyle}" Text="NOW" />
                  </Grid>
                </StackPanel>
                <Rectangle x:Name="InstrumentRule" Grid.Column="1" Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DlBorderBrush}" />
                <StackPanel x:Name="StorageBlock" Grid.Column="2" VerticalAlignment="Center" Spacing="10">
                  <TextBlock Style="{StaticResource DlKickerStyle}" Text="STORAGE" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource DlTextBrush}" Text="{x:Bind ViewModel.StorageValue, Mode=OneWay}" />
                    <TextBlock Padding="0,0,0,4" VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="13" Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind ViewModel.StorageUnitLine, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Grid Height="8" Background="{ThemeResource DlTrackBrush}" ColumnSpacing="2" CornerRadius="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{x:Bind ViewModel.StoredWidth, Mode=OneWay}" />
                      <ColumnDefinition Width="{x:Bind ViewModel.FlightWidth, Mode=OneWay}" />
                      <ColumnDefinition Width="{x:Bind ViewModel.FreeWidth, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource DlFillBrush}" CornerRadius="4,0,0,4" Visibility="{x:Bind ViewModel.StoredVisibility, Mode=OneWay}" />
                    <Border Grid.Column="1" Background="{ThemeResource DlGoldBrush}" Visibility="{x:Bind ViewModel.FlightVisibility, Mode=OneWay}" />
                  </Grid>
                  <StackPanel Spacing="5">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource DlAccentBrush}" />
                      <TextBlock Grid.Column="1" FontSize="13" Foreground="{ThemeResource DlMetaBrush}" Text="Stored" />
                      <TextBlock Grid.Column="2" FontFamily="{StaticResource HaloMonoFont}" FontSize="13" Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind ViewModel.StoredLine, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource DlGoldBrush}" />
                      <TextBlock Grid.Column="1" FontSize="13" Foreground="{ThemeResource DlDimBrush}" Text="In flight" />
                      <TextBlock Grid.Column="2" FontFamily="{StaticResource HaloMonoFont}" FontSize="13" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.InFlightLine, Mode=OneWay}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- `.dl-queue`: the unfinished transfers under the instrument. -->
              <StackPanel Margin="0,2,0,0" Visibility="{x:Bind ViewModel.QueueVisibility, Mode=OneWay}">
                <Rectangle Height="1" Fill="{ThemeResource DlBorderBrush}" />
                <ListView
                  x:Name="TransferList"
                  IsItemClickEnabled="True"
                  ItemClick="OnTransferItemClick"
                  ItemContainerStyle="{StaticResource DlQueueItemStyle}"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  SelectionMode="None">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DownloadRowViewModel">
                      <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                        <Border Background="{ThemeResource DlSelectedBrush}" CornerRadius="12" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                        <Rectangle Height="1" Margin="10,0" VerticalAlignment="Top" Fill="{ThemeResource DlRuleBrush}" Visibility="{x:Bind TopRuleVisibility, Mode=OneWay}" />
                        <Grid Padding="10,12" ColumnSpacing="16">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="128" Height="72" VerticalAlignment="Center" CornerRadius="8" Opacity="{x:Bind ThumbOpacity, Mode=OneWay}">
                            <Grid>
                              <local:PlaceholderArt ArtCornerRadius="8" />
                              <local:ArtworkImage DecodeWidth="256" MetaId="{x:Bind MetaId, Mode=OneWay}" SourceUrl="{x:Bind RowArtwork, Mode=OneWay}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <!-- The episode title gives way first, then the name. -->
                            <Grid ColumnSpacing="8">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="13" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind EpisodeLabel, Mode=OneWay}" Visibility="{x:Bind EpisodeLabelVisibility, Mode=OneWay}" />
                              <TextBlock Grid.Column="1" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource DlTextBrush}" Text="{x:Bind Name, Mode=OneWay}" /><Run Text="  " /><Run FontSize="14" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind Sub, Mode=OneWay}" />
                              </TextBlock>
                            </Grid>
                            <TextBlock Foreground="{ThemeResource DlFaintBrush}" Style="{StaticResource DlKickerStyle}" Text="UP NEXT" Visibility="{x:Bind UpNextVisibility, Mode=OneWay}" />
                            <StackPanel Spacing="8" Visibility="{x:Bind TransferBodyVisibility, Mode=OneWay}">
                              <Grid Height="6" Background="{ThemeResource DlBorderBrush}" CornerRadius="3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="{x:Bind ProgressDone, Mode=OneWay}" />
                                  <ColumnDefinition Width="{x:Bind ProgressRest, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource DlFillBrush}" CornerRadius="3" Visibility="{x:Bind ToneNormalVisibility, Mode=OneWay}" />
                                <Border Background="{ThemeResource DlGoldBrush}" CornerRadius="3" Visibility="{x:Bind ToneCautionVisibility, Mode=OneWay}" />
                                <Border Background="{ThemeResource DlDangerBrush}" CornerRadius="3" Visibility="{x:Bind ToneCriticalVisibility, Mode=OneWay}" />
                              </Grid>
                              <Grid>
                                <TextBlock Style="{StaticResource DlMonoStyle}" Visibility="{x:Bind ToneNormalVisibility, Mode=OneWay}"><Run Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind MetaLead, Mode=OneWay}" /><Run Text="{x:Bind MetaMiddle, Mode=OneWay}" /><Run Text="{x:Bind MetaLast, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource DlMonoStyle}" Visibility="{x:Bind ToneCautionVisibility, Mode=OneWay}"><Run Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind MetaLead, Mode=OneWay}" /><Run Text="{x:Bind MetaMiddle, Mode=OneWay}" /><Run Foreground="{ThemeResource DlCautionBrush}" Text="{x:Bind MetaLast, Mode=OneWay}" /></TextBlock>
                                <TextBlock Foreground="{ThemeResource DlDangerBrush}" Style="{StaticResource DlMonoStyle}" Visibility="{x:Bind ToneCriticalVisibility, Mode=OneWay}"><Run Text="{x:Bind MetaLead, Mode=OneWay}" /><Run Text="{x:Bind MetaMiddle, Mode=OneWay}" /><Run Text="{x:Bind MetaLast, Mode=OneWay}" /></TextBlock>
                              </Grid>
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button Click="OnChooseSourceRowClick" Style="{StaticResource DlButtonStyle}" Tag="{x:Bind Id}" Visibility="{x:Bind ChooseSourceVisibility, Mode=OneWay}">
                              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8AB;" /><TextBlock VerticalAlignment="Center" Text="Choose source again" /></StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Pause transfer" Click="OnPauseRowClick" Content="&#xE769;" Style="{StaticResource DlIconButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Pause transfer" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" />
                            <Button AutomationProperties.Name="Resume transfer" Click="OnResumeRowClick" Content="&#xE768;" Style="{StaticResource DlIconButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Resume transfer" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" />
                            <Button AutomationProperties.Name="Retry this source" Click="OnRetryRowClick" Content="&#xE72C;" Style="{StaticResource DlIconButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Retry this source" Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />
                            <Button AutomationProperties.Name="Cancel transfer" Click="OnCancelRowClick" Content="&#xE74D;" Style="{StaticResource DlDangerIconButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Cancel transfer" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- `.dl-ready`: the finished downloads as artwork cards whose columns stretch with the window. -->
          <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ReadySectionVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Style="{StaticResource DlKickerStyle}" Text="READY TO WATCH" />
              <TextBlock Foreground="{ThemeResource DlFaintBrush}" Style="{StaticResource DlKickerStyle}" Text="{x:Bind ViewModel.ReadyHeadline, Mode=OneWay}" />
            </StackPanel>
            <ItemsRepeater x:Name="ReadyGrid">
              <ItemsRepeater.Layout>
                <UniformGridLayout ItemsStretch="Uniform" MinColumnSpacing="18" MinItemWidth="220" MinRowSpacing="18" Orientation="Horizontal" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:DownloadRowViewModel">
                  <local:DownloadReadyCard PlayRequested="OnCardPlayRequested" Row="{x:Bind}" Selected="OnCardSelected" />
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>

          <!-- `.dl-empty-card`. The pane beside it shows the folder card whenever this card shows,
               so the folder action is not repeated here. -->
          <Border Padding="40,44" Background="{ThemeResource DlSurfaceBrush}" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="1" CornerRadius="16" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="36">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <local:PlaceholderArt Width="170" Height="110" VerticalAlignment="Top" ArtCornerRadius="12" Caption="NOTHING&#x000A;ON DISK" />
              <StackPanel Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource DlTextBrush}" Text="Nothing downloaded yet" />
                <StackPanel Margin="0,18,0,0" Spacing="9">
                  <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock CharacterSpacing="0" Foreground="{ThemeResource DlAccentInkBrush}" Style="{StaticResource DlKickerStyle}" Text="01" /><TextBlock Grid.Column="1" Style="{StaticResource DlEmptyStepStyle}" Text="Open a movie or episode from Library or Search." /></Grid>
                  <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock CharacterSpacing="0" Foreground="{ThemeResource DlAccentInkBrush}" Style="{StaticResource DlKickerStyle}" Text="02" /><TextBlock Grid.Column="1" Style="{StaticResource DlEmptyStepStyle}" Text="Pick a source, then choose Save for offline instead of Play." /></Grid>
                  <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock CharacterSpacing="0" Foreground="{ThemeResource DlAccentInkBrush}" Style="{StaticResource DlKickerStyle}" Text="03" /><TextBlock Grid.Column="1" Style="{StaticResource DlEmptyStepStyle}" Text="Keep Halo open until the transfer finishes. It resumes if you close it." /></Grid>
                </StackPanel>
                <Button Margin="0,22,0,0" Click="OnBrowseLibraryClick" Content="Browse library" Style="{StaticResource DlAccentButtonStyle}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- `.dl-nomatch-card`. -->
          <Border Padding="34" Background="{ThemeResource DlSurfaceBrush}" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="1" CornerRadius="16" Visibility="{x:Bind ViewModel.NoMatchesVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" Spacing="5">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource DlTextBrush}" Text="Nothing in this filter" />
              <TextBlock HorizontalAlignment="Center" FontSize="15" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.NoMatchesLine, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- `.dl-pane`: the full-height detail pane at the window edge. -->
    <Border Grid.Column="1" Background="{ThemeResource DlBgBrush}" BorderBrush="{ThemeResource DlSurfaceBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer x:Name="PaneScroller" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnPaneSizeChanged" VerticalScrollBarVisibility="Hidden">
        <Grid x:Name="PaneContent">
          <!-- At least the pane's height, so the delete button sits at its foot. -->
          <Grid Padding="24,28,24,24" RowSpacing="16" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="16">
              <Border x:Name="PaneArt" Height="187" CornerRadius="16">
                <Grid>
                  <local:PlaceholderArt ArtCornerRadius="16" />
                  <local:ArtworkImage DecodeWidth="680" MetaId="{x:Bind ViewModel.SelectedRow.MetaId, Mode=OneWay}" SourceUrl="{x:Bind ViewModel.SelectedRow.RowArtwork, Mode=OneWay}" />
                </Grid>
              </Border>
              <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource DlTextBrush}" Text="{x:Bind ViewModel.SelectedRow.Name, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                  <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Border Padding="8,2" Background="{ThemeResource DlAccentTintBrush}" CornerRadius="6" Visibility="{x:Bind ViewModel.SelectedRow.StateAccentVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource DlAccentInkBrush}" Style="{StaticResource DlStatePillTextStyle}" Text="{x:Bind ViewModel.SelectedRow.StatePill, Mode=OneWay}" /></Border>
                    <Border Padding="8,2" Background="{ThemeResource DlCautionTintBrush}" CornerRadius="6" Visibility="{x:Bind ViewModel.SelectedRow.StateCautionVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource DlCautionBrush}" Style="{StaticResource DlStatePillTextStyle}" Text="{x:Bind ViewModel.SelectedRow.StatePill, Mode=OneWay}" /></Border>
                    <Border Padding="8,2" Background="{ThemeResource DlDangerTintBrush}" CornerRadius="6" Visibility="{x:Bind ViewModel.SelectedRow.StateCriticalVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource DlDangerBrush}" Style="{StaticResource DlStatePillTextStyle}" Text="{x:Bind ViewModel.SelectedRow.StatePill, Mode=OneWay}" /></Border>
                    <Border Padding="8,2" Background="{ThemeResource DlSurfaceHighBrush}" CornerRadius="6" Visibility="{x:Bind ViewModel.SelectedRow.StateNeutralVisibility, Mode=OneWay}"><TextBlock Foreground="{ThemeResource DlDimBrush}" Style="{StaticResource DlStatePillTextStyle}" Text="{x:Bind ViewModel.SelectedRow.StatePill, Mode=OneWay}" /></Border>
                  </Grid>
                </Grid>
                <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlDimBrush}" Text="{x:Bind ViewModel.SelectedRow.PaneMeta, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedReadyVisibility, Mode=OneWay}">
                <Button Click="OnPlaySelectedClick" Style="{StaticResource DlPlayButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE768;" /><TextBlock VerticalAlignment="Center" Text="Play offline" /></StackPanel>
                </Button>
                <Button Click="OnRevealSelectedClick" Style="{StaticResource DlBlockButtonStyle}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="15" Glyph="&#xE838;" /><TextBlock VerticalAlignment="Center" Text="Open folder" /></StackPanel>
                </Button>
              </StackPanel>

              <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectedTransferVisibility, Mode=OneWay}">
                <Grid Height="6" Background="{ThemeResource DlBorderBrush}" CornerRadius="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind ViewModel.SelectedRow.ProgressDone, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind ViewModel.SelectedRow.ProgressRest, Mode=OneWay}" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{ThemeResource DlFillBrush}" CornerRadius="3" Visibility="{x:Bind ViewModel.SelectedRow.ToneNormalVisibility, Mode=OneWay}" />
                  <Border Background="{ThemeResource DlGoldBrush}" CornerRadius="3" Visibility="{x:Bind ViewModel.SelectedRow.ToneCautionVisibility, Mode=OneWay}" />
                  <Border Background="{ThemeResource DlDangerBrush}" CornerRadius="3" Visibility="{x:Bind ViewModel.SelectedRow.ToneCriticalVisibility, Mode=OneWay}" />
                </Grid>
                <!-- A failure's sentence wraps here: the pane is where it is read whole. -->
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind ViewModel.SelectedRow.Lead, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.SelectedRow.ToneNormalVisibility, Mode=OneWay}" />
                  <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlCautionBrush}" Text="{x:Bind ViewModel.SelectedRow.Lead, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.SelectedRow.ToneCautionVisibility, Mode=OneWay}" />
                  <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlDangerBrush}" Text="{x:Bind ViewModel.SelectedRow.Lead, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.SelectedRow.ToneCriticalVisibility, Mode=OneWay}" />
                  <TextBlock Grid.Column="1" FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlMetaBrush}" Text="{x:Bind ViewModel.SelectedRow.PercentText, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="8">
                    <Button Click="OnPauseSelectedClick" Style="{StaticResource DlBlockButtonStyle}" Visibility="{x:Bind ViewModel.SelectedRow.PanePauseVisibility, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="13" Glyph="&#xE769;" /><TextBlock VerticalAlignment="Center" Text="Pause transfer" /></StackPanel>
                    </Button>
                    <Button Click="OnResumeSelectedClick" Style="{StaticResource DlBlockButtonStyle}" Visibility="{x:Bind ViewModel.SelectedRow.PaneResumeVisibility, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="13" Glyph="&#xE768;" /><TextBlock VerticalAlignment="Center" Text="Resume transfer" /></StackPanel>
                    </Button>
                  </StackPanel>
                  <Button Grid.Column="1" Width="44" Height="44" VerticalAlignment="Top" AutomationProperties.Name="Cancel transfer" Click="OnCancelSelectedClick" Content="&#xE74D;" CornerRadius="12" Style="{StaticResource DlDangerIconButtonStyle}" ToolTipService.ToolTip="Cancel transfer" />
                </Grid>
                <Button Click="OnChooseSourceClick" Style="{StaticResource DlBlockButtonStyle}" Visibility="{x:Bind ViewModel.SelectedRow.ChooseSourceVisibility, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8AB;" /><TextBlock VerticalAlignment="Center" Text="Choose source again" /></StackPanel>
                </Button>
              </StackPanel>

              <Border Background="{ThemeResource DlSurfaceBrush}" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                  <Grid Padding="14,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DlFactLabelStyle}" Text="Quality" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind ViewModel.SelectedRow.QualityLine, Mode=OneWay}" />
                  </Grid>
                  <Grid Padding="14,12" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DlFactLabelStyle}" Text="{x:Bind ViewModel.SelectedRow.SizeFactLabel, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind ViewModel.SelectedRow.DownloadedLine, Mode=OneWay}" />
                  </Grid>
                  <Grid Padding="14,12" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DlFactLabelStyle}" Text="Subtitle" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind ViewModel.SelectedRow.Subs, Mode=OneWay}" />
                  </Grid>
                  <Grid Padding="14,12" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DlFactLabelStyle}" Text="Added" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind ViewModel.SelectedRow.AddedFact, Mode=OneWay}" />
                  </Grid>
                  <!-- Release names run far longer than the pane is wide; the tooltip carries the whole name. -->
                  <Grid Padding="14,12" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DlFactLabelStyle}" Text="File" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind ViewModel.SelectedRow.FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedRow.FileName, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- The failure sentence is already on the lead line; this says what happens to the bytes on disk. -->
              <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="{ThemeResource DlFaintBrush}" LineHeight="18" Text="THE PARTIAL FILE IS KEPT UNTIL A NEW SOURCE FINISHES." TextWrapping="Wrap" Visibility="{x:Bind ViewModel.SelectedRow.FailedNoteVisibility, Mode=OneWay}" />
            </StackPanel>

            <Button Grid.Row="2" Click="OnDeleteSelectedClick" Style="{StaticResource DlDeleteButtonStyle}" Visibility="{x:Bind ViewModel.SelectedReadyVisibility, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="15" Glyph="&#xE74D;" /><TextBlock VerticalAlignment="Center" Text="Delete download" /></StackPanel>
            </Button>
          </Grid>

          <!-- `.dl-folder-card`, with nothing to describe. -->
          <Border Margin="24,28" Padding="20" VerticalAlignment="Top" Background="{ThemeResource DlSurfaceBrush}" BorderBrush="{ThemeResource DlBorderBrush}" BorderThickness="1" CornerRadius="16" Visibility="{x:Bind ViewModel.FolderVisibility, Mode=OneWay}">
            <StackPanel Spacing="14">
              <TextBlock Style="{StaticResource DlKickerStyle}" Text="DOWNLOAD FOLDER" />
              <Button Click="OnManageFolderClick" Style="{StaticResource DlBlockButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="15" Glyph="&#xE838;" /><TextBlock VerticalAlignment="Center" Text="Manage folder" /></StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</Page>
