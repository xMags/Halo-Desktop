<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.DownloadsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <local:SectionHeader Title="Downloads" Crumb="{x:Bind ViewModel.HeaderCrumb, Mode=OneWay}" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="24,8,24,48" ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="292" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="16">
          <InfoBar
            IsClosable="True"
            IsOpen="True"
            Severity="Informational"
            Title="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}" />

          <Border Padding="18" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <Grid ColumnSpacing="16">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="176" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Spacing="5">
                <TextBlock Style="{StaticResource HaloMonoBig}" Text="{x:Bind ViewModel.RateText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.QueueLine, Mode=OneWay}" />
              </StackPanel>
              <Grid Grid.Column="1" Height="80" VerticalAlignment="Bottom">
                <ItemsControl x:Name="ChartList" VerticalAlignment="Bottom">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ChartBarViewModel">
                      <Grid Width="5" Height="80">
                        <Border Width="5" Height="{x:Bind Height}" VerticalAlignment="Bottom" Background="{ThemeResource HaloChartDimBrush}" CornerRadius="2,2,0,0" Visibility="{x:Bind HistoricalVisibility}" />
                        <Border Width="5" Height="{x:Bind Height}" VerticalAlignment="Bottom" Background="{ThemeResource HaloAccentBrush}" CornerRadius="2,2,0,0" Visibility="{x:Bind RecentVisibility}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <Button Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center" Click="OnPauseAllClick" Content="{x:Bind ViewModel.PauseAllLabel, Mode=OneWay}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" HorizontalAlignment="Left" Style="{StaticResource HaloMonoData}" Text="THROUGHPUT · LAST 60S" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="PEAK 41.2 MB/S" />
            </Grid>
          </Border>

          <Border Padding="16" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="10">
              <Grid><TextBlock FontWeight="SemiBold" Text="248.6 GB of downloads · 331.4 GB used" /><TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource HaloText3Brush}" Text="180.6 GB free of 512 GB" /></Grid>
              <Grid Height="8"><Border Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" /><Grid HorizontalAlignment="Left" Width="360"><Grid.ColumnDefinitions><ColumnDefinition Width="48*" /><ColumnDefinition Width="17*" /><ColumnDefinition Width="35*" /></Grid.ColumnDefinitions><Border Background="{ThemeResource HaloAccentBrush}" CornerRadius="4,0,0,4" /><Border Grid.Column="1" Background="{ThemeResource HaloText4Brush}" /></Grid></Grid>
              <StackPanel Orientation="Horizontal" Spacing="20"><TextBlock Foreground="{ThemeResource HaloAccentBrush}" Text="● Series 159 GB" /><TextBlock Foreground="{ThemeResource HaloSuccessBrush}" Text="● Movies 72 GB" /><TextBlock Foreground="{ThemeResource HaloCautionBrush}" Text="● In flight 17.6 GB" /></StackPanel>
            </StackPanel>
          </Border>

          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource HaloMonoKicker}" Text="IN PROGRESS" /><Rectangle Grid.Column="1" Height="1" Margin="12,0" Fill="{ThemeResource HaloDividerBrush}" /><TextBlock Grid.Column="2" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.TransferCountLabel, Mode=OneWay}" /></Grid>
          <ListView x:Name="TransferList" IsItemClickEnabled="True" ItemClick="OnTransferItemClick" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:DownloadRowViewModel">
                <Grid MinWidth="620" Padding="8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid Width="74" Height="42"><local:PlaceholderArt /><ProgressBar Height="3" VerticalAlignment="Bottom" Maximum="1" Value="{x:Bind Progress}" /></Grid>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind Tag}" /><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind Sub}" /></StackPanel>
                    <ProgressBar Height="4" Maximum="1" Value="{x:Bind Progress}" />
                    <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Border Padding="7,3" Background="{ThemeResource HaloAccentTintBrush}" CornerRadius="3" Visibility="{x:Bind DownloadingVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloAccentBrush}" Text="DOWNLOADING" /></Border>
                    <Border Padding="7,3" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3" Visibility="{x:Bind QueuedVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Text="QUEUED" /></Border>
                    <Border Padding="7,3" Background="{ThemeResource HaloCautionTintBrush}" CornerRadius="3" Visibility="{x:Bind PausedVisibility}"><TextBlock Style="{StaticResource HaloMonoData}" Foreground="{ThemeResource HaloCautionBrush}" Text="PAUSED" /></Border>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource HaloMonoKicker}" Text="READY TO WATCH" /><Rectangle Grid.Column="1" Height="1" Margin="12,0" Fill="{ThemeResource HaloDividerBrush}" /><TextBlock Grid.Column="2" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.ReadyCountLabel, Mode=OneWay}" /></Grid>
          <ListView x:Name="ReadyList" IsItemClickEnabled="True" ItemClick="OnReadyItemClick" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:DownloadRowViewModel">
                <Grid MinWidth="620" Padding="8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid Width="74" Height="42"><local:PlaceholderArt /><ProgressBar Height="3" VerticalAlignment="Bottom" Maximum="1" Value="{x:Bind Progress}" /></Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind Tag}" /><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind Sub}" /></StackPanel><TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" Text="&#xE768;" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
          <Button Height="164" Padding="0" Click="OnPlaySelectedClick">
            <Grid><local:PlaceholderArt /><Border Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#C0000000" CornerRadius="23"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="White" Text="&#xE768;" /></Border></Grid>
          </Button>
          <TextBlock Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoKicker}" Text="{x:Bind ViewModel.SelectedTag, Mode=OneWay}" />
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" />
          <TextBlock Foreground="{ThemeResource HaloText3Brush}" Text="{x:Bind ViewModel.SelectedSub, Mode=OneWay}" />
          <StackPanel Visibility="{x:Bind ViewModel.SelectedTransferVisibility, Mode=OneWay}" Spacing="8">
            <ProgressBar Height="5" Maximum="1" Value="{x:Bind ViewModel.SelectedProgress, Mode=OneWay}" />
            <TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.SelectedDetail, Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6"><Button Click="OnPauseSelectedClick" Content="Pause transfer" Visibility="{x:Bind ViewModel.PauseVisibility, Mode=OneWay}" /><Button Click="OnResumeSelectedClick" Content="Resume transfer" Visibility="{x:Bind ViewModel.ResumeVisibility, Mode=OneWay}" /><Button Click="OnStartNowClick" Content="Start now" Visibility="{x:Bind ViewModel.StartNowVisibility, Mode=OneWay}" /><Button Click="OnCancelSelectedClick" Content="&#xE711;" /></StackPanel>
          </StackPanel>
          <Button Click="OnPlaySelectedClick" Content="{x:Bind ViewModel.ReadyActionLabel, Mode=OneWay}" Style="{StaticResource HaloAccentButtonStyle}" Visibility="{x:Bind ViewModel.SelectedReadyVisibility, Mode=OneWay}" />
          <Border Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8"><TextBlock Style="{StaticResource HaloMonoKicker}" Text="DETAILS" /><Grid><TextBlock Text="Quality" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.SelectedQualityLine, Mode=OneWay}" /></Grid><Grid><TextBlock Text="File size" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.SelectedSize, Mode=OneWay}" /></Grid><Grid><TextBlock Text="Subtitle" /><TextBlock HorizontalAlignment="Right" Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.SelectedSubs, Mode=OneWay}" /></Grid></StackPanel>
          </Border>
          <Button BorderBrush="{ThemeResource HaloCriticalBrush}" Click="OnDeleteSelectedClick" Foreground="{ThemeResource HaloCriticalBrush}" Content="Delete from device" Visibility="{x:Bind ViewModel.SelectedReadyVisibility, Mode=OneWay}" />
          <Border Padding="14" Background="{ThemeResource HaloCardBrush}" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8"><TextBlock Style="{StaticResource HaloMonoKicker}" Text="QUEUE" /><TextBlock Style="{StaticResource HaloMonoData}" Text="{x:Bind ViewModel.QueueLine, Mode=OneWay}" TextWrapping="Wrap" /><Button Click="OnManageFolderClick" Content="Manage folder" /></StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
