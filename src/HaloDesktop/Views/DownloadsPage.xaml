<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.DownloadsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  NavigationCacheMode="Required">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:SectionHeader Title="Downloads" Crumb="2 ACTIVE · 18 DONE" />
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <TextBlock Text="LIVE MOCK THROUGHPUT" Style="{StaticResource HaloMonoKicker}" />
      <TextBlock x:Name="RateText" HorizontalAlignment="Center" Style="{StaticResource HaloMonoBig}" />
      <TextBlock x:Name="QueueText" HorizontalAlignment="Center" Style="{StaticResource HaloMonoData}" />
    </StackPanel>
  </Grid>
</Page>
