<?xml version="1.0" encoding="utf-8"?>
<!--
  Downloads, in Windows' own (Fluent) shapes: a SelectorBar of filters and the
  bulk actions under the title, a settings-style status card that opens on the
  speed and storage, failed transfers as error InfoBars, the running transfers
  as cards whose file facts open on demand, the queue folded into one card,
  and the finished files as a grid. What is not needed all the time (the speed
  graph, storage, file facts, the queue, cancel and the rarer folder actions)
  stays behind a click or a menu.
-->
<Page
  x:Class="HaloDesktop.DownloadsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  NavigationCacheMode="Required"
  Unloaded="OnUnloaded">
  <Page.Resources>
    <ResourceDictionary>
      <!-- A settings-style card: the control fill and hairline, radius 8. -->
      <Style x:Key="DlCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HaloCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HaloCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <!-- The clickable header of a card: no plate at rest, the stock hover wash. -->
      <Style x:Key="DlCardHeaderButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="16,10,12,10" />
      </Style>
      <!-- A command bar button: glyph and label, no plate at rest. -->
      <Style x:Key="DlSubtleButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <!-- A square icon button beside a row: the standard plate. -->
      <Style x:Key="DlRowIconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style x:Key="DlCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="DlSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
      </Style>
      <!-- One fact under an opened row: the label, its value on the right. -->
      <Style x:Key="DlFactRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="128,0,16,0" />
        <Setter Property="BorderBrush" Value="{ThemeResource HaloCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="ColumnSpacing" Value="16" />
      </Style>
      <Style x:Key="DlFactValueStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The title; under it the filters on the left and the bulk actions on the right. -->
    <Grid Padding="32,28,32,4" RowSpacing="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        FontFamily="Segoe UI Variable Display"
        FontSize="28"
        FontWeight="SemiBold"
        Foreground="{ThemeResource HaloText1Brush}"
        Text="Downloads" />
      <Grid Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <SelectorBar x:Name="FilterBar" HorizontalAlignment="Left" SelectionChanged="OnFilterSelectionChanged">
          <SelectorBarItem x:Name="AllFilterItem" IsSelected="True" Text="All" />
          <SelectorBarItem x:Name="ActiveFilterItem" Text="Active" />
          <SelectorBarItem x:Name="ReadyFilterItem" Text="Ready" />
          <SelectorBarItem x:Name="FailedFilterItem" Text="Failed" />
        </SelectorBar>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
          <Button AutomationProperties.Name="{x:Bind ViewModel.PauseAllLabel, Mode=OneWay}" Click="OnPauseAllClick" Style="{StaticResource DlSubtleButtonStyle}" Visibility="{x:Bind ViewModel.PauseAllVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="14" Glyph="{x:Bind ViewModel.PauseAllGlyph, Mode=OneWay}" /><TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PauseAllLabel, Mode=OneWay}" /></StackPanel>
          </Button>
          <Button Click="OnOpenFolderClick" Style="{StaticResource DlSubtleButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE838;" /><TextBlock VerticalAlignment="Center" Text="Open folder" /></StackPanel>
          </Button>
          <Button Width="36" Padding="0" AutomationProperties.Name="More download actions" Style="{StaticResource DlSubtleButtonStyle}" ToolTipService.ToolTip="More download actions">
            <FontIcon FontSize="14" Glyph="&#xE712;" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem MinWidth="220" Click="OnManageFolderClick" Text="Change download folder…">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="OnRetryFailedClick" Text="Retry all failed">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="32,12,32,40" Spacing="4">
        <InfoBar
          Margin="0,0,0,8"
          IsClosable="False"
          IsOpen="True"
          Message="{x:Bind ViewModel.ActionErrorText, Mode=OneWay}"
          Severity="Error"
          Title="Download action failed"
          Visibility="{x:Bind ViewModel.ActionErrorVisibility, Mode=OneWay}" />

        <!-- Status: one line shut; the minute of speed and the storage open under it. -->
        <Border Margin="0,0,0,8" Style="{StaticResource DlCardStyle}" Visibility="{x:Bind ViewModel.SummaryVisibility, Mode=OneWay}">
          <StackPanel>
            <Button x:Name="StatusToggle" MinHeight="68" AutomationProperties.Name="Transfer details" Click="OnStatusToggleClick" Style="{StaticResource DlCardHeaderButtonStyle}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="20" Foreground="{ThemeResource HaloAccentBrush}" Glyph="&#xEBD3;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Foreground="{ThemeResource HaloText1Brush}" Text="{x:Bind ViewModel.SummaryLine, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource DlCaptionStyle}" Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" />
                </StackPanel>
                <TextBlock x:Name="StatusHint" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource DlCaptionStyle}" Text="Details" />
                <FontIcon Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE70D;" RenderTransformOrigin="0.5,0.5">
                  <FontIcon.RenderTransform><RotateTransform x:Name="StatusChevronTurn" /></FontIcon.RenderTransform>
                </FontIcon>
              </Grid>
            </Button>
            <Grid x:Name="StatusDetails" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="32" Padding="52,14,16,16" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="Speed, last minute" />
                  <TextBlock HorizontalAlignment="Right" Style="{StaticResource DlCaptionStyle}" Text="{x:Bind ViewModel.PeakText, Mode=OneWay}" />
                </Grid>
                <!-- The bars are built and eased by DownloadsChartPresenter; their fill follows this hidden source's theme brush. -->
                <Border x:Name="ChartBrushSource" Background="{ThemeResource DlChartBarBrush}" Visibility="Collapsed" />
                <Grid x:Name="ChartHost" Height="56" AutomationProperties.Name="Throughput over the last minute" ColumnSpacing="2" />
                <Grid>
                  <TextBlock Style="{StaticResource DlCaptionStyle}" Text="1 min ago" />
                  <TextBlock HorizontalAlignment="Right" Style="{StaticResource DlCaptionStyle}" Text="Now" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="Storage" />
                <Grid Height="6" Background="{ThemeResource DlTrackBrush}" CornerRadius="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind ViewModel.StoredWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind ViewModel.FlightWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind ViewModel.FreeWidth, Mode=OneWay}" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{ThemeResource HaloText2Brush}" Visibility="{x:Bind ViewModel.StoredVisibility, Mode=OneWay}" />
                  <Border Grid.Column="1" Background="{ThemeResource HaloAccentBrush}" Visibility="{x:Bind ViewModel.FlightVisibility, Mode=OneWay}" />
                </Grid>
                <StackPanel Spacing="4">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="8" Height="8" VerticalAlignment="Center" Background="{ThemeResource HaloText2Brush}" CornerRadius="2" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DlCaptionStyle}" Text="Downloaded" />
                    <TextBlock Grid.Column="2" Style="{StaticResource DlCaptionStyle}" Text="{x:Bind ViewModel.StoredLine, Mode=OneWay}" />
                  </Grid>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="8" Height="8" VerticalAlignment="Center" Background="{ThemeResource HaloAccentBrush}" CornerRadius="2" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DlCaptionStyle}" Text="Arriving" />
                    <TextBlock Grid.Column="2" Style="{StaticResource DlCaptionStyle}" Text="{x:Bind ViewModel.InFlightLine, Mode=OneWay}" />
                  </Grid>
                  <TextBlock Style="{StaticResource DlCaptionStyle}" Text="{x:Bind ViewModel.StorageUnitLine, Mode=OneWay}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Failed transfers: one error InfoBar each, the fix as its first button. -->
        <ItemsRepeater x:Name="AttentionList" Margin="0,0,0,8" Visibility="{x:Bind ViewModel.AttentionVisibility, Mode=OneWay}">
          <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:DownloadRowViewModel">
              <InfoBar IsClosable="False" IsOpen="True" Message="{x:Bind Lead, Mode=OneWay}" Severity="Error" Title="{x:Bind CardTitle, Mode=OneWay}">
                <InfoBar.Content>
                  <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnChooseSourceRowClick" Content="Choose another source" Tag="{x:Bind Id}" Visibility="{x:Bind ChooseSourceVisibility, Mode=OneWay}" />
                    <Button Click="OnRetryRowClick" Content="Try again" Tag="{x:Bind Id}" Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />
                    <Button Click="OnCancelRowClick" Content="Remove" Style="{StaticResource DlSubtleButtonStyle}" Tag="{x:Bind Id}" />
                  </StackPanel>
                </InfoBar.Content>
              </InfoBar>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- Downloading: progress and pause always there; the file's facts open on a click. -->
        <TextBlock Style="{StaticResource DlSectionTitleStyle}" Text="Downloading" Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}" />
        <ItemsRepeater x:Name="RunningList" Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}">
          <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:DownloadRowViewModel">
              <Border Style="{StaticResource DlCardStyle}">
                <StackPanel>
                  <Grid Padding="0,0,8,0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" Click="OnToggleDetailsClick" Style="{StaticResource DlCardHeaderButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Details">
                      <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="54" CornerRadius="4" Opacity="{x:Bind ThumbOpacity, Mode=OneWay}">
                          <Grid>
                            <local:PlaceholderArt ArtCornerRadius="4" />
                            <local:ArtworkImage DecodeWidth="192" MetaId="{x:Bind MetaId, Mode=OneWay}" SourceUrl="{x:Bind RowArtwork, Mode=OneWay}" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                          <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Foreground="{ThemeResource HaloText1Brush}" Text="{x:Bind Name, Mode=OneWay}" /><Run Text="  " /><Run Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind EpisodeLabel, Mode=OneWay}" />
                          </TextBlock>
                          <ProgressBar Maximum="1" ShowPaused="{x:Bind IsPaused, Mode=OneWay}" Value="{x:Bind Progress, Mode=OneWay}" />
                          <Grid>
                            <TextBlock Style="{StaticResource DlCaptionStyle}" Visibility="{x:Bind ToneNormalVisibility, Mode=OneWay}"><Run Text="{x:Bind MetaLead, Mode=OneWay}" /><Run Text="{x:Bind MetaMiddle, Mode=OneWay}" /><Run Text="{x:Bind MetaLast, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource DlCaptionStyle}" Visibility="{x:Bind ToneCautionVisibility, Mode=OneWay}"><Run Text="{x:Bind MetaLead, Mode=OneWay}" /><Run Text="{x:Bind MetaMiddle, Mode=OneWay}" /><Run Foreground="{ThemeResource HaloCautionBrush}" Text="{x:Bind MetaLast, Mode=OneWay}" /></TextBlock>
                            <TextBlock Foreground="{ThemeResource HaloCriticalBrush}" Style="{StaticResource DlCaptionStyle}" Visibility="{x:Bind ToneCriticalVisibility, Mode=OneWay}"><Run Text="{x:Bind MetaLead, Mode=OneWay}" /><Run Text="{x:Bind MetaMiddle, Mode=OneWay}" /><Run Text="{x:Bind MetaLast, Mode=OneWay}" /></TextBlock>
                          </Grid>
                        </StackPanel>
                        <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE70D;" RenderTransformOrigin="0.5,0.5">
                          <FontIcon.RenderTransform><RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" /></FontIcon.RenderTransform>
                        </FontIcon>
                      </Grid>
                    </Button>
                    <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Pause transfer" Click="OnPauseRowClick" Style="{StaticResource DlRowIconButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Pause" Visibility="{x:Bind PauseVisibility, Mode=OneWay}">
                      <FontIcon FontSize="14" Glyph="&#xE769;" />
                    </Button>
                    <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Resume transfer" Click="OnResumeRowClick" Style="{StaticResource DlRowIconButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Resume" Visibility="{x:Bind ResumeVisibility, Mode=OneWay}">
                      <FontIcon FontSize="14" Glyph="&#xE768;" />
                    </Button>
                    <Button Grid.Column="2" Width="36" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="More actions" Style="{StaticResource DlSubtleButtonStyle}" ToolTipService.ToolTip="More actions">
                      <FontIcon FontSize="14" Glyph="&#xE712;" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuFlyoutItem MinWidth="200" Click="OnChooseSourceRowClick" Tag="{x:Bind Id}" Text="Choose another source">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutSeparator />
                          <MenuFlyoutItem Click="OnCancelRowClick" Tag="{x:Bind Id}" Text="Cancel download">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <StackPanel Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                    <Grid Style="{StaticResource DlFactRowStyle}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Quality" />
                      <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind QualityLine, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource DlFactRowStyle}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{x:Bind SizeFactLabel, Mode=OneWay}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind DownloadedLine, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource DlFactRowStyle}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Subtitle" />
                      <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind Subs, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource DlFactRowStyle}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Added" />
                      <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind AddedFact, Mode=OneWay}" />
                    </Grid>
                    <!-- Release names run far longer than the row; the tooltip carries the whole name. -->
                    <Grid Style="{StaticResource DlFactRowStyle}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="File" />
                      <TextBlock Grid.Column="1" Style="{StaticResource DlFactValueStyle}" Text="{x:Bind FileName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- Up next: one card, shut until opened. -->
        <Border Margin="0,4,0,0" Style="{StaticResource DlCardStyle}" Visibility="{x:Bind ViewModel.WaitingVisibility, Mode=OneWay}">
          <StackPanel>
            <Button MinHeight="52" AutomationProperties.Name="Up next" Click="OnWaitingToggleClick" Style="{StaticResource DlCardHeaderButtonStyle}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE8FD;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource HaloText1Brush}" Text="Up next" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource DlCaptionStyle}" Text="{x:Bind ViewModel.WaitingLine, Mode=OneWay}" />
                <FontIcon Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE70D;" RenderTransformOrigin="0.5,0.5">
                  <FontIcon.RenderTransform><RotateTransform x:Name="WaitingChevronTurn" /></FontIcon.RenderTransform>
                </FontIcon>
              </Grid>
            </Button>
            <ItemsRepeater x:Name="WaitingList" Visibility="Collapsed">
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:DownloadRowViewModel">
                  <Grid MinHeight="44" Padding="48,0,8,0" BorderBrush="{ThemeResource HaloCardStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                      <Run Foreground="{ThemeResource HaloText1Brush}" Text="{x:Bind Name, Mode=OneWay}" /><Run Text="  " /><Run Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind EpisodeLabel, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource DlCaptionStyle}" Text="{x:Bind DownloadedLine, Mode=OneWay}" />
                    <Button Grid.Column="2" Width="36" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Remove from the queue" Click="OnCancelRowClick" Style="{StaticResource DlSubtleButtonStyle}" Tag="{x:Bind Id}" ToolTipService.ToolTip="Remove from the queue">
                      <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </Border>

        <!-- Ready to watch: the finished files; Play on hover, the rest on right-click. -->
        <StackPanel Margin="0,12,0,0" Spacing="8" Visibility="{x:Bind ViewModel.ReadySectionVisibility, Mode=OneWay}">
          <TextBlock Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}">
            <Run Text="Ready to watch" /><Run Text="  " /><Run FontWeight="Normal" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.ReadyHeadline, Mode=OneWay}" />
          </TextBlock>
          <ItemsRepeater x:Name="ReadyGrid">
            <ItemsRepeater.Layout>
              <UniformGridLayout ItemsStretch="Uniform" MinColumnSpacing="16" MinItemWidth="220" MinRowSpacing="16" Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="local:DownloadRowViewModel">
                <local:DownloadReadyCard PlayRequested="OnCardPlayRequested" Row="{x:Bind}" Selected="OnCardPlayRequested">
                  <local:DownloadReadyCard.ContextFlyout>
                    <MenuFlyout>
                      <MenuFlyoutItem MinWidth="200" Click="OnReadyPlayClick" Tag="{x:Bind Id}" Text="Play offline">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Click="OnReadyRevealClick" Tag="{x:Bind Id}" Text="Show in folder">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem Click="OnReadyDeleteClick" Tag="{x:Bind Id}" Text="Delete from this PC">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </local:DownloadReadyCard.ContextFlyout>
                </local:DownloadReadyCard>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

        <!-- First run: nothing to show yet, so no status, filters' content or storage. -->
        <StackPanel MaxWidth="560" Margin="0,48,0,0" HorizontalAlignment="Center" Spacing="20" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
          <Border Width="64" Height="64" HorizontalAlignment="Center" Background="{ThemeResource HaloAccentTintBrush}" CornerRadius="16">
            <FontIcon FontSize="30" Foreground="{ThemeResource HaloAccentBrush}" Glyph="&#xEBD3;" />
          </Border>
          <StackPanel Spacing="6">
            <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="Watch without a connection" />
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource HaloText2Brush}" Text="Save a movie or an episode to this PC and it plays here even when you are offline." TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="4">
            <Border MinHeight="52" Padding="16,0" Style="{StaticResource DlCardStyle}">
              <Grid VerticalAlignment="Center" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="22" Height="22" BorderBrush="{ThemeResource HaloAccentBrush}" BorderThickness="1" CornerRadius="11"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource HaloAccentBrush}" Text="1" /></Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource HaloText1Brush}" Text="Open a movie or an episode from Library or Search." TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Border MinHeight="52" Padding="16,0" Style="{StaticResource DlCardStyle}">
              <Grid VerticalAlignment="Center" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="22" Height="22" BorderBrush="{ThemeResource HaloAccentBrush}" BorderThickness="1" CornerRadius="11"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource HaloAccentBrush}" Text="2" /></Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource HaloText1Brush}" Text="Pick a source, then choose Save for offline instead of Play." TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Border MinHeight="52" Padding="16,0" Style="{StaticResource DlCardStyle}">
              <Grid VerticalAlignment="Center" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="22" Height="22" BorderBrush="{ThemeResource HaloAccentBrush}" BorderThickness="1" CornerRadius="11"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource HaloAccentBrush}" Text="3" /></Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource HaloText1Brush}" Text="It downloads in the background and picks up again if you close Halo." TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
            <Button Click="OnBrowseLibraryClick" Content="Browse your library" Style="{StaticResource AccentButtonStyle}" />
            <Button Click="OnManageFolderClick" Content="Choose download folder" />
          </StackPanel>
        </StackPanel>

        <!-- A filter with nothing in it. -->
        <Border Margin="0,8,0,0" Padding="24" Style="{StaticResource DlCardStyle}" Visibility="{x:Bind ViewModel.NoMatchesVisibility, Mode=OneWay}">
          <StackPanel HorizontalAlignment="Center" Spacing="4">
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource HaloText1Brush}" Text="Nothing in this filter" />
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource HaloText2Brush}" Text="{x:Bind ViewModel.NoMatchesLine, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
