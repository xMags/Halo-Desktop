// The medal finish is declared with the control that renders it. This is the one
// type this sheet borrows from another file, so it is imported rather than
// restated.
import "Controls/QualityMedal.idl";

namespace HaloDesktop
{
    // What saving one source means right now, shared by the pick's Save, a row's
    // details and the row's own saved or saving mark. Updated in place as the
    // download moves, so the list is not rebuilt on every progress tick.
    runtimeclass SourceSaveViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Key { get; };
        String Label { get; };
        Boolean IsReady { get; };
        Microsoft.UI.Xaml.Visibility ButtonVisibility { get; };
        Microsoft.UI.Xaml.Visibility ArrowVisibility { get; };
        Microsoft.UI.Xaml.Visibility RingVisibility { get; };
        Microsoft.UI.Xaml.Visibility CheckVisibility { get; };
        Microsoft.UI.Xaml.Visibility ReadyLabelVisibility { get; };
        Microsoft.UI.Xaml.Visibility SavingLabelVisibility { get; };
        Microsoft.UI.Xaml.Visibility SavedLabelVisibility { get; };
    }

    // One cell of the details' fact grid. The From cell carries the provider and
    // its cache dot instead of a plain value.
    [default_interface]
    runtimeclass SourceFactViewModel
    {
        String Label { get; };
        String Value { get; };
        Microsoft.UI.Xaml.Visibility ValueVisibility { get; };
        Microsoft.UI.Xaml.Visibility ProviderVisibility { get; };
        String Provider { get; };
        String CacheLabel { get; };
        Microsoft.UI.Xaml.Visibility CacheGoodVisibility { get; };
        Microsoft.UI.Xaml.Visibility CacheNeutralVisibility { get; };
    }

    // Two cells side by side, or one across the whole line when it is the odd one out.
    [default_interface]
    runtimeclass SourceFactLineViewModel
    {
        SourceFactViewModel Left { get; };
        SourceFactViewModel Right { get; };
        Int32 LeftSpan { get; };
        Microsoft.UI.Xaml.Visibility RightVisibility { get; };
    }

    runtimeclass SourceDetailsViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Key { get; };
        String FileName { get; };
        String Warning { get; };
        Microsoft.UI.Xaml.Visibility WarningVisibility { get; };
        Object FactLines { get; };
        Microsoft.UI.Xaml.Visibility BandwidthVisibility { get; };
        String BandwidthLabel { get; };
        String BandwidthNote { get; };
        Microsoft.UI.Xaml.Visibility BandwidthNoteVisibility { get; };
        Double MeterFraction { get; };
        Microsoft.UI.Xaml.Visibility MeterVisibility { get; };
        Microsoft.UI.Xaml.Visibility MeterNormalVisibility { get; };
        Microsoft.UI.Xaml.Visibility MeterOverVisibility { get; };
        // The pick has its own Save on the card, so its details carry none.
        SourceSaveViewModel Save { get; };
        Microsoft.UI.Xaml.Visibility SaveVisibility { get; };
        String CopyLabel { get; };
        Microsoft.UI.Xaml.Visibility CopyGlyphVisibility { get; };
        Microsoft.UI.Xaml.Visibility CopiedGlyphVisibility { get; };
    }

    [default_interface]
    runtimeclass SourceProviderItemViewModel
    {
        String Name { get; };
        String Value { get; };
        Microsoft.UI.Xaml.Visibility AnsweredVisibility { get; };
        Microsoft.UI.Xaml.Visibility FailedVisibility { get; };
    }

    [default_interface]
    runtimeclass SourceQualityItemViewModel
    {
        String Label { get; };
        String Count { get; };
        Double Share { get; };
        Microsoft.UI.Xaml.Visibility TopTierVisibility { get; };
        Microsoft.UI.Xaml.Visibility MidTierVisibility { get; };
        Microsoft.UI.Xaml.Visibility LowTierVisibility { get; };
    }

    [default_interface]
    runtimeclass SourcePickerRuleViewModel
    {
        String Name { get; };
        String Value { get; };
    }

    runtimeclass SourceDisplayItemViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Microsoft.UI.Xaml.Visibility HeaderVisibility { get; };
        Microsoft.UI.Xaml.Visibility RowVisibility { get; };
        Microsoft.UI.Xaml.Visibility ShowMoreVisibility { get; };

        String GroupName { get; };
        String GroupCount { get; };
        String ShowMoreLabel { get; };

        String Key { get; };
        String MedalPlate { get; };
        String MedalTag { get; };
        QualityMedalFinish MedalFinish { get; };
        String StatusLabel { get; };
        Microsoft.UI.Xaml.Visibility InstantVisibility { get; };
        Microsoft.UI.Xaml.Visibility CachingVisibility { get; };
        Microsoft.UI.Xaml.Visibility ColdVisibility { get; };
        String MetaLine { get; };
        Microsoft.UI.Xaml.Visibility MetaVisibility { get; };
        // What Narrator reads for the row, which is the Play button.
        String PlayName { get; };
        SourceSaveViewModel Save { get; };
        SourceDetailsViewModel Details { get; };

        Microsoft.UI.Xaml.Visibility ExpandedVisibility { get; };
        Microsoft.UI.Xaml.Visibility ExpandGlyphVisibility { get; };
        Microsoft.UI.Xaml.Visibility CollapseGlyphVisibility { get; };
        String ChevronName { get; };
        String ChevronTip { get; };
        Microsoft.UI.Xaml.Visibility SelectionVisibility { get; };
    }

    runtimeclass SourcesViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Object Items { get; };
        Object ProviderItems { get; };
        Object QualityItems { get; };
        Object PickerRules { get; };

        String Kicker { get; };
        Microsoft.UI.Xaml.Visibility KickerVisibility { get; };
        String Heading { get; };
        String CountLine { get; };

        Microsoft.UI.Xaml.Visibility OfflineVisibility { get; };
        Microsoft.UI.Xaml.Visibility OfflineMedalVisibility { get; };
        String OfflinePlate { get; };
        String OfflineTag { get; };
        QualityMedalFinish OfflineFinish { get; };
        String OfflineMeta { get; };

        String AllFilterCount { get; };
        String UltraHdFilterCount { get; };
        String FullHdFilterCount { get; };
        String HdFilterCount { get; };
        // "Sort: Recommended", the sort button's tooltip and name.
        String SortLabel { get; };
        Int32 FilterIndex { get; };
        Int32 SortIndex { get; };

        Microsoft.UI.Xaml.Visibility FilterRowVisibility { get; };
        Microsoft.UI.Xaml.Visibility ListVisibility { get; };
        Microsoft.UI.Xaml.Visibility ResolvingVisibility { get; };
        Microsoft.UI.Xaml.Visibility EmptyVisibility { get; };

        String EmptyTitle { get; };
        String EmptyBody { get; };

        Microsoft.UI.Xaml.Visibility BannerVisibility { get; };
        Microsoft.UI.Xaml.Visibility BannerCautionVisibility { get; };
        Microsoft.UI.Xaml.Visibility BannerInfoVisibility { get; };
        String BannerTitle { get; };
        String BannerBody { get; };
        String BannerAction { get; };

        Microsoft.UI.Xaml.Visibility PickVisibility { get; };
        String PickPlate { get; };
        String PickTag { get; };
        QualityMedalFinish PickFinish { get; };
        String PickStatusLabel { get; };
        Microsoft.UI.Xaml.Visibility PickInstantVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickCachingVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickColdVisibility { get; };
        String PickMetaLine { get; };
        Microsoft.UI.Xaml.Visibility PickMetaVisibility { get; };
        String PickFileName { get; };
        SourceSaveViewModel PickSave { get; };
        SourceDetailsViewModel PickDetails { get; };
        Microsoft.UI.Xaml.Visibility PickSelectionVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickExpandedVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickExpandGlyphVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickCollapseGlyphVisibility { get; };
        String PickChevronName { get; };
        String PickChevronTip { get; };

        Microsoft.UI.Xaml.Visibility InfoVisibility { get; };
        Microsoft.UI.Xaml.Visibility InfoOpenGlyphVisibility { get; };
        Microsoft.UI.Xaml.Visibility InfoClosedGlyphVisibility { get; };

        // Index into Items of the selected row, or -1 while the pick holds the
        // selection. The page uses it to scroll the selection into view.
        Int32 SelectedIndex { get; };

        void Load(Object parameter);
        void Retry();
        void SetFilter(Int32 index);
        void SetSort(Int32 index);
        void ToggleInfo();
        void ToggleExpanded(String key);
        void TogglePickExpanded();
        void SelectKey(String key);
        void SelectPick();
        void MoveSelection(Int32 delta);
        void ExpandSelected();
        void CollapseSelected();
        void RevealCold();
        void PlaySelected();
        void OpenPlayer(String key);
        // False when the saved copy is no longer on this device.
        Boolean PlayOffline();
        void OpenSettings();
        void Close();
        String FileNameFor(String key);
        void MarkCopied(String key);
    }

    // The expanded read-out under a card. View behaviour only: Save and Copy are
    // handed to the sheet, which owns the dialogs and the clipboard.
    [default_interface]
    runtimeclass SourceDetailsPanel : Microsoft.UI.Xaml.Controls.UserControl
    {
        SourceDetailsPanel();
        SourceDetailsViewModel Details;
        event Microsoft.UI.Xaml.RoutedEventHandler SaveClick;
        event Microsoft.UI.Xaml.RoutedEventHandler CopyClick;
    }

    // Save for offline, as it stands for one source. Prominent is the pick's 44 px
    // size beside its Play; the details panel's is 34 px.
    [default_interface]
    runtimeclass SourceSaveButton : Microsoft.UI.Xaml.Controls.UserControl
    {
        SourceSaveButton();
        SourceSaveViewModel Save;
        Boolean Prominent;
        event Microsoft.UI.Xaml.RoutedEventHandler Click;
    }

    // "How this list was built", and the resolve laid bare behind it.
    [default_interface]
    runtimeclass SourcesSheetFooter : Microsoft.UI.Xaml.Controls.UserControl
    {
        SourcesSheetFooter();
        SourcesViewModel ViewModel;
    }

    [default_interface]
    runtimeclass SourcesPage : Microsoft.UI.Xaml.Controls.Page
    {
        SourcesPage();
        SourcesViewModel ViewModel { get; };
    }
}
