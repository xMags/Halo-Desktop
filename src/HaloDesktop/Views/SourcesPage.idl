// The badge tone is declared with the control that renders it. This is the one
// type this sheet borrows from another file, so it is imported rather than
// restated.
import "Controls/QualityBadge.idl";

namespace HaloDesktop
{
    [default_interface]
    runtimeclass SourceSpecItemViewModel
    {
        String Key { get; };
        String Value { get; };
    }

    [default_interface]
    runtimeclass SourceProviderItemViewModel
    {
        String Name { get; };
        String Value { get; };
        Microsoft.UI.Xaml.Visibility AnsweredVisibility { get; };
        Microsoft.UI.Xaml.Visibility FailedVisibility { get; };
    }

    [default_interface]
    runtimeclass SourceQualityItemViewModel
    {
        String Label { get; };
        String Count { get; };
        Double Share { get; };
        Microsoft.UI.Xaml.Visibility TopTierVisibility { get; };
        Microsoft.UI.Xaml.Visibility MidTierVisibility { get; };
        Microsoft.UI.Xaml.Visibility LowTierVisibility { get; };
    }

    [default_interface]
    runtimeclass SourcePickerRuleViewModel
    {
        String Name { get; };
        String Value { get; };
    }

    runtimeclass SourceDisplayItemViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Microsoft.UI.Xaml.Visibility HeaderVisibility { get; };
        Microsoft.UI.Xaml.Visibility RowVisibility { get; };
        Microsoft.UI.Xaml.Visibility ShowMoreVisibility { get; };

        String GroupName { get; };
        String GroupNote { get; };
        String GroupCount { get; };
        String ShowMoreLabel { get; };

        String Key { get; };
        String QualityBadgeTier { get; };
        String QualityBadgeDetail { get; };
        QualityBadgeTone QualityTone { get; };
        String StatusLabel { get; };
        Microsoft.UI.Xaml.Visibility InstantVisibility { get; };
        Microsoft.UI.Xaml.Visibility OnDiskVisibility { get; };
        Microsoft.UI.Xaml.Visibility CachingVisibility { get; };
        Microsoft.UI.Xaml.Visibility ColdVisibility { get; };
        String SoundAndSize { get; };
        String LanguageLine { get; };
        String Warning { get; };
        Microsoft.UI.Xaml.Visibility WarningVisibility { get; };
        Microsoft.UI.Xaml.Visibility SaveVisibility { get; };
        String FileName { get; };
        String Reason { get; };
        Object Specs { get; };

        Microsoft.UI.Xaml.Visibility ExpandedVisibility { get; };
        Microsoft.UI.Xaml.Visibility ExpandGlyphVisibility { get; };
        Microsoft.UI.Xaml.Visibility CollapseGlyphVisibility { get; };
        Microsoft.UI.Xaml.Visibility SelectionVisibility { get; };
    }

    runtimeclass SourcesViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Object Items { get; };
        Object ProviderItems { get; };
        Object QualityItems { get; };
        Object PickerRules { get; };

        Double SheetWidth { get; };

        String Kicker { get; };
        Microsoft.UI.Xaml.Visibility KickerVisibility { get; };
        String Heading { get; };
        String CountLine { get; };

        String AllFilterCount { get; };
        String PlaysNowFilterCount { get; };
        String UltraHdFilterCount { get; };
        String FullHdFilterCount { get; };
        String SortLabel { get; };
        Int32 FilterIndex { get; };
        Int32 SortIndex { get; };

        Microsoft.UI.Xaml.Visibility FilterRowVisibility { get; };
        Microsoft.UI.Xaml.Visibility ListVisibility { get; };
        Microsoft.UI.Xaml.Visibility ResolvingVisibility { get; };
        Microsoft.UI.Xaml.Visibility EmptyVisibility { get; };

        String EmptyTitle { get; };
        String EmptyBody { get; };

        Microsoft.UI.Xaml.Visibility BannerVisibility { get; };
        Microsoft.UI.Xaml.Visibility BannerCautionVisibility { get; };
        Microsoft.UI.Xaml.Visibility BannerInfoVisibility { get; };
        String BannerTitle { get; };
        String BannerBody { get; };
        String BannerAction { get; };

        Microsoft.UI.Xaml.Visibility PickVisibility { get; };
        String PickQualityBadgeTier { get; };
        String PickQualityBadgeDetail { get; };
        QualityBadgeTone PickQualityTone { get; };
        String PickStatusLabel { get; };
        Microsoft.UI.Xaml.Visibility PickInstantVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickOnDiskVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickCachingVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickColdVisibility { get; };
        String PickWhy { get; };
        String PickLine { get; };
        String PickFileName { get; };
        String PickWatchNote { get; };
        Microsoft.UI.Xaml.Visibility PickWatchNoteVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickSelectionVisibility { get; };
        Microsoft.UI.Xaml.Visibility PickSaveVisibility { get; };

        Microsoft.UI.Xaml.Visibility InfoVisibility { get; };
        Microsoft.UI.Xaml.Visibility InfoExpandGlyphVisibility { get; };
        Microsoft.UI.Xaml.Visibility InfoCollapseGlyphVisibility { get; };

        Int32 SelectedIndex { get; };

        void Load(Object parameter);
        void Retry();
        void SetFilter(Int32 index);
        void SetSort(Int32 index);
        void ToggleInfo();
        void ToggleExpanded(String key);
        void SelectKey(String key);
        void SelectPick();
        void MoveSelection(Int32 delta);
        void ExpandSelected();
        void CollapseSelected();
        void RevealCold();
        void PlaySelected();
        void OpenPlayer(String key);
        void OpenSettings();
        void Close();
        String FileNameFor(String key);
    }

    [default_interface]
    runtimeclass SourcesPage : Microsoft.UI.Xaml.Controls.Page
    {
        SourcesPage();
        SourcesViewModel ViewModel { get; };
    }
}
