namespace HaloDesktop
{
    [default_interface]
    runtimeclass PlaybackTrackViewModel
    {
        Int64 Id { get; };
        String Title { get; };
        String Note { get; };
        String Codec { get; };
        Boolean IsSelected { get; };
    }

    [default_interface]
    runtimeclass AddonSubtitleViewModel
    {
        String Key { get; };
        String Language { get; };
        String Addon { get; };
        String Variant { get; };
        Microsoft.UI.Xaml.Visibility HashMatchVisibility { get; };
        Microsoft.UI.Xaml.Visibility NameMatchVisibility { get; };
        Microsoft.UI.Xaml.Visibility SelectedVisibility { get; };
    }

    // Subtitle appearance, edited from the playback panel. Writes the same account
    // settings the settings page writes, so a change made during a film is the new
    // default everywhere, and applies to the running file without reloading it.
    runtimeclass SubtitleAppearanceViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Double Size;
        String SizeLabel { get; };
        Boolean IsDefaultFont { get; };
        Boolean IsSystemFont { get; };
        Boolean IsSerifFont { get; };
        Boolean IsMonoFont { get; };
        Boolean IsNoOutline { get; };
        Boolean IsThinOutline { get; };
        Boolean IsNormalOutline { get; };
        Boolean IsThickOutline { get; };
        Boolean Shadow;
        Boolean TrackStyling;
        String PreviewText { get; };
        Double PreviewFontSize { get; };
        Microsoft.UI.Xaml.Media.FontFamily PreviewFontFamily { get; };
        Double PreviewOutlineOffset { get; };
        Double PreviewOutlineNegativeOffset { get; };
        Double PreviewShadowOffset { get; };
        Microsoft.UI.Xaml.Visibility PreviewOutlineVisibility { get; };
        Microsoft.UI.Xaml.Visibility PreviewShadowVisibility { get; };
        void SetFont(Int32 index);
        void SetOutline(Int32 index);
        void Refresh();
    }

    runtimeclass ScrubPreviewViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Microsoft.UI.Xaml.Visibility PreviewVisibility { get; };
        Microsoft.UI.Xaml.Media.Imaging.WriteableBitmap Image { get; };
        Microsoft.UI.Xaml.Visibility ImageVisibility { get; };
        String TimeText { get; };
        Double OffsetX { get; };
        Double CardWidth { get; };
        Double CardHeight { get; };
        Boolean IsOpen { get; };
        void Hover(Double pointerX, Double trackWidth, Double durationSeconds);
        void Hide();
        void Reset();
    }

    runtimeclass PlayerViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Double Position { get; };
        Double Duration { get; };
        Double Volume;
        String VolumeText { get; };
        String PositionText { get; };
        String DurationText { get; };
        String SpeedText { get; };
        Boolean IsSpeedThreeQuarter { get; };
        Boolean IsSpeedNormal { get; };
        Boolean IsSpeedOneQuarter { get; };
        Boolean IsSpeedOneHalf { get; };
        Boolean IsSpeedOneThreeQuarter { get; };
        Boolean IsSpeedDouble { get; };
        String AudioSummary { get; };
        String SubtitleSummary { get; };
        Double PlayButtonSize { get; };
        Double TransportButtonSize { get; };
        Microsoft.UI.Xaml.Thickness HeaderPadding { get; };
        Microsoft.UI.Xaml.Thickness TransportPadding { get; };
        Double TitleFontSize { get; };
        String QualityTierText { get; };
        String QualityDetailText { get; };
        Microsoft.UI.Xaml.Visibility QualityBadgeVisibility { get; };
        Double QualityBadgeFontSize { get; };
        Object AudioTracks { get; };
        Object SubtitleTracks { get; };
        Object AddonSubtitles { get; };
        Boolean SubtitlesOffSelected { get; };
        Double OsdOpacity { get; };
        Microsoft.UI.Xaml.Visibility OsdWakeVisibility { get; };
        Double UpNextProgress { get; };
        String UpNextKicker { get; };
        String UpNextTitle { get; };
        String UpNextEpisodeLabel { get; };
        String UpNextArt { get; };
        String SubtitleDelayText { get; };
        String AudioDelayText { get; };
        Boolean IsPaused { get; };
        Boolean IsFullscreen { get; };
        Boolean UpNextOpen { get; };
        Boolean AudioTabSelected { get; };
        Boolean SubtitleTabSelected { get; };
        Boolean SubtitleTracksTabSelected { get; };
        Boolean SubtitleAppearanceTabSelected { get; };
        Boolean SpeedTabSelected { get; };
        Microsoft.UI.Xaml.Visibility PausedVisibility { get; };
        Microsoft.UI.Xaml.Visibility PlayingVisibility { get; };
        Boolean IsBuffering { get; };
        Microsoft.UI.Xaml.Visibility BufferingVisibility { get; };
        Microsoft.UI.Xaml.Visibility BufferingLabelVisibility { get; };
        Double BufferingRingSize { get; };
        Microsoft.UI.Xaml.Visibility EnterFullscreenIconVisibility { get; };
        Microsoft.UI.Xaml.Visibility ExitFullscreenIconVisibility { get; };
        Microsoft.UI.Xaml.Visibility PanelVisibility { get; };
        Microsoft.UI.Xaml.Visibility AudioPanelVisibility { get; };
        Microsoft.UI.Xaml.Visibility SubtitlePanelVisibility { get; };
        Microsoft.UI.Xaml.Visibility SubtitleTracksVisibility { get; };
        Microsoft.UI.Xaml.Visibility SubtitleAppearanceVisibility { get; };
        SubtitleAppearanceViewModel SubtitleAppearance { get; };
        ScrubPreviewViewModel ScrubPreview { get; };
        Microsoft.UI.Xaml.Visibility SpeedPanelVisibility { get; };
        Microsoft.UI.Xaml.Visibility UpNextVisibility { get; };
        Microsoft.UI.Xaml.Visibility UpNextAvailableVisibility { get; };
        void TogglePause();
        void BeginScrub();
        void ScrubTo(Double seconds);
        void EndScrub(Double seconds);
        void SeekRelative(Double seconds);
        void ChangeVolume(Double delta);
        void SetSpeed(Double speed);
        void ShowPanel(Int32 index);
        void SelectPanel(Int32 index);
        void SelectSubtitleTab(Int32 index);
        void ClosePanel();
        void SelectAudio(Int64 id);
        void SelectSubtitle(Int64 id);
        void DisableSubtitles();
        void SelectAddonSubtitle(String key);
        void AdjustSubtitleDelay(Int32 milliseconds);
        void AdjustAudioDelay(Int32 milliseconds);
        void ToggleUpNext();
        void CancelUpNext();
        void PlayNext();
        void ToggleFullscreen();
        void HandleEscape();
        void ClosePlayer();
        void NotifyUserActivity();
    }

    [default_interface]
    runtimeclass PlayerOsd : Microsoft.UI.Xaml.Controls.UserControl
    {
        PlayerOsd();
        PlayerViewModel ViewModel { get; };
    }

    [default_interface]
    runtimeclass PlayerPage : Microsoft.UI.Xaml.Controls.Page
    {
        PlayerPage();
        PlayerViewModel ViewModel { get; };
    }
}
