<?xml version="1.0" encoding="utf-8"?>
<!--
  `.si-fan`: five posters on the halo ring, mirror-image about the centre one,
  placed in the deck's coordinates as the reference places them. The ring turns in
  from -26deg at scale .7 after .55s; the posters slide in from the left and
  rotate into place, the centre one first. With motion off everything starts in
  place. A poster whose image fails keeps its dark card. Drawn only.
-->
<UserControl
  x:Class="HaloDesktop.SignInPosterFan"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="1060"
  Height="600"
  AutomationProperties.AccessibilityView="Raw"
  IsHitTestVisible="False"
  IsTabStop="False"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded">

  <UserControl.Resources>
    <Storyboard x:Key="EntranceStoryboard">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:2.05" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingTurn" Storyboard.TargetProperty="Angle">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-26" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="-26" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:2.05" Value="-10" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0.7" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:2.05" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0.7" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:2.05" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster1" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.75" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster1Turn" Storyboard.TargetProperty="Angle">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.75" Value="-12" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster1Slide" Storyboard.TargetProperty="X">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-260" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="-260" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.75" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster2" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.48" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.63" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster2Turn" Storyboard.TargetProperty="Angle">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.48" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.63" Value="-6" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster2Slide" Storyboard.TargetProperty="X">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-350" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.48" Value="-350" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.63" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster3" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.51" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster3Turn" Storyboard.TargetProperty="Angle">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.51" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster3Slide" Storyboard.TargetProperty="X">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-440" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="-440" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.51" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster4" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.48" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.63" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster4Turn" Storyboard.TargetProperty="Angle">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.48" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.63" Value="6" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster4Slide" Storyboard.TargetProperty="X">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-560" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.48" Value="-560" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.63" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster5" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.75" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster5Turn" Storyboard.TargetProperty="Angle">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.75" Value="12" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Poster5Slide" Storyboard.TargetProperty="X">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-650" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="-650" />
        <SplineDoubleKeyFrame KeySpline="0.2,0.8 0.2,1" KeyTime="0:0:1.75" Value="0" />
      </DoubleAnimationUsingKeyFrames>

    </Storyboard>
  </UserControl.Resources>

  <Canvas>
    <!-- `.si-ring`: 660x200 at 412,220, a 2px border with its glow, turned -10deg. -->
    <Grid
      x:Name="Ring"
      Canvas.Left="412"
      Canvas.Top="220"
      Width="660"
      Height="200"
      RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="RingScale" />
          <RotateTransform x:Name="RingTurn" Angle="-10" />
        </TransformGroup>
      </Grid.RenderTransform>
      <Ellipse Margin="-12" Stroke="{StaticResource HaloSignInRingGlowBrush}" StrokeThickness="24" />
      <Ellipse Stroke="{StaticResource HaloSignInRingBrush}" StrokeThickness="2" />
    </Grid>
    <Grid
      x:Name="Poster1"
      Canvas.Left="452"
      Canvas.Top="213"
      Canvas.ZIndex="1"
      Width="172"
      Height="258"
      RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <RotateTransform x:Name="Poster1Turn" Angle="-12" />
          <TranslateTransform x:Name="Poster1Slide" />
        </TransformGroup>
      </Grid.RenderTransform>
      <Border Background="{StaticResource HaloSignInPosterGroundBrush}" CornerRadius="12" />
      <Border CornerRadius="12">
        <Border.Background>
          <ImageBrush x:Name="Poster1Image" ImageFailed="OnPosterFailed" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
      <Border Background="{StaticResource HaloSignInPosterGlossBrush}" CornerRadius="12" />
      <Border BorderBrush="{StaticResource HaloSignInPosterRingBrush}" BorderThickness="1" CornerRadius="12" />
    </Grid>
    <Grid
      x:Name="Poster2"
      Canvas.Left="544"
      Canvas.Top="171"
      Canvas.ZIndex="2"
      Width="172"
      Height="258"
      RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <RotateTransform x:Name="Poster2Turn" Angle="-6" />
          <TranslateTransform x:Name="Poster2Slide" />
        </TransformGroup>
      </Grid.RenderTransform>
      <Border Background="{StaticResource HaloSignInPosterGroundBrush}" CornerRadius="12" />
      <Border CornerRadius="12">
        <Border.Background>
          <ImageBrush x:Name="Poster2Image" ImageFailed="OnPosterFailed" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
      <Border Background="{StaticResource HaloSignInPosterGlossBrush}" CornerRadius="12" />
      <Border BorderBrush="{StaticResource HaloSignInPosterRingBrush}" BorderThickness="1" CornerRadius="12" />
      <Border Margin="10,10,0,0" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource HaloSignInPosterChipBrush}" CornerRadius="4">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <FontIcon VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource HaloSignInOfflineInkBrush}" Glyph="&#xE73E;" />
          <TextBlock Foreground="{StaticResource HaloSignInOfflineInkBrush}" Style="{StaticResource HaloSignInPosterChipTextStyle}" Text="OFFLINE" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid
      x:Name="Poster3"
      Canvas.Left="640"
      Canvas.Top="137"
      Canvas.ZIndex="4"
      Width="204"
      Height="306"
      RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <RotateTransform x:Name="Poster3Turn" Angle="0" />
          <TranslateTransform x:Name="Poster3Slide" />
        </TransformGroup>
      </Grid.RenderTransform>
      <Border Background="{StaticResource HaloSignInPosterGroundBrush}" CornerRadius="12" />
      <Border CornerRadius="12">
        <Border.Background>
          <ImageBrush x:Name="Poster3Image" ImageFailed="OnPosterFailed" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
      <Border Background="{StaticResource HaloSignInPosterGlossBrush}" CornerRadius="12" />
      <Border BorderBrush="{StaticResource HaloSignInPosterRingBrush}" BorderThickness="1" CornerRadius="12" />
      <Border Margin="10,10,0,0" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource HaloSignInPosterChipBrush}" CornerRadius="4">
        <TextBlock Foreground="{StaticResource HaloSignInGoldInkBrush}" Style="{StaticResource HaloSignInPosterChipTextStyle}" Text="4K &#x00B7; HDR" />
      </Border>
    </Grid>
    <Grid
      x:Name="Poster4"
      Canvas.Left="768"
      Canvas.Top="171"
      Canvas.ZIndex="2"
      Width="172"
      Height="258"
      RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <RotateTransform x:Name="Poster4Turn" Angle="6" />
          <TranslateTransform x:Name="Poster4Slide" />
        </TransformGroup>
      </Grid.RenderTransform>
      <Border Background="{StaticResource HaloSignInPosterGroundBrush}" CornerRadius="12" />
      <Border CornerRadius="12">
        <Border.Background>
          <ImageBrush x:Name="Poster4Image" ImageFailed="OnPosterFailed" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
      <Border Background="{StaticResource HaloSignInPosterGlossBrush}" CornerRadius="12" />
      <Border BorderBrush="{StaticResource HaloSignInPosterRingBrush}" BorderThickness="1" CornerRadius="12" />
    </Grid>
    <Grid
      x:Name="Poster5"
      Canvas.Left="860"
      Canvas.Top="213"
      Canvas.ZIndex="1"
      Width="172"
      Height="258"
      RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TransformGroup>
          <RotateTransform x:Name="Poster5Turn" Angle="12" />
          <TranslateTransform x:Name="Poster5Slide" />
        </TransformGroup>
      </Grid.RenderTransform>
      <Border Background="{StaticResource HaloSignInPosterGroundBrush}" CornerRadius="12" />
      <Border CornerRadius="12">
        <Border.Background>
          <ImageBrush x:Name="Poster5Image" ImageFailed="OnPosterFailed" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
      <Border Background="{StaticResource HaloSignInPosterGlossBrush}" CornerRadius="12" />
      <Border BorderBrush="{StaticResource HaloSignInPosterRingBrush}" BorderThickness="1" CornerRadius="12" />
    </Grid>
  </Canvas>
</UserControl>