<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.DetailHero"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  IsTabStop="False">
  <UserControl.Resources>
    <!--
      `dh-rise`: each block of the body, then the aside, rises 14px into place
      while it fades in, 0.7s, staggered. The reference's `both` fill holds every
      block at its start until its turn, so each delay is a held key frame rather
      than a BeginTime, which would show the block in place first. Every target is
      animated through Opacity and its own TranslateTransform only; none of them
      is handed a composition visual (the logo's shadow lives in a child).
    -->
    <Storyboard x:Key="RiseStoryboard">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleBlock" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.7" KeySpline="0.2,0.8 0.2,1" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleShift" Storyboard.TargetProperty="Y">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="14" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.7" KeySpline="0.2,0.8 0.2,1" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FactsLine" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.76" KeySpline="0.2,0.8 0.2,1" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FactsShift" Storyboard.TargetProperty="Y">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="14" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="14" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.76" KeySpline="0.2,0.8 0.2,1" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SynopsisText" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.82" KeySpline="0.2,0.8 0.2,1" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SynopsisShift" Storyboard.TargetProperty="Y">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="14" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="14" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.82" KeySpline="0.2,0.8 0.2,1" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.88" KeySpline="0.2,0.8 0.2,1" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActionsShift" Storyboard.TargetProperty="Y">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="14" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="14" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.88" KeySpline="0.2,0.8 0.2,1" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressRow" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="0" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.94" KeySpline="0.2,0.8 0.2,1" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressShift" Storyboard.TargetProperty="Y">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="14" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="14" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.94" KeySpline="0.2,0.8 0.2,1" Value="0" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WaysToWatch" Storyboard.TargetProperty="Opacity">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.9" KeySpline="0.2,0.8 0.2,1" Value="1" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WaysShift" Storyboard.TargetProperty="Y">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="14" />
        <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="14" />
        <SplineDoubleKeyFrame KeyTime="0:0:0.9" KeySpline="0.2,0.8 0.2,1" Value="0" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>

  <!-- `.dh`: as tall as the art behind it, its content at the bottom. -->
  <Grid x:Name="HeroRoot" MinHeight="480">
    <Grid
      x:Name="HeroInner"
      Padding="32,72,32,40"
      VerticalAlignment="Bottom"
      ColumnSpacing="40">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel
        x:Name="Body"
        MaxWidth="560"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom">
        <!-- The logo, bounded both ways (addons ship anything from square marks to
             long wordmarks), or the name when there is none or it fails. -->
        <Grid x:Name="TitleBlock" HorizontalAlignment="Left">
          <Grid.RenderTransform>
            <TranslateTransform x:Name="TitleShift" />
          </Grid.RenderTransform>
          <Border
            x:Name="LogoShadowHost"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False" />
          <Image
            x:Name="LogoImage"
            MaxWidth="440"
            MaxHeight="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
            ImageFailed="OnLogoFailed"
            ImageOpened="OnLogoOpened"
            SizeChanged="OnLogoSizeChanged"
            Stretch="Uniform"
            ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.LogoVisibility, Mode=OneWay}" />
          <TextBlock
            FontFamily="Segoe UI Variable Display"
            FontSize="44"
            FontWeight="SemiBold"
            Foreground="{ThemeResource HaloDetailInkBrush}"
            LineHeight="47.5"
            LineStackingStrategy="BlockLineHeight"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextWrapping="WrapWholeWords"
            Visibility="{x:Bind ViewModel.TitleVisibility, Mode=OneWay}" />
        </Grid>

        <!-- Release, runtime or seasons, three genres, the age chip and the rating. -->
        <ItemsControl
          x:Name="FactsLine"
          Margin="0,18,0,0"
          IsTabStop="False"
          ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}">
          <ItemsControl.RenderTransform>
            <TranslateTransform x:Name="FactsShift" />
          </ItemsControl.RenderTransform>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <local:WrapPanel HorizontalSpacing="0" VerticalSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:DetailFactViewModel">
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  Margin="9,0"
                  VerticalAlignment="Center"
                  FontSize="14"
                  Foreground="{ThemeResource HaloDetailInk40Brush}"
                  Text="&#x00B7;"
                  Visibility="{x:Bind SeparatorVisibility}" />
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="14"
                  Foreground="{ThemeResource HaloDetailInk74Brush}"
                  Text="{x:Bind Text}"
                  Visibility="{x:Bind PlainVisibility}" />
                <Border
                  Padding="6,0"
                  VerticalAlignment="Center"
                  BorderBrush="{ThemeResource HaloDetailCertificateStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Visibility="{x:Bind CertificateVisibility}">
                  <TextBlock FontSize="12" Foreground="{ThemeResource HaloDetailInk74Brush}" Text="{x:Bind Text}" />
                </Border>
                <StackPanel
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="6"
                  Visibility="{x:Bind ImdbVisibility}">
                  <Border Padding="4,1" VerticalAlignment="Center" Background="{ThemeResource HaloDetailImdbBrush}" CornerRadius="3">
                    <TextBlock FontSize="10" FontWeight="ExtraBold" Foreground="{ThemeResource HaloDetailOnInkBrush}" Text="IMDb" />
                  </Border>
                  <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource HaloDetailInk74Brush}" Text="{x:Bind Text}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
          x:Name="SynopsisText"
          Margin="0,14,0,0"
          FontSize="15"
          Foreground="{ThemeResource HaloDetailInk86Brush}"
          LineHeight="24"
          LineStackingStrategy="BlockLineHeight"
          MaxLines="3"
          Text="{x:Bind ViewModel.Synopsis, Mode=OneWay}"
          TextTrimming="CharacterEllipsis"
          TextWrapping="Wrap"
          Visibility="{x:Bind ViewModel.SynopsisVisibility, Mode=OneWay}">
          <TextBlock.RenderTransform>
            <TranslateTransform x:Name="SynopsisShift" />
          </TextBlock.RenderTransform>
        </TextBlock>

        <StackPanel
          x:Name="Actions"
          Margin="0,28,0,0"
          Orientation="Horizontal"
          Spacing="12">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="ActionsShift" />
          </StackPanel.RenderTransform>
          <Button
            x:Name="PlayButton"
            AutomationProperties.Name="{x:Bind ViewModel.PlayLabel, Mode=OneWay}"
            Click="OnPlayClick"
            Style="{StaticResource HaloDetailPlayButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE768;" />
              <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PlayLabel, Mode=OneWay}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="Add to library"
            Click="OnLibraryClick"
            Style="{StaticResource HaloDetailRoundButtonStyle}"
            ToolTipService.ToolTip="Add to library"
            Visibility="{x:Bind ViewModel.NotInLibraryVisibility, Mode=OneWay}">
            <FontIcon FontSize="18" Glyph="&#xE734;" />
          </Button>
          <Button
            AutomationProperties.Name="In library"
            Click="OnLibraryClick"
            Style="{StaticResource HaloDetailRoundOnButtonStyle}"
            ToolTipService.ToolTip="In library"
            Visibility="{x:Bind ViewModel.InLibraryVisibility, Mode=OneWay}">
            <FontIcon FontSize="18" Glyph="&#xE73E;" />
          </Button>
          <Button
            AutomationProperties.Name="Download"
            Click="OnPlayClick"
            Style="{StaticResource HaloDetailRoundButtonStyle}"
            ToolTipService.ToolTip="Download">
            <FontIcon FontSize="18" Glyph="&#xE896;" />
          </Button>
          <Button
            AutomationProperties.Name="Watch the trailer on YouTube"
            Click="OnTrailerClick"
            Style="{StaticResource HaloDetailRoundButtonStyle}"
            ToolTipService.ToolTip="Trailer on YouTube"
            Visibility="{x:Bind ViewModel.TrailerVisibility, Mode=OneWay}">
            <FontIcon FontSize="18" Glyph="&#xE714;" />
          </Button>
        </StackPanel>

        <!-- Progress of the episode Resume plays, then the best quality offered. -->
        <StackPanel
          x:Name="ProgressRow"
          MinHeight="24"
          Margin="0,16,0,0"
          Orientation="Horizontal"
          Spacing="12">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="ProgressShift" />
          </StackPanel.RenderTransform>
          <Grid
            Width="160"
            Height="4"
            VerticalAlignment="Center"
            Background="{ThemeResource HaloDetailBarTrackBrush}"
            CornerRadius="2"
            Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
            <Border Background="{ThemeResource HaloDetailBarBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <TextBlock
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource HaloDetailInk72Brush}"
            Text="{x:Bind ViewModel.TimeLeft, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}" />
          <TextBlock
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource HaloDetailInk40Brush}"
            Text="&#x00B7;"
            Visibility="{x:Bind ViewModel.ProgressSeparatorVisibility, Mode=OneWay}" />
          <local:QualityMedal
            VerticalAlignment="Center"
            Finish="{x:Bind ViewModel.BestFinish, Mode=OneWay}"
            Plate="{x:Bind ViewModel.BestPlate, Mode=OneWay}"
            Size="Small"
            TagText="{x:Bind ViewModel.BestTag, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.BestVisibility, Mode=OneWay}" />
          <Button
            VerticalAlignment="Center"
            Click="OnPlayClick"
            Content="{x:Bind ViewModel.SourcesLink, Mode=OneWay}"
            Style="{StaticResource HaloDetailLinkButtonStyle}"
            Visibility="{x:Bind ViewModel.BestVisibility, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>

      <!-- "Ways to watch": what the addons offer for the video the main button
           plays, from the same request the source sheet makes. -->
      <Border
        x:Name="WaysToWatch"
        Grid.Column="1"
        Width="340"
        VerticalAlignment="Bottom"
        Style="{StaticResource HaloDetailGlassPanelStyle}">
        <Border.RenderTransform>
          <TranslateTransform x:Name="WaysShift" />
        </Border.RenderTransform>
        <StackPanel>
          <TextBlock
            Margin="0,0,0,4"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{ThemeResource HaloDetailInk72Brush}"
            Text="Ways to watch" />
          <StackPanel
            Margin="0,12,0,0"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.AvailabilityLoadingVisibility, Mode=OneWay}">
            <ProgressRing Width="14" Height="14" MinWidth="0" MinHeight="0" VerticalAlignment="Center" IsActive="True" />
            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource HaloDetailInk55Brush}" Text="Asking your addons&#x2026;" />
          </StackPanel>
          <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Availability, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:DetailAvailabilityViewModel">
                <Button AutomationProperties.Name="{x:Bind Count}" Click="OnPlayClick" Style="{StaticResource HaloDetailWatchRowButtonStyle}">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="82" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:QualityMedal Finish="{x:Bind Finish}" Plate="{x:Bind Plate}" Size="Small" TagText="{x:Bind TagText}" />
                    <Grid
                      Grid.Column="1"
                      Height="4"
                      VerticalAlignment="Center"
                      Background="{ThemeResource HaloDetailMeterTrackBrush}"
                      CornerRadius="2">
                      <Border Background="{ThemeResource HaloDetailMeterBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5" Visibility="{x:Bind PlainMeterVisibility}">
                        <Border.RenderTransform>
                          <ScaleTransform ScaleX="{x:Bind Meter}" />
                        </Border.RenderTransform>
                      </Border>
                      <Border Background="{ThemeResource HaloDetailGoldMeterBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5" Visibility="{x:Bind GoldMeterVisibility}">
                        <Border.RenderTransform>
                          <ScaleTransform ScaleX="{x:Bind Meter}" />
                        </Border.RenderTransform>
                      </Border>
                    </Grid>
                    <TextBlock
                      Grid.Column="2"
                      MinWidth="74"
                      VerticalAlignment="Center"
                      FontSize="13"
                      Foreground="{ThemeResource HaloDetailInk72Brush}"
                      Text="{x:Bind Count}"
                      TextAlignment="Right" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock
            Margin="0,12,0,0"
            FontSize="13"
            Foreground="{ThemeResource HaloDetailInk55Brush}"
            Text="None of your addons has streams for this title."
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.AvailabilityEmptyVisibility, Mode=OneWay}" />
          <!-- No addon offers streams at all: Halo ships none, so say what to do. -->
          <StackPanel Margin="0,12,0,0" Spacing="4" Visibility="{x:Bind ViewModel.NoStreamAddonsVisibility, Mode=OneWay}">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HaloDetailInk72Brush}" Text="Add a streaming addon to watch" TextWrapping="Wrap" />
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloDetailInk55Brush}" Text="Halo doesn't come with streams. Add an addon that provides them, and its sources show up here." TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.AvailabilityFailures, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock
                  Margin="0,12,0,0"
                  FontSize="13"
                  Foreground="{ThemeResource HaloCriticalBrush}"
                  Text="{Binding}"
                  TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid
            Margin="0,14,0,0"
            Padding="0,14,0,0"
            BorderBrush="{ThemeResource HaloDetailLineBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.SubtitlesVisibility, Mode=OneWay}">
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloDetailInk72Brush}" Text="Subtitles" />
            <TextBlock
              HorizontalAlignment="Right"
              FontSize="13"
              Foreground="{ThemeResource HaloDetailInk72Brush}"
              Text="{x:Bind ViewModel.SubtitlesText, Mode=OneWay}" />
          </Grid>
          <Button
            Margin="0,16,0,0"
            Click="OnPlayClick"
            Content="Browse all sources"
            Style="{StaticResource HaloDetailBrowseButtonStyle}"
            Visibility="{x:Bind ViewModel.BrowseSourcesVisibility, Mode=OneWay}" />
          <Button
            Margin="0,16,0,0"
            Click="OnAddAddonClick"
            Content="Add an addon"
            Style="{StaticResource HaloDetailBrowseButtonStyle}"
            Visibility="{x:Bind ViewModel.NoStreamAddonsVisibility, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
