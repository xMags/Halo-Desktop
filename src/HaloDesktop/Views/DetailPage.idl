namespace HaloDesktop
{
    [default_interface]
    runtimeclass DetailEpisodeViewModel
    {
        String Tag { get; };
        String Title { get; };
        String Blurb { get; };
        String Runtime { get; };
        String Aired { get; };
        String VideoId { get; };
        String Thumbnail { get; };
        Double Progress { get; };
        Microsoft.UI.Xaml.Visibility SavedVisibility { get; };
        Microsoft.UI.Xaml.Visibility WatchedVisibility { get; };
        Microsoft.UI.Xaml.Visibility InProgressVisibility { get; };
        Microsoft.UI.Xaml.Visibility IdleVisibility { get; };
    }

    runtimeclass DetailViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Title { get; };
        String HeaderTitle { get; };
        String Kicker { get; };
        String MetaLine { get; };
        String Synopsis { get; };
        String Poster { get; };
        String Background { get; };
        String PrimaryActionLabel { get; };
        String SourceActionLabel { get; };
        String SeasonMeta { get; };
        String LibraryLabel { get; };
        Int32 SeasonIndex { get; };
        Object Episodes { get; };
        Object Facts { get; };
        Object Availability { get; };
        Object Seasons { get; };
        Microsoft.UI.Xaml.Visibility ContentVisibility { get; };
        Microsoft.UI.Xaml.Visibility LoadingVisibility { get; };
        Microsoft.UI.Xaml.Visibility ErrorVisibility { get; };
        Microsoft.UI.Xaml.Visibility EpisodeSectionVisibility { get; };
        Microsoft.UI.Xaml.Controls.Orientation AsideOrientation { get; };
        Int32 AsideColumn { get; };
        Int32 AsideColumnSpan { get; };
        Double AsideCardWidth { get; };
        void Load(Object parameter);
        void SelectSeason(Int32 index);
        void Retry();
        void ToggleLibrary();
        void OpenSources(Object episode);
        void OpenPrimarySource();
        void BrowseSources();
        void OpenDownloads();
        void GoBack();
    }

    [default_interface]
    runtimeclass DetailPage : Microsoft.UI.Xaml.Controls.Page
    {
        DetailPage();
        DetailViewModel ViewModel { get; };
    }
}
