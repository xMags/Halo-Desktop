<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.DetailEpisodeRow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  IsTabStop="False"
  PointerCanceled="OnHoverEnded"
  PointerEntered="OnHoverStarted"
  PointerExited="OnHoverEnded">
  <!--
    `.ep-row`: thumbnail, text and the time column. Hover is drawn with plain
    opacity transitions only; nothing in this row is handed a composition visual.
  -->
  <Grid>
    <Border
      Background="{ThemeResource HaloDetailCurrentBrush}"
      BorderBrush="{ThemeResource HaloDetailEdgeBrush}"
      BorderThickness="1"
      CornerRadius="12"
      IsHitTestVisible="False"
      Visibility="{x:Bind Episode.CurrentVisibility, Mode=OneWay}" />
    <Border
      x:Name="HoverFill"
      Background="{ThemeResource HaloDetailHoverBrush}"
      CornerRadius="12"
      IsHitTestVisible="False"
      Opacity="0">
      <Border.OpacityTransition>
        <ScalarTransition Duration="0:0:0.12" />
      </Border.OpacityTransition>
    </Border>
    <Button
      Padding="10"
      HorizontalAlignment="Stretch"
      AutomationProperties.Name="{x:Bind Episode.Title, Mode=OneWay}"
      Click="OnClick"
      CornerRadius="12"
      Style="{StaticResource HaloDetailBareButtonStyle}">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="152" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="152" Height="86" CornerRadius="8">
          <local:PlaceholderArt Caption="STILL" />
          <local:ArtworkImage DecodeWidth="304" SourceUrl="{x:Bind Episode.Thumbnail, Mode=OneWay}" />
          <Border
            x:Name="PlayCircle"
            Width="34"
            Height="34"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource HaloDetailPlayCircleBrush}"
            CornerRadius="17"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.OpacityTransition>
              <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <FontIcon FontSize="14" Foreground="{ThemeResource HaloDetailInkBrush}" Glyph="&#xE768;" />
          </Border>
          <Grid
            Height="3"
            VerticalAlignment="Bottom"
            Background="{StaticResource HaloProgressTrackBrush}"
            Visibility="{x:Bind Episode.ProgressVisibility, Mode=OneWay}">
            <Border Background="{ThemeResource HaloAccentBrush}" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="{x:Bind Episode.Progress, Mode=OneWay}" />
              </Border.RenderTransform>
            </Border>
          </Grid>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              VerticalAlignment="Center"
              FontFamily="{StaticResource HaloMonoFont}"
              FontSize="12"
              Foreground="{ThemeResource HaloAccentBrush}"
              Text="{x:Bind Episode.Tag, Mode=OneWay}"
              Visibility="{x:Bind Episode.AccentTagVisibility, Mode=OneWay}" />
            <TextBlock
              VerticalAlignment="Center"
              FontFamily="{StaticResource HaloMonoFont}"
              FontSize="12"
              Foreground="{ThemeResource HaloDetailInk50Brush}"
              Text="{x:Bind Episode.Tag, Mode=OneWay}"
              Visibility="{x:Bind Episode.PlainTagVisibility, Mode=OneWay}" />
            <FontIcon
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="13"
              Foreground="{ThemeResource HaloSuccessBrush}"
              Glyph="&#xE73E;"
              ToolTipService.ToolTip="Watched"
              Visibility="{x:Bind Episode.WatchedVisibility, Mode=OneWay}" />
            <TextBlock
              Grid.Column="2"
              VerticalAlignment="Center"
              FontSize="15"
              FontWeight="SemiBold"
              Foreground="{ThemeResource HaloDetailInkBrush}"
              Text="{x:Bind Episode.Title, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
            <Border
              Grid.Column="3"
              Padding="6,2"
              VerticalAlignment="Center"
              Background="{ThemeResource HaloSuccessTintBrush}"
              CornerRadius="3"
              Visibility="{x:Bind Episode.SavedVisibility, Mode=OneWay}">
              <TextBlock
                FontFamily="{StaticResource HaloMonoBoldFont}"
                FontSize="12"
                Foreground="{ThemeResource HaloSuccessBrush}"
                Text="SAVED" />
            </Border>
          </Grid>
          <TextBlock
            FontSize="13"
            Foreground="{ThemeResource HaloDetailInk55Brush}"
            LineHeight="18.85"
            LineStackingStrategy="BlockLineHeight"
            MaxLines="2"
            Text="{x:Bind Episode.Blurb, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap"
            Visibility="{x:Bind Episode.BlurbVisibility, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
          <TextBlock
            HorizontalAlignment="Right"
            FontFamily="{StaticResource HaloMonoFont}"
            FontSize="12"
            Foreground="{ThemeResource HaloDetailInk50Brush}"
            Text="{x:Bind Episode.Aside, Mode=OneWay}"
            Visibility="{x:Bind Episode.AsideVisibility, Mode=OneWay}" />
          <TextBlock
            HorizontalAlignment="Right"
            FontFamily="{StaticResource HaloMonoFont}"
            FontSize="12"
            Foreground="{ThemeResource HaloDetailInk50Brush}"
            Text="{x:Bind Episode.Aired, Mode=OneWay}"
            Visibility="{x:Bind Episode.AiredVisibility, Mode=OneWay}" />
        </StackPanel>
      </Grid>
    </Button>
  </Grid>
</UserControl>
