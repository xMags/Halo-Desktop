<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.ConnectPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop">

  <Grid Background="Transparent">
    <StackPanel
      Width="404"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Image Width="26" Height="26" Source="ms-appx:///Assets/halo-mark.png" />
        <TextBlock
          VerticalAlignment="Center"
          CharacterSpacing="140"
          FontSize="15"
          FontWeight="SemiBold"
          Foreground="{ThemeResource HaloText1Brush}"
          Text="HALO" />
      </StackPanel>

      <TextBlock
        Margin="0,26,0,0"
        FontFamily="Segoe UI Variable Display"
        FontSize="26"
        FontWeight="SemiBold"
        Foreground="{ThemeResource HaloText1Brush}"
        Text="Point Halo at your server." />
      <TextBlock
        Margin="0,8,0,0"
        FontSize="13.5"
        Foreground="{ThemeResource HaloText2Brush}"
        Text="Your library, watch progress and addons live there. Nothing is stored by anyone else."
        TextWrapping="Wrap" />

      <TextBox
        Margin="0,24,0,0"
        AutomationProperties.Name="Server URL"
        PlaceholderText="https://halo.mynas.dev"
        Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse
          Width="7"
          Height="7"
          VerticalAlignment="Center"
          Fill="{ThemeResource HaloSuccessBrush}"
          Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}" />
        <TextBlock
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Foreground="{ThemeResource HaloSuccessBrush}"
          Style="{StaticResource HaloMonoData}"
          Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
          Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}" />
        <Button
          Grid.Column="2"
          Click="OnTestServerClick"
          Content="Test server"
          IsEnabled="{x:Bind ViewModel.CanTest, Mode=OneWay}" />
      </Grid>

      <ProgressRing
        Width="22"
        Height="22"
        Margin="0,16,0,0"
        HorizontalAlignment="Center"
        IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" />
      <Button
        Height="36"
        Margin="0,12,0,0"
        Click="OnContinueClick"
        Content="Continue"
        IsEnabled="{x:Bind ViewModel.CanContinue, Mode=OneWay}"
        Style="{StaticResource HaloAccentButtonStyle}" />
      <TextBlock
        Margin="0,16,0,0"
        HorizontalAlignment="Center"
        FontSize="12.5"
        Foreground="{ThemeResource HaloText3Brush}">
        <Run Text="No server yet? " />
        <Run Foreground="{ThemeResource HaloAccentBrush}" Text="Read the setup guide" />
      </TextBlock>
    </StackPanel>
  </Grid>
</Page>
