<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.CatalogPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  NavigationCacheMode="Disabled"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  ContextRequested="OnContextRequested">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <local:SectionHeader ShowBack="True" BackClick="OnBackClick" Title="{x:Bind ViewModel.Title, Mode=OneWay}">
      <local:SectionHeader.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource HaloMonoData}"
            Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.SourceVisibility, Mode=OneWay}" />
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource HaloMonoData}"
            Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" />
        </StackPanel>
      </local:SectionHeader.RightContent>
    </local:SectionHeader>
    <!--
      As many columns as fit at the poster width, then stretched to share the
      whole row, so a wide window leaves no empty band at the right. Rows are
      as tall as the stretched art and its caption. The end area below the grid
      is where the next page's spinner, or why it could not load, appears.
    -->
    <ScrollViewer
      x:Name="CatalogScroller"
      Grid.Row="1"
      HorizontalScrollMode="Disabled"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Hidden"
      ViewChanged="OnScrollerViewChanged"
      Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
      <StackPanel>
        <ItemsRepeater x:Name="CatalogGrid" VerticalCacheLength="4" Margin="24,20,24,32" SizeChanged="OnGridSizeChanged">
          <ItemsRepeater.Layout>
            <UniformGridLayout
              x:Name="CatalogLayout"
              ItemsStretch="Uniform"
              MinColumnSpacing="22"
              MinRowSpacing="14"
              Orientation="Horizontal" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:MediaSummary">
              <local:PosterCard
                Title="{x:Bind Title}"
                Meta="{x:Bind Meta}"
                Poster="{x:Bind Poster}" MetaId="{x:Bind Id}"
                KindLabel="{x:Bind KindLabel}"
                ShowKindBadge="True"
                FillsColumn="True"
                Tag="{x:Bind}"
                Click="OnPosterClick" />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <StackPanel
          MinHeight="56"
          Margin="24,-16,24,24"
          HorizontalAlignment="Center"
          Orientation="Horizontal"
          Spacing="12"
          Visibility="{x:Bind ViewModel.MoreVisibility, Mode=OneWay}">
          <ProgressRing
            Width="20"
            Height="20"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.LoadingMore, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.LoadingMoreVisibility, Mode=OneWay}" />
          <TextBlock
            VerticalAlignment="Center"
            FontSize="{StaticResource HaloFontLabel}"
            Foreground="{ThemeResource HaloText3Brush}"
            Text="Couldn't load more titles."
            Visibility="{x:Bind ViewModel.MoreFailedVisibility, Mode=OneWay}" />
          <Button
            VerticalAlignment="Center"
            Click="OnRetryMoreClick"
            Content="Retry"
            Visibility="{x:Bind ViewModel.MoreFailedVisibility, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel
      Grid.Row="1"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Spacing="8"
      Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
      <TextBlock FontSize="{StaticResource HaloFontSubtitle}" FontWeight="SemiBold" Text="Nothing to show" />
      <TextBlock Foreground="{ThemeResource HaloText3Brush}" Text="No titles are available in this catalog." />
    </StackPanel>
  </Grid>
</Page>
