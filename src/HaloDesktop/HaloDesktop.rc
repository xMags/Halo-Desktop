// Gives HaloDesktop.exe its own icon in Explorer, the taskbar, and Alt+Tab.
// Windows shows the lowest-numbered RT_GROUP_ICON as the executable's icon, so
// this stays at 1. The generated manifest resource is a different resource
// type and does not collide with it.
#include <windows.h>

1 ICON "Assets\\Halo.ico"

// The app's version. Settings reads FILEVERSION back for its Version row
// (Services/BuildInfoReader.cpp), so it is the one place a release bumps it,
// alongside the installer's /DAppVersion and Package.appxmanifest.
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Last Projects"
            VALUE "FileDescription", "Halo Desktop"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "HaloDesktop"
            VALUE "OriginalFilename", "HaloDesktop.exe"
            VALUE "ProductName", "Halo Desktop"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
