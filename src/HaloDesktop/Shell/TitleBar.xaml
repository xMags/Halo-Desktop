<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.TitleBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Height="32"
  IsTabStop="False">

  <!-- 30 puts the 16px mark's centre at 38, the middle of the 76px rail below
       it (HaloRailWidth). -->
  <Grid Padding="30,0,0,0" Background="Transparent">
    <StackPanel
      Orientation="Horizontal"
      Spacing="10"
      VerticalAlignment="Center">
      <local:HaloMark VerticalAlignment="Center" Size="16" />
      <TextBlock
        VerticalAlignment="Center"
        FontSize="{StaticResource HaloFontLabel}"
        Foreground="{ThemeResource HaloText2Brush}"
        Text="Halo Desktop" />
    </StackPanel>
  </Grid>
</UserControl>
