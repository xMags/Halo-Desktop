<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.TitleBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Height="32"
  IsTabStop="False">

  <Grid Padding="12,0,0,0" Background="Transparent">
    <StackPanel
      Orientation="Horizontal"
      Spacing="10"
      VerticalAlignment="Center">
      <Image
        Width="16"
        Height="16"
        IsHitTestVisible="False"
        Source="ms-appx:///Assets/halo-mark.png" />
      <TextBlock
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="{ThemeResource HaloText2Brush}"
        Text="Halo" />
    </StackPanel>
  </Grid>
</UserControl>
