<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.ShellPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:HaloDesktop"
  KeyboardAcceleratorPlacementMode="Hidden"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator
      Key="K"
      Modifiers="Control"
      Invoked="OnSearchAcceleratorInvoked" />
    <!-- The rail has no back button, so Alt+Left carries the shortcut,
         alongside the mouse back button handled in the code-behind. -->
    <KeyboardAccelerator
      Key="Left"
      Modifiers="Menu"
      Invoked="OnBackAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <Grid x:Name="ShellRoot" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!--
      The rail: one fixed width, a Fluent glyph over its
      label for each destination, the account at the foot. It never expands.
      Glyphs: Microsoft's Fluent UI System Icons (MIT), 24px regular and filled,
      microsoft/fluentui-system-icons at 6c2c9075cf8952ef48369b2475233b6e9761efed.
      Arrow keys move between destinations (XY focus) without navigating; Enter
      or Space opens one. Tab enters the rail once.
    -->
    <Grid x:Name="Rail" Width="{StaticResource HaloRailWidth}" Padding="0,8,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel
        x:Name="RailItems"
        Spacing="4"
        TabFocusNavigation="Once"
        XYFocusKeyboardNavigation="Enabled">
