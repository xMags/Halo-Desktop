<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.ShellPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:HaloDesktop"
  Loaded="OnLoaded">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator
      Key="K"
      Modifiers="Control"
      Invoked="OnSearchAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <NavigationView
    x:Name="Navigation"
    AlwaysShowHeader="False"
    Background="Transparent"
    CompactPaneLength="48"
    IsBackButtonVisible="Auto"
    IsBackEnabled="False"
    IsSettingsVisible="False"
    ItemInvoked="OnItemInvoked"
    BackRequested="OnBackRequested"
    OpenPaneLength="280"
    PaneDisplayMode="Left">

    <NavigationView.AutoSuggestBox>
      <AutoSuggestBox
        x:Name="SearchBox"
        IsTabStop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        PlaceholderText="Search"
        QueryIcon="Find"
        QuerySubmitted="OnSearchSubmitted" />
    </NavigationView.AutoSuggestBox>

    <NavigationView.MenuItems>
      <NavigationViewItemHeader>
        <TextBlock Text="MENU" Style="{StaticResource HaloMonoKicker}" />
      </NavigationViewItemHeader>
      <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE80F;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="SearchItem" Content="Search" Tag="Search">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE721;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="LibraryItem" Content="Library" Tag="Library">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE8F1;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="DownloadsItem" Tag="Downloads">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE896;" />
        </NavigationViewItem.Icon>
        <NavigationViewItem.Content>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Downloads" />
            <InfoBadge Grid.Column="1" Margin="12,0,0,0" Value="2" />
          </Grid>
        </NavigationViewItem.Content>
      </NavigationViewItem>
      <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="Settings">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE713;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <NavigationView.PaneCustomContent>
      <StackPanel Margin="4,10,4,0">
        <TextBlock Margin="12,0,0,8" Text="JUMP BACK IN" Style="{StaticResource HaloMonoKicker}" />

        <Grid Height="44" Padding="8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:PlaceholderArt Width="24" Height="34" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloText1Brush}" Text="Northwind Divide" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource HaloMonoData}" Text="S02E04 · 18 MIN LEFT" />
          </StackPanel>
        </Grid>

        <Grid Height="44" Padding="8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:PlaceholderArt Width="24" Height="34" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloText1Brush}" Text="The Long Sunday" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource HaloMonoData}" Text="52 MIN LEFT" />
          </StackPanel>
        </Grid>

        <Grid Height="44" Padding="8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:PlaceholderArt Width="24" Height="34" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloText1Brush}" Text="Harbour Lights" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource HaloMonoData}" Text="S01E07 · 6 MIN LEFT" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </NavigationView.PaneCustomContent>

    <NavigationView.PaneFooter>
      <Button Click="OnAccountClick" Style="{StaticResource HaloPaneRowButtonStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border
            Width="28"
            Height="28"
            Background="{ThemeResource HaloAccentBrush}"
            CornerRadius="14">
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="11.5"
              FontWeight="SemiBold"
              Foreground="{ThemeResource HaloOnAccentBrush}"
              Text="DB" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="{ThemeResource HaloText1Brush}" Text="debashis" />
            <TextBlock Style="{StaticResource HaloMonoData}" Text="ADMIN" />
          </StackPanel>
        </Grid>
      </Button>
    </NavigationView.PaneFooter>

    <Border
      Background="{ThemeResource HaloLayerBrush}"
      BorderBrush="{ThemeResource HaloCardStrokeBrush}"
      BorderThickness="1,1,0,0"
      CornerRadius="8,0,0,0">
      <Frame x:Name="ContentFrame" />
    </Border>
  </NavigationView>
</Page>
