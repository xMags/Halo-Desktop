<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.ShellPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  KeyboardAcceleratorPlacementMode="Hidden"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator
      Key="K"
      Modifiers="Control"
      Invoked="OnSearchAcceleratorInvoked" />
    <!-- The rail has no back button, so Alt+Left carries the shortcut,
         alongside the mouse back button handled in the code-behind. -->
    <KeyboardAccelerator
      Key="Left"
      Modifiers="Menu"
      Invoked="OnBackAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <Grid x:Name="ShellRoot" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!--
      The rail: one fixed width, a large icon over its
      label for each destination, the account at the foot. It never expands.
      Arrow keys move between destinations (XY focus) without navigating; Enter
      or Space opens one. Tab enters the rail once.
    -->
    <Grid x:Name="Rail" Width="{StaticResource HaloRailWidth}" Padding="0,4,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel
        x:Name="RailItems"
        Spacing="4"
        TabFocusNavigation="Once"
        XYFocusKeyboardNavigation="Enabled">
        <RadioButton x:Name="HomeItem" AutomationProperties.Name="Home" Click="OnRailItemClick" GroupName="ShellRail" Style="{StaticResource HaloNavRailItemStyle}" Tag="Home">
          <StackPanel Spacing="4">
            <FontIcon HorizontalAlignment="Center" FontSize="22" Glyph="&#xE80F;" />
            <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource HaloFontCaption}" Text="Home" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SearchItem" AutomationProperties.Name="Search" Click="OnRailItemClick" GroupName="ShellRail" Style="{StaticResource HaloNavRailItemStyle}" Tag="Search">
          <StackPanel Spacing="4">
            <FontIcon HorizontalAlignment="Center" FontSize="22" Glyph="&#xE721;" />
            <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource HaloFontCaption}" Text="Search" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="LibraryItem" AutomationProperties.Name="Library" Click="OnRailItemClick" GroupName="ShellRail" Style="{StaticResource HaloNavRailItemStyle}" Tag="Library">
          <StackPanel Spacing="4">
            <FontIcon HorizontalAlignment="Center" FontSize="22" Glyph="&#xE8F1;" />
            <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource HaloFontCaption}" Text="Library" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="HistoryItem" AutomationProperties.Name="History" Click="OnRailItemClick" GroupName="ShellRail" Style="{StaticResource HaloNavRailItemStyle}" Tag="History">
          <StackPanel Spacing="4">
            <FontIcon HorizontalAlignment="Center" FontSize="22" Glyph="&#xE823;" />
            <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource HaloFontCaption}" Text="History" />
          </StackPanel>
        </RadioButton>
        <!-- Windows' cloud-download glyph, with a dot on it while anything downloads. -->
        <RadioButton x:Name="DownloadsItem" AutomationProperties.Name="Downloads" Click="OnRailItemClick" GroupName="ShellRail" Style="{StaticResource HaloNavRailItemStyle}" Tag="Downloads">
          <StackPanel Spacing="4">
            <Grid HorizontalAlignment="Center">
              <FontIcon FontSize="22" Glyph="&#xEBD3;" />
              <InfoBadge
                x:Name="DownloadsDot"
                Margin="0,-2,-6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="Collapsed" />
            </Grid>
            <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource HaloFontCaption}" Text="Downloads" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SettingsItem" AutomationProperties.Name="Settings" Click="OnRailItemClick" GroupName="ShellRail" Style="{StaticResource HaloNavRailItemStyle}" Tag="Settings">
          <StackPanel Spacing="4">
            <FontIcon HorizontalAlignment="Center" FontSize="22" Glyph="&#xE713;" />
            <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource HaloFontCaption}" Text="Settings" />
          </StackPanel>
        </RadioButton>
      </StackPanel>

      <!-- The account: its picture only; its name and tier are the tooltip. -->
      <Button
        x:Name="AccountButton"
        Grid.Row="1"
        Click="OnAccountClick"
        Style="{StaticResource HaloRailAccountButtonStyle}">
        <Border Width="32" Height="32" CornerRadius="16">
          <!-- The account's own picture when it has one, set from the code-behind;
               the stock avatar otherwise. -->
          <Image
            x:Name="AccountAvatar"
            Source="ms-appx:///Assets/user-avatar.png"
            Stretch="UniformToFill" />
        </Border>
      </Button>
    </Grid>

    <!-- Listens for presses on empty content so a caret can be dismissed. The element
         that actually receives the focus is FocusSink, inside. -->
    <Border
      x:Name="ContentHost"
      Grid.Column="1"
      Background="{ThemeResource HaloLayerBrush}"
      BorderBrush="{ThemeResource HaloCardStrokeBrush}"
      BorderThickness="1,1,0,0"
      CornerRadius="8,0,0,0"
      SizeChanged="OnContentHostSizeChanged">
      <Grid>
        <Frame x:Name="ContentFrame" />
        <!-- Focus parks here when a press dismisses a caret. It must be a sibling of
             the frame, never an ancestor: focusing an ancestor makes XAML resolve the
             request down into the page and land on its first tab stop, which on Home
             is the search box the press was meant to leave, and that re-focus drags
             the scroll back to the top. Given a real size and IsTabStop because a
             Control refuses programmatic focus without them. -->
        <ContentControl
          x:Name="FocusSink"
          Width="1"
          Height="1"
          MinWidth="0"
          MinHeight="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsTabStop="True"
          Opacity="0"
          UseSystemFocusVisuals="False" />
      </Grid>
    </Border>
  </Grid>
</Page>
