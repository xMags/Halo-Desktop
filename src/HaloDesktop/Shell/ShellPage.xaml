      <!--
        The one selection pill, just inside the lit tile's left edge (6 of
        rail gutter plus 3). It slides from item to item, stretching on the
        way as Windows' own navigation pill does (ShellPage::MoveRailIndicator).
      -->
      <Border
        x:Name="RailIndicator"
        Width="3"
        Height="16"
        Margin="9,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="{ThemeResource HaloAccentBrush}"
        CornerRadius="1.5"
        IsHitTestVisible="False"
        Opacity="0">
        <Border.RenderTransform>
          <CompositeTransform x:Name="RailIndicatorTransform" CenterY="8" />
        </Border.RenderTransform>
      </Border>

      <!-- The account: its picture only; its name and tier are the tooltip. -->
      <Button
        x:Name="AccountButton"
        Grid.Row="1"
        Click="OnAccountClick"
        Style="{StaticResource HaloRailAccountButtonStyle}">
        <Border Width="32" Height="32" CornerRadius="16">
          <!-- The account's own picture when it has one, set from the code-behind;
               the stock avatar otherwise. -->
          <Image
            x:Name="AccountAvatar"
            Source="ms-appx:///Assets/user-avatar.png"
            Stretch="UniformToFill" />
        </Border>
      </Button>
    </Grid>

    <!-- Listens for presses on empty content so a caret can be dismissed. The element
         that actually receives the focus is FocusSink, inside. -->
    <Border
      x:Name="ContentHost"
      Grid.Column="1"
      Background="{ThemeResource HaloLayerBrush}"
      BorderBrush="{ThemeResource HaloCardStrokeBrush}"
      BorderThickness="1,1,0,0"
      CornerRadius="8,0,0,0"
      SizeChanged="OnContentHostSizeChanged">
      <Grid>
        <Frame x:Name="ContentFrame" />
        <!-- Focus parks here when a press dismisses a caret. It must be a sibling of
             the frame, never an ancestor: focusing an ancestor makes XAML resolve the
             request down into the page and land on its first tab stop, which on Home
             is the search box the press was meant to leave, and that re-focus drags
             the scroll back to the top. Given a real size and IsTabStop because a
             Control refuses programmatic focus without them. -->
        <ContentControl
          x:Name="FocusSink"
          Width="1"
          Height="1"
          MinWidth="0"
          MinHeight="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsTabStop="True"
          Opacity="0"
          UseSystemFocusVisuals="False" />
      </Grid>
    </Border>
  </Grid>
</Page>
