<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="HaloDesktop.ShellPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:HaloDesktop"
  KeyboardAcceleratorPlacementMode="Hidden"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator
      Key="K"
      Modifiers="Control"
      Invoked="OnSearchAcceleratorInvoked" />
  </Page.KeyboardAccelerators>

  <NavigationView
    x:Name="Navigation"
    AlwaysShowHeader="False"
    Background="Transparent"
    CompactPaneLength="48"
    IsBackButtonVisible="Collapsed"
    IsBackEnabled="False"
    IsSettingsVisible="False"
    ItemInvoked="OnItemInvoked"
    BackRequested="OnBackRequested"
    PaneOpening="OnPaneOpening"
    PaneClosing="OnPaneClosing"
    OpenPaneLength="{StaticResource HaloPaneWidth}"
    PaneDisplayMode="Left">

    <NavigationView.Resources>
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource HaloNavSelColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource HaloAccentTintColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource HaloChartDimColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource HaloAccentColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource HaloAccentColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource HaloAccentColor}" />
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
    </NavigationView.Resources>

    <NavigationView.MenuItems>
      <NavigationViewItemHeader Content="MENU" Style="{StaticResource HaloNavSectionHeaderStyle}" />
      <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE80F;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="SearchItem" Content="Search" Tag="Search">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE721;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="LibraryItem" Content="Library" Tag="Library">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE8F1;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="DownloadsItem" Tag="Downloads">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE896;" />
        </NavigationViewItem.Icon>
        <NavigationViewItem.Content>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Downloads" />
            <InfoBadge x:Name="DownloadsBadge" Grid.Column="1" Margin="12,0,0,0" Value="2" />
          </Grid>
        </NavigationViewItem.Content>
      </NavigationViewItem>
      <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="Settings">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE713;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>

      <!--
        "Jump back in" belongs after the menu in the design. PaneCustomContent is
        templated above MenuItems, so these live in MenuItems instead and opt out of
        selection. They are hidden with the pane, matching the design's expanded-only rule.
      -->
      <NavigationViewItemHeader x:Name="JumpHeader" Margin="0,14,0,0" Content="JUMP BACK IN" Style="{StaticResource HaloNavSectionHeaderStyle}" />
      <NavigationViewItem x:Name="JumpItem1" Height="44" SelectsOnInvoked="False" Tag="Jump0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="24" Height="34" VerticalAlignment="Center"><controls:PlaceholderArt /><controls:ArtworkImage x:Name="JumpPoster1" /></Grid>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="JumpTitle1" FontSize="13" Foreground="{ThemeResource HaloText1Brush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="JumpMeta1" Style="{StaticResource HaloMonoData}" />
          </StackPanel>
        </Grid>
      </NavigationViewItem>
      <NavigationViewItem x:Name="JumpItem2" Height="44" SelectsOnInvoked="False" Tag="Jump1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="24" Height="34" VerticalAlignment="Center"><controls:PlaceholderArt /><controls:ArtworkImage x:Name="JumpPoster2" /></Grid>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="JumpTitle2" FontSize="13" Foreground="{ThemeResource HaloText1Brush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="JumpMeta2" Style="{StaticResource HaloMonoData}" />
          </StackPanel>
        </Grid>
      </NavigationViewItem>
      <NavigationViewItem x:Name="JumpItem3" Height="44" SelectsOnInvoked="False" Tag="Jump2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="24" Height="34" VerticalAlignment="Center"><controls:PlaceholderArt /><controls:ArtworkImage x:Name="JumpPoster3" /></Grid>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="JumpTitle3" FontSize="13" Foreground="{ThemeResource HaloText1Brush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="JumpMeta3" Style="{StaticResource HaloMonoData}" />
          </StackPanel>
        </Grid>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <NavigationView.PaneFooter>
      <Button Click="OnAccountClick" Style="{StaticResource HaloPaneRowButtonStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border
            Width="28"
            Height="28"
            CornerRadius="14">
            <Image
              Source="ms-appx:///Assets/user-avatar.png"
              Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="AccountName" FontSize="13.5" Foreground="{ThemeResource HaloText1Brush}" />
            <TextBlock x:Name="AccountRole" CharacterSpacing="120" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9.5" Foreground="{ThemeResource HaloAccentBrush}" />
          </StackPanel>
        </Grid>
      </Button>
    </NavigationView.PaneFooter>

    <!-- Doubles as the focus sink: a press on empty content takes focus off a text box. -->
    <Border
      x:Name="ContentHost"
      Background="{ThemeResource HaloLayerBrush}"
      BorderBrush="{ThemeResource HaloCardStrokeBrush}"
      BorderThickness="1,1,0,0"
      CornerRadius="8,0,0,0"
      IsTabStop="True"
      PointerPressed="OnContentPointerPressed"
      SizeChanged="OnContentHostSizeChanged"
      UseSystemFocusVisuals="False">
      <Frame x:Name="ContentFrame" />
    </Border>
  </NavigationView>
</Page>
