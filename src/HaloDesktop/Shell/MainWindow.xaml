<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HaloDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HaloDesktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Halo Desktop">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The window ground is painted, not left to the system backdrop: Mica tints
            toward the desktop wallpaper, so the ground was never the palette's own
            colour. A child rather than RootGrid.Background so it resolves under the
            RequestedTheme the theme service sets on the root.
        -->
        <Border Grid.RowSpan="2" Background="{ThemeResource HaloMicaBrush}" IsHitTestVisible="False" />

        <!--
            Two ambient glows behind the shell, placed as the reference places them: the
            first off the top-left corner, the second anchored to the right edge so it
            follows the window as it widens.
        -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Ellipse
                Width="760"
                Height="520"
                Margin="-280,-340,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{ThemeResource HaloGlowABrush}" />
            <Ellipse
                Width="720"
                Height="500"
                Margin="0,-350,-160,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Fill="{ThemeResource HaloGlowBBrush}" />
        </Grid>

        <local:TitleBar x:Name="AppTitleBar" Grid.Row="0" />
        <Grid Grid.Row="1">
            <local:ShellPage x:Name="ShellLayer" />
            <!-- The sheet layer is deliberately unpainted: the sources sheet draws its
                 own scrim and lets the shell page it was opened from show through. It
                 sits below the overlay so opening the player covers the sheet. -->
            <Frame
                x:Name="SheetFrame"
                Background="Transparent"
                Visibility="Collapsed" />
            <Frame
                x:Name="OverlayFrame"
                Background="{ThemeResource HaloMicaBrush}"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
