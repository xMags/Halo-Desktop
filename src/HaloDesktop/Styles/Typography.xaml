<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The type ramp. Sizes are declared here and nowhere else: before this there
    were eighteen distinct literals spread over two hundred and eighty-two call
    sites, including half-points, which is why the app had no consistent voice
    and why changing how large anything read meant editing every screen.

    Nine steps, pitched so a 125% display reads as 150% used to. The ramp
    compresses towards the top on purpose: small text needs proportionally more
    help than a page title does, and display sizes were never the complaint.

    Anything genuinely below chrome, such as the subtitle preview, is bound to a
    view model instead and deliberately not on this ramp: that number is the
    size of a subtitle, not the size of a label.
  -->
  <x:Double x:Key="HaloFontCaption">12</x:Double>
  <x:Double x:Key="HaloFontSmall">13</x:Double>
  <x:Double x:Key="HaloFontLabel">14</x:Double>
  <x:Double x:Key="HaloFontBody">15</x:Double>
  <x:Double x:Key="HaloFontEmphasis">16</x:Double>
  <x:Double x:Key="HaloFontSubtitle">18</x:Double>
  <x:Double x:Key="HaloFontShelf">20</x:Double>
  <x:Double x:Key="HaloFontSection">22</x:Double>
  <x:Double x:Key="HaloFontDisplay">26</x:Double>
  <x:Double x:Key="HaloFontMonoBig">28</x:Double>
  <x:Double x:Key="HaloFontPageTitle">30</x:Double>
  <x:Double x:Key="HaloFontDetailTitle">36</x:Double>
  <!-- The hero title is driven by the layout step and only falls back to this. -->
  <x:Double x:Key="HaloFontHeroTitle">36</x:Double>

  <Style x:Key="HaloPageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontPageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
  </Style>

  <Style x:Key="HaloHeroTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontHeroTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-10" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
  </Style>

  <Style x:Key="HaloDetailTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontDetailTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
  </Style>

  <Style x:Key="HaloSectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource HaloFontSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
  </Style>

  <Style x:Key="HaloShelfTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource HaloFontShelf}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
  </Style>

  <Style x:Key="HaloBody" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource HaloFontEmphasis}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="HaloBodySmall" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource HaloFontBody}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="HaloCaption12" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource HaloFontLabel}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
  </Style>

  <Style x:Key="HaloMonoKicker" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HaloMonoBoldFont}" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CharacterSpacing" Value="160" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
  </Style>

  <Style x:Key="HaloMonoData" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HaloMonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontCaption}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
  </Style>

  <Style x:Key="HaloMonoBig" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HaloMonoBoldFont}" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontMonoBig}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText1Brush}" />
  </Style>

  <!-- The compact strip under a source headline: size, range, sound, language. -->
  <Style x:Key="HaloMonoMeta" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HaloMonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontCaption}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
  </Style>

  <Style x:Key="HaloMonoTileCaption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HaloMonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontCaption}" />
    <Setter Property="CharacterSpacing" Value="120" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText4Brush}" />
  </Style>
</ResourceDictionary>
