<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="HaloPaneRowButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
  </Style>

  <!--
    HorizontalAlignment is set because the WinUI Button default is Left, not
    Stretch. A card that hugs its content is not a card: without this every
    caller has to remember the override, and a row of cards comes out ragged.
  -->
  <Style x:Key="HaloCardButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{ThemeResource HaloCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloOverlayCornerRadius}" />
  </Style>

  <!-- Episode and aside cards on the detail page, tinted more heavily than the
       normal card so the backdrop artwork stays visible without washing out the
       card text. -->
  <Style x:Key="HaloDetailCardButtonStyle" BasedOn="{StaticResource HaloCardButtonStyle}" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource HaloDetailCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloDetailCardStrokeBrush}" />
  </Style>

  <Style x:Key="HaloAccentButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource HaloAccentAltBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    The destructive buttons are templated rather than coloured through Background and
    Foreground alone: the stock template swaps in its own grey fill and ink on hover
    and press, which turned a red button grey under the pointer. Every destructive
    control draws in the critical colour; the filled variant is kept for the one
    action a dialog or panel is asking the viewer to confirm.
  -->
  <Style x:Key="HaloDangerButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource HaloDangerFillBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter
            x:Name="ContentPresenter"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            AutomationProperties.AccessibilityView="Raw"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTransitions="{TemplateBinding ContentTransitions}"
            CornerRadius="{TemplateBinding CornerRadius}"
            FontWeight="{TemplateBinding FontWeight}"
            Foreground="{TemplateBinding Foreground}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource HaloDangerHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource HaloDangerHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Outlined red: a destructive action that is not the point of its surface. -->
  <Style x:Key="HaloDangerOutlineButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCriticalBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{ThemeResource HaloCriticalBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter
            x:Name="ContentPresenter"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            AutomationProperties.AccessibilityView="Raw"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTransitions="{TemplateBinding ContentTransitions}"
            CornerRadius="{TemplateBinding CornerRadius}"
            FontWeight="{TemplateBinding FontWeight}"
            Foreground="{TemplateBinding Foreground}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource HaloCriticalTintBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource HaloCriticalTintBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HaloDetailTileStyle" TargetType="Border">
    <Setter Property="Padding" Value="15,13" />
    <Setter Property="Background" Value="{ThemeResource HaloTileBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="HaloChipButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{ThemeResource HaloCtrlBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontLabel}" />
  </Style>

  <Style x:Key="HaloSegmentedButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontBody}" />
  </Style>

  <!-- Square icon-only button, 36x36, matching the design's secondary action squares. -->
  <Style x:Key="HaloIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
  </Style>

  <!--
    The icon square for a destructive action (remove, cancel, delete): the glyph is
    drawn in the critical colour and the hover wash is the critical tint. Disabled it
    falls back to the faintest ink, since a locked item has nothing to destroy.
  -->
  <Style x:Key="HaloDangerIconButtonStyle" BasedOn="{StaticResource HaloIconButtonStyle}" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource HaloCtrlBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{ThemeResource HaloCriticalBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter
            x:Name="ContentPresenter"
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            AutomationProperties.AccessibilityView="Raw"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            ContentTransitions="{TemplateBinding ContentTransitions}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Foreground="{TemplateBinding Foreground}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource HaloCriticalTintBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource HaloCriticalTintBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource HaloText4Brush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Borderless left-aligned row used by the Settings jump rail. -->
  <Style x:Key="HaloRailButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!--
    Track-only toggle: the design carries no On/Off text beside the switch.
    Null (not empty string) content so the presenters measure to zero and the row
    keeps the design's height instead of reserving a label line.
  -->
  <Style x:Key="HaloToggleSwitchStyle" TargetType="ToggleSwitch">
    <!-- The stock template reserves room for On/Off labels even when both are
         null. Pin the control to its visible switch width so right-aligned
         setting actions do not carry an invisible trailing column. -->
    <Setter Property="Width" Value="52" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
  </Style>

  <!--
    NavigationViewItemHeader's stock template applies its own text treatment, which
    swallowed the kicker styling. Templating it keeps the design's mono label.
  -->
  <Style x:Key="HaloNavSectionHeaderStyle" TargetType="NavigationViewItemHeader">
    <Setter Property="Padding" Value="12,6,12,8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="NavigationViewItemHeader">
          <ContentPresenter
            Padding="{TemplateBinding Padding}"
            HorizontalAlignment="Left"
            Content="{TemplateBinding Content}"
            FontFamily="{StaticResource HaloMonoBoldFont}"
            FontSize="{StaticResource HaloFontCaption}"
            FontWeight="Bold"
            Foreground="{ThemeResource HaloText3Brush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Segmented and chip selectors are RadioButtons so grouping, keyboarding and
    automation keep working; only the template changes. Hover and selection are
    separate layers so the two visual state groups never fight over one property.
  -->
  <!--
    The chosen option is a raised pill (its own fill and a hairline edge) on the
    tray, so it reads at a glance in both themes; the others use the secondary
    ink rather than the dimmest, so every label stays easy to read. 24 tall
    inside the tray's 3px inset and 1px edge makes 32, the height of a text box,
    so a tray beside a search box lines up with it.
  -->
  <Style x:Key="HaloSegmentedRadioStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontBody}" />
    <Setter Property="Background" Value="Transparent" />
    <!-- Centred by default, but honoured rather than hard-coded: a caller asking for Stretch used to be silently ignored. -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="4">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" Opacity="0" />
            <Border x:Name="SelectionLayer" Background="{ThemeResource HaloSegmentSelectedBrush}" BorderBrush="{ThemeResource HaloSegmentSelectedStrokeBrush}" BorderThickness="1" CornerRadius="4" Opacity="0" />
            <ContentPresenter
              x:Name="Label"
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              FontWeight="Normal"
              Foreground="{ThemeResource HaloText2Brush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource HaloText1Brush}" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HaloChipRadioStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontLabel}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="14">
            <Border
              x:Name="BaseLayer"
              BorderBrush="{ThemeResource HaloCtrlStrokeBrush}"
              BorderThickness="1"
              CornerRadius="14" />
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="14" Opacity="0" />
            <Border
              x:Name="SelectionLayer"
              Background="{ThemeResource HaloAccentTintBrush}"
              BorderBrush="{ThemeResource HaloAccentBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Opacity="0" />
            <ContentPresenter
              x:Name="Label"
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              Foreground="{ThemeResource HaloText3Brush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource HaloAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The quiet pill: no stroke at rest, a soft wash under the pointer, and the
    chosen one a plain wash in the strongest ink. Search's kind filters and a
    person's role filters, which sit under content rather than lead it.
  -->
  <Style x:Key="HaloQuietChipRadioStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontSmall}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="15">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="15" Opacity="0" />
            <Border x:Name="SelectionLayer" Background="{ThemeResource HaloQuietSelectedBrush}" CornerRadius="15" Opacity="0" />
            <ContentPresenter
              x:Name="Label"
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              Foreground="{ThemeResource HaloText2Brush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource HaloText1Brush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    List rows in the design are self-contained cards, and selection is an accent
    border rather than the stock selection pill, so the container is templated.
  -->
  <Style x:Key="HaloCardListItemStyle" TargetType="ListViewItem">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid>
            <Border
              x:Name="Root"
              Background="{ThemeResource HaloCardBrush}"
              BorderBrush="{ThemeResource HaloCardStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8" />
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloCtrlHoverBrush}" CornerRadius="8" Opacity="0" />
            <ContentPresenter
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource HaloNavSelBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource HaloAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOverSelected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource HaloNavSelBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource HaloAccentBrush}" />
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PressedSelected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource HaloNavSelBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource HaloAccentBrush}" />
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Picture-card selector used by the appearance switcher: the content is a preview
    thumbnail plus a label, and selection reads as an accent frame around the card.
  -->
  <Style x:Key="HaloThemeCardRadioStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <Border
              x:Name="Base"
              Background="{ThemeResource HaloCardBrush}"
              BorderBrush="{ThemeResource HaloCardStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8" />
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="8" Opacity="0" />
            <Border
              x:Name="SelectionLayer"
              Background="{ThemeResource HaloAccentTintBrush}"
              BorderBrush="{ThemeResource HaloAccentBrush}"
              BorderThickness="2"
              CornerRadius="8"
              Opacity="0" />
            <ContentPresenter
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The sources sheet. Its surface is the window background rather than a card so
    it reads as another plane of the app, not a dialog floating on top of it.
  -->
  <Style x:Key="HaloSheetSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource HaloMicaBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloDividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <!--
    Count pills. Unselected is borderless on purpose: four outlined pills in a row
    read as a toolbar, and only the active one is meant to carry weight.
  -->
  <Style x:Key="HaloFilterPillStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontBody}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="4">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" Opacity="0" />
            <!-- Selection is the accent wash rather than a neutral fill: these rows
                 carry five pills and live counts, and grey on grey is hard to find. -->
            <Border
              x:Name="SelectionLayer"
              Background="{ThemeResource HaloAccentTintBrush}"
              BorderBrush="{ThemeResource HaloInfoStrokeBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Opacity="0" />
            <ContentPresenter
              x:Name="Label"
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              FontWeight="Normal"
              Foreground="{ThemeResource HaloText3Brush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource HaloAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The sources sheet's flat buttons. Each is a transparent frame with a hover fill
    that only changes opacity in a visual state: nothing here takes a composition
    visual or a property transition. They differ only in the fill (`sbp` on the
    row, `sb` on the icon buttons, `cth` on the quiet ones, `ct` on Copy) and
    in whether the ink brightens under the pointer.
  -->
  <!-- `.sx-card-main`: the whole compact row is its Play button. -->
  <Style x:Key="HaloSheetRowButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtlePressedBrush}" Opacity="0" />
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- `.sx-sort` and `.sx-chevron`: a glyph in Text3 that brightens over a `sb` fill. -->
  <Style x:Key="HaloSheetIconButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText3Brush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" Opacity="0" />
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource HaloText1Brush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource HaloText1Brush}" />
                    <Setter Target="ContentPresenter.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    `.sx-close`, `.sx-link`, `.sx-reveal` and the footer toggle: no fill until the
    pointer is over it, then `cth`. The ink is whatever the caller sets.
  -->
  <Style x:Key="HaloSheetQuietButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloCtrlHoverBrush}" Opacity="0" />
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- `.sx-copy`: Text2 on nothing, Text1 on `ct` under the pointer. -->
  <Style x:Key="HaloSheetCopyButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource HaloText2Brush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloCtrlBrush}" Opacity="0" />
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource HaloText1Brush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource HaloText1Brush}" />
                    <Setter Target="ContentPresenter.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    `.btn.sx-btn.sx-save`: the standard control fill and stroke, `cth` under the
    pointer. Saving and Saved are disabled but stay at full strength, because they
    report rather than offer; their ink is set by the content.
  -->
  <Style x:Key="HaloSheetSaveButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{ThemeResource HaloCtrlBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root">
            <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloCtrlHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              FontWeight="{TemplateBinding FontWeight}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    `.sx-play-offline`: the one solid button, Text1 with the ground's colour for
    ink, a touch darker under the pointer (the reference's brightness 0.92).
  -->
  <Style x:Key="HaloSheetSolidButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{ThemeResource HaloText1Brush}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloMicaBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root">
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HoverLayer" Background="#14000000" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              FontWeight="{TemplateBinding FontWeight}"
              Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The card frame itself. Selection is drawn as a separate ring on top. -->
  <Style x:Key="HaloSourceCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource HaloCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- The 3px inset tray the segmented selectors sit inside: a shade under the
       page, so the chosen option's raised pill stands out from it. -->
  <Style x:Key="HaloSegmentedTrayStyle" TargetType="Border">
    <Setter Property="Padding" Value="3" />
    <Setter Property="Background" Value="{ThemeResource HaloSegmentTrayBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!--
    A destructive menu entry: label and glyph in the critical colour. The stock
    template, copied here unchanged otherwise, repaints the label with the primary ink
    under the pointer and on press, which would make the entry turn ordinary exactly
    when it is about to be chosen. Disabled keeps the stock disabled ink.
  -->
  <Style x:Key="HaloDangerMenuFlyoutItemStyle" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}" TargetType="MenuFlyoutItem">
    <Setter Property="Foreground" Value="{ThemeResource HaloCriticalBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuFlyoutItem">
          <Grid
            x:Name="LayoutRoot"
            Margin="{StaticResource MenuFlyoutItemMargin}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
                    <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
                    <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundDisabled}" />
                    <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                    <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                    <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckPlaceholderStates">
                <VisualState x:Name="NoPlaceholder" />
                <VisualState x:Name="CheckPlaceholder">
                  <VisualState.Setters>
                    <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IconPlaceholder">
                  <VisualState.Setters>
                    <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                    <Setter Target="IconRoot.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckAndIconPlaceholder">
                  <VisualState.Setters>
                    <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemDoublePlaceholderThemeThickness}" />
                    <Setter Target="IconRoot.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                    <Setter Target="IconRoot.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="PaddingSizeStates">
                <VisualState x:Name="DefaultPadding" />
                <VisualState x:Name="NarrowPadding">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Padding">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="KeyboardAcceleratorTextVisibility">
                <VisualState x:Name="KeyboardAcceleratorTextCollapsed" />
                <VisualState x:Name="KeyboardAcceleratorTextVisible">
                  <VisualState.Setters>
                    <Setter Target="KeyboardAcceleratorTextBlock.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox
              x:Name="IconRoot"
              Width="16"
              Height="16"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Visibility="Collapsed">
              <ContentPresenter x:Name="IconContent" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
            </Viewbox>
            <TextBlock
              x:Name="TextBlock"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              Foreground="{TemplateBinding Foreground}"
              Text="{TemplateBinding Text}"
              TextTrimming="{ThemeResource MenuFlyoutItemTextTrimming}" />
            <TextBlock
              x:Name="KeyboardAcceleratorTextBlock"
              Grid.Column="1"
              MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KeyboardAcceleratorTextMinWidth}"
              Margin="24,4,0,0"
              HorizontalAlignment="Right"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              AutomationProperties.AccessibilityView="Raw"
              Foreground="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
              Style="{ThemeResource CaptionTextBlockStyle}"
              Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
              TextAlignment="Right"
              Visibility="Collapsed" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
