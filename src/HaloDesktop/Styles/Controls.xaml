<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="HaloPaneRowButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
  </Style>

  <!--
    HorizontalAlignment is set because the WinUI Button default is Left, not
    Stretch. A card that hugs its content is not a card: without this every
    caller has to remember the override, and a row of cards comes out ragged.
  -->
  <Style x:Key="HaloCardButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{ThemeResource HaloCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloOverlayCornerRadius}" />
  </Style>

  <Style x:Key="HaloAccentButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource HaloAccentAltBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="HaloDangerButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource HaloDangerFillBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="HaloDetailTileStyle" TargetType="Border">
    <Setter Property="Padding" Value="15,13" />
    <Setter Property="Background" Value="{ThemeResource HaloTileBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="HaloChipButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{ThemeResource HaloCtrlBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontLabel}" />
  </Style>

  <Style x:Key="HaloSegmentedButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontBody}" />
  </Style>

  <!-- Square icon-only button, 36x36, matching the design's secondary action squares. -->
  <Style x:Key="HaloIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
  </Style>

  <!-- Borderless left-aligned row used by the Settings jump rail. -->
  <Style x:Key="HaloRailButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!--
    Track-only toggle: the design carries no On/Off text beside the switch.
    Null (not empty string) content so the presenters measure to zero and the row
    keeps the design's height instead of reserving a label line.
  -->
  <Style x:Key="HaloToggleSwitchStyle" TargetType="ToggleSwitch">
    <!-- The stock template reserves room for On/Off labels even when both are
         null. Pin the control to its visible switch width so right-aligned
         setting actions do not carry an invisible trailing column. -->
    <Setter Property="Width" Value="52" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
  </Style>

  <!--
    NavigationViewItemHeader's stock template applies its own text treatment, which
    swallowed the kicker styling. Templating it keeps the design's mono label.
  -->
  <Style x:Key="HaloNavSectionHeaderStyle" TargetType="NavigationViewItemHeader">
    <Setter Property="Padding" Value="12,6,12,8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="NavigationViewItemHeader">
          <ContentPresenter
            Padding="{TemplateBinding Padding}"
            HorizontalAlignment="Left"
            CharacterSpacing="160"
            Content="{TemplateBinding Content}"
            FontFamily="{StaticResource HaloMonoBoldFont}"
            FontSize="{StaticResource HaloFontCaption}"
            FontWeight="Bold"
            Foreground="{ThemeResource HaloText3Brush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Segmented and chip selectors are RadioButtons so grouping, keyboarding and
    automation keep working; only the template changes. Hover and selection are
    separate layers so the two visual state groups never fight over one property.
  -->
  <Style x:Key="HaloSegmentedRadioStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontBody}" />
    <Setter Property="Background" Value="Transparent" />
    <!-- Centred by default, but honoured rather than hard-coded: a caller asking for Stretch used to be silently ignored. -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="3">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="3" Opacity="0" />
            <Border x:Name="SelectionLayer" Background="{ThemeResource HaloCtrlHoverBrush}" CornerRadius="3" Opacity="0" />
            <ContentPresenter
              x:Name="Label"
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              FontWeight="Normal"
              Foreground="{ThemeResource HaloText3Brush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource HaloText1Brush}" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HaloChipRadioStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontLabel}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="14">
            <Border
              x:Name="BaseLayer"
              BorderBrush="{ThemeResource HaloCtrlStrokeBrush}"
              BorderThickness="1"
              CornerRadius="14" />
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="14" Opacity="0" />
            <Border
              x:Name="SelectionLayer"
              Background="{ThemeResource HaloAccentTintBrush}"
              BorderBrush="{ThemeResource HaloAccentBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Opacity="0" />
            <ContentPresenter
              x:Name="Label"
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              Foreground="{ThemeResource HaloText3Brush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource HaloAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    List rows in the design are self-contained cards, and selection is an accent
    border rather than the stock selection pill, so the container is templated.
  -->
  <Style x:Key="HaloCardListItemStyle" TargetType="ListViewItem">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid>
            <Border
              x:Name="Root"
              Background="{ThemeResource HaloCardBrush}"
              BorderBrush="{ThemeResource HaloCardStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8" />
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloCtrlHoverBrush}" CornerRadius="8" Opacity="0" />
            <ContentPresenter
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource HaloNavSelBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource HaloAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOverSelected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource HaloNavSelBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource HaloAccentBrush}" />
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PressedSelected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource HaloNavSelBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource HaloAccentBrush}" />
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Picture-card selector used by the appearance switcher: the content is a preview
    thumbnail plus a label, and selection reads as an accent frame around the card.
  -->
  <Style x:Key="HaloThemeCardRadioStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <Border
              x:Name="Base"
              Background="{ThemeResource HaloCardBrush}"
              BorderBrush="{ThemeResource HaloCardStrokeBrush}"
              BorderThickness="1"
              CornerRadius="8" />
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="8" Opacity="0" />
            <Border
              x:Name="SelectionLayer"
              Background="{ThemeResource HaloAccentTintBrush}"
              BorderBrush="{ThemeResource HaloAccentBrush}"
              BorderThickness="2"
              CornerRadius="8"
              Opacity="0" />
            <ContentPresenter
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The sources sheet. Its surface is the window background rather than a card so
    it reads as another plane of the app, not a dialog floating on top of it.
  -->
  <Style x:Key="HaloSheetSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource HaloMicaBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloDividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <!--
    Count pills. Unselected is borderless on purpose: four outlined pills in a row
    read as a toolbar, and only the active one is meant to carry weight.
  -->
  <Style x:Key="HaloFilterPillStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FontSize" Value="{StaticResource HaloFontBody}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="4">
            <Border x:Name="HoverLayer" Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" Opacity="0" />
            <!-- Selection is the accent wash rather than a neutral fill: these rows
                 carry five pills and live counts, and grey on grey is hard to find. -->
            <Border
              x:Name="SelectionLayer"
              Background="{ThemeResource HaloAccentTintBrush}"
              BorderBrush="{ThemeResource HaloInfoStrokeBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Opacity="0" />
            <ContentPresenter
              x:Name="Label"
              Padding="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              AutomationProperties.AccessibilityView="Raw"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              FontSize="{TemplateBinding FontSize}"
              FontWeight="Normal"
              Foreground="{ThemeResource HaloText3Brush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectionLayer.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource HaloAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The whole collapsed row of a source card is one hit target for expanding it.
    Borderless and transparent because the card around it already draws the frame,
    and a second border inside the first is one line too many.
  -->
  <Style x:Key="HaloSheetRowButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- The card frame itself. Selection is drawn as a separate ring on top. -->
  <Style x:Key="HaloSourceCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource HaloCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- The 3px inset tray the segmented selectors sit inside. -->
  <Style x:Key="HaloSegmentedTrayStyle" TargetType="Border">
    <Setter Property="Padding" Value="3" />
    <Setter Property="Background" Value="{ThemeResource HaloCtrlBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
</ResourceDictionary>
