<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="HaloPaneRowButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
  </Style>

  <Style x:Key="HaloCardButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{ThemeResource HaloCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloOverlayCornerRadius}" />
  </Style>

  <Style x:Key="HaloAccentButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource HaloAccentAltBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource HaloOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource HaloControlCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="HaloChipButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{ThemeResource HaloCtrlBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HaloCtrlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="HaloSegmentedButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="13" />
  </Style>
</ResourceDictionary>
