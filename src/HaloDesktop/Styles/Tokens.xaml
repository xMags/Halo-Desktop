  <SolidColorBrush x:Key="HaloSubtitleStageTextBrush" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="HaloSubtitleGlyphBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="HaloSubtitleOutlineBrush" Color="#F0000000" />
  <SolidColorBrush x:Key="HaloSubtitleShadowBrush" Color="#A6000000" />
  <LinearGradientBrush x:Key="HaloSubtitleStageScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0.4" Color="#00000000" />
    <GradientStop Offset="1" Color="#73000000" />
  </LinearGradientBrush>

  <CornerRadius x:Key="HaloControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="HaloOverlayCornerRadius">8</CornerRadius>
  <!--
    The radius a card's artwork is clipped to. Named separately from the overlay
    radius it currently shares a value with because a card frame and its
    placeholder have to agree exactly: rounding the two differently leaves the
    frame's corners uncovered until the artwork arrives.
  -->
  <CornerRadius x:Key="HaloArtCornerRadius">8</CornerRadius>
