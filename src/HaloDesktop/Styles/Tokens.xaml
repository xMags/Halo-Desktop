      <SolidColorBrush x:Key="HaloBadgeMutedStrokeBrush" Color="{StaticResource HaloBadgeMutedStrokeColor}" />
      <SolidColorBrush x:Key="HaloHoverCardStrokeBrush" Color="{StaticResource HaloHoverCardStrokeColor}" />
      <SolidColorBrush x:Key="HaloHoverCardShadowBrush" Color="{StaticResource HaloHoverCardShadowColor}" />
      <SolidColorBrush x:Key="HaloCtrlStrongStrokeBrush" Color="{StaticResource HaloCtrlStrongStrokeColor}" />
      <SolidColorBrush x:Key="HaloCtrlElevationStrokeBrush" Color="{StaticResource HaloCtrlElevationStrokeColor}" />
      <SolidColorBrush x:Key="HaloTextBoxFocusFillBrush" Color="{StaticResource HaloTextBoxFocusFillColor}" />
      <SolidColorBrush x:Key="HaloTextBoxPlaceholderBrush" Color="{StaticResource HaloTextBoxPlaceholderColor}" />
      <SolidColorBrush x:Key="HaloTextBoxPlaceholderFocusedBrush" Color="{StaticResource HaloTextBoxPlaceholderFocusedColor}" />
      <SolidColorBrush x:Key="HaloCtrlDisabledBrush" Color="{StaticResource HaloCtrlDisabledColor}" />
      <SolidColorBrush x:Key="HaloCtrlAltSecondaryBrush" Color="{StaticResource HaloCtrlAltSecondaryColor}" />
      <SolidColorBrush x:Key="HaloCtrlAltTertiaryBrush" Color="{StaticResource HaloCtrlAltTertiaryColor}" />
      <SolidColorBrush x:Key="HaloCtrlAltQuaternaryBrush" Color="{StaticResource HaloCtrlAltQuaternaryColor}" />
      <SolidColorBrush x:Key="HaloCtrlStrongStrokeDisabledBrush" Color="{StaticResource HaloCtrlStrongStrokeDisabledColor}" />
      <SolidColorBrush x:Key="HaloAccentDisabledBrush" Color="{StaticResource HaloAccentDisabledColor}" />
      <SolidColorBrush x:Key="HaloOnAccentDisabledBrush" Color="{StaticResource HaloOnAccentDisabledColor}" />
      <SolidColorBrush x:Key="HaloCtrlSolidBrush" Color="{StaticResource HaloCtrlSolidColor}" />
      <LinearGradientBrush x:Key="HaloTileBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="{StaticResource HaloTileTopColor}" />
        <GradientStop Offset="1" Color="{StaticResource HaloTileBottomColor}" />
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="HaloGlowABrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="{StaticResource HaloGlowAColor}" />
        <GradientStop Offset="1" Color="#000070E0" />
      </RadialGradientBrush>
      <RadialGradientBrush x:Key="HaloGlowBBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="{StaticResource HaloGlowBColor}" />
        <GradientStop Offset="1" Color="#007850C8" />
      </RadialGradientBrush>

      <!--
        The stock dialog surface is a different grey from every other Halo overlay and
        splits its button row onto its own band. Repainted from the flyout tokens so a
        dialog reads as the same material as a menu, in whichever theme it opens.
      -->
      <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource HaloFlyoutColor}" />
      <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource HaloCardStrokeColor}" />
      <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource HaloText1Color}" />
      <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
      <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="{StaticResource HaloCardStrokeColor}" />

      <BitmapImage x:Key="HaloPlaceholderStripe" UriSource="ms-appx:///Assets/stripe-light.png" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="HaloMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="HaloMonoBoldFont">ms-appx:///Assets/Fonts/JetBrainsMono-Bold.ttf#JetBrains Mono</FontFamily>

  <!--
    The subtitle stage stands in for a video frame, so it is deliberately kept out of
    the theme dictionaries: playback paints white captions with a dark border over
    picture whichever theme the app is wearing. Tinting the stage with the light
    palette put white text on a near-white panel, which hid the caption and
    misrepresented the outline and shadow settings the panel exists to demonstrate.
  -->
  <!--
    The sheet scrim is deliberately outside the theme dictionaries. It exists to
    push the page behind the sheet back, and a light-theme scrim that lightened
    instead of darkened would leave the sheet floating on nothing.
  -->
  <SolidColorBrush x:Key="HaloSheetScrimBrush" Color="#6B000000" />

  <!--
    The unwatched remainder of a progress track. Outside the theme dictionaries
    for the same reason as the sheet scrim: it is only ever drawn on top of a
    video still, never on a page surface, so a light-theme variant that lightened
    instead of darkened would erase the track against a bright frame.
  -->
  <SolidColorBrush x:Key="HaloProgressTrackBrush" Color="#73000000" />

  <!--
    The quality medal's metals are marks rather than palette colours, so like the
    sheet scrim they sit outside the theme dictionaries: a medal has to mean the same
    thing stamped on a dark video frame and on the light sources sheet. Only the plain
    medal below HD (the HaloBadgeMuted tokens), which has no meaning of its own,
    follows the theme. Per metal: the struck face (Brush), the plate lettering
    (TierBrush) and the tag cut into the face (InkBrush). The dark plate and the frame
    stroke are shared by all three metals, under their original gold names.
  -->
  <LinearGradientBrush x:Key="HaloBadgeGoldBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFF8E7A6" />
    <GradientStop Offset="0.46" Color="#FFE7C25C" />
    <GradientStop Offset="0.54" Color="#FFC79A2E" />
    <GradientStop Offset="1" Color="#FFEBCC72" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HaloBadgeGoldTierBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFF8E7A6" />
    <GradientStop Offset="1" Color="#FFD3A63A" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="HaloBadgeGoldPlateBrush" Color="#FF0B0B0D" />
  <SolidColorBrush x:Key="HaloBadgeGoldInkBrush" Color="#FF14100A" />
  <SolidColorBrush x:Key="HaloBadgeGoldStrokeBrush" Color="#59000000" />
  <LinearGradientBrush x:Key="HaloBadgeSilverBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFF4F6F9" />
    <GradientStop Offset="0.46" Color="#FFC9CFD8" />
    <GradientStop Offset="0.54" Color="#FF959DAA" />
    <GradientStop Offset="1" Color="#FFDDE2E8" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HaloBadgeSilverTierBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFFFFFFF" />
    <GradientStop Offset="1" Color="#FFAEB6C2" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="HaloBadgeSilverInkBrush" Color="#FF15181D" />
  <LinearGradientBrush x:Key="HaloBadgeBronzeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFF3CFAC" />
    <GradientStop Offset="0.46" Color="#FFCF9468" />
    <GradientStop Offset="0.54" Color="#FFA2663D" />
    <GradientStop Offset="1" Color="#FFDDAA80" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HaloBadgeBronzeTierBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFF6D2AE" />
    <GradientStop Offset="1" Color="#FFC08356" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="HaloBadgeBronzeInkBrush" Color="#FF1C120B" />
  <LinearGradientBrush x:Key="HaloSheetShadowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Offset="0" Color="#00000000" />
    <GradientStop Offset="1" Color="#57000000" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="HaloSubtitleStageBrush" Color="#FF232428" />
  <SolidColorBrush x:Key="HaloSubtitleStageStrokeBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="HaloSubtitleStageTextBrush" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="HaloSubtitleGlyphBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="HaloSubtitleOutlineBrush" Color="#F0000000" />
  <SolidColorBrush x:Key="HaloSubtitleShadowBrush" Color="#A6000000" />
  <LinearGradientBrush x:Key="HaloSubtitleStageScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0.4" Color="#00000000" />
    <GradientStop Offset="1" Color="#73000000" />
  </LinearGradientBrush>

  <CornerRadius x:Key="HaloControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="HaloOverlayCornerRadius">8</CornerRadius>
  <!--
    The radius a card's artwork is clipped to. Named separately from the overlay
    radius it currently shares a value with because a card frame and its
    placeholder have to agree exactly: rounding the two differently leaves the
    frame's corners uncovered until the artwork arrives.
  -->
  <CornerRadius x:Key="HaloArtCornerRadius">8</CornerRadius>
  <x:Double x:Key="HaloGutter">24</x:Double>
  <x:Double x:Key="HaloPaneWidth">224</x:Double>
  <x:Double x:Key="HaloCompactPaneWidth">56</x:Double>
  <x:Double x:Key="HaloPosterWidth">132</x:Double>
  <x:Double x:Key="HaloWideCardWidth">268</x:Double>
  <x:Double x:Key="HaloAsideWidth">292</x:Double>
  <x:Double x:Key="HaloHeroHeight">304</x:Double>
  <x:Double x:Key="HaloHeroTitleSize">36</x:Double>
  <x:Double x:Key="HaloFormMaxWidth">680</x:Double>
  <!--
    Both bounds carry the same value, so a dialog is one fixed, compact box rather than
    a band as wide as its longest sentence.
  -->
  <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
  <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
  <x:Double x:Key="HaloLibraryColumns">6</x:Double>
</ResourceDictionary>
