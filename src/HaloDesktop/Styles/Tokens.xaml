  <!--
    The subtitle stage stands in for a video frame, so it is deliberately kept out of
    the theme dictionaries: playback paints white captions with a dark border over
    picture whichever theme the app is wearing. Tinting the stage with the light
    palette put white text on a near-white panel, which hid the caption and
    misrepresented the outline and shadow settings the panel exists to demonstrate.
  -->
  <!--
    The sheet scrim is deliberately outside the theme dictionaries. It exists to
    push the page behind the sheet back, and a light-theme scrim that lightened
    instead of darkened would leave the sheet floating on nothing.
  -->
  <SolidColorBrush x:Key="HaloSheetScrimBrush" Color="#6B000000" />

  <!--
    The unwatched remainder of a progress track. Outside the theme dictionaries
    for the same reason as the sheet scrim: it is only ever drawn on top of a
    video still, never on a page surface, so a light-theme variant that lightened
    instead of darkened would erase the track against a bright frame.
  -->
  <SolidColorBrush x:Key="HaloProgressTrackBrush" Color="#73000000" />

  <!--
    Gold is a mark rather than a palette colour, so like the sheet scrim it sits
    outside the theme dictionaries: the quality badge has to mean the same thing
    stamped on a dark video frame and on the light sources sheet. Only the muted
    variant, which has no meaning of its own beyond "not the top tier", follows
    the theme.
  -->
  <LinearGradientBrush x:Key="HaloBadgeGoldBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFF8E7A6" />
    <GradientStop Offset="0.46" Color="#FFE7C25C" />
    <GradientStop Offset="0.54" Color="#FFC79A2E" />
    <GradientStop Offset="1" Color="#FFEBCC72" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HaloBadgeGoldTierBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#FFF8E7A6" />
    <GradientStop Offset="1" Color="#FFD3A63A" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="HaloBadgeGoldPlateBrush" Color="#FF0A0A0C" />
  <SolidColorBrush x:Key="HaloBadgeGoldInkBrush" Color="#FF14100A" />
  <SolidColorBrush x:Key="HaloBadgeGoldStrokeBrush" Color="#59000000" />
  <LinearGradientBrush x:Key="HaloSheetShadowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Offset="0" Color="#00000000" />
    <GradientStop Offset="1" Color="#57000000" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="HaloSubtitleStageBrush" Color="#FF232428" />
