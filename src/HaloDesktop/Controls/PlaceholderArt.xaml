<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.PlaceholderArt"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The radius is settable because this fills the art slot of cards that clip at
    a larger radius than the control's own default. A placeholder rounded tighter
    than the frame around it leaves the frame's corners uncovered, which reads as
    four transparent nicks on every card whose artwork has not arrived yet.
    ArtCornerRadius rather than the inherited Control.CornerRadius: UserControl's
    template ignores that one, so setting it would look like it worked and do
    nothing.
  -->
  <Border
    x:Name="ArtSurface"
    Background="{ThemeResource HaloPhTint1Brush}"
    CornerRadius="{StaticResource HaloControlCornerRadius}">
    <Grid>
      <Image
        x:Name="Stripes"
        Source="{ThemeResource HaloPlaceholderStripe}"
        Stretch="UniformToFill" />
      <!-- A movie or series poster: a soft surface and one faint glyph, nothing else. -->
      <Grid x:Name="PosterSurface" Background="{ThemeResource HaloPosterPlaceholderBrush}" Visibility="Collapsed">
        <FontIcon x:Name="MovieGlyph" FontSize="30" Foreground="{ThemeResource HaloPosterPlaceholderGlyphBrush}" Glyph="&#xE8B2;" Visibility="Collapsed" />
        <FontIcon x:Name="SeriesGlyph" FontSize="30" Foreground="{ThemeResource HaloPosterPlaceholderGlyphBrush}" Glyph="&#xE7F4;" Visibility="Collapsed" />
      </Grid>
      <TextBlock
        x:Name="CaptionText"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontFamily="{StaticResource HaloMonoBoldFont}"
        FontSize="{StaticResource HaloFontCaption}"
        FontWeight="Bold"
        Foreground="{ThemeResource HaloPhTextBrush}"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="Collapsed" />
    </Grid>
  </Border>
</UserControl>
