<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.PlaceholderArt"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The radius is settable because this fills the art slot of cards that clip at
    a larger radius than the control's own default. A placeholder rounded tighter
    than the frame around it leaves the frame's corners uncovered, which reads as
    four transparent nicks on every card whose artwork has not arrived yet.
    ArtCornerRadius rather than the inherited Control.CornerRadius: UserControl's
    template ignores that one, so setting it would look like it worked and do
    nothing.
  -->
  <Border
    x:Name="ArtSurface"
    Background="{ThemeResource HaloPhTint1Brush}"
    CornerRadius="{StaticResource HaloControlCornerRadius}">
    <Grid>
      <Image
        Source="{ThemeResource HaloPlaceholderStripe}"
        Stretch="UniformToFill" />
      <TextBlock
        x:Name="CaptionText"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontFamily="{StaticResource HaloMonoBoldFont}"
        FontSize="{StaticResource HaloFontCaption}"
        FontWeight="Bold"
        Foreground="{ThemeResource HaloPhTextBrush}"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="Collapsed" />
    </Grid>
  </Border>
</UserControl>
