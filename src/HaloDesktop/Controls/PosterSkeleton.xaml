<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.PosterSkeleton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  AutomationProperties.AccessibilityView="Raw"
  IsHitTestVisible="False"
  IsTabStop="False"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  Width="132">
  <!--
    `.poster-skeleton`: the art frame in the card fill with the card stroke,
    then a 78% bar 14px tall 8px under it and a 42% bar 12px tall 4px under
    that, both in the subtle fill. The top 4px band is the room a poster card
    keeps for its hover lift, so a skeleton sits exactly where its card will.
  -->
  <StackPanel Margin="0,4,0,0">
    <Border
      x:Name="ArtFrame"
      Height="198"
      Background="{ThemeResource HaloCardBrush}"
      BorderBrush="{ThemeResource HaloCardStrokeBrush}"
      BorderThickness="1"
      CornerRadius="{StaticResource HaloArtCornerRadius}">
      <!-- `.skeleton-badge`: 44 x 18, radius 4, 8 in from the frame's corner. -->
      <Border
        x:Name="KindBar"
        Width="44"
        Height="18"
        Margin="7"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="{ThemeResource HaloSubtleBrush}"
        CornerRadius="4"
        Visibility="Collapsed" />
    </Border>
    <Grid Height="14" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="78*" />
        <ColumnDefinition Width="22*" />
      </Grid.ColumnDefinitions>
      <Border Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
    </Grid>
    <Grid Height="12" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="42*" />
        <ColumnDefinition Width="58*" />
      </Grid.ColumnDefinitions>
      <Border Background="{ThemeResource HaloSubtleBrush}" CornerRadius="4" />
    </Grid>
  </StackPanel>
</UserControl>
