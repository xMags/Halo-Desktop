<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.QualityBadge"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  HorizontalAlignment="Left"
  VerticalAlignment="Center"
  Loaded="OnLoaded">
  <!--
    Tone is a visual state rather than a brush assigned from code so the colours
    stay in markup and follow a theme change on their own.
  -->
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ToneStates">
        <VisualState x:Name="Gold" />
        <VisualState x:Name="Muted">
          <VisualState.Setters>
            <Setter Target="Frame.Background" Value="{ThemeResource HaloBadgeMutedFillBrush}" />
            <Setter Target="Frame.BorderBrush" Value="{ThemeResource HaloBadgeMutedStrokeBrush}" />
            <Setter Target="Plate.Background" Value="{ThemeResource HaloBadgeMutedPlateBrush}" />
            <Setter Target="TierText.Foreground" Value="{ThemeResource HaloBadgeMutedTierBrush}" />
            <Setter Target="DetailText.Foreground" Value="{ThemeResource HaloBadgeMutedInkBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border
      x:Name="Frame"
      Padding="3"
      Background="{StaticResource HaloBadgeGoldBrush}"
      BorderBrush="{StaticResource HaloBadgeGoldStrokeBrush}"
      BorderThickness="1"
      CornerRadius="5">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border x:Name="Plate" Padding="6,2" VerticalAlignment="Center" Background="{StaticResource HaloBadgeGoldPlateBrush}" CornerRadius="3">
          <TextBlock
            x:Name="TierText"
            CharacterSpacing="60"
            FontFamily="{StaticResource HaloMonoBoldFont}"
            FontSize="{StaticResource HaloFontCaption}"
            Foreground="{StaticResource HaloBadgeGoldTierBrush}" />
        </Border>
        <TextBlock
          x:Name="DetailText"
          Margin="0,0,4,0"
          VerticalAlignment="Center"
          CharacterSpacing="120"
          FontFamily="{StaticResource HaloMonoBoldFont}"
          FontSize="{StaticResource HaloFontCaption}"
          Foreground="{StaticResource HaloBadgeGoldInkBrush}"
          Visibility="Collapsed" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
