<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.MediaShelf"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TitleText" Style="{StaticResource HaloShelfTitle}" />
      <TextBlock x:Name="SourceText" Grid.Column="1" Margin="10,0,0,2" VerticalAlignment="Bottom" Style="{StaticResource HaloMonoData}" />
      <Button Grid.Column="3" Padding="8,3" Background="Transparent" BorderThickness="0" FontSize="{StaticResource HaloFontBody}" Foreground="{ThemeResource HaloAccentBrush}" Content="See all" AutomationProperties.Name="See all shelf items" Click="OnSeeAllClick" />
      <Button x:Name="ScrollLeftButton" Grid.Column="4" Width="28" Height="28" MinWidth="0" Margin="8,0,0,0" Padding="0" AutomationProperties.Name="Scroll left" Click="OnScrollLeft" ToolTipService.ToolTip="Scroll left">
        <FontIcon FontSize="{StaticResource HaloFontLabel}" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76B;" />
      </Button>
      <Button x:Name="ScrollRightButton" Grid.Column="5" Width="28" Height="28" MinWidth="0" Margin="6,0,0,0" Padding="0" AutomationProperties.Name="Scroll right" Click="OnScrollRight" ToolTipService.ToolTip="Scroll right">
        <FontIcon FontSize="{StaticResource HaloFontLabel}" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76C;" />
      </Button>
    </Grid>
    <ScrollViewer
      x:Name="ShelfScroller"
      Grid.Row="1"
      Margin="0,-4,0,0"
      HorizontalScrollBarVisibility="Hidden"
      HorizontalScrollMode="Disabled"
      VerticalScrollMode="Disabled"
      ZoomMode="Disabled"
      SizeChanged="OnStripSizeChanged"
      ViewChanged="OnStripViewChanged">
      <!-- The wheel handler belongs on the content, not on the scroller. A
               ScrollViewer class-handles the wheel before any handler attached to
               the scroller itself, and marks it handled, so one attached there is
               never called. The transparent background makes the gaps between
               cards hit-testable too, so the strip answers everywhere. -->
      <Grid Background="Transparent" PointerWheelChanged="OnStripPointerWheelChanged" SizeChanged="OnStripSizeChanged">
        <ItemsRepeater x:Name="ShelfItems" HorizontalCacheLength="4">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Horizontal" Spacing="14" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <!-- The slot is sized so whole cards fill the strip (WholeCardStrip);
               the card stretches to it and keeps its 2:3 art. -->
          <DataTemplate x:DataType="local:MediaSummary">
            <Grid>
              <local:PosterCard
                Title="{x:Bind Title}"
                Meta="{x:Bind Meta}"
                Poster="{x:Bind Poster}" MetaId="{x:Bind Id}"
                KindLabel="{x:Bind KindLabel}"
                ShowKindBadge="False"
                FillsColumn="True"
                Tag="{x:Bind}"
                Click="OnPosterClick" />
            </Grid>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </Grid>
    </ScrollViewer>
    <!-- While the catalog loads: six skeleton cards where the strip will be,
         at the strip's own offset so the cards land on them. -->
    <StackPanel
      x:Name="SkeletonStrip"
      Grid.Row="1"
      Margin="0,-4,0,0"
      Orientation="Horizontal"
      Spacing="14"
      Visibility="Collapsed">
      <local:PosterSkeleton />
      <local:PosterSkeleton />
      <local:PosterSkeleton />
      <local:PosterSkeleton />
      <local:PosterSkeleton />
      <local:PosterSkeleton />
    </StackPanel>
    <!-- No edge fades, unlike the reference: XAML has no opacity mask for live
         content, so a fade was the page ground laid over the edge, and over the
         translucent window that band of opaque ground reads as haze. -->
  </Grid>
</UserControl>
