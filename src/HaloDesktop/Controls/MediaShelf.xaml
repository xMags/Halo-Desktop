<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.MediaShelf"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TitleText" Style="{StaticResource HaloShelfTitle}" />
      <TextBlock x:Name="SourceText" Grid.Column="1" Margin="10,0,0,2" VerticalAlignment="Bottom" Style="{StaticResource HaloMonoData}" />
      <Button Grid.Column="3" Padding="8,3" Background="Transparent" BorderThickness="0" FontSize="13" Foreground="{ThemeResource HaloAccentBrush}" Content="See all" AutomationProperties.Name="See all shelf items" Click="OnSeeAllClick" />
      <Button Grid.Column="4" Width="28" Height="28" MinWidth="0" Margin="8,0,0,0" Padding="0" AutomationProperties.Name="Scroll left" Click="OnScrollLeft" ToolTipService.ToolTip="Scroll left">
        <FontIcon FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76B;" />
      </Button>
      <Button Grid.Column="5" Width="28" Height="28" MinWidth="0" Margin="6,0,0,0" Padding="0" AutomationProperties.Name="Scroll right" Click="OnScrollRight" ToolTipService.ToolTip="Scroll right">
        <FontIcon FontSize="12" Foreground="{ThemeResource HaloText2Brush}" Glyph="&#xE76C;" />
      </Button>
    </Grid>
    <ScrollViewer
      x:Name="ShelfScroller"
      Grid.Row="1"
      HorizontalScrollBarVisibility="Hidden"
      HorizontalScrollMode="Disabled"
      VerticalScrollMode="Disabled"
      ZoomMode="Disabled">
      <!-- The wheel handler belongs on the content, not on the scroller. A
               ScrollViewer class-handles the wheel before any handler attached to
               the scroller itself, and marks it handled, so one attached there is
               never called. The transparent background makes the gaps between
               cards hit-testable too, so the strip answers everywhere. -->
      <Grid Background="Transparent" PointerWheelChanged="OnStripPointerWheelChanged">
        <ItemsRepeater x:Name="ShelfItems">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Horizontal" Spacing="14" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="local:MediaSummary">
            <local:PosterCard
              Title="{x:Bind Title}"
              Meta="{x:Bind Meta}"
              Poster="{x:Bind Poster}"
              KindLabel="{x:Bind KindLabel}"
              ShowKindBadge="False"
              Tag="{x:Bind}"
              Click="OnPosterClick" />
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
