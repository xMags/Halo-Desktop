<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.ContinueCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  Width="268">
  <UserControl.Resources>
    <!--
      The card already states hover itself: a 2px lift and the accent ring over
      the art frame. The stock Button paints a filled, rounded panel behind the
      whole card on top of that, which reads as a pane of glass laid under the
      still and its title. Only that fill is dropped. The button keeps its
      transparent background, so the still, the title and the gaps around them
      all stay hit-testable as one card.
    -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
  </UserControl.Resources>
  <Button
    x:Name="CardButton"
    Padding="0"
    HorizontalContentAlignment="Stretch"
    Background="Transparent"
    BorderThickness="0"
    Click="OnCardClick"
    PointerEntered="OnCardPointerEntered"
    PointerExited="OnCardPointerExited">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ArtRow" Height="151" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!--
        The border is what clips the still, the chips and the progress track to
        the card radius. Without it the artwork drew square over a rounded
        placeholder, so the card changed shape the moment the image arrived.
      -->
      <Border
        x:Name="ArtBorder"
        BorderBrush="{ThemeResource HaloCardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource HaloArtCornerRadius}">
        <Grid>
          <local:PlaceholderArt x:Name="StillPlaceholder" ArtCornerRadius="{StaticResource HaloArtCornerRadius}" />
          <local:ArtworkImage x:Name="Still" Placeholder="{x:Bind StillPlaceholder}" />
          <local:TagChip x:Name="EpisodeChip" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" />
          <local:TagChip x:Name="TimeLeftChip" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          <!--
            Two star columns rather than a ProgressBar. The stock template draws
            its unfilled track as a 1px line centred in whatever height it is
            given while the filled indicator takes the full height, so a 3px bar
            stepped down to a hairline at the progress point; and it paints the
            indicator in the Windows accent, which is not Halo's.
          -->
          <Grid x:Name="ProgressTrack" Height="3" VerticalAlignment="Bottom" Background="{ThemeResource HaloProgressTrackBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="ProgressFilled" Width="0*" />
              <ColumnDefinition x:Name="ProgressRemaining" Width="1*" />
            </Grid.ColumnDefinitions>
            <Rectangle Fill="{ThemeResource HaloAccentBrush}" />
          </Grid>
        </Grid>
      </Border>
      <!--
        The hover accent is a second ring laid exactly over the art frame and
        faded in, rather than the frame's brush being swapped in code. A code
        swap has to find the brush by string key at runtime, which fails
        silently when it misses, and writing a local BorderBrush also cancels
        the ThemeResource binding, so the frame would stop following a later
        light/dark switch. Opacity is a plain double with neither problem.
      -->
      <Border
        x:Name="ArtHoverRing"
        BorderBrush="{ThemeResource HaloAccentBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource HaloArtCornerRadius}"
        IsHitTestVisible="False"
        Opacity="0" />
      <TextBlock
        x:Name="TitleText"
        Grid.Row="1"
        Margin="1,8,1,0"
        FontSize="{StaticResource HaloFontBody}"
        Foreground="{ThemeResource HaloText1Brush}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        x:Name="MetaText"
        Grid.Row="2"
        Margin="1,3,1,0"
        Style="{StaticResource HaloMonoData}"
        TextTrimming="CharacterEllipsis" />
    </Grid>
  </Button>
</UserControl>
