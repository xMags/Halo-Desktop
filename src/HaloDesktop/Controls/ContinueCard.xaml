<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.ContinueCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  Width="268">
  <Button
    x:Name="CardButton"
    Padding="0"
    HorizontalContentAlignment="Stretch"
    Background="Transparent"
    BorderThickness="0"
    Click="OnCardClick">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ArtRow" Height="151" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <local:PlaceholderArt />
        <local:ArtworkImage x:Name="Still" />
        <local:TagChip x:Name="EpisodeChip" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <local:TagChip x:Name="TimeLeftChip" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        <ProgressBar x:Name="ProgressTrack" Height="3" VerticalAlignment="Bottom" Maximum="1" />
      </Grid>
      <TextBlock
        x:Name="TitleText"
        Grid.Row="1"
        Margin="1,8,1,0"
        FontSize="13"
        Foreground="{ThemeResource HaloText1Brush}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        x:Name="MetaText"
        Grid.Row="2"
        Margin="1,3,1,0"
        Style="{StaticResource HaloMonoData}"
        TextTrimming="CharacterEllipsis" />
    </Grid>
  </Button>
</UserControl>
