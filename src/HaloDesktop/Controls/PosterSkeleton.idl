namespace HaloDesktop
{
    // The reference's PosterCardSkeleton: a poster card's frame and two text
    // bars, at the poster size of the current layout step. Drawn only; it
    // takes no input and says nothing to assistive technology.
    [default_interface]
    runtimeclass PosterSkeleton : Microsoft.UI.Xaml.Controls.UserControl
    {
        PosterSkeleton();
        // True in a grid whose columns stretch, as PosterCard's: the skeleton
        // takes its column's width and its frame keeps 2:3 at that width.
        Boolean FillsColumn;
        // `showKind`: the badge's bar in the frame's top left corner.
        Boolean ShowKindBadge;
    }
}
