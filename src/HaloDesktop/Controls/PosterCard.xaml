<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.PosterCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  Width="132">
  <UserControl.Resources>
    <!--
      The card already states hover itself: a 2px lift, a stronger art frame and
      a shadow under the art. The stock Button paints a filled, rounded panel behind the whole
      card on top of that, which reads as a pane of glass laid under the poster
      and its title. Only that fill is dropped. The button keeps its transparent
      background, so the poster, the title and the gaps around them all stay
      hit-testable as one card.
    -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
  </UserControl.Resources>
  <!--
    The four pixels above the button are the room the card lifts into on hover.
    The lift is a render-time translation, so with no space of its own the card
    slid straight out of whatever clips it: a shelf is a scroll viewer exactly
    one card tall, and a grid view item clips to its own bounds. Both cut the
    lift off flat and squared the top corners, so the card read as dropping into
    a slot rather than rising out of the row. Hosts that care about the gap
    above the row cancel this band with a matching negative margin.
  -->
  <Button
    x:Name="CardButton"
    Margin="0,4,0,0"
    Padding="0"
    HorizontalContentAlignment="Stretch"
    Background="Transparent"
    BorderThickness="0"
    Click="OnCardClick"
    PointerEntered="OnCardPointerEntered"
    PointerExited="OnCardPointerExited">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ArtRow" Height="198" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The hover shadow is drawn into this host, which fades in with the stroke. -->
      <Border
        x:Name="ShadowHost"
        IsHitTestVisible="False"
        Opacity="0">
        <Border.OpacityTransition>
          <ScalarTransition Duration="0:0:0.12" />
        </Border.OpacityTransition>
      </Border>
      <!--
        The frame's own stroke is drawn as a ring over the art, as is the
        hover stroke, and the two crossfade: swapping the frame's brush in code
        would cancel its ThemeResource binding, and laying the translucent
        hover stroke over the resting one would tint it. The frame keeps its
        1px border, unpainted, so the art sits where it always did.
      -->
      <Border
        x:Name="ArtBorder"
        BorderBrush="Transparent"
        BorderThickness="1"
        CornerRadius="{StaticResource HaloArtCornerRadius}">
        <Grid>
          <local:PlaceholderArt x:Name="Placeholder" ArtCornerRadius="{StaticResource HaloArtCornerRadius}" />
          <Image x:Name="PosterImage" Opacity="0" Stretch="UniformToFill" ImageOpened="OnPosterOpened" ImageFailed="OnPosterFailed" />
        </Grid>
      </Border>
      <Border
        x:Name="ArtRestRing"
        BorderBrush="{ThemeResource HaloCardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource HaloArtCornerRadius}"
        IsHitTestVisible="False">
        <Border.OpacityTransition>
          <ScalarTransition Duration="0:0:0.12" />
        </Border.OpacityTransition>
      </Border>
      <Border
        x:Name="ArtHoverRing"
        BorderBrush="{ThemeResource HaloHoverCardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource HaloArtCornerRadius}"
        IsHitTestVisible="False"
        Opacity="0">
        <Border.OpacityTransition>
          <ScalarTransition Duration="0:0:0.12" />
        </Border.OpacityTransition>
      </Border>
      <Border
        x:Name="KindBadge"
        Margin="8"
        Padding="6,3"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="#B0000000"
        CornerRadius="3"
        Visibility="Collapsed">
        <TextBlock x:Name="KindText" FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="{StaticResource HaloFontCaption}" Foreground="White" />
      </Border>
      <TextBlock
        x:Name="TitleText"
        Grid.Row="1"
        Margin="1,8,1,0"
        FontSize="{StaticResource HaloFontBody}"
        Foreground="{ThemeResource HaloText1Brush}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        x:Name="MetaText"
        Grid.Row="2"
        Margin="1,3,1,0"
        Style="{StaticResource HaloMonoData}"
        TextTrimming="CharacterEllipsis" />
    </Grid>
  </Button>
</UserControl>
