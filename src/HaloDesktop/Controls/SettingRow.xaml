<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.SettingRow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid MinHeight="54" Padding="0,6" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Spacing="2">
      <TextBlock x:Name="LabelText" FontSize="13.5" Foreground="{ThemeResource HaloText1Brush}" />
      <TextBlock x:Name="HintText" FontSize="12" Foreground="{ThemeResource HaloText3Brush}" TextWrapping="Wrap" />
    </StackPanel>
    <ContentPresenter x:Name="SettingContentHost" Grid.Column="1" VerticalAlignment="Center" />
  </Grid>
</UserControl>
