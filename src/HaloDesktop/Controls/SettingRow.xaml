<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.SettingRow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    One setting as Windows Settings lays it out: an optional glyph, the label over
    its hint, and the control at the row's end. Spacing sits on the glyph's margin
    rather than the grid's ColumnSpacing, so a row without a glyph starts flush.
  -->
  <Grid MinHeight="42" Padding="16,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <FontIcon x:Name="GlyphIcon" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="20" Foreground="{ThemeResource HaloText1Brush}" Visibility="Collapsed" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
      <TextBlock x:Name="LabelText" FontSize="{StaticResource HaloFontLabel}" Foreground="{ThemeResource HaloText1Brush}" TextWrapping="Wrap" />
      <TextBlock x:Name="HintText" FontSize="{StaticResource HaloFontSmall}" Foreground="{ThemeResource HaloText3Brush}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
    <ContentPresenter x:Name="SettingContentHost" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" />
  </Grid>
</UserControl>
