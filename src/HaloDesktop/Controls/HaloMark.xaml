<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.HaloMark"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsHitTestVisible="False"
  IsTabStop="False">
  <!--
    The reference's 64-unit SVG, scaled to Size. The ring is two halves so the bars can
    sit between them: the back half under the bars, the front half over them. The bars
    arrive from code already cut clear of the front half (HaloMarkGeometry), which is
    what the SVG does with a mask.
  -->
  <Viewbox x:Name="MarkBox" Width="16" Height="16" Stretch="Uniform">
    <Canvas Width="64" Height="64">
      <Path
        x:Name="BackRing"
        Data="M 5,34 A 27,9.5 0 0 1 59,34"
        Stroke="{ThemeResource HaloText1Brush}"
        StrokeEndLineCap="Round"
        StrokeStartLineCap="Round"
        StrokeThickness="7">
        <Path.RenderTransform>
          <RotateTransform Angle="-16" CenterX="32" CenterY="34" />
        </Path.RenderTransform>
      </Path>
      <Path x:Name="Bars" Fill="{ThemeResource HaloAccentAltBrush}" />
      <Path
        x:Name="FrontRing"
        Data="M 5,34 A 27,9.5 0 0 0 59,34"
        Stroke="{ThemeResource HaloText1Brush}"
        StrokeEndLineCap="Round"
        StrokeStartLineCap="Round"
        StrokeThickness="7">
        <Path.RenderTransform>
          <RotateTransform Angle="-16" CenterX="32" CenterY="34" />
        </Path.RenderTransform>
      </Path>
    </Canvas>
  </Viewbox>
</UserControl>
