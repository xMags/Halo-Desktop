<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.SectionHeader"
  x:Name="Root"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Padding must match the SectionHeader::m_contentPadding default in the code-behind: this is the value every page that does not set ContentPadding keeps. -->
  <Grid x:Name="HeaderGrid" Padding="24,12,24,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Collapsed unless a page opts in: only pages reached from another page
         inside the shell frame have somewhere to go back to. -->
    <Button
      x:Name="BackButton"
      Width="34"
      Height="34"
      MinWidth="0"
      Margin="0,0,14,2"
      Padding="0"
      VerticalAlignment="Bottom"
      AutomationProperties.Name="Back"
      Click="OnBackClick"
      CornerRadius="4"
      ToolTipService.ToolTip="Back"
      Visibility="Collapsed">
      <FontIcon FontSize="{StaticResource HaloFontEmphasis}" Glyph="&#xE72B;" />
    </Button>
    <TextBlock
      x:Name="TitleText"
      Grid.Column="1"
      VerticalAlignment="Bottom"
      Style="{StaticResource HaloPageTitle}" />
    <ContentPresenter
      x:Name="RightContentHost"
      Grid.Column="3"
      VerticalAlignment="Bottom" />
  </Grid>
</UserControl>
