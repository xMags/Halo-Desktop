namespace HaloDesktop
{
    [default_interface]
    runtimeclass PosterCard : Microsoft.UI.Xaml.Controls.UserControl
    {
        PosterCard();
        String Title;
        String Meta;
        String Poster;
        String KindLabel;
        Boolean ShowKindBadge;
        // True in a grid whose columns stretch: the card takes its column's
        // width and its art keeps the 2:3 frame at that width.
        Boolean FillsColumn;
        Double CardWidth { get; };
        event Microsoft.UI.Xaml.RoutedEventHandler Click;
        // The poster it was handed could not be loaded. Search counts such a
        // title as artless; other hosts need not listen.
        event Microsoft.UI.Xaml.RoutedEventHandler PosterFailed;
    }
}
