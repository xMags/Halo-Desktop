namespace HaloDesktop
{
    [default_interface]
    runtimeclass MediaShelf : Microsoft.UI.Xaml.Controls.UserControl
    {
        MediaShelf();
        String Title;
        String SourceLabel;
        Object ItemsSource;
        // The shelf's catalog has not answered: six skeleton cards stand in
        // for its strip under the real title.
        Boolean IsLoading;
        Object SelectedItem { get; };
        event Microsoft.UI.Xaml.RoutedEventHandler ItemClick;
        event Microsoft.UI.Xaml.RoutedEventHandler SeeAllClick;
    }
}
