<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.QualityMedal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  HorizontalAlignment="Left"
  VerticalAlignment="Center"
  IsTabStop="False"
  Loaded="OnLoaded">
  <!--
    Finish, size and tag are visual states rather than values assigned from code, so
    the colours stay in markup and the plain finish follows a theme change on its own.
    The markup defaults are a tagged gold medium medal; the states override them.
    Sizes, metals and inks are the reference's medal.css.
  -->
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="FinishStates">
        <VisualState x:Name="Gold" />
        <VisualState x:Name="Silver">
          <VisualState.Setters>
            <Setter Target="Face.Background" Value="{StaticResource HaloBadgeSilverBrush}" />
            <Setter Target="PlateText.Foreground" Value="{StaticResource HaloBadgeSilverTierBrush}" />
            <Setter Target="TagLabel.Foreground" Value="{StaticResource HaloBadgeSilverInkBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Bronze">
          <VisualState.Setters>
            <Setter Target="Face.Background" Value="{StaticResource HaloBadgeBronzeBrush}" />
            <Setter Target="PlateText.Foreground" Value="{StaticResource HaloBadgeBronzeTierBrush}" />
            <Setter Target="TagLabel.Foreground" Value="{StaticResource HaloBadgeBronzeInkBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Plain">
          <VisualState.Setters>
            <Setter Target="Face.Background" Value="{ThemeResource HaloBadgeMutedFillBrush}" />
            <Setter Target="Face.BorderBrush" Value="{ThemeResource HaloBadgeMutedStrokeBrush}" />
            <Setter Target="Plate.Background" Value="{ThemeResource HaloBadgeMutedPlateBrush}" />
            <Setter Target="PlateText.Foreground" Value="{ThemeResource HaloBadgeMutedTierBrush}" />
            <Setter Target="TagLabel.Foreground" Value="{ThemeResource HaloBadgeMutedInkBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="SizeStates">
        <VisualState x:Name="Small">
          <VisualState.Setters>
            <Setter Target="Face.Width" Value="78" />
            <Setter Target="Face.Height" Value="22" />
            <Setter Target="Face.Padding" Value="2" />
            <Setter Target="Face.CornerRadius" Value="5" />
            <Setter Target="Plate.MinWidth" Value="40" />
            <Setter Target="Plate.Padding" Value="5,0" />
            <Setter Target="Plate.CornerRadius" Value="3" />
            <Setter Target="PlateText.FontSize" Value="10.5" />
            <Setter Target="TagLabel.FontSize" Value="8.5" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Medium" />
        <VisualState x:Name="Large">
          <VisualState.Setters>
            <Setter Target="Face.Width" Value="112" />
            <Setter Target="Face.Height" Value="36" />
            <Setter Target="Plate.MinWidth" Value="56" />
            <Setter Target="PlateText.FontSize" Value="15" />
            <Setter Target="TagLabel.FontSize" Value="12" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="TagStates">
        <VisualState x:Name="Tagged" />
        <!-- Nothing to say beside the plate: it takes the medal, no empty box. -->
        <VisualState x:Name="Untagged">
          <VisualState.Setters>
            <Setter Target="Plate.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="TagLabel.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border
      x:Name="Face"
      Width="96"
      Height="30"
      Padding="3"
      Background="{StaticResource HaloBadgeGoldBrush}"
      BorderBrush="{StaticResource HaloBadgeGoldStrokeBrush}"
      BorderThickness="1"
      CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
          x:Name="Plate"
          MinWidth="48"
          Padding="6,0"
          Background="{StaticResource HaloBadgeGoldPlateBrush}"
          CornerRadius="4">
          <TextBlock
            x:Name="PlateText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CharacterSpacing="40"
            FontFamily="{StaticResource HaloMonoBoldFont}"
            FontSize="13"
            FontWeight="Bold"
            Foreground="{StaticResource HaloBadgeGoldTierBrush}" />
        </Border>
        <TextBlock
          x:Name="TagLabel"
          Grid.Column="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          CharacterSpacing="100"
          FontFamily="{StaticResource HaloMonoBoldFont}"
          FontSize="10.5"
          FontWeight="Bold"
          Foreground="{StaticResource HaloBadgeGoldInkBrush}"
          TextAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
