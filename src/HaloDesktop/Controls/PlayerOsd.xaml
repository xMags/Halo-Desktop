<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="HaloDesktop.PlayerOsd"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HaloDesktop"
  Loaded="OnLoaded">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#80141416" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#9928282C" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#B02C2C30" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2E60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3D60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#4D60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#52FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#9960CDFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#FF60CDFF" />
    <Style x:Key="PlayerChipButtonStyle" TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PlayerTransportButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style x:Key="PlayerPlayButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <Storyboard><DoubleAnimation Storyboard.TargetName="PlaySurface" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0" /></Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard><DoubleAnimation Storyboard.TargetName="PlaySurface" Storyboard.TargetProperty="Opacity" To="0.82" Duration="0" /></Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard><DoubleAnimation Storyboard.TargetName="PlaySurface" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Ellipse x:Name="PlaySurface" Fill="{TemplateBinding Background}" />
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PlayerTrackRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HaloSegmentedRadioStyle}">
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="PlayerSpeedRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource HaloSegmentedRadioStyle}">
      <Setter Property="Height" Value="58" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style x:Key="PlayerStepperButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </UserControl.Resources>
  <Grid
    x:Name="OsdRoot"
    Background="Transparent"
    Opacity="{x:Bind ViewModel.OsdOpacity, Mode=OneWay}"
    PointerMoved="OnOsdPointerMoved">
    <Rectangle Height="160" VerticalAlignment="Top">
      <Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Offset="0" Color="#CC000000" /><GradientStop Offset="1" Color="#00000000" /></LinearGradientBrush></Rectangle.Fill>
    </Rectangle>
    <Grid Margin="{x:Bind ViewModel.HeaderPadding, Mode=OneWay}" VerticalAlignment="Top">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button Width="34" Height="34" Padding="0" AutomationProperties.Name="Back" Background="#80141418" BorderBrush="#1FFFFFFF" BorderThickness="1" Click="OnBackClick" CornerRadius="4"><FontIcon FontSize="15" Foreground="White" Glyph="&#xE72B;" /></Button>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TitleText" FontSize="{x:Bind ViewModel.TitleFontSize, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" Text="Halo" /><TextBlock x:Name="SourceLabelText" Margin="0,2,0,0" FontFamily="{StaticResource HaloMonoFont}" FontSize="10.5" Foreground="#94FFFFFF" Text="SOURCE" /></StackPanel>
    </Grid>

    <Border Padding="26,14" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#9E141418" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.PausedVisibility, Mode=OneWay}"><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" Text="Paused" /></Border>

    <Grid VerticalAlignment="Bottom">
      <Rectangle Height="240" VerticalAlignment="Bottom"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Offset="0" Color="#00000000" /><GradientStop Offset="1" Color="#E6040508" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <StackPanel Margin="{x:Bind ViewModel.TransportPadding, Mode=OneWay}" VerticalAlignment="Bottom">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ToggleButton IsChecked="{x:Bind ViewModel.SubtitleTabSelected, Mode=OneWay}" Click="OnSubtitlesPanelClick" Style="{StaticResource PlayerChipButtonStyle}"><StackPanel><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" CharacterSpacing="160" Text="SUBTITLES" /><TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="White" Text="English · ASS" /></StackPanel></ToggleButton>
            <ToggleButton IsChecked="{x:Bind ViewModel.AudioTabSelected, Mode=OneWay}" Click="OnAudioPanelClick" Style="{StaticResource PlayerChipButtonStyle}"><StackPanel><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" CharacterSpacing="160" Text="AUDIO" /><TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="White" Text="English 5.1 · EAC3" /></StackPanel></ToggleButton>
            <ToggleButton IsChecked="{x:Bind ViewModel.SpeedTabSelected, Mode=OneWay}" Click="OnSpeedPanelClick" Style="{StaticResource PlayerChipButtonStyle}"><StackPanel><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" CharacterSpacing="160" Text="SPEED" /><TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="White" Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}" /></StackPanel></ToggleButton>
            <ToggleButton IsChecked="{x:Bind ViewModel.UpNextOpen, Mode=OneWay}" Click="OnUpNextClick" Style="{StaticResource PlayerChipButtonStyle}" Visibility="{x:Bind ViewModel.UpNextAvailableVisibility, Mode=OneWay}"><StackPanel><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9" CharacterSpacing="160" Text="UP NEXT" /><TextBlock MaxWidth="210" Margin="0,4,0,0" FontSize="12.5" Foreground="White" Text="{x:Bind ViewModel.UpNextTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" /></StackPanel></ToggleButton>
          </StackPanel>
          <TextBlock Grid.Column="1" Padding="0,0,0,8" VerticalAlignment="Bottom" FontFamily="{StaticResource HaloMonoFont}" FontSize="10" Foreground="#70FFFFFF" Text="SPACE PLAY · ←/→ 10 S · F FULL SCREEN · ESC EXIT" />
        </Grid>
        <Grid Height="32" Margin="0,4,0,0">
          <Border Height="6" Margin="8,0" VerticalAlignment="Center" Background="#29FFFFFF" CornerRadius="3" IsHitTestVisible="False" />
          <ProgressBar Height="6" Margin="8,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="3" Foreground="#4DFFFFFF" IsHitTestVisible="False" Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}" Value="{x:Bind ViewModel.BufferedPosition, Mode=OneWay}" />
          <ProgressBar Height="6" Margin="8,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="3" Foreground="#FF60CDFF" IsHitTestVisible="False" Maximum="{Binding ElementName=SeekSlider, Path=Maximum}" Value="{Binding ElementName=SeekSlider, Path=Value}" />
          <Slider
            x:Name="SeekSlider"
            Height="32"
            AutomationProperties.Name="Seek position"
            Background="Transparent"
            CornerRadius="3"
            Foreground="Transparent"
            IsThumbToolTipEnabled="False"
            Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}"
            Minimum="0"
            Value="{x:Bind ViewModel.Position, Mode=OneWay}">
            <Slider.Resources>
              <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
              <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
              <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
              <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
              <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
              <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
              <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
              <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
              <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
              <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF" />
              <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFFFFFFF" />
            </Slider.Resources>
          </Slider>
        </Grid>
        <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="96" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Width="{x:Bind ViewModel.PlayButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.PlayButtonSize, Mode=OneWay}" AutomationProperties.Name="Play or pause" Click="OnTogglePauseClick" Style="{StaticResource PlayerPlayButtonStyle}">
            <Grid Width="14" Height="14">
              <Viewbox Width="14" Height="14" Visibility="{x:Bind ViewModel.PausedVisibility, Mode=OneWay}">
                <Canvas Width="12" Height="12"><Path Data="M 2,1 L 11,6 L 2,11 Z" Fill="Black" /></Canvas>
              </Viewbox>
              <Viewbox Width="14" Height="14" Visibility="{x:Bind ViewModel.PlayingVisibility, Mode=OneWay}">
                <Canvas Width="12" Height="12"><Rectangle Canvas.Left="2" Canvas.Top="1" Width="3" Height="10" Fill="Black" /><Rectangle Canvas.Left="7" Canvas.Top="1" Width="3" Height="10" Fill="Black" /></Canvas>
              </Viewbox>
            </Grid>
          </Button>
          <Button Grid.Column="1" Width="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Margin="14,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Back 10 seconds" Click="OnReplayClick" Style="{StaticResource PlayerTransportButtonStyle}">
            <Viewbox Width="16" Height="16">
              <Canvas Width="16" Height="16"><Path Data="M 13.5,8 A 5.5,5.5 0 1 1 11.8,4 M 11.6,1.4 V 4.2 H 8.8" Stroke="White" StrokeThickness="1.2" /></Canvas>
            </Viewbox>
          </Button>
          <Button Grid.Column="2" Width="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Forward 10 seconds" Click="OnForwardClick" Style="{StaticResource PlayerTransportButtonStyle}">
            <Viewbox Width="16" Height="16">
              <Canvas Width="16" Height="16"><Path Data="M 2.5,8 A 5.5,5.5 0 1 0 4.2,4 M 4.4,1.4 V 4.2 H 7.2" Stroke="White" StrokeThickness="1.2" /></Canvas>
            </Viewbox>
          </Button>
          <StackPanel Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="#D1FFFFFF" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
            <TextBlock Margin="7,0,0,0" FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="#66FFFFFF" Text="/" />
            <TextBlock Margin="7,0,0,0" FontFamily="{StaticResource HaloMonoFont}" FontSize="12" Foreground="#66FFFFFF" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
          </StackPanel>
          <Viewbox Grid.Column="5" Width="16" Height="16" VerticalAlignment="Center">
            <Canvas Width="16" Height="16"><Path Data="M 3,6 H 5.4 L 9,3 V 13 L 5.4,10 H 3 Z M 11.4,5.6 A 3.4,3.4 0 0 1 11.4,10.4" Opacity="0.8" Stroke="White" StrokeThickness="1.2" /></Canvas>
          </Viewbox>
          <Slider Grid.Column="6" Height="32" Margin="10,0" IsThumbToolTipEnabled="False" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Volume, Mode=TwoWay}">
            <Slider.Resources>
              <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
              <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
              <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
              <x:Double x:Key="SliderInnerThumbWidth">12</x:Double>
              <x:Double x:Key="SliderInnerThumbHeight">12</x:Double>
              <SolidColorBrush x:Key="SliderTrackFill" Color="#2EFFFFFF" />
              <SolidColorBrush x:Key="SliderTrackValueFill" Color="#DBFFFFFF" />
              <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF" />
              <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
            </Slider.Resources>
          </Slider>
          <TextBlock Grid.Column="7" Width="28" VerticalAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" Foreground="White" Text="{x:Bind ViewModel.VolumeText, Mode=OneWay}" />
          <Button Grid.Column="8" Width="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Margin="10,0,0,0" AutomationProperties.Name="Picture in picture" CornerRadius="6" Style="{StaticResource PlayerTransportButtonStyle}" ToolTipService.ToolTip="Picture in picture is not available">
            <Viewbox Width="15" Height="15">
              <Canvas Width="16" Height="16"><Rectangle Canvas.Left="1.5" Canvas.Top="2.5" Width="13" Height="11" RadiusX="1.5" RadiusY="1.5" Stroke="White" StrokeThickness="1.2" /><Rectangle Canvas.Left="8" Canvas.Top="8" Width="5.5" Height="4.5" RadiusX="1" RadiusY="1" Stroke="White" StrokeThickness="1.2" /></Canvas>
            </Viewbox>
          </Button>
          <Button Grid.Column="9" Width="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Height="{x:Bind ViewModel.TransportButtonSize, Mode=OneWay}" Margin="10,0,0,0" AutomationProperties.Name="Toggle fullscreen" Click="OnFullscreenClick" CornerRadius="6" Style="{StaticResource PlayerTransportButtonStyle}">
            <Grid Width="15" Height="15">
              <Viewbox Width="15" Height="15" Visibility="{x:Bind ViewModel.EnterFullscreenIconVisibility, Mode=OneWay}">
                <Canvas Width="16" Height="16"><Path Data="M 2,6 V 2 H 6 M 14,6 V 2 H 10 M 2,10 V 14 H 6 M 14,10 V 14 H 10" Stroke="White" StrokeThickness="1.2" /></Canvas>
              </Viewbox>
              <Viewbox Width="15" Height="15" Visibility="{x:Bind ViewModel.ExitFullscreenIconVisibility, Mode=OneWay}">
                <Canvas Width="16" Height="16"><Path Data="M 6,2 V 6 H 2 M 10,2 V 6 H 14 M 6,14 V 10 H 2 M 10,14 V 10 H 14" Stroke="White" StrokeThickness="1.2" /></Canvas>
              </Viewbox>
            </Grid>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>

    <Grid Visibility="{x:Bind ViewModel.PanelVisibility, Mode=OneWay}">
      <Border Background="#80040508" />
      <Border Width="400" HorizontalAlignment="Right" Background="#DB1C1C20" BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0" CornerRadius="22,0,0,22">
        <Grid Padding="22">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="White" Text="Playback" />
              <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="#8FFFFFFF" Text="Applies live: nothing reloads" />
            </StackPanel>
            <Button Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close panel" Click="OnClosePanelClick"><FontIcon FontSize="11" Foreground="White" Glyph="&#xE711;" /></Button>
          </Grid>
          <Border Grid.Row="1" Margin="0,20,0,16" Style="{StaticResource HaloSegmentedTrayStyle}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <RadioButton GroupName="PanelTab" IsChecked="{x:Bind ViewModel.AudioTabSelected, Mode=OneWay}" Click="OnAudioTabClick" Content="Audio" Style="{StaticResource HaloSegmentedRadioStyle}" />
              <RadioButton Grid.Column="1" GroupName="PanelTab" IsChecked="{x:Bind ViewModel.SubtitleTabSelected, Mode=OneWay}" Click="OnSubtitlesTabClick" Content="Subtitles" Style="{StaticResource HaloSegmentedRadioStyle}" />
              <RadioButton Grid.Column="2" GroupName="PanelTab" IsChecked="{x:Bind ViewModel.SpeedTabSelected, Mode=OneWay}" Click="OnSpeedTabClick" Content="Speed" Style="{StaticResource HaloSegmentedRadioStyle}" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
            <Grid>
              <StackPanel Visibility="{x:Bind ViewModel.SubtitlePanelVisibility, Mode=OneWay}">
                <TextBlock Margin="0,0,0,6" Foreground="#99FFFFFF" Style="{StaticResource HaloMonoKicker}" Text="IN THIS FILE" />
                <RadioButton GroupName="SubtitleTrack" Click="OnSubtitlesOffClick" Style="{StaticResource PlayerTrackRadioStyle}">
                  <StackPanel><TextBlock FontSize="13.5" Foreground="White" Text="Off" /><TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="#8FFFFFFF" Text="No subtitles" /></StackPanel>
                </RadioButton>
                <ItemsControl x:Name="SubtitleTrackList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaybackTrackViewModel">
                      <RadioButton GroupName="SubtitleTrack" IsChecked="{x:Bind IsSelected, Mode=OneTime}" Click="OnSubtitleTrackClick" Style="{StaticResource PlayerTrackRadioStyle}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock FontSize="13.5" Foreground="White" Text="{x:Bind Title}" /><TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="#8FFFFFFF" Text="{x:Bind Note}" /></StackPanel>
                          <Border Grid.Column="1" Padding="6,3" VerticalAlignment="Center" Background="#3318CDFF" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9.5" Foreground="White" Text="{x:Bind Codec}" /></Border>
                        </Grid>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,18,0,6" Foreground="#99FFFFFF" Style="{StaticResource HaloMonoKicker}" Text="FROM ADDONS" />
                <ItemsControl x:Name="AddonSubtitleList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AddonSubtitleViewModel"><Button Margin="0,0,0,4" Padding="10,8" HorizontalContentAlignment="Stretch" Background="#0AFFFFFF" BorderThickness="0" CornerRadius="4" Click="OnAddonSubtitleClick" Tag="{x:Bind Key}"><StackPanel><TextBlock FontSize="13" Foreground="White" Text="{x:Bind Language}" /><TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="#8FFFFFFF"><Run Text="{x:Bind Addon}" /><Run Text=" · " /><Run Text="{x:Bind Variant}" /></TextBlock></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Grid Margin="0,18,0,0"><TextBlock VerticalAlignment="Center" Foreground="White" Text="Subtitle delay" /><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Click="OnSubtitleDelayDownClick" Content="−" Style="{StaticResource PlayerStepperButtonStyle}" /><TextBlock Width="68" VerticalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" Foreground="White" Text="{x:Bind ViewModel.SubtitleDelayText, Mode=OneWay}" /><Button Click="OnSubtitleDelayUpClick" Content="+" Style="{StaticResource PlayerStepperButtonStyle}" /></StackPanel></Grid>
              </StackPanel>
              <StackPanel Visibility="{x:Bind ViewModel.AudioPanelVisibility, Mode=OneWay}">
                <TextBlock Margin="0,0,0,6" Foreground="#99FFFFFF" Style="{StaticResource HaloMonoKicker}" Text="TRACKS" />
                <ItemsControl x:Name="AudioTrackList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaybackTrackViewModel">
                      <RadioButton GroupName="AudioTrack" IsChecked="{x:Bind IsSelected, Mode=OneTime}" Click="OnAudioTrackClick" Style="{StaticResource PlayerTrackRadioStyle}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock FontSize="13.5" Foreground="White" Text="{x:Bind Title}" /><TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="#8FFFFFFF" Text="{x:Bind Note}" /></StackPanel>
                          <Border Grid.Column="1" Padding="6,3" VerticalAlignment="Center" Background="#3318CDFF" CornerRadius="3"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="9.5" Foreground="White" Text="{x:Bind Codec}" /></Border>
                        </Grid>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,18,0,0"><TextBlock VerticalAlignment="Center" Foreground="White" Text="Audio delay" /><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Click="OnAudioDelayDownClick" Content="−" Style="{StaticResource PlayerStepperButtonStyle}" /><TextBlock Width="68" VerticalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource HaloMonoFont}" Foreground="White" Text="{x:Bind ViewModel.AudioDelayText, Mode=OneWay}" /><Button Click="OnAudioDelayUpClick" Content="+" Style="{StaticResource PlayerStepperButtonStyle}" /></StackPanel></Grid>
              </StackPanel>
              <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.SpeedPanelVisibility, Mode=OneWay}">
                <Grid ColumnSpacing="8" RowSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <RadioButton GroupName="SpeedChoice" Click="OnSpeedHalfClick" Style="{StaticResource PlayerSpeedRadioStyle}"><StackPanel><TextBlock FontSize="15" Foreground="White" Text="0.5×" /><TextBlock FontSize="11" Foreground="#8FFFFFFF" Text="Half" /></StackPanel></RadioButton>
                  <RadioButton Grid.Column="1" GroupName="SpeedChoice" Click="OnSpeedThreeQuarterClick" Style="{StaticResource PlayerSpeedRadioStyle}"><StackPanel><TextBlock FontSize="15" Foreground="White" Text="0.75×" /><TextBlock FontSize="11" Foreground="#8FFFFFFF" Text="25% slower" /></StackPanel></RadioButton>
                  <RadioButton Grid.Column="2" GroupName="SpeedChoice" IsChecked="True" Click="OnSpeedNormalClick" Style="{StaticResource PlayerSpeedRadioStyle}"><StackPanel><TextBlock FontSize="15" Foreground="White" Text="1×" /><TextBlock FontSize="11" Foreground="#8FFFFFFF" Text="Normal" /></StackPanel></RadioButton>
                  <RadioButton Grid.Row="1" GroupName="SpeedChoice" Click="OnSpeedOneQuarterClick" Style="{StaticResource PlayerSpeedRadioStyle}"><StackPanel><TextBlock FontSize="15" Foreground="White" Text="1.25×" /><TextBlock FontSize="11" Foreground="#8FFFFFFF" Text="25% faster" /></StackPanel></RadioButton>
                  <RadioButton Grid.Row="1" Grid.Column="1" GroupName="SpeedChoice" Click="OnSpeedOneHalfClick" Style="{StaticResource PlayerSpeedRadioStyle}"><StackPanel><TextBlock FontSize="15" Foreground="White" Text="1.5×" /><TextBlock FontSize="11" Foreground="#8FFFFFFF" Text="50% faster" /></StackPanel></RadioButton>
                  <RadioButton Grid.Row="1" Grid.Column="2" GroupName="SpeedChoice" Click="OnSpeedDoubleClick" Style="{StaticResource PlayerSpeedRadioStyle}"><StackPanel><TextBlock FontSize="15" Foreground="White" Text="2×" /><TextBlock FontSize="11" Foreground="#8FFFFFFF" Text="Double" /></StackPanel></RadioButton>
                </Grid>
                <TextBlock FontSize="12" Foreground="#99FFFFFF" Text="Pitch is corrected up to 2×. Beyond that mpv drops the audio filter." TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Width="332" Margin="0,0,24,168" Padding="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#DB18181C" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.UpNextVisibility, Mode=OneWay}">
      <StackPanel>
        <Grid>
          <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource HaloAccentBrush}" Style="{StaticResource HaloMonoKicker}" Text="{x:Bind ViewModel.UpNextKicker, Mode=OneWay}" />
          <Button MinWidth="0" MinHeight="0" Padding="4" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Click="OnCancelUpNextClick" FontSize="12" Foreground="#99FFFFFF" Content="Cancel" />
        </Grid>
        <Grid Margin="0,10,0,0" ColumnSpacing="11">
          <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid Width="84" Height="48"><local:PlaceholderArt /><local:ArtworkImage SourceUrl="{x:Bind ViewModel.UpNextPoster, Mode=OneWay}" /></Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontFamily="{StaticResource HaloMonoBoldFont}" FontSize="10" Foreground="#99FFFFFF" Text="{x:Bind ViewModel.UpNextEpisodeLabel, Mode=OneWay}" /><TextBlock MaxWidth="205" Margin="0,4,0,0" FontSize="13.5" FontWeight="SemiBold" Foreground="White" Text="{x:Bind ViewModel.UpNextTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" /></StackPanel>
        </Grid>
        <ProgressBar Height="3" Margin="0,11,0,0" Maximum="100" Value="{x:Bind ViewModel.UpNextProgress, Mode=OneWay}" />
        <Button Height="30" Margin="0,11,0,0" Click="OnPlayNextClick" Content="Play now" Style="{StaticResource HaloAccentButtonStyle}" />
      </StackPanel>
    </Border>

    <Grid
      Background="Transparent"
      PointerPressed="OnOsdWakePointerPressed"
      Visibility="{x:Bind ViewModel.OsdWakeVisibility, Mode=OneWay}" />
  </Grid>
</UserControl>
