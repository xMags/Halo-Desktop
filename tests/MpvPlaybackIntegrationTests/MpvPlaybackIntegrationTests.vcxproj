<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{EC711F1A-614B-4FE0-9AA4-8BA2139CAFB7}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>MpvPlaybackIntegrationTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &lt; '18.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration"><UseDebugLibraries>true</UseDebugLibraries></PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration"><UseDebugLibraries>false</UseDebugLibraries><WholeProgramOptimization>true</WholeProgramOptimization></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\</RepositoryRoot>
    <OutDir>$(RepositoryRoot)x64\$(Configuration)\MpvPlaybackIntegrationTests\</OutDir>
    <IntDir>$(RepositoryRoot)x64\$(Configuration)\MpvPlaybackIntegrationTests\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(RepositoryRoot)src\HaloDesktop;$(RepositoryRoot)external\mpv\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalOptions>%(AdditionalOptions) /utf-8 /permissive-</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(RepositoryRoot)external\mpv\lib\mpv.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Console</SubSystem>
    </Link>
    <PostBuildEvent>
      <!--
        The Vulkan loader travels with libmpv here for the same reason it does
        in the app: libmpv statically imports vulkan-1.dll, so without it the
        test cannot load libmpv on a machine with no GPU driver installed.
      -->
      <Command>copy /Y "$(RepositoryRoot)external\mpv\bin\libmpv-2.dll" "$(OutDir)libmpv-2.dll"
copy /Y "$(RepositoryRoot)external\vulkan\bin\vulkan-1.dll" "$(OutDir)vulkan-1.dll"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="MpvPlaybackIntegrationTests.cpp" />
    <ClCompile Include="..\..\src\HaloDesktop\Playback\MpvCommand.cpp"><Link>MpvCommand.cpp</Link></ClCompile>
    <ClCompile Include="..\..\src\HaloDesktop\Playback\PlaybackPolicy.cpp"><Link>PlaybackPolicy.cpp</Link></ClCompile>
    <ClCompile Include="..\..\src\HaloDesktop\Security\ProtectedHttpHeaders.cpp"><Link>ProtectedHttpHeaders.cpp</Link></ClCompile>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
